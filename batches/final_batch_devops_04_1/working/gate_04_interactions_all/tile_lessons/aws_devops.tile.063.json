        "public": {
          "prompt": "Read each independent supplied evidence excerpt and its reviewer decision. Decide whether that decision is supported by the evidence and the verification requirements, or unsupported. A supported decision may correctly identify a failure; it does not always mean the operation succeeded.",
          "buckets": [
            {
              "bucket_id": "supported",
