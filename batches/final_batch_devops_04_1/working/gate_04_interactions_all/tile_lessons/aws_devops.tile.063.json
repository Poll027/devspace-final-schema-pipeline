              "review_url": "https://www.youtube.com/watch?v=FNbHpOTwifQ&t=0s",
              "start_seconds": 0,
              "end_seconds": 274,
              "label": "Locate an explicit deny or missing allow with the IAM Policy Simulator",
              "summary": "The IAM Policy Simulator tests selected operations against policies associated with an existing identity. In the demonstrated case, user Daniel has an S3 allow policy and a separate policy explicitly denying bucket creation. Simulating bucket creation returns a denial because the explicit deny overrides the allow. The Show Statement control identifies the statement responsible. Simulated object retrieval and deletion are allowed, and their results identify the supporting allow statement. Testing DynamoDB operations instead produces implicit denials because the identity has not been granted those permissions. These results distinguish an applicable explicit deny from a missing allow; they do not demonstrate a correction or a successful retest of the actual denied operation.",
              "fact_ids": [
                "f2"
              ],
              "transcript_ref": "FNbHpOTwifQ:0-274"
            }
          ],
          "group_title": "Locate the policy evidence behind a denial",
          "bridge": {
            "before": "Watch how selected operations produce different results for the same identity, and how Show Statement locates supporting evidence. The clip calls denial from a missing allow an “implicit denial.”",
            "after": "The clip demonstrates deny precedence and missing allows. The text additionally covers complete request context, unsatisfied conditions, constraints beyond identity policies, and the smallest approved correction followed by retesting the denied operation."
          },
          "default_mode": "video"
        }
