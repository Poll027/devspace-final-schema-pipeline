      "blocks": [
        {
          "type": "prose",
          "text": "terraform validate checks syntax and internal consistency, not remote service state or provider API success.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation"
            ],
            "fact_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb1",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb2",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb3",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb4",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb5"
            ]
          },
          "block_id": "aws_devops.tile.066.s01.b01"
        },
        {
          "type": "prose",
          "text": "Where backend access is unnecessary, initialize needed providers and modules with terraform init -backend=false before static validation.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation"
            ],
            "fact_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#f2"
            ],
            "teaching_block_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb1",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb2",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb3",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb4",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb5"
            ]
          },
          "block_id": "aws_devops.tile.066.s01.b02"
        },
        {
          "type": "prose",
          "text": "Make terraform validate blocking. Stop on nonzero exit, correct the invalid declaration and rerun before the supplied approved apply step.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation"
            ],
            "fact_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb1",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb2",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb3",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb4",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb5"
            ]
          },
          "block_id": "aws_devops.tile.066.s01.b03"
        },
        {
          "type": "prose",
          "text": "terraform fmt -check checks canonical formatting and can serve as an additional blocking configuration check.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation"
            ],
            "fact_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#f4"
            ],
            "teaching_block_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb1",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb2",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb3",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb4",
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#tb5"
            ]
          },
          "block_id": "aws_devops.tile.066.s01.b04"
        },
        {
          "type": "prose",
          "text": "For the supplied invalid EC2 declaration, validation failure must block apply. After correction, rerun validation and any blocking formatting check. A formatting-only change is not a configuration-validity correction, and static-check success is not provisioning evidence.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation"
            ],
            "fact_ids": [
              "aws_devops.gate_infrastructure_changes_with_configuration_validation#f1",
