        "public": {
          "prompt": "After the supplied retention policy is applied, an expired event remains physically visible. Which interpretation is valid?",
          "options": [
            {
              "option_id": "o1",
              "text": "Expiry marks events for deletion; physical deletion is not necessarily immediate."
            },
            {
              "option_id": "o2",
              "text": "Visible expired events prove the retention setting was not saved."
            },
            {
              "option_id": "o3",
              "text": "Retention requires every expired event to disappear immediately."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
