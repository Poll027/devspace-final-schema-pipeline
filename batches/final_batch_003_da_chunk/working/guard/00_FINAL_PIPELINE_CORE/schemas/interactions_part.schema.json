{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactions_part.schema.json",
  "title": "Stage 04 output: one interaction per check/hands_on step",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "interactions_part"
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tile_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "interaction": {
                  "$ref": "interaction_union.schema.json"
                }
              },
              "additionalProperties": false,
              "required": [
                "step_id",
                "interaction"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "tile_id",
          "interactions"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_id",
    "batch_id",
    "tiles"
  ]
}
