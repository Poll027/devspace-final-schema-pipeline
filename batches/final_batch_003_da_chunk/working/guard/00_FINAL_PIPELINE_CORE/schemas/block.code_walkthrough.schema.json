{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.code_walkthrough.schema.json",
  "title": "Block: code_walkthrough (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "code_walkthrough"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "language": {
      "enum": [
        "python",
        "sql",
        "javascript",
        "typescript",
        "jsx",
        "css",
        "html",
        "bash",
        "r",
        "excel_formula"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "start_line",
          "end_line",
          "text"
        ]
      }
    },
    "reveal": {
      "enum": [
        "all",
        "line_by_line"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "text",
            "table"
          ]
        },
        "text": {
          "type": "string"
        },
        "asset_ref": {
          "$ref": "common.schema.json#/$defs/asset_ref"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "execution_provenance": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "code_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "language",
    "code"
  ]
}
