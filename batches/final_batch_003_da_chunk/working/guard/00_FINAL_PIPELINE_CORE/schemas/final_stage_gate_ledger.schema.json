{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final_stage_gate_ledger.schema.json",
  "title": "Stage gates (written only by update_ledger.py)",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "artifact_hash": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "generator_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluator_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "unresolved_issue_count": {
            "type": "integer",
            "minimum": 0
          },
          "gated_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "stage_id",
          "artifact",
          "artifact_hash",
          "verdict",
          "unresolved_issue_count",
          "gated_at"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "batch_id",
    "gates"
  ]
}
