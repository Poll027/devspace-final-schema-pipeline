{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.code_exercise.schema.json",
  "title": "Interaction: code_exercise (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "code_exercise"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "python",
                "sql",
                "javascript",
                "react_sandbox",
                "spreadsheet",
                "bash"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ]
        },
        "workspace": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "editable",
                      "readonly"
                    ]
                  },
                  "language": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "role",
                  "content"
                ]
              },
              "minItems": 1
            },
            "entry": {
              "type": "string"
            },
            "asset_mounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "variant_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mount_path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "mount_path"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "files"
          ]
        },
        "constraints": {
          "type": "object",
          "properties": {
            "allowed_syntax": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blocked_syntax": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "walkthrough": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "focus_lines": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "instruction": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "action": {
                "enum": [
                  "read",
                  "edit",
                  "run",
                  "predict"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "step",
              "instruction",
              "action"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "runtime",
        "workspace"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "kind": {
                "enum": [
                  "stdout_equals",
                  "value_equals",
                  "dataframe_equals",
                  "query_result_equals",
                  "function_call",
                  "forbidden_syntax"
                ]
              },
              "spec": {
                "type": "object"
              },
              "visible": {
                "type": "boolean"
              },
              "message_on_fail": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false,
            "required": [
              "test_id",
              "kind",
              "spec",
              "message_on_fail"
            ]
          },
          "minItems": 1
        },
        "solution_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ]
          },
          "minItems": 1
        },
        "execution_provenance": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1
            },
            "solution_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "tests_passed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "tests",
        "solution_files"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
