{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch_run_context.schema.json",
  "title": "Stage 00 output",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "glossary_bundle_file": {
      "type": "string",
      "minLength": 1
    },
    "glossary_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "toc_workspace": {
      "type": "string",
      "minLength": 1
    },
    "toc_freeze_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "tile_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "player_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "batch_id",
    "path_id",
    "glossary_bundle_file",
    "glossary_batch_id",
    "toc_workspace",
    "toc_freeze_hash",
    "tile_ids",
    "player_version"
  ]
}
