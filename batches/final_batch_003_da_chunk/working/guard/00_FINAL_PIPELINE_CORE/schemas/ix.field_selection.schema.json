{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.field_selection.schema.json",
  "title": "Interaction: field_selection (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "field_selection"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "scenario": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "field_id",
              "label"
            ]
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "fields"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "role": {
                "enum": [
                  "required",
                  "acceptable",
                  "unneeded",
                  "forbidden"
                ]
              },
              "rationale": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false,
            "required": [
              "field_id",
              "role",
              "rationale"
            ]
          },
          "minItems": 2
        },
        "outcome_messages": {
          "type": "object",
          "properties": {
            "missing_required": {
              "type": "string"
            },
            "includes_forbidden": {
              "type": "string"
            },
            "includes_unneeded": {
              "type": "string"
            },
            "ok": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "rules"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
