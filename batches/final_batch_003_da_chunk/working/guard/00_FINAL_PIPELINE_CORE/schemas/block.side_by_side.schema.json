{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.side_by_side.schema.json",
  "title": "Block: side_by_side (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "side_by_side"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "left": {
      "oneOf": [
        {
          "$ref": "block.data_table.schema.json"
        },
        {
          "$ref": "block.spreadsheet_grid.schema.json"
        },
        {
          "$ref": "block.chart.schema.json"
        },
        {
          "$ref": "block.code_walkthrough.schema.json"
        },
        {
          "$ref": "block.diagram.schema.json"
        },
        {
          "$ref": "block.process_flow.schema.json"
        }
      ]
    },
    "right": {
      "oneOf": [
        {
          "$ref": "block.data_table.schema.json"
        },
        {
          "$ref": "block.spreadsheet_grid.schema.json"
        },
        {
          "$ref": "block.chart.schema.json"
        },
        {
          "$ref": "block.code_walkthrough.schema.json"
        },
        {
          "$ref": "block.diagram.schema.json"
        },
        {
          "$ref": "block.process_flow.schema.json"
        }
      ]
    },
    "left_label": {
      "type": "string",
      "minLength": 1
    },
    "right_label": {
      "type": "string",
      "minLength": 1
    },
    "takeaway": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "left",
    "right",
    "left_label",
    "right_label",
    "takeaway"
  ]
}
