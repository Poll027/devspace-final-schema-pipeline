{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.data_table.schema.json",
  "title": "Block: data_table (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "data_table"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "asset_ref": {
      "$ref": "common.schema.json#/$defs/asset_ref"
    },
    "caption": {
      "type": "string"
    },
    "highlight": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "label": {
            "type": "string"
          },
          "tone": {
            "enum": [
              "focus",
              "good",
              "bad",
              "neutral"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "target"
        ]
      }
    },
    "tag_columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "enum": [
              "focus",
              "good",
              "bad",
              "neutral"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "column",
          "tag"
        ]
      }
    },
    "inspect": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "caption_template": {
          "type": "string"
        },
        "id_column": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    },
    "result_of": {
      "type": "object",
      "description": "Show the result of running a query on registry datasets. The rows are COMPUTED by the sandbox (assemble fills `result`), never typed. Use this instead of asset_ref whenever the table is a query's output (DISTINCT, WHERE, GROUP BY, JOIN ...).",
      "properties": {
        "runtime": {
          "enum": [
            "sql"
          ]
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "asset_mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "variant_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mount_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "asset_id",
              "mount_path"
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime",
        "sql",
        "asset_mounts"
      ]
    },
    "result": {
      "type": "object",
      "description": "Computed by assemble_tiles.py from result_of; never authored.",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "execution_provenance": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string"
            },
            "runtime_version": {
              "type": "string"
            },
            "sql_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "anyOf": [
    {
      "required": [
        "asset_ref"
      ]
    },
    {
      "required": [
        "result_of"
      ]
    }
  ]
}
