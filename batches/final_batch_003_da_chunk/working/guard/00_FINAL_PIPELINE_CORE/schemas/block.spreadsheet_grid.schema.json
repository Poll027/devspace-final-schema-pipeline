{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.spreadsheet_grid.schema.json",
  "title": "Block: spreadsheet_grid (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "spreadsheet_grid"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "asset_ref": {
      "$ref": "common.schema.json#/$defs/asset_ref"
    },
    "sheet_name": {
      "type": "string"
    },
    "range": {
      "type": "string",
      "pattern": "^[A-Z]+[0-9]+:[A-Z]+[0-9]+$"
    },
    "show_formula_bar": {
      "type": "boolean"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Z]+[0-9]+$"
          },
          "formula": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "ref"
        ]
      }
    },
    "selection": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "target",
          "text"
        ]
      }
    },
    "computed_values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "asset_ref",
    "range"
  ]
}
