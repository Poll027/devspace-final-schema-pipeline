{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#\\-]*$",
      "maxLength": 160
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "where": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "row_ref": {
      "type": "object",
      "properties": {
        "where": {
          "$ref": "#/$defs/where"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "where"
      ]
    },
    "cell_ref": {
      "type": "object",
      "properties": {
        "where": {
          "$ref": "#/$defs/where"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "where",
        "column"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "row",
            "column",
            "cell"
          ]
        },
        "row": {
          "$ref": "#/$defs/row_ref"
        },
        "column": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "asset_ref": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "variant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "asset_id"
      ]
    },
    "lineage": {
      "type": "object",
      "properties": {
        "concept_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "teaching_block_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "segment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "properties": {
        "gems": {
          "type": "integer",
          "minimum": 0
        },
        "first_try_bonus": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "$ref": "#/$defs/id"
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "concept_id",
          "capability",
          "fact_ids"
        ]
      },
      "minItems": 1
    },
    "feedback": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "object",
          "properties": {
            "message": {
              "$ref": "#/$defs/text"
            },
            "coach": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "message"
          ]
        },
        "incorrect": {
          "type": "object",
          "properties": {
            "message": {
              "$ref": "#/$defs/text"
            },
            "coach": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "message"
          ]
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "remediation_step_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false,
      "required": [
        "correct",
        "incorrect"
      ]
    }
  }
}
