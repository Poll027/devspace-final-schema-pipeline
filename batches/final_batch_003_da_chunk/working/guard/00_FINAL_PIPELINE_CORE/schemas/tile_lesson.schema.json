{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tile_lesson.schema.json",
  "title": "Final Schema: tile lesson (the unit the player loads)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "tile_lesson"
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tile_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "toc_location": {
      "type": "object",
      "properties": {
        "region_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "terrain_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "additionalProperties": false,
      "required": [
        "region_id",
        "terrain_id"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "glossary_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "toc_freeze_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "glossary_bundle_hashes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "scenario_registry_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "glossary_batch_id",
        "glossary_bundle_hashes",
        "scenario_registry_hash"
      ]
    },
    "requires": {
      "type": "object",
      "properties": {
        "min_player_version": {
          "type": "string",
          "minLength": 1
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "block_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interaction_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "min_player_version",
        "block_types",
        "interaction_types",
        "asset_ids"
      ]
    },
    "pacing": {
      "type": "object",
      "properties": {
        "estimated_minutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "step.schema.json"
      },
      "minItems": 1
    },
    "remediation_steps": {
      "type": "array",
      "items": {
        "$ref": "step.schema.json"
      }
    },
    "completion": {
      "type": "object",
      "properties": {
        "rule": {
          "enum": [
            "all_required_steps_complete"
          ]
        },
        "reward": {
          "$ref": "common.schema.json#/$defs/reward"
        },
        "next_tile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rule"
      ]
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_id",
    "tile_id",
    "title",
    "concept_ids",
    "source",
    "requires",
    "steps",
    "completion"
  ]
}
