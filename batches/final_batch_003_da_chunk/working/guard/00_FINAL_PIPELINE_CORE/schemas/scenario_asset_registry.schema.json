{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_asset_registry.schema.json",
  "title": "Path scenarios + reusable assets (datasets are one asset kind)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "scenario_asset_registry"
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "locale": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "glossary_example_vocab": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "name",
          "summary"
        ]
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "asset_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "asset_kind": {
                "const": "dataset"
              },
              "scenario_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "integer",
                        "number",
                        "string",
                        "boolean",
                        "date",
                        "datetime"
                      ]
                    },
                    "semantic_role": {
                      "enum": [
                        "identifier",
                        "categorical",
                        "numerical",
                        "datetime",
                        "text",
                        "pii"
                      ]
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "numeric_looking_label": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "semantic_role"
                  ]
                },
                "minItems": 1
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "minItems": 1
              },
              "data_file": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "enum": [
                      "csv",
                      "parquet",
                      "json"
                    ]
                  },
                  "sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "uri",
                  "format",
                  "sha256"
                ]
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant_id": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "derived_from": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "purpose": {
                      "type": "string"
                    },
                    "ops": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "const": "set_cell"
                              },
                              "where": {
                                "$ref": "common.schema.json#/$defs/where"
                              },
                              "occurrence": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "column": {
                                "type": "string",
                                "minLength": 1
                              },
                              "value": {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean",
                                  "null"
                                ]
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "op",
                              "where",
                              "column",
                              "value"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "const": "duplicate_row"
                              },
                              "where": {
                                "$ref": "common.schema.json#/$defs/where"
                              },
                              "occurrence": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "insert": {
                                "enum": [
                                  "after",
                                  "end"
                                ]
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "op",
                              "where"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "const": "drop_rows"
                              },
                              "where": {
                                "$ref": "common.schema.json#/$defs/where"
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "op",
                              "where"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "op": {
                                "const": "drop_columns"
                              },
                              "columns": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "minItems": 1
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "op",
                              "columns"
                            ]
                          }
                        ]
                      }
                    },
                    "planted_issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "issue_id": {
                            "$ref": "common.schema.json#/$defs/id"
                          },
                          "kind": {
                            "enum": [
                              "missing_value",
                              "impossible_value",
                              "duplicate_row",
                              "inconsistent_category",
                              "outlier_suspicious",
                              "wrong_type",
                              "other"
                            ]
                          },
                          "locations": {
                            "type": "array",
                            "items": {
                              "$ref": "common.schema.json#/$defs/cell_ref"
                            },
                            "minItems": 1
                          },
                          "description": {
                            "$ref": "common.schema.json#/$defs/text"
                          },
                          "rule": {
                            "type": "object",
                            "properties": {
                              "column": {
                                "type": "string",
                                "minLength": 1
                              },
                              "op": {
                                "enum": [
                                  "is_null",
                                  "lt",
                                  "le",
                                  "gt",
                                  "ge",
                                  "eq",
                                  "ne",
                                  "lower_ne_value",
                                  "casing_differs_from_siblings"
                                ]
                              },
                              "value": {
                                "type": [
                                  "string",
                                  "number",
                                  "boolean",
                                  "null"
                                ]
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "column",
                              "op"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "issue_id",
                          "kind",
                          "locations",
                          "description"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "variant_id",
                    "derived_from",
                    "ops"
                  ]
                }
              },
              "provenance": {
                "enum": [
                  "authored",
                  "generated_by_script",
                  "imported"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "asset_id",
              "asset_kind",
              "scenario_id",
              "title",
              "columns",
              "provenance"
            ]
          },
          {
            "type": "object",
            "properties": {
              "asset_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "asset_kind": {
                "const": "code_workspace"
              },
              "scenario_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "content"
                  ]
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "asset_id",
              "asset_kind",
              "scenario_id",
              "title",
              "runtime",
              "files"
            ]
          },
          {
            "type": "object",
            "properties": {
              "asset_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "asset_kind": {
                "const": "image"
              },
              "scenario_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "alt_text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "asset_id",
              "asset_kind",
              "scenario_id",
              "title",
              "uri",
              "alt_text"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_id",
    "scenarios",
    "assets"
  ]
}
