    {
      "tile_id": "tile_stakeholder_presentation_structure",
      "title": "Structuring Presentations and Writing Executive Summaries",
      "summary": "Learn to structure a short presentation as opening, body, and call to action, and to write an executive summary with a takeaway title and section headers.",
      "steps": [
        {
          "step_id": "tile_stakeholder_presentation_structure.s01",
          "type": "explainer",
          "concept_ids": [
            "stakeholder.presentation_structure_basics"
          ],
          "eyebrow": "Presentation Structure",
          "title": "Opening, Body, Call to Action",
          "lede": "With the Lagos finding, the recommendation, and a simplified chart ready, the last piece is putting them in an order that carries the operations manager from 'why am I reading this' to 'what do you want me to do.'",
          "blocks": [
            {
              "type": "prose",
              "text": "A summary should have an obvious beginning, middle, and end. In the beginning, level-set the audience; in the middle, present the analysis; in the end, conclude with the key takeaways. In a story's structure, the beginning establishes the context of the situation, and this gets carried onward to the twist, before the ending brings the story to its close. Mapped onto the Lagos presentation: the beginning is the situation (delivery times across the three cities this month), the twist is the Lagos slowdown, and the ending is the courier recommendation.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "stakeholder.presentation_structure_basics"
                ],
                "fact_ids": [
                  "stakeholder.presentation_structure_basics#f1",
                  "stakeholder.presentation_structure_basics#f2"
                ],
                "teaching_block_ids": [
                  "stakeholder.presentation_structure_basics#tb1",
                  "stakeholder.presentation_structure_basics#tb2"
                ]
              }
            },
            {
              "type": "process_flow",
              "title": "Three-Part Presentation Spine",
              "direction": "LR",
              "nodes": [
                {
                  "id": "opening",
                  "label": "Opening",
                  "kind": "start",
                  "detail": "Context / situation \u2014 why are we reviewing Lagos delivery times?"
                },
                {
                  "id": "body",
                  "label": "Body",
                  "kind": "step",
                  "detail": "Finding + evidence \u2014 Lagos avg delivery time rose from 22 to 30 min; distance is the strongest driver."
                },
                {
                  "id": "cta",
                  "label": "Call to Action",
                  "kind": "end",
                  "detail": "What is being asked \u2014 approve adding one courier on the longest Lagos routes."
