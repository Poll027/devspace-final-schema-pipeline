        {
          "step_id": "tile_stakeholder_tailoring_anticipating.s02",
          "type": "explainer",
          "concept_ids": [
            "stakeholder.tailoring_detail_to_audience"
          ],
          "eyebrow": "Tailoring Detail",
          "title": "Technical vs. Big-Picture Audiences",
          "lede": "The order in which you present findings and recommendations should shift depending on who is reading.",
          "blocks": [
            {
              "type": "prose",
              "text": "Technical or detail-oriented people may prefer to understand the specifics of an analysis first, so they are prepared to take in ideas about next steps. With executives or other big-picture-oriented people \u2014 who do not have a lot of patience for the specifics \u2014 you should think about starting with your request. An executive audience might only want the high-level arc: the operations manager may want the day-by-day breakdown, while the executive slide can lead with the recommendation and skip the breakdown.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "stakeholder.tailoring_detail_to_audience"
                ],
                "fact_ids": [
                  "stakeholder.tailoring_detail_to_audience#f3",
                  "stakeholder.tailoring_detail_to_audience#f4"
                ],
                "teaching_block_ids": [
