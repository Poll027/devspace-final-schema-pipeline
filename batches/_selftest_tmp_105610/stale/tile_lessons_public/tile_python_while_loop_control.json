                "f2"
              ],
              "transcript_ref": "gD8ePxAhjUM:178-421"
            }
          ],
          "bridge": {
            "before": "Watch the trace: each pass re-checks the condition, and with no update line the same check passes forever. The clip counts up with i; Devspace's examples use a Fibonacci-style update and a countdown of pending deliveries.",
            "after": "Both Devspace examples rely on the same idea from the recap: the body must change what the condition checks, or the loop never stops."
          },
          "default_mode": "video"
        }
