              "f3"
            ]
          }
        ],
        "anchors": [
          "python.pep8_style#assessment:remove_extraneous_whitespace"
        ],
        "public": {
          "prompt": "Which line follows PEP 8's rule about extraneous whitespace?\n\n```python\n# A\nresult = compute( x , y )\n\n# B\nresult = compute(x, y)\n\n# C\nresult = compute(x ,y)\n\n# D\nresult = compute( x,y )\n```",
          "options": [
            {
              "option_id": "opt_a",
              "text": "A — spaces inside the parentheses make it easier to read."
            },
            {
              "option_id": "opt_b",
              "text": "B — no spaces immediately inside parentheses or before commas."
            },
            {
              "option_id": "opt_c",
              "text": "C — one space before the comma is acceptable."
            },
            {
              "option_id": "opt_d",
              "text": "D — spaces inside parentheses are fine as long as they are symmetric."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "PEP 8 says to avoid spaces immediately inside parentheses. `compute( x , y )` has extraneous spaces inside the parentheses and before the comma."
            },
            "opt_b": {
              "message": "Correct. PEP 8 recommends no spaces immediately inside parentheses and no space before a comma: `compute(x, y)`."
            },
            "opt_c": {
              "message": "PEP 8 says to avoid a space immediately before a comma. The correct form is `compute(x, y)` — space after the comma, not before."
            },
            "opt_d": {
              "message": "Symmetry does not make extraneous whitespace acceptable. PEP 8 says no spaces immediately inside parentheses."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Right — PEP 8 says no spaces immediately inside parentheses and no space before a comma: `compute(x, y)`."
          },
          "incorrect": {
            "message": "PEP 8 avoids extraneous whitespace: no spaces immediately inside parentheses `()`, `[]`, `{}`, and no space immediately before a comma, semicolon, or colon."
          },
          "hints": [
            "PEP 8 says: avoid whitespace immediately inside parentheses, brackets, or braces.",
            "Also avoid a space immediately before a comma. The correct pattern is `f(x, y)` — space after the comma, not before."
          ],
          "remediation_step_id": "tile_python_pep8_style.r01"
        }
      }
