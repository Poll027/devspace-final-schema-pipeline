      "interaction": {
        "type": "choice",
        "interaction_id": "ix.tile_python_comprehensions_iterating.s02",
        "difficulty": "core",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "python.comprehensions",
