        "public": {
          "prompt": "Read the supplied S3 state-access policy summaries and operation records. Decide whether each verifies scoped approved access, separate exercise-bucket provisioning and denial of unapproved access without disclosing state. Locking configuration is supplied separately and must remain unchanged.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets every supplied verification criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Does not meet every supplied verification criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Approved reader: ListBucket restricted to required prefix; GetObject restricted to state object\nApproved writer: same scoped listing and reading plus PutObject restricted to state object\nApproved provisioning identity: backend initialization succeeded; separate exercise bucket created; state stored in supplied backend\nUnapproved identity: GetObject denied; overwrite PutObject denied\nEvidence: status records only, no state contents\nSeparate coordination configuration: unchanged"
            },
            {
              "item_id": "i2",
              "text": "Approved reader and writer: all required prefix and object scopes verified\nApproved identity: backend initialized; separate exercise bucket created\nUnapproved identity: state read denied; state overwrite succeeded\nEvidence: status records only\nSeparate coordination configuration: unchanged"
            },
            {
              "item_id": "i3",
              "text": "Approved reader: ListBucket for every prefix; GetObject for every object in the state bucket\nApproved writer: PutObject for every object in the state bucket\nBackend initialization and separate exercise bucket: successful\nUnapproved read and overwrite: denied\nEvidence: no state contents"
            },
            {
              "item_id": "i4",
              "text": "Approved permissions: required prefix-scoped ListBucket and state-object GetObject/PutObject verified\nBackend initialized; separate exercise bucket provisioned through approved identity\nUnapproved read and overwrite: denied\nEvidence attachment: complete sensitive state contents"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails",
            "i4": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "Scoped approved access, provisioning, both unapproved denials and non-disclosing evidence meet the criteria."
            },
            "i2": {
              "message": "Both unapproved read and overwrite attempts must be denied."
            },
            "i3": {
              "message": "Approved permissions must be scoped to the required prefix and state object, not the whole bucket."
            },
            "i4": {
              "message": "Recorded evidence must not expose state contents even when permission checks succeed."
            }
          }
        }
