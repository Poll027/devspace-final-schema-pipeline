          "expected_value": "illustrative: RTO=18 minutes pass; RPO=4 minutes pass | alternative_marker: RTO=18 minutes pass; RPO=10 minutes fail",
          "reference_formula": "=A2&\": RTO=\"&ROUND((D2-C2)*1440,0)&\" minutes \"&IF(ROUND((D2-C2)*1440,0)<=H2,\"pass\",\"fail\")&\"; RPO=\"&ROUND((C2-F2)*1440,0)&\" minutes \"&IF(ROUND((C2-F2)*1440,0)<=K2,\"pass\",\"fail\")&\" | \"&A3&\": RTO=\"&ROUND((D3-C3)*1440,0)&\" minutes \"&IF(ROUND((D3-C3)*1440,0)<=H3,\"pass\",\"fail\")&\"; RPO=\"&ROUND((C3-F3)*1440,0)&\" minutes \"&IF(ROUND((C3-F3)*1440,0)<=K3,\"pass\",\"fail\")",
