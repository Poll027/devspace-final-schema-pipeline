      "eyebrow": "Learn",
      "title": "Measure time and data separately",
      "blocks": [
        {
          "type": "prose",
          "text": "An isolated recovery rehearsal needs two independent comparisons: restoration time against RTO and recoverable data loss against RPO.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal"
            ],
            "fact_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#tb1",
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Measure elapsed time from the defined disruption start to passing service-readiness checks for RTO. Measure the gap from the disruption point to the latest recovered data point for RPO. A running service alone proves neither objective.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal"
            ],
            "fact_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#f2",
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "data_table",
          "asset_ref": {
            "asset_id": "ds.recovery_objectives",
            "columns": [
              "case_id",
              "environment",
              "disruption_start",
              "passing_readiness_at",
              "readiness_evidence",
              "latest_recovered_marker",
              "restoration_minutes",
              "rto_minutes",
              "rto_result",
              "data_gap_minutes",
              "rpo_minutes",
              "rpo_result"
            ]
          },
          "caption": "Independent RTO and RPO comparisons",
          "lineage": {
            "concept_ids": [
              "aws_devops.verify_restored_service_and_data_against_rto_rpo_in_an_isolated_rehearsal"
            ],
            "fact_ids": [],
