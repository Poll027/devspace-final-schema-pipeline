      "title": "Connect evidence to prevention",
      "blocks": [
        {
          "type": "prose",
          "text": "Post-incident analysis records impact, events, contributing causes and actions to reduce recurrence.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
