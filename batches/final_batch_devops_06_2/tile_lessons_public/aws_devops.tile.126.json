        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Learn",
      "title": "Read the evidence, not the shortcut",
      "blocks": [
        {
          "type": "prose",
          "text": "Read the registered symptom, investigation, correction and verification observations in timestamp order. The verified correction supports the identified configuration error, not an additional invented cause. The follow-up detects that same mismatch, assigns an accountable owner and checks completion by replaying the supplied mismatch. Keep this bounded conclusion separate from the factual timeline.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change"
            ],
            "fact_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change#f1",
              "aws_devops.document_incident_evidence_and_a_preventive_change#f2",
              "aws_devops.document_incident_evidence_and_a_preventive_change#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A plausible causal story is not a supported conclusion. Do not treat every nearby event as a contributing cause, assign unsupported blame, or choose unrelated improvements. A preventive action should address the recurrence path demonstrated by the verified fix. Its owner and verification method make the follow-up accountable.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change"
            ],
            "fact_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change#f2",
              "aws_devops.document_incident_evidence_and_a_preventive_change#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.document_incident_evidence_and_a_preventive_change#tb4",
              "aws_devops.document_incident_evidence_and_a_preventive_change#tb5"
            ],
            "anchors": []
          }
        }
      ]
    },
