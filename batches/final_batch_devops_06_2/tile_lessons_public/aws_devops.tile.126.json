          "segments": [
            {
              "segment_id": "seg_aws_devops.document_incident_evidence_and_a_preventive_change_qKTxXE5h-18_73_199",
              "video_id": "qKTxXE5h-18",
              "youtube_url": "https://www.youtube.com/watch?v=qKTxXE5h-18",
              "review_url": "https://www.youtube.com/watch?v=qKTxXE5h-18&t=73s",
              "start_seconds": 73,
              "end_seconds": 199,
              "label": "Structure a factual incident record and accountable preventive actions",
              "summary": "Post-incident analysis, called a postmortem here, records impact, response actions, causes and follow-up work. A blameless account focuses on contributing system and process conditions rather than accusing individuals or teams. A useful structure includes an executive summary, incident details, impact, causes and trigger, a timeline, lessons learned and action items. Severity claims should use verifiable data rather than dramatic language. Follow-up actions need clear owners, priorities, tracking tickets and verifiable completion criteria. Include prevention rather than only mitigation, and track completion dates or estimates so actions can be reviewed later.",
              "fact_ids": [
                "f1"
              ],
              "transcript_ref": "qKTxXE5h-18:73-199"
            }
          ],
          "group_title": "Evidence-based incident records and accountable prevention",
          "bridge": {
            "before": "Watch for the incident-record structure and concrete completion criteria for follow-up actions. The clip uses “postmortem” for post-incident analysis and emphasizes contributing causes rather than personal blame.",
            "after": "The clip explains structure and accountability, but does not work through an evidence timeline or justify one action from a verified cause. The text covers observation-versus-conclusion separation and cause-linked prevention."
          },
          "default_mode": "video"
        }
      ]
