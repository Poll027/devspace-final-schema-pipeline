          "segments": [
            {
              "segment_id": "seg_terraform.state_locking_AmWnWfuSTfQ_196_504",
              "video_id": "AmWnWfuSTfQ",
              "youtube_url": "https://www.youtube.com/watch?v=AmWnWfuSTfQ",
              "review_url": "https://www.youtube.com/watch?v=AmWnWfuSTfQ&t=196s",
              "start_seconds": 196,
              "end_seconds": 504,
              "label": "Enable locking and observe a competing Terraform apply being blocked",
              "summary": "The presenter enables S3 lock-file locking with use_lockfile = true and reinitializes the backend. During an apply awaiting approval, the S3 bucket contains a .tflock object. After the operation completes, the state object remains and the lock object is gone. The demonstration then destroys and recreates its example infrastructure. While the next apply awaits approval, a second terminal attempts another apply against the same state and receives an error acquiring the state lock. Once the first operation completes, the second terminal can retry successfully and reports that the infrastructure matches the configuration. The lock coordinates these Terraform operations; the demonstrated contention ends through normal completion, without disabling locking.",
              "fact_ids": [
                "f1",
                "f3"
              ],
              "transcript_ref": "AmWnWfuSTfQ:196-504"
            }
          ],
          "group_title": "Enable S3 lock-file locking and verify writer contention",
          "bridge": {
            "before": "Watch for the opt-in use_lockfile setting, the temporary .tflock object, and the second terminal's lock-acquisition error. The demonstration uses different infrastructure; your supplied exercise provisions a separate S3 bucket.",
            "after": "The competing apply is blocked until the first operation finishes. The clip omits .tflock permissions and the authorization-boundary distinction; the text covers both, plus why force-unlock must not bypass an active writer."
          },
          "default_mode": "video"
        }
      ]
