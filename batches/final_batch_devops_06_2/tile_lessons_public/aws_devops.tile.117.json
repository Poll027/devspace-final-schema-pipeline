      "eyebrow": "Learn",
      "title": "Bound retries and verify capture",
      "blocks": [
        {
          "type": "prose",
          "text": "EventBridge retries retryable target-delivery failures within two configured limits: maximum event age and retry attempts.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture"
            ],
            "fact_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Set RetryPolicy MaximumRetryAttempts and MaximumEventAgeInSeconds to the approved finite budget. Set DeadLetterConfig to the approved SQS queue ARN, with required queue permissions, and inspect the seeded exhausted failure there. Some nonretryable failures go directly to capture; not every failure receives retries.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture"
            ],
            "fact_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f2",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f3",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f4"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "process_flow",
          "direction": "LR",
          "nodes": [
            {
              "id": "failure",
              "label": "Delivery failure",
              "kind": "decision"
            },
            {
              "id": "retry",
              "label": "Finite age + attempt limits"
            },
            {
              "id": "capture",
              "label": "Approved SQS capture"
            },
            {
              "id": "inspect",
              "label": "Permissions + event inspection"
            }
          ],
          "edges": [
            {
              "from": "failure",
              "to": "retry",
              "label": "Retryable"
            },
            {
              "from": "retry",
              "to": "capture",
              "label": "Exhausted"
            },
            {
              "from": "failure",
              "to": "capture",
              "label": "Some nonretryable failures"
            },
            {
              "from": "capture",
              "to": "inspect"
            }
          ],
          "alt_text": "Retryable delivery is bounded by event age and attempts before exhaustion reaches capture. Some nonretryable failures go directly to capture. Verify queue permissions and inspect the captured event.",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture"
            ],
            "fact_ids": [],
