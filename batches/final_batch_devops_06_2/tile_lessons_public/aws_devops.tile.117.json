        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Learn",
      "title": "Read the evidence, not the shortcut",
      "blocks": [
        {
          "type": "prose",
          "text": "Review both finite limits and the capture route. A retry count alone does not prove the approved queue can accept the failed event. Check its permissions and inspect the seeded exhausted-delivery event in that queue.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture"
            ],
            "fact_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f1",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f2",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Contrast retry exhaustion with direct capture. A retryable failure is interpreted against the age and attempt limits; some nonretryable failures reach capture without a full retry history. Both need inspectable capture evidence. An ARN in the configuration is not a substitute for checking the captured event.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture"
            ],
            "fact_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f1",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f4",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#tb4",
              "aws_devops.handle_failed_event_delivery_with_bounded_retries_and_failure_capture#tb5"
            ],
            "anchors": []
          }
        }
      ]
