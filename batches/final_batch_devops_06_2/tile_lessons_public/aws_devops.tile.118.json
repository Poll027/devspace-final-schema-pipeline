      "eyebrow": "Learn",
      "title": "Observe the ECS rollout",
      "blocks": [
        {
          "type": "prose",
          "text": "An ECS rolling deployment replaces service tasks within minimumHealthyPercent and maximumPercent bounds relative to desiredCount. These settings do not mean every update replaces all tasks at once.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout"
            ],
            "fact_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#tb1",
              "aws_devops.perform_a_controlled_ecs_service_rollout#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Register the supplied new image version in a task-definition revision, then update the service to that revision. Follow service events, running task revisions and health until the supplied steady-state criteria pass.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout"
            ],
            "fact_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#f2",
              "aws_devops.perform_a_controlled_ecs_service_rollout#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#tb3",
              "aws_devops.perform_a_controlled_ecs_service_rollout#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "An accepted service-update request is not evidence of a healthy rollout. Keep the replacement settings alongside the observed events, revisions and health; completion depends on the supplied steady-state checks, not the request.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout"
            ],
            "fact_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.perform_a_controlled_ecs_service_rollout#tb5"
            ],
            "anchors": []
          }
        },
