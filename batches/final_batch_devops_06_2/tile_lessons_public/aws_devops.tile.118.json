        "public": {
          "prompt": "Read each ECS rollout record and decide whether it establishes every supplied rollout criterion. Criteria: version B registered in a task-definition revision and used by the service; replacement consistent with the supplied minimumHealthyPercent and maximumPercent relative to desiredCount; events, running revisions and health meeting supplied steady state.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets every supplied verification criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Does not meet every supplied verification criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Task-definition revision: registered with image version B\nService target: registered B revision\nReplacement observation: consistent with both supplied percentage bounds relative to desiredCount\nService events: satisfy supplied steady-state checks\nRunning task revisions: all supplied required B revisions\nHealth: all supplied required checks pass"
            },
            {
              "item_id": "i2",
              "text": "Task-definition revision: registered with image version B\nService-update request: accepted\nRunning tasks: still include version A revision\nHealth and service events: not checked\nReview conclusion: rollout healthy"
            },
            {
              "item_id": "i3",
              "text": "Task-definition revision and service: version B\nService events, running revisions and health: meet supplied steady-state checks\nReplacement observation: outside the supplied maximumPercent bound relative to desiredCount"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "The revision, replacement bounds and all steady-state evidence are present."
            },
            "i2": {
              "message": "Acceptance alone does not establish running B revisions or health and events."
            },
            "i3": {
              "message": "Task replacement must also be consistent with the supplied percentage bounds."
            }
          }
        }
      }
