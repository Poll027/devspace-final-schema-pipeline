        "public": {
          "prompt": "Read each DNS cutover record and decide whether it verifies readiness-before-switch, the approved procedure and actual client convergence accounting for supplied TTL and cached answers.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets every supplied verification criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Does not meet every supplied verification criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Restored target: supplied readiness checks pass before switch\nSwitch: approved DNS procedure\nClient checks: cached old answers observed during supplied TTL; later checks establish clients reach restored target\nConclusion: convergence verified from client-target evidence with TTL considered"
            },
            {
              "item_id": "i2",
              "text": "Restored target: supplied readiness checks not yet passing\nSwitch: performed through approved DNS procedure anyway\nLater client checks: reach restored target"
            },
            {
              "item_id": "i3",
              "text": "Restored target: readiness passes before approved switch\nDNS setting: new target recorded\nClients: still using cached old answer within supplied TTL\nConclusion: every client immediately converged because the configuration changed"
            },
            {
              "item_id": "i4",
              "text": "Restored target: readiness passes\nSwitch: approved procedure after readiness\nDNS configuration: updated\nClient-target checks and TTL review: omitted\nConclusion: convergence verified"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails",
            "i4": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "Readiness preceded the approved switch, and actual client-target evidence accounts for caching and TTL."
            },
            "i2": {
              "message": "The endpoint switch must wait for passing readiness checks."
            },
            "i3": {
              "message": "The setting change does not prove convergence; client evidence still shows the old target."
            },
            "i4": {
              "message": "Actual client checks accounting for cached answers and TTL are required."
            }
          }
        }
      }
