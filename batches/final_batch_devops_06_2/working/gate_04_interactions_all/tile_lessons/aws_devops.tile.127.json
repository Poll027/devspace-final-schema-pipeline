        "anchors": [
          "recovery.endpoint_cutover#assessment:account_for_dns_caching_and_ttl_in_client_convergence_checks"
        ],
        "feedback": {
          "correct": {
            "message": "Your judgement follows the supplied evidence and the required checks."
          },
          "incorrect": {
            "message": "Recheck the evidence against each required criterion; a partial check is not enough."
          },
          "hints": [
            "Separate a changed setting from clients’ actual targets."
          ],
          "remediation_step_id": "aws_devops.tile.127.r01"
        },
        "public": {
          "prompt": "A DNS setting has been switched to the restored target. What must client-convergence verification account for?",
          "options": [
            {
              "option_id": "o1",
              "text": "Every client immediately uses the new setting."
            },
            {
              "option_id": "o2",
              "text": "Actual client targets, cached answers and the supplied TTL."
            },
            {
              "option_id": "o3",
              "text": "Only the configuration update, with no client checks."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o2"
          ],
          "option_feedback": {
            "o1": {
              "message": "Cached DNS answers and TTL can affect convergence."
            },
            "o2": {
              "message": "Check clients reach the restored target while accounting for caching and TTL."
            },
            "o3": {
              "message": "The approved switch is not itself proof that clients reach the restored target."
            }
          }
        }
      }
