      "eyebrow": "Check",
      "title": "Does a DNS update prove convergence?",
      "lede": "Read the supplied question and choose the conclusion supported by the evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.127.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
