      "eyebrow": "Learn",
      "title": "Promote one built artifact",
      "blocks": [
        {
          "type": "prose",
          "text": "Build produces an artifact. Release combines that build with environment configuration, and run executes the release. A staging-tested output should remain the same built content when promoted.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments"
            ],
            "fact_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#tb1",
              "aws_devops.promote_the_same_artifact_version_across_environments#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Carry the same immutable artifact reference or digest from staging to production, supplying production configuration rather than rebuilding the source. Compare deployed digests and recorded build provenance in both environments to verify that the tested output is the promoted output.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments"
            ],
            "fact_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#f2",
              "aws_devops.promote_the_same_artifact_version_across_environments#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#tb3",
              "aws_devops.promote_the_same_artifact_version_across_environments#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "The registered comparison keeps one artifact and build provenance across staging and production while configuration differs. Rebuilding from the same source is not this same-artifact check. Different deployed digests do not show that the tested output was promoted.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments"
            ],
            "fact_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#f2",
              "aws_devops.promote_the_same_artifact_version_across_environments#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.promote_the_same_artifact_version_across_environments#tb5"
            ],
            "anchors": []
          }
        },
