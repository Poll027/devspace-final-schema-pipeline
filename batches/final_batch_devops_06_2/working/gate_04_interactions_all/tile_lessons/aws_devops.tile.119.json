        ],
        "anchors": [
          "aws_devops.promote_the_same_artifact_version_across_environments#assessment:verify_staging_and_production_artifact_digests_and_build_provenance"
        ],
        "feedback": {
          "correct": {
            "message": "Your judgement follows the supplied evidence and the required checks."
          },
          "incorrect": {
            "message": "Recheck the evidence against each required criterion; a partial check is not enough."
          },
          "hints": [
            "Trace the output identity separately from environment configuration."
          ],
          "remediation_step_id": "aws_devops.tile.119.r01"
        },
        "public": {
          "prompt": "Which comparison verifies that production received the tested staging build output?",
          "options": [
            {
              "option_id": "o1",
              "text": "The environment names are different."
            },
            {
              "option_id": "o2",
              "text": "The source was rebuilt separately for production."
            },
            {
              "option_id": "o3",
              "text": "The deployed digests match and recorded provenance identifies the same build output."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o3"
          ],
          "option_feedback": {
            "o1": {
              "message": "Environment names do not identify the deployed build output."
            },
            "o2": {
              "message": "Promotion retains the immutable output rather than rebuilding it."
            },
            "o3": {
              "message": "Matching deployed digests and provenance verify the tested output was promoted."
            }
          }
        }
      }
