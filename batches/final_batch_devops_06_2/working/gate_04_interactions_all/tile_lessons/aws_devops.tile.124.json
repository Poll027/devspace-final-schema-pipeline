      "eyebrow": "Learn",
      "title": "Stay within the runbook",
      "blocks": [
        {
          "type": "prose",
          "text": "A runbook describes known procedures and expected operational outcomes.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook"
            ],
            "fact_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb1",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Verify its preconditions, take only approved actions, and check each expected result before advancing. On a supplied stop condition or an out-of-bounds outcome, stop routine execution and escalate with observed evidence.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook"
            ],
            "fact_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f2",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "diagram",
          "diagram_kind": "sequence",
          "nodes": [
            {
              "id": "n1",
              "label": "Verify supplied runbook preconditions"
            },
            {
              "id": "n2",
              "label": "Current approved action"
            },
            {
              "id": "n3",
              "label": "Expected outcome ↔ actual result"
            },
            {
              "id": "n4",
              "label": "Within bounds: record result, next approved action"
            },
            {
              "id": "n5",
              "label": "Stop condition / outside bounds: stop and escalate with evidence"
            }
          ],
          "edges": [
            {
              "from": "n1",
              "to": "n2",
              "label": "Before action",
              "directed": true
            },
            {
              "from": "n2",
              "to": "n3",
              "label": "Check",
              "directed": true
            },
            {
              "from": "n3",
              "to": "n4",
              "label": "Matches",
              "directed": true
            },
            {
              "from": "n3",
              "to": "n5",
              "label": "Stop / mismatch",
              "directed": true
            }
          ],
          "alt_text": "Verify the supplied runbook preconditions, perform the current approved action, and compare the actual result with the expected outcome. If the result is within bounds and no stop condition applies, record it and proceed to the next approved action. If a supplied stop condition applies or the result is outside bounds, do not advance: stop routine execution and escalate with the observed evidence.",
          "lineage": {
            "concept_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook"
            ],
            "fact_ids": [],
            "teaching_block_ids": [],
            "anchors": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#visual"
            ]
          },
          "title": "Schematic runbook execution record"
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.124.s02",
      "type": "explainer",
      "concept_ids": [
        "aws_devops.recover_an_incident_safely_using_an_established_runbook"
