              "message": "Approval to attempt an action does not authorize advancement past an out-of-bounds result."
            },
            "o2": {
              "message": "Execute only approved actions and stop on the supplied condition."
            },
            "o3": {
              "message": "An out-of-bounds outcome requires stopping and escalation with evidence."
            }
          }
        }
