        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Learn",
      "title": "Read the evidence, not the shortcut",
      "blocks": [
        {
          "type": "prose",
          "text": "Use the supplied runbook to compare each actual result with its expected outcome. A passing result permits the next approved action. A supplied stop condition or result outside the bounds calls for stopping and escalation. Preserve the last completed action and the result that required escalation so the next responder has a reproducible record.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook"
            ],
            "fact_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f1",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f2",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A runbook that initially matches the incident is not unconditional permission to continue. Its preconditions, expected results and stop bounds remain in force at each action boundary. Do not improvise extra resource changes when a check says the situation is outside routine execution; preserve the observed evidence and escalate.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook"
            ],
            "fact_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f2",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb4",
              "aws_devops.recover_an_incident_safely_using_an_established_runbook#tb5"
            ],
            "anchors": []
          }
        }
      ]
    },
