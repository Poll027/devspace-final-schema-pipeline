      "eyebrow": "Learn",
      "title": "Wait for authorized approval",
      "blocks": [
        {
          "type": "prose",
          "text": "Manual approval stops pipeline progression until an authorized approver approves. Rejection or expiration fails the action.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval"
            ],
            "fact_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb1",
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Place approval between staging and production with the supplied review link or revision context and authorized approver permissions. Verify the pipeline waits there, then advances only after approval of the intended execution and revision.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval"
            ],
            "fact_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#f2",
              "aws_devops.control_environment_promotion_with_a_manual_approval#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb3",
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A notification does not grant approval authority. Check the approver permissions separately from notification delivery. Approval recorded for one revision is not approval of another; keep the intended execution and revision with the wait and progression evidence.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval"
            ],
            "fact_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#m1",
              "aws_devops.control_environment_promotion_with_a_manual_approval#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb5",
              "aws_devops.control_environment_promotion_with_a_manual_approval#tb6"
            ],
            "anchors": []
          }
        },
        {
          "type": "diagram",
          "diagram_kind": "sequence",
          "nodes": [
            {
              "id": "n1",
              "label": "Staging: intended execution and revision"
            },
            {
              "id": "n2",
              "label": "Approval pending: review link / revision context"
            },
            {
              "id": "n3",
              "label": "Authorized approver approves intended execution and revision"
            },
            {
              "id": "n4",
              "label": "Production progression verified"
            },
            {
              "id": "n5",
              "label": "Rejection or expiration: action fails"
            }
          ],
          "edges": [
            {
              "from": "n1",
              "to": "n2",
              "label": "Wait point",
              "directed": true
            },
            {
              "from": "n2",
              "to": "n3",
              "label": "Authorized decision",
              "directed": true
            },
            {
              "from": "n3",
              "to": "n4",
              "label": "Advance",
              "directed": true
            },
            {
              "from": "n2",
              "to": "n5",
              "label": "Reject / expire",
              "directed": true
            }
          ],
          "alt_text": "Staging reaches the manual approval wait point for the intended execution and revision, with the supplied review context. From pending approval, authorized approval of that execution and revision permits production progression; alternatively, rejection or expiration fails the approval action and does not authorize production progression.",
          "lineage": {
            "concept_ids": [
              "aws_devops.control_environment_promotion_with_a_manual_approval"
            ],
            "fact_ids": [],
