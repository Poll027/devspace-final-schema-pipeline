    {
      "step_id": "aws_devops.tile.120.s02",
      "type": "explainer",
      "concept_ids": [
        "cost.residual_charge_verification"
      ],
      "lineage": {
        "teaching_block_ids": [
          "cost.residual_charge_verification#tb4",
          "cost.residual_charge_verification#tb5"
        ],
        "fact_ids": [
          "cost.residual_charge_verification#f1",
          "cost.residual_charge_verification#f2",
          "cost.residual_charge_verification#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Learn",
      "title": "Read the evidence, not the shortcut",
      "blocks": [
        {
          "type": "prose",
          "text": "In the registered initial and refreshed reports, use the same teardown interval and account/service filter. The initial extract has no matching usage row: retain that as a provisional reporting observation, not measured zero usage. The refreshed extract adds a charge for usage before deletion. Its appearance in a later report is not proof of continuing usage.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "cost.residual_charge_verification"
            ],
            "fact_ids": [
              "cost.residual_charge_verification#f1",
              "cost.residual_charge_verification#f2",
              "cost.residual_charge_verification#f3"
            ],
            "teaching_block_ids": [
              "cost.residual_charge_verification#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Compare when usage occurred with the deletion evidence, not merely when the report was opened. Repeat after refresh, remembering that some data can appear later. Neither an early empty report nor resource absence proves zero cost; a later charge is not automatically post-deletion usage. This is a timing check, not a new price estimate.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "cost.residual_charge_verification"
            ],
            "fact_ids": [
              "cost.residual_charge_verification#f1",
              "cost.residual_charge_verification#f3"
            ],
            "teaching_block_ids": [
              "cost.residual_charge_verification#tb4",
              "cost.residual_charge_verification#tb5"
            ],
            "anchors": []
          }
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.120.s03",
      "type": "check",
      "concept_ids": [
        "cost.residual_charge_verification"
      ],
      "lineage": {
        "teaching_block_ids": [],
        "fact_ids": [
          "cost.residual_charge_verification#f1",
          "cost.residual_charge_verification#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "cost.residual_charge_verification#assessment:account_for_billing_data_delay_in_teardown_verification"
        ]
      },
      "eyebrow": "Check",
      "title": "What does the report timing prove?",
      "lede": "Read the supplied question and choose the conclusion supported by the evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.120.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "cost.residual_charge_verification",
            "capability": "account_for_billing_data_delay_in_teardown_verification",
            "fact_ids": [
              "f1",
              "f3"
            ]
          }
        ],
        "anchors": [
          "cost.residual_charge_verification#assessment:account_for_billing_data_delay_in_teardown_verification"
        ],
        "feedback": {
          "correct": {
            "message": "Your judgement follows the supplied evidence and the required checks."
          },
          "incorrect": {
            "message": "Recheck the evidence against each required criterion; a partial check is not enough."
          },
          "hints": [
            "Compare report timing and usage timing with deletion evidence."
          ],
          "remediation_step_id": "aws_devops.tile.120.r01"
        },
        "public": {
          "prompt": "The initial filtered Cost Explorer extract is empty after teardown. What conclusion is justified?",
          "options": [
            {
              "option_id": "o1",
              "text": "The result is provisional; repeat the inspection after refresh and compare usage timestamps with deletion evidence."
            },
            {
              "option_id": "o2",
              "text": "An empty extract proves there are no charges for the interval."
            },
            {
              "option_id": "o3",
              "text": "Resource absence proves that all previously incurred usage charges are gone."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Cost Explorer refreshes at least once every 24 hours, and some data takes longer to appear."
            },
            "o2": {
              "message": "An initial empty result is not final billing evidence."
            },
            "o3": {
              "message": "Pre-deletion usage can still appear in refreshed data; resource absence does not prove zero cost."
            }
          }
        }
      }
    },
    {
