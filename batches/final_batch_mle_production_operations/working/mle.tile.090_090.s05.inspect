{
  "type": "code_exercise",
  "public": {
    "prompt": "This Python workspace supplies fixture-backed wrappers for the taught gcloud commands; it never runs a shell or touches live resources. Reorder the existing operations (keep their arguments) to inspect authorized identity/target, preserve and reproduce fault evidence and test the runbook hypothesis, stop and confirm stopped before start, confirm running, reconnect, verify readiness/bounded prediction/non-disclosure, and inspect the same target afterward. Return the single recovery record. The graded variable is report: a record with top-level fields target, pre_fault, hypothesis, trace, after, credentials, scope. Retain the supplied nested record structure and declared ordering.",
    "runtime": {
      "kind": "python",
      "version": "0.29.5",
      "packages": [
        "numpy"
      ]
    },
    "workspace": {
      "entry": "main.py",
      "files": [
        {
          "path": "main.py",
          "role": "editable",
          "language": "python",
          "content": "# Supplied fixture infrastructure; learner edits only the statements below.\n_fixture_support = \"import csv, json, datetime\\nimport numpy as np\\nSCHEMAS = {'incident_evidence': {'phase': 'string', 'INSTANCE': 'string', 'ZONE': 'string', 'authorized_identity': 'string', 'instance_state': 'string', 'process_state': 'string', 'readiness': 'boolean', 'prediction_contract_pass': 'boolean', 'fault_evidence': 'string', 'hypothesis_result': 'string', 'credential_review_pass': 'boolean'}}\\ndef load(name):\\n    with open(name+'.csv') as f:\\n        data=list(csv.DictReader(f))\\n    for r in data:\\n        for k,t in SCHEMAS[name].items():\\n            v=r[k]\\n            r[k] = None if v=='' else (v=='True' if t=='boolean' else int(v) if t=='integer' else float(v) if t=='number' else v)\\n    return data\\ndef column(data,key):\\n    return np.asarray([r[key] for r in data])\\ndef emit(value):\\n    return value\\n\\nclass Recovery:\\n    def __init__(self,data,policy): self.data=data; self.policy=policy; self.trace=[]; self.state='initial'\\n    def step(self,action,required,next_state):\\n        if self.state!=required: raise ValueError('operation lacks required prior evidence/completion')\\n        self.trace.append(action); self.state=next_state\\n    def describe_before(self): self.step('gcloud compute instances describe '+self.policy['INSTANCE']+' --zone='+self.policy['ZONE'],'initial','inspected')\\n    def reproduce_and_test(self): self.step('gcloud compute ssh; preserve fault evidence and test runbook hypothesis','inspected','tested')\\n    def stop_and_wait(self): self.step('gcloud compute instances stop; confirm TERMINATED','tested','stopped')\\n    def start_and_wait(self): self.step('gcloud compute instances start; confirm RUNNING','stopped','started')\\n    def reconnect(self): self.step('gcloud compute ssh same target','started','connected')\\n    def verify_service(self): self.step('readiness and bounded prediction; credential review','connected','verified')\\n    def describe_after(self): self.step('gcloud compute instances describe same target','verified','done')\\n    def report(self):\\n        if self.state!='done': raise ValueError('incomplete recovery')\\n        before=self.data[0]; after=self.data[-1]\\n        for row in [before,after]:\\n            assert row['INSTANCE']==self.policy['INSTANCE'] and row['ZONE']==self.policy['ZONE'] and row['authorized_identity']==self.policy['authorized_identity'] and row['credential_review_pass']\\n        assert before['fault_evidence'] and before['hypothesis_result']\\n        assert after['instance_state']=='RUNNING' and after['process_state']=='running' and after['readiness'] and after['prediction_contract_pass']\\n        return {'target':self.policy,'pre_fault':before['fault_evidence'],'hypothesis':before['hypothesis_result'],'trace':self.trace,'after':after,'credentials':'runtime references only','scope':'fixture-backed simulator, not live cloud evidence'}\\n\\n\"\nexec(_fixture_support)\npolicy = {'INSTANCE': 'serving-lab', 'ZONE': 'lab-zone-a', 'authorized_identity': 'lab.operator', 'allowed_actions': ['inspect', 'reproduce_fault', 'test_hypothesis', 'stop', 'wait_stopped', 'start', 'wait_running', 'reconnect', 'readiness', 'bounded_prediction'], 'prediction_contract': {'request': {'distance_category': 'long_distance', 'numeric_values': 5}, 'response': {'predicted_class': 'late'}}, 'credentials': 'runtime-injected only'}\nlab = Recovery(load('incident_evidence'),policy)\n\n# Reorder the supplied operations. Do not change target arguments.\nlab.describe_after()\nlab.verify_service()\nlab.reconnect()\nlab.start_and_wait()\nlab.stop_and_wait()\nlab.reproduce_and_test()\nlab.describe_before()\nreport = lab.report()\n"
        }
      ],
      "asset_mounts": [
        {
          "asset_id": "ds.incident_evidence",
          "mount_path": "incident_evidence.csv"
        }
      ]
    },
    "constraints": {
      "allowed_syntax": [
        "gcloud compute instances describe INSTANCE --zone=ZONE",
        "gcloud compute instances stop INSTANCE --zone=ZONE",
        "gcloud compute instances start INSTANCE --zone=ZONE",
        "gcloud compute ssh INSTANCE --zone=ZONE"
      ],
      "blocked_syntax": [
        "gcloud compute instances delete",
        "gcloud compute disks delete",
        "gcloud compute addresses delete"
      ]
    }
  },
