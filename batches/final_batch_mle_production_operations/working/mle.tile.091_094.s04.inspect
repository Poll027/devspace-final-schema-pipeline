{
  "type": "code_exercise",
  "public": {
    "prompt": "Select only running observations for the supplied instance/model process in [interval_start,interval_end_exclusive). Match CPU and memory on that same mask, exclude stopped and unrelated rows, and report counts, CPU percent, memory MiB, means and population std(ddof=0). Keep identity and interval in the single summary. Identify only workload-local utilization, not every machine.\nThe supplied mechanism handles parsing and report assembly. Your bounded edit is to bind each named input to the intended mounted row collection and select np.mean and np.std as its mean/spread functions. Replace only the None bindings. Do not copy an output or change the fixed contract. Run and inspect the full report described above. The graded variable is report: a record with top-level fields scope, count, cpu_mean, cpu_std, memory_mean, memory_std, cpu_count, memory_count, interpretation. Retain the supplied nested record structure and declared ordering.",
    "runtime": {
      "kind": "python",
      "version": "0.29.5",
      "packages": [
        "numpy"
      ]
    },
    "workspace": {
      "entry": "main.py",
      "files": [
        {
          "path": "main.py",
          "role": "editable",
          "language": "python",
          "content": "# Supplied fixture parsing, contract/report mechanism and authorized simulator.\n_fixture_support = \"import csv, json, datetime\\nimport numpy as np\\nSCHEMAS = {'resource_telemetry': {'timestamp': 'datetime', 'INSTANCE': 'string', 'process_id': 'string', 'instance_state': 'string', 'running_process': 'string', 'cpu_percent': 'number', 'memory_value': 'number', 'memory_unit': 'string', 'included': 'boolean'}}\\ndef load(name):\\n    with open(name+'.csv') as f:\\n        data=list(csv.DictReader(f))\\n    for r in data:\\n        for k,t in SCHEMAS[name].items():\\n            v=r[k]\\n            r[k] = None if v=='' else (v=='True' if t=='boolean' else int(v) if t=='integer' else float(v) if t=='number' else v)\\n    return data\\ndef column(data,key):\\n    return np.asarray([r[key] for r in data])\\ndef emit(value):\\n    return value\\n\\n\\npolicy = {'INSTANCE': 'serving-lab', 'process_id': 'model-service', 'interval_start': '2026-01-02T10:00:00Z', 'interval_end_exclusive': '2026-01-02T10:03:00Z', 'cpu_unit': 'percent', 'memory_unit': 'MiB', 'ddof': 0, 'action_required': False, 'lifecycle_policy': 'These lifecycle records belong to the utilization fixture; no recovery fault or learner lifecycle action is required.'}\\ndef calculate_contract(resource_telemetry_input,mean_function,spread_function):\\n    supplied_rows = {'resource_telemetry':resource_telemetry_input}\\n    def load(name):\\n        return supplied_rows[name]\\n    policy = {'INSTANCE': 'serving-lab', 'process_id': 'model-service', 'interval_start': '2026-01-02T10:00:00Z', 'interval_end_exclusive': '2026-01-02T10:03:00Z', 'cpu_unit': 'percent', 'memory_unit': 'MiB', 'ddof': 0, 'action_required': False, 'lifecycle_policy': 'These lifecycle records belong to the utilization fixture; no recovery fault or learner lifecycle action is required.'}\\n    data = load('resource_telemetry')\\n    instance = column(data,'INSTANCE')\\n    process = column(data,'process_id')\\n    running_process = column(data,'running_process')\\n    state = column(data,'instance_state')\\n    time = column(data,'timestamp')\\n    cpu_all = column(data,'cpu_percent')\\n    memory_all = column(data,'memory_value')\\n    mask = (instance == policy['INSTANCE']) & (process == policy['process_id']) & (running_process == policy['process_id']) & (state == 'RUNNING') & (time >= policy['interval_start']) & (time < policy['interval_end_exclusive'])\\n    \\n    cpu = cpu_all[mask]\\n    \\n    memory = memory_all[mask]\\n    \\n    count = len(cpu)\\n    \\n    cpu_mean = mean_function(cpu)\\n    \\n    cpu_std = spread_function(cpu, ddof=0)\\n    \\n    memory_mean = mean_function(memory)\\n    \\n    memory_std = spread_function(memory, ddof=0)\\n    \\n    report = {'scope':policy,'count':count,'cpu_mean':cpu_mean,'cpu_std':cpu_std,'memory_mean':memory_mean,'memory_std':memory_std,'cpu_count':count,'memory_count':len(memory),'interpretation':'descriptive utilization for this matched workload interval only'}\\n    return report\\n\"\nexec(_fixture_support)\nresource_telemetry_rows = load('resource_telemetry')\n# Bind each contract input to its intended row collection.\nresource_telemetry_input = None\nmean_function = None\nspread_function = None\n# Select the NumPy mean and standard-deviation functions; the supplied contract fixes ddof=0.\nreport = calculate_contract(resource_telemetry_input,mean_function,spread_function)\n"
        }
      ],
      "asset_mounts": [
        {
          "asset_id": "ds.resource_telemetry",
          "mount_path": "resource_telemetry.csv"
