{
  "type": "code_exercise",
  "public": {
    "prompt": "Compute baseline mean and population std from alert_observations.csv. Author the supplied owner/response YAML with threshold baseline mean plus the declared margin, safely dump and reload it. The rule is strict >: assert false below and at equality, true above. Replay all windows and return statistics, reloaded config and breach-only owner/action records.\nThe supplied mechanism handles parsing and report assembly. Your bounded edit is to bind each named input to the intended mounted row collection and select np.mean and np.std as its mean/spread functions. Replace only the None bindings. Do not copy an output or change the fixed contract. Run and inspect the full report described above. The graded variable is report: a record with top-level fields mean, std, config, records. Retain the supplied nested record structure and declared ordering.",
    "runtime": {
      "kind": "python",
      "version": "0.29.5",
      "packages": [
        "numpy",
        "pyyaml"
      ]
    },
    "workspace": {
      "entry": "main.py",
      "files": [
        {
          "path": "main.py",
          "role": "editable",
          "language": "python",
          "content": "# Supplied fixture parsing, contract/report mechanism and authorized simulator.\n_fixture_support = \"import csv, json, datetime\\nimport numpy as np\\nSCHEMAS = {'alert_observations': {'window_id': 'string', 'numeric_values': 'number'}}\\ndef load(name):\\n    with open(name+'.csv') as f:\\n        data=list(csv.DictReader(f))\\n    for r in data:\\n        for k,t in SCHEMAS[name].items():\\n            v=r[k]\\n            r[k] = None if v=='' else (v=='True' if t=='boolean' else int(v) if t=='integer' else float(v) if t=='number' else v)\\n    return data\\ndef column(data,key):\\n    return np.asarray([r[key] for r in data])\\ndef emit(value):\\n    return value\\n\\ndef replay(config,data):\\n    windows={}\\n    for r in data: windows.setdefault(r['window_id'],[]).append(r['numeric_values'])\\n    return [{'window':k,'owner':config['owner'],'response':config['response']} for k,v in windows.items() if k!='baseline' and np.mean(v)>config['threshold']]\\n\\n\\npolicy = {'indicator': 'window_mean', 'baseline_window': 'baseline', 'window_rule': 'mean(window)>mean(baseline)+4', 'ddof': 0, 'owner': 'order_oncall', 'response': 'investigate_window', 'expected_replays': {'normal': False, 'boundary': False, 'breached': True}}\\ndef calculate_contract(alert_observations_input,mean_function,spread_function):\\n    supplied_rows = {'alert_observations':alert_observations_input}\\n    def load(name):\\n        return supplied_rows[name]\\n    import yaml\\n    policy = {'indicator': 'window_mean', 'baseline_window': 'baseline', 'window_rule': 'mean(window)>mean(baseline)+4', 'ddof': 0, 'owner': 'order_oncall', 'response': 'investigate_window', 'expected_replays': {'normal': False, 'boundary': False, 'breached': True}}\\n    data = load('alert_observations')\\n    margin = 4\\n    baseline = np.asarray([r['numeric_values'] for r in data if r['window_id']=='baseline'])\\n    mean = mean_function(baseline)\\n    \\n    std = spread_function(baseline, ddof=0)\\n    \\n    threshold = mean + margin\\n    \\n    config = {'threshold': threshold, 'owner': policy['owner'], 'response': policy['response'], 'ddof': 0}\\n    \\n    config['threshold'] = float(config['threshold'])\\n    \\n    with open('alert.yaml','w') as file_handle:\\n        yaml.safe_dump(config, file_handle)\\n    \\n    with open('alert.yaml') as file_handle:\\n        loaded = yaml.safe_load(file_handle)\\n    \\n    assert (threshold-1 > threshold) == False\\n    \\n    assert (threshold > threshold) == False\\n    \\n    assert (threshold+1 > threshold) == True\\n    \\n    records = replay(loaded,data)\\n    \\n    report = {'mean':mean,'std':std,'config':loaded,'records':records}\\n    return report\\n\"\nexec(_fixture_support)\nalert_observations_rows = load('alert_observations')\n# Bind each contract input to its intended row collection.\nalert_observations_input = None\nmean_function = None\nspread_function = None\n# Select the NumPy mean and standard-deviation functions; the supplied contract fixes ddof=0.\nreport = calculate_contract(alert_observations_input,mean_function,spread_function)\n"
        }
      ],
