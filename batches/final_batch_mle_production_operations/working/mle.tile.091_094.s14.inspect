        "Variable assignment",
        "Dictionary-key and list-index access",
        "with open(...) as file_handle",
        "yaml.safe_dump(config, file_handle)",
        "yaml.safe_load(file_handle)",
        "gcloud compute instances describe INSTANCE --zone=ZONE",
        "gcloud compute instances stop INSTANCE --zone=ZONE",
        "Supplied event-response YAML fields for budget scope, amount, reporting period, thresholds, existing Pub/Sub topic, event binding and fixed target",
        "Supplied runtime Secret Manager references and secretEnv configuration"
      ],
      "blocked_syntax": [
        "gcloud compute instances delete",
        "gcloud compute instance-groups managed delete",
        "Wildcard or dynamically enumerated resource targets",
        "yaml.load with an unsafe loader",
        "YAML tags that construct arbitrary Python objects",
        "Literal credentials in configuration or command arguments"
      ]
    }
  },
