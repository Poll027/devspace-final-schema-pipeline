        },
        {
          "type": "prose",
          "text": "Use the recorded previous immutable image reference for the approved replacement container.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
