      "blocks": [
        {
          "type": "prose",
          "text": "Resolve the previously approved registry version and its artifact as the rollback target, preserving the approval/version identity rather than selecting an unapproved latest version.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
