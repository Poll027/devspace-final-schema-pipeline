      "title": "Roll back a serving release to a previous approved registry artifact",
      "blocks": [
        {
          "type": "prose",
          "text": "Resolve the approved previous artifact. Verify its replacement service before retiring the faulty test release.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Resolve the previously approved registry version and its artifact as the rollback target, preserving the approval/version identity rather than selecting an unapproved latest version.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb2"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Use the recorded previous immutable image reference for the approved replacement container.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb2"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Verify readiness and a bounded prediction fixture after the rollback, and confirm the response contract still matches the service.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb2"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Keep secrets out of Dockerfile ARG and ENV: they persist in the final image or its metadata.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb3"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Deliver sensitive values through runtime secrets, never as literal Compose values.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb3"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f5"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Start the approved replacement under its distinct container identity with the required environment and published port; do not retire the faulty test release before the replacement is ready.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.model_release_rollback"
            ],
            "teaching_block_ids": [
              "mle.model_release_rollback#tb3"
            ],
            "fact_ids": [
              "mle.model_release_rollback#f6"
            ],
            "anchors": []
          }
        },
