  "scenarios": [
    {
      "scenario_id": "scenario_nga_delivery_ops",
      "name": "Nigeria Delivery Operations",
      "summary": "A data analyst at a Nigerian last-mile logistics company is preparing a stakeholder presentation for the operations manager. The analyst has already explored delivery-time data across Lagos, Abuja, and Kano, and must now choose the right chart type for each point being communicated, then simplify those charts to reduce visual clutter for a non-technical audience.",
      "locale": "en-NG",
      "currency": "NGN",
      "domain": "logistics / delivery operations",
      "glossary_example_vocab": [
        "Lagos",
        "Abuja",
        "Kano",
        "delivery time",
        "average delivery time",
        "delivery volume",
        "total orders",
        "operations manager",
        "bar chart",
        "line graph",
        "boxplot",
        "pie chart",
        "scatterplot",
        "week over week",
        "part-to-whole",
        "comparison",
        "trend",
        "distribution",
        "gridlines",
        "border",
        "data labels",
        "trailing zeros",
        "rotated axis labels",
        "22.00 minutes",
        "22 min",
        "distance"
      ]
    }
  ],
  "assets": [
    {
      "asset_id": "asset_city_deliveries",
      "asset_kind": "dataset",
      "scenario_id": "scenario_nga_delivery_ops",
      "title": "City Delivery Summary",
      "description": "Average delivery time and total order count per city (Lagos, Abuja, Kano) for the current reporting period. Used for bar chart (comparison) and pie chart (part-to-whole share of total orders) examples.",
      "columns": [
        {
          "name": "city",
          "type": "string",
          "semantic_role": "categorical",
          "description": "City name (Lagos, Abuja, or Kano)"
        },
        {
          "name": "avg_delivery_minutes",
          "type": "number",
          "semantic_role": "numerical",
          "unit": "minutes",
          "description": "Average delivery time in minutes for orders in this city"
        },
        {
          "name": "order_count",
          "type": "integer",
          "semantic_role": "numerical",
          "unit": "orders",
          "description": "Total number of orders fulfilled in this city during the reporting period"
        }
      ],
      "rows": [
        [
          "Lagos",
          34.0,
          720
        ],
        [
          "Abuja",
          22.0,
          300
        ],
        [
          "Kano",
          19.0,
          180
        ]
      ],
      "variants": [
        {
          "variant_id": "city_deliveries_messy",
          "derived_from": "asset_city_deliveries",
          "purpose": "Messy version with an impossible negative delivery time for Kano",
          "ops": [
            {
              "op": "set_cell",
              "where": {
                "city": "Kano"
              },
              "occurrence": 0,
              "column": "avg_delivery_minutes",
              "value": -5.0
            }
          ],
          "planted_issues": [
            {
              "issue_id": "issue_impossible_delivery_time",
              "kind": "impossible_value",
              "locations": [
                {
                  "where": {
                    "city": "Kano"
                  },
                  "occurrence": 0,
                  "column": "avg_delivery_minutes"
                }
              ],
              "description": "avg_delivery_minutes is -5.0 for Kano \u2014 a negative delivery time is impossible and indicates a data entry error.",
              "rule": {
                "column": "avg_delivery_minutes",
                "op": "lt",
                "value": 0
              }
            }
          ]
        }
      ],
      "provenance": "authored"
    },
