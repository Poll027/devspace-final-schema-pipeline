        {
          "step_id": "tile_stakeholder_chart_matching_simplifying.r03",
          "type": "remediation",
          "concept_ids": [
            "stakeholder.simplifying_charts_for_audience"
          ],
          "eyebrow": "Let's revisit",
          "title": "What counts as clutter \u2014 and why removing it helps",
          "lede": "Each element you remove from a chart reduces the cognitive effort the audience spends reading it.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.r03.b1",
              "role": "mechanism",
              "text": "Gridlines can be deleted; if precise values matter, label the data point directly instead. A chart's border can be removed \u2014 white space differentiates parts of a visual better than a border. Data labels should be used sparingly, only where exact values are important; otherwise use the axis. Unnecessary trailing zeroes can be dropped from axis labels. Diagonally rotated axis text is slower to read \u2014 abbreviate labels so they render horizontally.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.simplifying_charts_for_audience"
                ],
