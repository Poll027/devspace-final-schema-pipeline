        {
          "step_id": "tile_stakeholder_chart_matching_simplifying.r04",
          "type": "remediation",
          "concept_ids": [
            "stakeholder.simplifying_charts_for_audience"
          ],
          "eyebrow": "Let's revisit",
          "title": "Border vs. white space: why the border can go",
          "lede": "A chart border feels like it organises the visual \u2014 but white space does that job better.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.r04.b1",
              "role": "mechanism",
              "text": "A chart's border is not adding informative value \u2014 it does not encode any data and does not help the audience read the bars. White space around the chart differentiates it from surrounding content just as effectively, without adding a visual element the eye has to process. Removing the border is one of the quickest single changes that reduces clutter on a chart built for a non-technical audience like the operations manager.",
              "lineage": {
