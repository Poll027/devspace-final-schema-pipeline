                "block_id": "tile_stakeholder_chart_matching_simplifying.s01.b3.right",
                "chart_kind": "line",
                "asset_ref": {
                  "asset_id": "asset_lagos_weekly_deliveries",
                  "variant_id": null,
                  "columns": [
                    "week_label",
                    "avg_delivery_minutes"
