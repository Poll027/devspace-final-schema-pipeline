              "f2"
            ]
          }
        ],
        "anchors": [
          "aws_devops.configure_security_groups#assessment:determine_stateful_response_traffic_behavior"
        ],
        "public": {
          "prompt": "A security group allowed a new connection. For the response to that tracked connection, there is no allow rule in the response direction. What follows from security-group statefulness?",
          "options": [
            {
              "option_id": "o1",
              "text": "The response is allowed regardless of response-direction rules."
            },
            {
              "option_id": "o2",
              "text": "The response is blocked until a separate response-direction allow is added."
            },
            {
              "option_id": "o3",
              "text": "Every later new connection from any source is also allowed."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Statefulness allows response traffic for the allowed connection."
            },
            "o2": {
              "message": "Statefulness means this response does not require a separate response-direction allow rule."
            },
            "o3": {
              "message": "A tracked response is not a new connection from an arbitrary source; new connections still need applicable allows."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Statefulness allows response traffic for the allowed connection."
          },
          "incorrect": {
            "message": "Judge the response as response traffic for the already allowed connection, not as an arbitrary new connection."
          },
          "hints": [
            "Distinguish a tracked response from a new connection."
          ],
          "remediation_step_id": "aws_devops.tile.028.r01"
        }
      }
    },
