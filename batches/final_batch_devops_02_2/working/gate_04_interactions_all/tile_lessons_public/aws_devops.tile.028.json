      "title": "Allow the required connection",
      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Security groups contain allow rules evaluated at associated network interfaces, not explicit deny rules.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_security_groups"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_security_groups#tb1",
              "aws_devops.configure_security_groups#tb2"
            ],
            "fact_ids": [
              "aws_devops.configure_security_groups#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "They are stateful: responses to allowed connections are allowed regardless of response-direction rules. Add inbound rules for the required protocol, port range and approved source; remove unnecessary ingress, then test required connections and responses.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_security_groups"
            ],
