              "target_kind": "row"
            },
            {
              "task_id": "t6",
              "prompt": "Which request is not permitted because its bucket ARN does not match the policy object-resource scope, with no identity allow to contribute permission?",
              "target_kind": "row"
            },
            {
              "task_id": "t7",
              "prompt": "Which request has a matching caller, action and object scope but is not permitted because Condition does not match and identity-side allow is absent?",
              "target_kind": "row"
