      "eyebrow": "Check your understanding",
      "title": "Judge cross-account permission evidence",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.030.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.evaluate_resource_based_permissions_for_a_requested_operation",
            "capability": "determine_general_cross_account_permission_requirements",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.evaluate_resource_based_permissions_for_a_requested_operation#assessment:determine_general_cross_account_permission_requirements"
        ],
        "public": {
          "prompt": "For an ordinary supplied cross-account S3 request with no applicable explicit deny, the resource side allows the request but identity-side permission is absent. Which judgement follows from the taught general rule?",
          "options": [
            {
              "option_id": "o1",
              "text": "Permission is not demonstrated: cross-account access generally requires permission on both sides."
            },
            {
              "option_id": "o2",
              "text": "The resource allow alone is sufficient because same-account contributed-allow reasoning always applies across accounts."
            },
            {
              "option_id": "o3",
              "text": "The identity side alone would be sufficient even if the resource side did not permit the request."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The ordinary supplied case lacks identity-side permission; the general cross-account rule requires permission on both sides."
            },
            "o2": {
              "message": "Same-account contributed allows do not replace the general cross-account requirement for permission on both sides."
            },
            "o3": {
              "message": "The general cross-account rule requires permission on both sides, not only identity-side permission."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The ordinary supplied case lacks identity-side permission; the general cross-account rule requires permission on both sides."
          },
          "incorrect": {
            "message": "Apply the general cross-account requirement rather than treating this as a same-account contributed-allow case."
          },
          "hints": [
            "Check whether both the identity side and resource side supply permission."
          ],
          "remediation_step_id": "aws_devops.tile.030.r01"
        }
      }
