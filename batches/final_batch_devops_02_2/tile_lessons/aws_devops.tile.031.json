      "title": "Distinguish creation from governance",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.031.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.execute_an_established_managed_account_onboarding_workflow",
