        ],
        "anchors": [
          "aws_devops.execute_an_established_managed_account_onboarding_workflow#assessment:distinguish_account_creation_from_verified_governance_completion"
        ],
        "public": {
          "prompt": "An Account Factory account was created and its enrollment and organizational-unit placement match the approved inputs. One supplied baseline checkpoint has no supporting applied-control result. Which completion judgement is supported?",
          "options": [
            {
              "option_id": "o1",
              "text": "Record that checkpoint as unverified; account creation alone does not demonstrate governance completion."
            },
            {
              "option_id": "o2",
              "text": "Mark governance complete solely because account creation succeeded."
            },
            {
              "option_id": "o3",
              "text": "Treat the missing checkpoint as verified because enrollment and placement match."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The missing checkpoint evidence remains unverified even though creation, enrollment and placement have evidence."
            },
            "o2": {
              "message": "Creating an account does not substitute for checking enrollment, placement and supplied baseline evidence."
            },
            "o3": {
              "message": "Enrollment and placement do not supply the missing applied-control evidence for that checkpoint."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The missing checkpoint evidence remains unverified even though creation, enrollment and placement have evidence."
          },
          "incorrect": {
            "message": "Creation, enrollment and placement do not provide a missing applied-control checkpoint result."
          },
          "hints": [
            "Matching enrollment and placement do not supply missing baseline-checkpoint evidence."
          ],
          "remediation_step_id": "aws_devops.tile.031.r01"
        }
      }
    },
