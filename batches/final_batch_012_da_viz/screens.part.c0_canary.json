        {
          "step_id": "tile_viz_figures_layout_plotting.s09",
          "type": "explainer",
          "concept_ids": [
            "viz.pyplot_basic_plotting"
          ],
          "eyebrow": "pyplot interface",
          "title": "Two Ways to Call plt.plot()",
          "lede": "pyplot's `plot()` function accepts data in two forms \u2014 learn which x-axis you get from each.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_viz_figures_layout_plotting.s09.b01",
              "role": "intro",
              "text": "You have already seen `ax.plot(x, y)` draw onto an Axes created with `plt.subplots()`. pyplot also has its own `plot()` function, called directly as `plt.plot()`, and it accepts data in two different forms.",
              "lineage": {
                "concept_ids": [
                  "viz.pyplot_basic_plotting"
                ],
                "teaching_block_ids": [
                  "viz.pyplot_basic_plotting#tb1"
                ],
                "fact_ids": [
                  "viz.pyplot_basic_plotting#f1",
                  "viz.pyplot_basic_plotting#f2"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_viz_figures_layout_plotting.s09.b02",
              "role": "syntax",
              "text": "`plt.plot(y)` with a single argument treats it as y-values and automatically generates x-values starting from 0. `plt.plot([18, 22, 26, 19, 30])` plots those five delivery times against the automatic x-positions 0, 1, 2, 3, 4.",
              "lineage": {
                "concept_ids": [
                  "viz.pyplot_basic_plotting"
                ],
                "teaching_block_ids": [
                  "viz.pyplot_basic_plotting#tb2"
                ],
                "fact_ids": [
                  "viz.pyplot_basic_plotting#f1"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_viz_figures_layout_plotting.s09.b03",
              "role": "syntax",
              "text": "`plt.plot(x, y)` with two arguments plots y-values against the given x-values instead. `plt.plot([1, 2, 3, 4, 5], [18, 22, 26, 19, 30])` plots the same delivery times against day numbers 1 through 5, not the automatic 0-based positions.",
              "lineage": {
                "concept_ids": [
                  "viz.pyplot_basic_plotting"
                ],
                "teaching_block_ids": [
                  "viz.pyplot_basic_plotting#tb3"
                ],
                "fact_ids": [
                  "viz.pyplot_basic_plotting#f2"
                ]
              }
            },
            {
              "type": "side_by_side",
              "block_id": "tile_viz_figures_layout_plotting.s09.b04",
              "left_label": "plt.plot(y) \u2014 automatic x-axis (0-based)",
              "right_label": "plt.plot(x, y) \u2014 supplied x-axis",
              "left": {
                "type": "code_walkthrough",
                "language": "python",
                "code": "plt.plot([18, 22, 26, 19, 30])\n# x-axis: 0, 1, 2, 3, 4 (auto)",
                "annotations": [
                  {
                    "start_line": 1,
                    "end_line": 1,
                    "text": "Single argument: y-values only; x starts at 0"
                  }
                ]
              },
              "right": {
                "type": "code_walkthrough",
                "language": "python",
                "code": "plt.plot([1, 2, 3, 4, 5], [18, 22, 26, 19, 30])\n# x-axis: 1, 2, 3, 4, 5 (supplied)",
                "annotations": [
                  {
                    "start_line": 1,
                    "end_line": 1,
                    "text": "Two arguments: x-values first, then y-values"
                  }
                ]
              },
              "takeaway": "Both forms call the same function; the only difference is whether you supply x-values or let pyplot number them from 0.",
              "lineage": {
                "concept_ids": [
                  "viz.pyplot_basic_plotting"
                ],
                "teaching_block_ids": [
                  "viz.pyplot_basic_plotting#tb2",
                  "viz.pyplot_basic_plotting#tb3"
                ],
                "fact_ids": [
                  "viz.pyplot_basic_plotting#f1",
                  "viz.pyplot_basic_plotting#f2"
                ],
                "anchors": [
                  "viz.pyplot_basic_plotting#visual"
                ]
              }
            }
          ],
