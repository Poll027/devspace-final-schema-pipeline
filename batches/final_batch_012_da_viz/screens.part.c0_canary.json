        {
          "step_id": "tile_viz_figures_layout_plotting.s06",
          "type": "explainer",
          "concept_ids": [
            "viz.figure_size_layout"
          ],
          "eyebrow": "figure layout",
          "title": "Setting Figure Size and Fitting the Layout",
          "lede": "Two settings on the Figure object control how big it is and whether its contents fit without clipping.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_viz_figures_layout_plotting.s06.b01",
              "role": "definition",
              "text": "`plt.subplots(figsize=(width, height))` sets the figure's dimensions. `figsize` is a (width, height) tuple measured in inches; its default is [6.4, 4.8]. Passing `figsize=(8, 4)` makes a wider-than-default figure, 8 inches by 4 inches.",
              "lineage": {
                "concept_ids": [
                  "viz.figure_size_layout"
                ],
                "teaching_block_ids": [
                  "viz.figure_size_layout#tb1"
                ],
                "fact_ids": [
                  "viz.figure_size_layout#f1"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_viz_figures_layout_plotting.s06.b02",
              "role": "mechanism",
              "text": "`tight_layout()` automatically adjusts subplot parameters so the subplot(s) fit into the figure area; it checks the extents of tick labels, axis labels, and titles. Call it as `plt.tight_layout()` or `fig.tight_layout()`.",
              "lineage": {
                "concept_ids": [
                  "viz.figure_size_layout"
                ],
                "teaching_block_ids": [
                  "viz.figure_size_layout#tb2"
                ],
                "fact_ids": [
                  "viz.figure_size_layout#f2",
                  "viz.figure_size_layout#f3"
                ]
              }
            },
            {
              "type": "code_walkthrough",
              "block_id": "tile_viz_figures_layout_plotting.s06.b03",
              "language": "python",
              "code": "import matplotlib.pyplot as plt\nfig, ax = plt.subplots(figsize=(8, 4))\nfig.tight_layout()",
              "annotations": [
                {
                  "start_line": 2,
                  "end_line": 2,
                  "text": "figsize=(8, 4) sets the canvas to 8 inches wide by 4 inches tall"
                },
                {
                  "start_line": 3,
                  "end_line": 3,
                  "text": "fig.tight_layout() adjusts spacing so subplot contents fit within the figure area"
                }
              ],
              "reveal": "line_by_line",
              "lineage": {
