  "steps": [
    {
      "step_id": "tile_viz_figures_layout_plotting.s01",
      "type": "explainer",
      "concept_ids": [
        "viz.matplotlib_figure_axes"
      ],
      "eyebrow": "matplotlib basics",
      "title": "The Figure and the Axes",
      "lede": "Every matplotlib graph lives inside two nested objects — learn which is which before writing code.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_viz_figures_layout_plotting.s01.b01",
          "role": "intro",
          "text": "Imagine this week's QuickDeliver delivery times — 18, 22, 26, 19, 30 minutes — as a graph instead of a list. Matplotlib draws that graph onto two different kinds of object. Matplotlib graphs data on Figures, and each Figure can contain one or more Axes, which is the area where data is actually plotted.",
          "lineage": {
            "concept_ids": [
              "viz.matplotlib_figure_axes"
            ],
            "teaching_block_ids": [
              "viz.matplotlib_figure_axes#tb1"
            ],
            "fact_ids": [
              "viz.matplotlib_figure_axes#f1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_viz_figures_layout_plotting.s01.b02",
          "role": "definition",
          "text": "The Figure is the overall canvas — the whole window or image you display or save. An Axes is one plotting area inside that Figure: the rectangle with its own x- and y-axis where lines, bars, or points are drawn. A single Figure can hold more than one Axes.",
          "lineage": {
            "concept_ids": [
              "viz.matplotlib_figure_axes"
            ],
            "teaching_block_ids": [
              "viz.matplotlib_figure_axes#tb2"
            ],
            "fact_ids": [
              "viz.matplotlib_figure_axes#f1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_viz_figures_layout_plotting.s01.b03",
          "role": "syntax",
          "text": "After `import matplotlib.pyplot as plt`, `fig, ax = plt.subplots()` creates a Figure and one Axes together: `fig` refers to the whole canvas, `ax` refers to the plotting area inside it.",
          "lineage": {
            "concept_ids": [
              "viz.matplotlib_figure_axes"
            ],
            "teaching_block_ids": [
              "viz.matplotlib_figure_axes#tb3"
            ],
            "fact_ids": [
              "viz.matplotlib_figure_axes#f2"
            ]
          }
        },
        {
          "type": "diagram",
          "block_id": "tile_viz_figures_layout_plotting.s01.b04",
          "diagram_kind": "container",
          "title": "Figure contains Axes",
          "nodes": [
            {
              "id": "figure_node",
              "label": "Figure (canvas)",
              "kind": "outer"
            },
            {
              "id": "axes_node",
              "label": "Axes (plotting area)",
              "kind": "inner"
            },
            {
              "id": "line_node",
              "label": "line drawn on Axes",
              "kind": "content"
            }
          ],
          "edges": [
            {
              "from": "figure_node",
              "to": "axes_node",
              "label": "contains"
            },
            {
              "from": "axes_node",
              "to": "line_node",
              "label": "renders"
            }
          ],
          "layout": "auto",
          "alt_text": "A box-within-a-box diagram: the outer rectangle is labelled 'Figure (canvas)'; inside it sits a smaller rectangle labelled 'Axes (plotting area)'; inside the Axes a simple line represents plotted data.",
