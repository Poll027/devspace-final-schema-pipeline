    {
      "step_id": "tile_viz_figures_layout_plotting.s03",
      "type": "explainer",
      "concept_ids": [
        "viz.matplotlib_figure_axes"
      ],
      "eyebrow": "matplotlib basics",
      "title": "Plotting onto the Axes",
      "lede": "All drawing goes through ax — not fig.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_viz_figures_layout_plotting.s03.b01",
          "role": "example",
          "text": "Plotting calls such as `ax.plot(x, y)` draw onto that Axes object. After `fig, ax = plt.subplots()`, `ax.plot([1, 2, 3, 4, 5], [18, 22, 26, 19, 30])` draws the delivery times as a line onto `ax`. The Figure never receives plotted data — it just holds the Axes.",
