        {
          "step_id": "tile_stats_center_spread.s10",
          "type": "recap",
          "concept_ids": [
            "stats.descriptive_measures_of_center",
            "stats.measures_of_spread"
          ],
          "eyebrow": "Recap",
          "title": "Center and spread: what you've learned",
          "lede": "Three measures of center, three measures of spread — and a clear rule for which to use.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.s10.b1",
              "role": "takeaway",
              "text": "Mean, median, and mode all answer \"what's typical,\" but the mean is pulled by extreme values while the median is not — so check for unusually large values before reporting a single center number.",
              "lineage": {
                "concept_ids": [
                  "stats.descriptive_measures_of_center"
                ],
                "fact_ids": [
                  "stats.descriptive_measures_of_center#f1",
                  "stats.descriptive_measures_of_center#f2",
                  "stats.descriptive_measures_of_center#f3",
                  "stats.descriptive_measures_of_center#f4"
