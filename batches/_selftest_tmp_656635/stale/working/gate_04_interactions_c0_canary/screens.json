            "fact_ids": [
              "stats.measures_of_spread#f4"
            ],
            "teaching_block_ids": [
              "stats.measures_of_spread#tb5"
            ]
          }
        },
        {
          "step_id": "tile_stats_center_spread.r04",
          "type": "remediation",
          "concept_ids": [
            "stats.measures_of_spread"
          ],
          "eyebrow": "Let's review",
          "title": "Range, variance, and standard deviation step by step",
          "lede": "The hands-on asked you to compute all three spread measures. Here's each calculation laid out clearly.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.r04.b1",
              "role": "definition",
              "text": "**Range:** 80 − 18 = **62 minutes** (largest minus smallest). **Variance:** sum the squared deviations from the mean (≈ 30.9) and divide by n − 1 = 6 → ≈ **481.1 minutes²**. **Standard deviation:** √481.1 ≈ **21.9 minutes** — the typical distance of a delivery time from the mean, in the original units.",
              "lineage": {
                "concept_ids": [
                  "stats.measures_of_spread"
                ],
                "fact_ids": [
                  "stats.measures_of_spread#f1",
                  "stats.measures_of_spread#f2",
                  "stats.measures_of_spread#f3"
                ],
                "teaching_block_ids": [
                  "stats.measures_of_spread#tb2",
                  "stats.measures_of_spread#tb3",
                  "stats.measures_of_spread#tb4"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.r04.b2",
              "role": "misconception",
              "text": "The range only looks at the two extremes; variance and standard deviation take every observation into account. Standard deviation is expressed in the same units as the data (minutes), while variance is in squared units (minutes²) — making standard deviation the easier one to interpret directly.",
              "lineage": {
                "concept_ids": [
                  "stats.measures_of_spread"
