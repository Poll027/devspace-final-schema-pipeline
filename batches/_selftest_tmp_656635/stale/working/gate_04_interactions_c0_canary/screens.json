        {
          "step_id": "tile_stats_center_spread.r02",
          "type": "remediation",
          "concept_ids": [
            "stats.descriptive_measures_of_center"
          ],
          "eyebrow": "Let's review",
          "title": "Computing mean, median, and mode step by step",
          "lede": "The hands-on asked you to compute all three measures. Here's each calculation laid out clearly.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.r02.b1",
              "role": "definition",
              "text": "**Mean:** add all seven values (18 + 20 + 22 + 22 + 26 + 28 + 80 = 216) and divide by 7 → ≈ **30.9 minutes**. **Median:** sort the values; the fourth (middle) value is **22 minutes**. **Mode:** 22 minutes appears twice, every other value once → mode = **22 minutes**.",
              "lineage": {
