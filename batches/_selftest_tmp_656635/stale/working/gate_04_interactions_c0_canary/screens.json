                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.s10.b2",
              "role": "takeaway",
              "text": "Range, variance, and standard deviation all quantify spread. The range uses only the two extremes; variance and standard deviation use every observation's distance from the mean. Standard deviation is in the original units, making it the most directly interpretable.",
              "lineage": {
                "concept_ids": [
                  "stats.measures_of_spread"
                ],
                "fact_ids": [
                  "stats.measures_of_spread#f1",
                  "stats.measures_of_spread#f2",
                  "stats.measures_of_spread#f3",
