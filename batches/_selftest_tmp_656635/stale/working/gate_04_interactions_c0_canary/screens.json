        },
        {
          "step_id": "tile_stats_center_spread.r03",
          "type": "remediation",
          "concept_ids": [
            "stats.measures_of_spread"
          ],
          "eyebrow": "Let's review",
          "title": "Why the range misses the full picture",
          "lede": "The check asked about the range's main limitation. Here's the contrast that makes it concrete.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stats_center_spread.r03.b1",
              "role": "misconception",
              "text": "The range (62 minutes) is based only on the two most extreme values — 80 and 18 — and ignores how the rest of the data are spread. Imagine all six non-outlier deliveries were exactly 22 minutes: the range would still be 62, even though the data is far less scattered. Variance and standard deviation use every observation's distance from the mean, so they capture that difference.",
              "lineage": {
                "concept_ids": [
                  "stats.measures_of_spread"
                ],
                "fact_ids": [
                  "stats.measures_of_spread#f4"
                ],
                "teaching_block_ids": [
                  "stats.measures_of_spread#tb5"
                ]
              }
            }
