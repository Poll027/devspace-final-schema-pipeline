        ],
        "public": {
          "prompt": "The delivery record identifies review handoff as the longest measured wait. Which proposal is evidence-backed and bounded?",
          "options": [
            {
              "option_id": "o1",
              "text": "Change only that handoff and name a measurable expected outcome for its waiting time."
            },
            {
              "option_id": "o2",
              "text": "Change every delivery stage without identifying which evidence supports each change."
            },
            {
              "option_id": "o3",
              "text": "Choose an unrelated stage because it is easier to change."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This follows the stated evidence and the taught verification rule."
            },
            "o2": {
              "message": "The task calls for one bounded change addressing the supported bottleneck."
            },
            "o3": {
              "message": "Ease of change is not evidence that the selected stage is the bottleneck."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your choice follows the stated evidence and verification rule."
          },
          "incorrect": {
            "message": "Recheck the evidence and the explanation for the selected option."
          },
          "hints": [
            "Connect one observation to one bounded change and a measurable outcome."
          ],
          "remediation_step_id": "aws_devops.tile.042.r01"
        }
      }
    },
