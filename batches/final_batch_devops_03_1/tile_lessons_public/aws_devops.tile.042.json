      "blocks": [
        {
          "type": "prose",
          "text": "The orders review-handoff record supports one bottleneck and a bounded handoff change. Keep its success signal fixed across baseline and after-change observations. Report improvement, no change or worsening from that comparison; completing the action alone does not establish success.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement"
            ],
            "fact_ids": [
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement#f1",
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement#f2",
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Do not switch to a more flattering measure when the chosen signal fails to improve. Implementation is not proof of improvement.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.select_one_evidence_backed_delivery_workflow_improvement"
            ],
            "fact_ids": [
