      "blocks": [
        {
          "type": "prose",
          "text": "The supplied bucket logical ID declares the approved property value; its Ref output names that bucket. Compare the corresponding live property with the declaration after deployment. Check Type and Properties under Resources, make only approved property/reference edits, and retain validation, sandbox-creation, event and output evidence with the live-property comparison.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template"
            ],
            "fact_ids": [
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template#f1",
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template#f2",
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template#f3",
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template#f4"
            ],
            "teaching_block_ids": [
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Template validation does not verify the live bucket property. Ref returns the bucket name, not an invented object reference.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template"
