        },
        {
          "type": "prose",
          "text": "Type: AWS::S3::Bucket declares an S3 bucket. Ref on that logical ID returns the bucket name.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.read_and_modify_a_standard_cloudformation_s3_template"
            ],
