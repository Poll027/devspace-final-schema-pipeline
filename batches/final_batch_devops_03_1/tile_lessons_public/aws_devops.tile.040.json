        "public": {
          "prompt": "Read each template/deployment review excerpt and decide whether the approved bucket change, references and deployment evidence are verified. Logical ID and property placeholders refer to the supplied values.",
          "buckets": [
            {
              "bucket_id": "supported",
              "label": "Meets the stated criterion / conclusion supported"
            },
            {
              "bucket_id": "unsupported",
              "label": "Does not meet the criterion / conclusion unsupported"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Template review: Resources contains exactly one bucket at the supplied logical ID, Type: AWS::S3::Bucket; only the approved property and supplied references changed. Outputs use Ref on that logical ID.\naws cloudformation validate-template --template-body file://TEMPLATE: succeeds. Approved stack created from that template. Stack events confirm success; output equals deployed bucket name; live bucket property equals approved declaration.\nConclusion: approved deployment and Ref result verified."
            },
            {
              "item_id": "i2",
              "text": "Resources: supplied logical ID; Type: AWS::S3::Bucket; approved property declared. Outputs Ref a different logical ID. Validation fails on that reference; no approved stack creation.\nConclusion: references and approved change verified."
            },
            {
              "item_id": "i3",
              "text": "Template declares the supplied AWS::S3::Bucket and correct Ref; validation succeeds; approved stack creation attempted. No events, outputs or live property inspected.\nConclusion: the approved change has been confirmed deployed."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "supported",
            "i2": "unsupported",
            "i3": "unsupported"
          },
          "item_feedback": {
            "i1": {
              "message": "The record connects declaration, intended logical-ID references, validation, stack evidence and the live property; Ref yields the bucket name."
            },
            "i2": {
              "message": "The wrong logical-ID reference and failed validation do not meet the template/deployment requirement."
            },
            "i3": {
              "message": "Validation and a creation attempt do not confirm deployed outputs or the live property."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Each judgement follows the supplied excerpt and the verification criterion."
          },
          "incorrect": {
            "message": "Check the evidence behind each conclusion; a partial success does not establish every required boundary."
          },
          "hints": [
            "Validation and a local declaration do not replace live deployment verification."
          ],
