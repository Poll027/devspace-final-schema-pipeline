            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Change the supplied declared property and references. Validate with aws cloudformation validate-template --template-body file://TEMPLATE, then create the sandbox stack from the approved template.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
