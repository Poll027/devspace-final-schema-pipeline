      "blocks": [
        {
          "type": "prose",
          "text": "A Running Pod still needs container and event evidence.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [],
            "teaching_block_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A Pod groups containers sharing networking and storage. Its lifecycle is distinct from a controller that may replace it.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Pod phases include Pending, Running, Succeeded, Failed and Unknown. A phase alone does not fully diagnose container health.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f2"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Inspect status with kubectl get pod NAME, events with kubectl describe pod NAME, and the intended container’s output with kubectl logs NAME -c CONTAINER.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
