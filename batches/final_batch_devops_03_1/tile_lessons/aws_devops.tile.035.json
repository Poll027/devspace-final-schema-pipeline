            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Pod phases include Pending, Running, Succeeded, Failed and Unknown. A phase alone does not fully diagnose container health.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
