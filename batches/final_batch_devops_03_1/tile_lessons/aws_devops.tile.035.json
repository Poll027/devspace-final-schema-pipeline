        ],
        "anchors": [],
        "segment_ids": []
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Read the supplied Pod’s status, described events and named container’s logs together. For Pending, use scheduling-event evidence rather than guessing a correction. For Running, inspect runtime events and output. Another container’s logs do not establish the named container’s condition.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f1",
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f2",
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Running is a lifecycle phase, not a complete health diagnosis. Keep status, events and the intended container’s output together.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup"
            ],
            "fact_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f2",
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_eks_pod_using_supplied_cluster_access_setup#tb5"
            ],
            "anchors": []
          }
        }
      ]
    },
