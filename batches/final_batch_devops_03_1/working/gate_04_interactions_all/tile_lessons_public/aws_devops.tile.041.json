            {
              "bucket_id": "unsupported",
              "label": "Does not meet the criterion / conclusion unsupported"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Runtime identity: supplied approved identity. Permission: secretsmanager:GetSecretValue on supplied secret. Request: GetSecretValue with supplied identifier. Retrieved value passed directly to supplied runtime consumer. Safe result: success. Value neither displayed nor written to source code or logs."
            },
            {
              "item_id": "i2",
              "text": "Approved runtime identity has GetSecretValue for supplied secret; retrieval and consumer use succeed. Logging records the retrieved value to prove success.\nConclusion: safe secret consumption verified."
            },
            {
              "item_id": "i3",
              "text": "Consumer succeeds using a value embedded in source code; no GetSecretValue request by the approved runtime identity.\nConclusion: authorized runtime retrieval and no persistence verified."
