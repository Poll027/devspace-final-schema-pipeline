            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Secrets Manager protects stored secret values and returns them to authorized consumers at runtime.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
            ],
            "fact_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Call GetSecretValue for the supplied secret identifier using the approved runtime identity with secretsmanager:GetSecretValue permission.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
            ],
            "fact_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#f2"
            ],
            "teaching_block_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Use the value in the runtime consumer without putting it in source code or logs. Verify the consumer’s safe result instead of displaying the secret.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
            ],
            "fact_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "For the supplied identifier, review GetSecretValue under the approved runtime identity and permission. Pass the value to the consumer and inspect its safe success result. Keep the value out of source and logs; a debugging transcript need not reveal it.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
            ],
            "fact_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#f1",
              "aws_devops.retrieve_a_managed_workload_secret#f2",
              "aws_devops.retrieve_a_managed_workload_secret#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.retrieve_a_managed_workload_secret#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Showing the secret is not necessary evidence. The consumer’s safe result verifies use without disclosure.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
