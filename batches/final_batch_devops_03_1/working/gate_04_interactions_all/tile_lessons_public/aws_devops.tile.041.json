      "blocks": [
        {
          "type": "prose",
          "text": "Check authorized runtime use without exposing the value.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.retrieve_a_managed_workload_secret"
            ],
            "fact_ids": [],
            "teaching_block_ids": [
