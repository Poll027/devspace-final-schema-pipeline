        "public": {
          "prompt": "Read each target-authorization excerpt and decide whether it uses the supplied target’s required model and only the approved action/resource, leaving event matching unchanged.",
          "buckets": [
            {
              "bucket_id": "supported",
              "label": "Meets the stated criterion / conclusion supported"
