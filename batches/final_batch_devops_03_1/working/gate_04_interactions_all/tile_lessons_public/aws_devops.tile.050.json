        ],
        "anchors": [],
        "segment_ids": []
      },
      "blocks": [
        {
          "type": "prose",
          "text": "For a role-requiring target, inspect both events.amazonaws.com trust and approved operation/resource permissions. For the supplied SNS or Lambda case, inspect resource-based invocation permission instead. The same selection pattern does not make these authorization records interchangeable; retain the target and its required model together.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f1",
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f2",
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Matching and authority are separate. A role used by one target is not the model for every target, including SNS and Lambda.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f1",
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#tb5"
            ],
            "anchors": []
          }
        }
      ]
