    {
      "step_id": "aws_devops.tile.050.s02",
      "type": "explainer",
      "concept_ids": [
        "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
      ],
      "title": "Work through the evidence: Separate event matching from execution authority",
      "eyebrow": "Orders sandbox · explainer",
      "lineage": {
        "concept_ids": [
          "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
        ],
        "fact_ids": [
          "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f1",
          "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f2",
