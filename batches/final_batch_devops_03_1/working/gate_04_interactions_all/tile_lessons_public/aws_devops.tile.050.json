            "i1": {
              "message": "The record has the required EventBridge trust and scoped operation/resource permission without changing event selection."
            },
            "i2": {
              "message": "SNS uses the required resource-based invocation model, scoped to the supplied action and resource."
            },
            "i3": {
              "message": "Changing matching does not grant invocation authority, and Lambda requires the supplied resource-based permission."
            },
            "i4": {
