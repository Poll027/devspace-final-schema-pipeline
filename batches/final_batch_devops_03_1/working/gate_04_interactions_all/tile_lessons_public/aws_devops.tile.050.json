        {
          "type": "prose",
          "text": "Targets such as SNS and Lambda require resource-based invocation permissions. Select the target’s required authorization model rather than assigning a role to every target.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
