      "blocks": [
        {
          "type": "prose",
          "text": "A matching event does not itself authorize the target operation.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [],
            "teaching_block_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "An EventBridge pattern selects events; target execution authority is a separate requirement.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f1"
            ],
            "teaching_block_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "When the target requires an execution role, permit events.amazonaws.com to assume it. Scope role permissions to the approved target operation and resource.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#f2"
            ],
            "teaching_block_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Targets such as SNS and Lambda require resource-based invocation permissions. Select the target’s required authorization model rather than assigning a role to every target.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.authorize_an_event_target_with_least_privilege_execution_permissions"
            ],
            "fact_ids": [
