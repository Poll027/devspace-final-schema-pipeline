          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Supplied role-based target. Trust: events.amazonaws.com may assume execution role. Role permissions allow only supplied approved target operation on supplied resource. Authorization record retains that scope. Event pattern unchanged.\nConclusion: required bounded execution authority configured."
            },
            {
              "item_id": "i2",
              "text": "Supplied SNS target. Resource-based invocation permission permits only supplied bounded action on supplied resource in the supplied approved context. Event pattern unchanged.\nConclusion: required target authorization model used."
            },
            {
              "item_id": "i3",
              "text": "Supplied Lambda target. No resource-based invocation permission. Only the event pattern is broadened.\nConclusion: target invocation authority configured."
            },
            {
              "item_id": "i4",
              "text": "Supplied role-based target. Trust allows events.amazonaws.com, but operation permissions allow every action on every resource rather than only the supplied action/resource. Event pattern unchanged.\nConclusion: least-privilege bounded execution authority configured."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "supported",
