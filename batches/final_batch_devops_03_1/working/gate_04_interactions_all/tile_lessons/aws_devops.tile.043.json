        "public": {
          "prompt": "Read the compliance finding and proposed next-action records; decide whether each correctly identifies the mismatch and follows the supplied governing policy without inferring an attack.",
          "buckets": [
            {
              "bucket_id": "supported",
              "label": "Meets the stated criterion / conclusion supported"
            },
            {
              "bucket_id": "unsupported",
              "label": "Does not meet the criterion / conclusion unsupported"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Rule: supplied configuration rule. Noncompliant resource: intended supplied resource. Rule parameters require approved value; recorded resource configuration has a different value. Evaluation evidence retained with rule and resource. Governing policy: escalate to the established owner; no change authorized yet.\nDecision: record required versus observed value and escalate without change or attack claim."
            },
            {
              "item_id": "i2",
              "text": "Same finding: intended resource recorded with value different from rule parameter; evidence retained. Policy requires escalation before changes.\nDecision: apply a repair immediately, then notify the owner."
            },
            {
              "item_id": "i3",
              "text": "Same finding: noncompliant intended resource; required and recorded values differ. Policy requires escalation before changes.\nDecision: report that the evaluation proves an attack, without preserving the rule parameters or resource configuration."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "supported",
            "i2": "unsupported",
            "i3": "unsupported"
          },
          "item_feedback": {
            "i1": {
              "message": "The affected resource, violated condition and preserved evidence support the policy-governed escalation."
            },
            "i2": {
              "message": "The supplied policy does not authorize a change before escalation."
            },
            "i3": {
              "message": "A compliance mismatch does not prove an attack, and the omitted evidence is needed to support the mismatch and next action."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Each judgement follows the supplied excerpt and the verification criterion."
          },
          "incorrect": {
            "message": "Check the evidence behind each conclusion; a partial success does not establish every required boundary."
          },
          "hints": [
            "Compare required and recorded values, then apply the policy’s permitted path."
          ],
