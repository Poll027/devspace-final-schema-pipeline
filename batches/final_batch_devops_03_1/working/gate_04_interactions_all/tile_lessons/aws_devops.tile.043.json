      "blocks": [
        {
          "type": "prose",
          "text": "For the supplied noncompliant resource, compare recorded configuration, evaluation result and rule parameters. Describe the mismatched setting, retaining any unexpected rule-parameter discrepancy. Preserve that evidence with the governing policy’s remediation or escalation choice; do not infer an attacker or invent an unapproved change.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.triage_a_basic_configuration_compliance_finding"
            ],
            "fact_ids": [
              "aws_devops.triage_a_basic_configuration_compliance_finding#f1",
