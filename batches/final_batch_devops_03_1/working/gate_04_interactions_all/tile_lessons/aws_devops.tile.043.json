          }
        ],
        "public": {
          "prompt": "AWS Config reports a resource noncompliant. The governing policy requires escalation before changes. What is the authorized next action?",
          "options": [
            {
              "option_id": "o1",
              "text": "Preserve the evaluation evidence and escalate through the policy’s stated path without changing the resource."
            },
            {
              "option_id": "o2",
              "text": "Declare an attack from the compliance result alone."
            },
            {
              "option_id": "o3",
              "text": "Apply a configuration change immediately despite the escalation requirement."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This follows the stated evidence and the taught verification rule."
            },
            "o2": {
              "message": "A compliance mismatch is not proof of an attack."
            },
            "o3": {
              "message": "The next action must follow the governing policy, which has not authorized that change."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your choice follows the stated evidence and verification rule."
          },
          "incorrect": {
            "message": "Recheck the evidence and the explanation for the selected option."
          },
          "hints": [
            "Keep the finding separate from the policy governing the response."
          ],
          "remediation_step_id": "aws_devops.tile.043.r01"
        }
      }
