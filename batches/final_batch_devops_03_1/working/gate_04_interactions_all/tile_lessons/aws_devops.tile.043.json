            ],
            "teaching_block_ids": [
              "aws_devops.triage_a_basic_configuration_compliance_finding#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Noncompliant describes configuration against desired conditions, not proof of compromise. The governing policy determines the response.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.triage_a_basic_configuration_compliance_finding"
            ],
