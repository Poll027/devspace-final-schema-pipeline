      "lede": "Read the supplied evidence in this step and choose the interpretation it supports.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.034.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.hand_over_an_actionable_operational_runbook#assessment:identify_failure_handling_stop_conditions_and_escalation_recipient"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.hand_over_an_actionable_operational_runbook",
            "capability": "identify_failure_handling_stop_conditions_and_escalation_recipient",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "The expected result of an approved restart action is absent. What should the runbook tell the receiving operator?",
          "options": [
            {
              "option_id": "o1",
              "text": "Follow the stated failure-handling instructions, stop at the stated condition and escalate to the named recipient."
            },
            {
              "option_id": "o2",
              "text": "Retry or substitute actions until the service appears healthy."
            },
            {
              "option_id": "o3",
              "text": "Record only that the restart was attempted and leave the recipient unspecified."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This follows the stated evidence and the taught verification rule."
            },
            "o2": {
              "message": "The runbook must identify a bounded failure response, not introduce actions outside the established procedure."
            },
            "o3": {
              "message": "An attempt does not replace failure handling, a stop condition or who takes over."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your choice follows the stated evidence and verification rule."
          },
          "incorrect": {
            "message": "Recheck the evidence and the explanation for the selected option."
          },
          "hints": [
            "Look for a bounded handover when routine execution cannot continue."
          ],
          "remediation_step_id": "aws_devops.tile.034.r01"
        }
      }
