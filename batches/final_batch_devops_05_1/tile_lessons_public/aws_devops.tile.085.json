        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.085.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.deploy_a_supplied_cloudformation_s3_environment_across_accounts_and_regions_with_assumed_roles",
            "capability": "verify_no_stack_in_supplied_unapproved_targets",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.deploy_a_supplied_cloudformation_s3_environment_across_accounts_and_regions_with_assumed_roles#assessment:verify_no_stack_in_supplied_unappr-18fdc1f0"
        ],
        "public": {
          "prompt": "Both approved targets have successful stacks. A supplied unapproved target’s stack check returns an access error. Which conclusion is justified?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Approved-target success confirms absence in every unapproved target."
            },
            {
              "option_id": "o2",
              "text": "Absence in that unapproved target remains unverified; the access error is not proof of no stack."
            },
            {
              "option_id": "o3",
              "text": "The access error confirms there is no stack in the unapproved target."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o2"
          ],
          "option_feedback": {
            "o1": {
              "message": "Each supplied unapproved target needs its own absence evidence."
            },
            "o2": {
              "message": "Absence requires a successful check, not a failure to inspect."
            },
            "o3": {
              "message": "An access error does not establish stack absence."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Absence requires a successful check, not a failure to inspect."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.085.r01"
        }
      }
    },
