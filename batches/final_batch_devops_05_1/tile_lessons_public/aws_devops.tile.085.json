        ],
        "public": {
          "prompt": "Read each deployment review and decide whether it verifies exactly both approved account/Region pairs and absence at every supplied unapproved target. All deployments use the same supplied S3 CloudFormation template. Inspect caller, profile, Region, stack outputs and bucket evidence in these supplied records:\n```json\n{\"columns\":[\"target_id\",\"account_id\",\"region\",\"approved\",\"role_profile\",\"role_arn\",\"source_profile\",\"verified_caller_account\",\"explicit_region\",\"stack_name\",\"stack_status\",\"stack_output_bucket\",\"observed_bucket_identity\",\"observed_bucket_location\",\"absence_check_result\"],\"rows\":[[\"approved-1\",111111111111,\"us-east-1\",true,\"sandbox-east\",\"arn:aws:iam::111111111111:role/SandboxDeployment\",\"sandbox-source\",111111111111,\"us-east-1\",\"sandbox-audit\",\"CREATE_COMPLETE\",\"sandbox-audit-111111111111-us-east-1\",\"sandbox-audit-111111111111-us-east-1\",\"us-east-1\",\"not applicable: approved deployment\"],[\"approved-2\",222222222222,\"us-west-2\",true,\"sandbox-west\",\"arn:aws:iam::222222222222:role/SandboxDeployment\",\"sandbox-source\",222222222222,\"us-west-2\",\"sandbox-audit\",\"CREATE_COMPLETE\",\"sandbox-audit-222222222222-us-west-2\",\"sandbox-audit-222222222222-us-west-2\",\"us-west-2\",\"not applicable: approved deployment\"],[\"unapproved-1\",333333333333,\"us-east-1\",false,null,null,null,null,null,\"sandbox-audit\",\"ABSENT\",null,null,null,\"confirmed absent\"],[\"unapproved-2\",333333333333,\"us-west-2\",false,null,null,null,null,null,\"sandbox-audit\",\"ABSENT\",null,null,null,\"confirmed absent\"]]}\n```",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Alternative review case: both approved rows verified, but one supplied unapproved target’s check returns AccessDenied. Reviewer records no stack there and marks every unapproved target’s absence confirmed."
            },
            {
              "item_id": "e2",
              "text": "Review: for each approved pair, role_arn and source_profile from its named profile checked; aws sts get-caller-identity --profile NAME verifies the recorded caller. Stack created with that profile and explicit --region REGION using the same template. Both approved rows independently show successful stacks and matching output/observed bucket identities and approved locations. Every supplied unapproved target’s successful absence check confirms no stack."
            },
            {
              "item_id": "e3",
              "text": "Review: only the first approved row inspected. Its successful stack is used to conclude the second approved account/Region has the correct caller, bucket and location; no unapproved-target checks reviewed."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "violates",
            "e2": "meets",
            "e3": "violates"
          },
          "item_feedback": {
            "e1": {
              "message": "An access error is not proof of absence; that supplied unapproved target remains unverified."
            },
            "e2": {
              "message": "Both approved targets have independent caller, stack and bucket evidence; every supplied unapproved target has confirmed absence."
            },
            "e3": {
              "message": "One target cannot establish the other’s identity or outputs, and every supplied unapproved target also needs an absence check."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
