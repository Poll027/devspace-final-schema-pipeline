      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.083.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.apply_bounded_eks_workload_configuration_and_secrets",
            "capability": "distinguish_secret_encoding_from_required_protection",
            "fact_ids": [
              "f4"
            ]
          }
        ],
        "anchors": [
          "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#assessment:distinguish_secret_encoding_from_required_protection"
        ],
        "public": {
          "prompt": "A reviewer says a Secret’s base64 encoding makes further protection unnecessary. Which judgement is supported?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Incorrect: base64 is not encryption; access control and appropriate storage protection are still required."
            },
            {
              "option_id": "o2",
              "text": "Correct: base64 encoding replaces both access control and storage protection."
            },
            {
              "option_id": "o3",
              "text": "Correct if the consumer prints the decoded secret to verify it."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Encoding does not replace the Secret’s required protection."
            },
            "o2": {
              "message": "Base64 is not encryption and does not eliminate protection requirements."
            },
            "o3": {
              "message": "Consumer checks must not expose secret values; printing does not establish safe protection."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Encoding does not replace the Secret’s required protection."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.083.r01"
        }
      }
