      },
      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "A ConfigMap supplies nonconfidential configuration separately from the container image. In the Pod template, use envFrom.configMapRef or env.valueFrom.configMapKeyRef. Reference a Secret with env.valueFrom.secretKeyRef or a secret-backed volume; test the consumer without printing secret values. Secrets need access control and appropriate storage protection: base64 encoding is not encryption.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets"
            ],
            "teaching_block_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb1",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb2",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb3"
            ],
            "fact_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f1",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f2",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f3",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f4"
            ],
            "segment_ids": [],
            "anchors": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#visual"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "bash",
          "code": "# Illustrative YAML Deployment Pod-template excerpt; no secret value\nspec:\n  template:\n    spec:\n      containers:\n        - name: supplied-consumer\n          env: [{name: APP_MODE, valueFrom: {configMapKeyRef: {name: supplied-config, key: mode}}}, {name: APP_TOKEN, valueFrom: {secretKeyRef: {name: supplied-secret, key: token}}}]",
          "annotations": [
            {
              "start_line": 7,
              "end_line": 7,
              "text": "APP_MODE ← supplied-config / mode: nonconfidential configuration"
            },
            {
              "start_line": 7,
              "end_line": 7,
              "text": "APP_TOKEN ← supplied-secret / token: value hidden; test the consumer without printing it"
            }
          ],
