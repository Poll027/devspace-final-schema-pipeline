          "option_feedback": {
            "o1": {
              "message": "The running environment does not automatically refresh from the ConfigMap change."
            },
            "o2": {
              "message": "Object updates alone do not establish the actual running consumer’s environment."
            },
            "o3": {
              "message": "ConfigMap changes do not automatically update environment variables inside already-running containers."
            }
          }
        },
        "feedback": {
          "correct": {
