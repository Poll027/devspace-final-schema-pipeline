              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb5"
            ],
            "fact_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Base64 encoding is not encryption and does not replace access control or appropriate storage protection. Do not print or return a decoded secret to verify consumption. Use a safe consumer result that confirms the secret was consumed without revealing its value.",
