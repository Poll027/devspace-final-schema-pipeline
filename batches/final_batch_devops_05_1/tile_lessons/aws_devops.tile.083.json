      ],
      "title": "Revisit reference configuration safely",
      "eyebrow": "One clear contrast",
      "blocks": [
        {
          "type": "prose",
          "text": "Secrets require access control and appropriate storage protection; base64 encoding is not encryption.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets"
            ],
            "teaching_block_ids": [
