        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Worked review",
      "blocks": [
        {
          "type": "prose",
          "text": "Check the intended ConfigMap and Secret references in the supplied Pod template, then test the consuming workload without exposing secret values. Nonconfidential configuration belongs in the ConfigMap; the Secret still needs access control and storage protection.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets"
            ],
            "teaching_block_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb4",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb5",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb6"
            ],
            "fact_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f1",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f2",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f3",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f4",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#m1"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A ConfigMap change does not automatically update ConfigMap-backed environment variables inside already-running containers. Tie consumer evidence to the actual references and running consumer rather than assuming the updated ConfigMap alone proves a change. Base64 encoding is not encryption.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets"
            ],
            "teaching_block_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb4",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb5",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#tb6"
            ],
            "fact_ids": [
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f1",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f2",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f3",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#f4",
              "aws_devops.apply_bounded_eks_workload_configuration_and_secrets#m1"
            ],
            "segment_ids": [],
            "anchors": []
          }
        }
      ]
