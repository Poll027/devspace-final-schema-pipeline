      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "A required path needs the subnet’s actual route-table association and a matching destination route to a usable target. Check DNS resolution and intended endpoint address, then inspect route association, required protocol/port rules and response traffic to locate the failing layer.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.diagnose_aws_connectivity_failures"
            ],
            "teaching_block_ids": [
              "aws_devops.diagnose_aws_connectivity_failures#tb1",
              "aws_devops.diagnose_aws_connectivity_failures#tb2",
              "aws_devops.diagnose_aws_connectivity_failures#tb3"
            ],
            "fact_ids": [
              "aws_devops.diagnose_aws_connectivity_failures#f1",
              "aws_devops.diagnose_aws_connectivity_failures#f2",
              "aws_devops.diagnose_aws_connectivity_failures#f3",
              "aws_devops.diagnose_aws_connectivity_failures#f4"
            ],
            "segment_ids": [],
            "anchors": [
              "aws_devops.diagnose_aws_connectivity_failures#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Network ACLs are stateless: requests and responses need permission in their respective directions. Make only the approved correction supported by that layer’s evidence, then repeat the endpoint connection test.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.diagnose_aws_connectivity_failures"
            ],
            "teaching_block_ids": [
