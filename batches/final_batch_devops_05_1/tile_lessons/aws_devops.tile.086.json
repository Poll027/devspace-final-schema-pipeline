          "segments": [
            {
              "segment_id": "seg_aws_devops.diagnose_aws_connectivity_failures_3FumWkHSusY_1763_1858",
              "video_id": "3FumWkHSusY",
              "youtube_url": "https://www.youtube.com/watch?v=3FumWkHSusY",
              "review_url": "https://www.youtube.com/watch?v=3FumWkHSusY&t=1763s",
              "start_seconds": 1763,
              "end_seconds": 1858,
              "label": "How a network ACL can block a permitted request's response",
              "summary": "Security groups automatically permit response traffic for an allowed request. Network ACLs are stateless: inbound and outbound traffic are evaluated separately. In the example, assuming an inbound rule permits the request, an outbound deny rule prevents the response from reaching the caller. Network ACL deny rules can apply to individual IP addresses or CIDR ranges. A permitted request therefore does not establish that its response can pass.",
              "fact_ids": [
                "f3"
              ],
              "transcript_ref": "3FumWkHSusY:1763-1858"
            }
          ],
          "group_title": "Why permitted requests can still fail at a network ACL",
          "bridge": {
            "before": "Watch how an outbound deny blocks a response. This example assumes inbound traffic is explicitly allowed; the speaker's wording about no matching inbound rule does not mean unmatched traffic is allowed.",
            "after": "The clip explains stateless response filtering, not the full diagnosis. The text covers DNS and endpoint checks, actual route association, matching routes to usable targets, protocol/port checks, approved correction and endpoint retesting."
          },
          "default_mode": "video"
        }
      ]
    },
