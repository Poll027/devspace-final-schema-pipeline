      },
      "eyebrow": "Worked review",
      "blocks": [
        {
          "type": "prose",
          "text": "The supplied three-target case keeps successful, failed and unresolved outcomes separate. Retain target identity, invocation status and output evidence with each category. An unresolved outcome is not a failure established by evidence.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "automation.partial_failure"
            ],
            "teaching_block_ids": [
              "automation.partial_failure#tb4",
              "automation.partial_failure#tb5"
            ],
            "fact_ids": [
              "automation.partial_failure#f1",
              "automation.partial_failure#f2",
              "automation.partial_failure#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Keep successful work visible when selecting the supplied scoped follow-up. A single overall command label cannot replace per-target results, and one failure does not justify repeating the whole operation. Preserve uncertainty until inspection establishes the unresolved target’s outcome.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "automation.partial_failure"
            ],
            "teaching_block_ids": [
              "automation.partial_failure#tb4",
              "automation.partial_failure#tb5"
            ],
            "fact_ids": [
              "automation.partial_failure#f1",
              "automation.partial_failure#f2",
