          "automation.partial_failure#assessment:classify_and_record_per_target_outcomes",
          "automation.partial_failure#assessment:preserve_successful_targets_and_report_scoped_follow_up"
        ],
        "public": {
          "prompt": "Read each fleet follow-up record and decide whether it preserves target-specific outcomes and the supplied scoped procedure. Invocation evidence and required follow-up:\n```json\n{\"columns\":[\"command_id\",\"target_id\",\"invocation_status\",\"output_evidence\",\"outcome_category\",\"supplied_follow_up\"],\"rows\":[[\"command-review\",\"node A\",\"Success\",\"Successful output confirms completion.\",\"successful\",\"Retain completion evidence; exclude from repeat execution.\"],[\"command-review\",\"node B\",\"Failed\",\"Invocation output reports failure.\",\"failed\",\"Retain node B\\u2019s failure evidence and route node B alone for review under the supplied procedure; do not repeat execution on node A.\"],[\"command-review\",\"node C\",\"Unresolved\",\"Available invocation evidence does not establish completion or failure.\",\"unresolved\",\"Inspect further before assigning an outcome or considering repeat execution.\"]]}\n```",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Record: node A successful and excluded; node B failed and routed alone for review. Node C recorded successful because no final failure is visible."
            },
            {
              "item_id": "e2",
              "text": "Record:\nnode A: successful; evidence: Successful output confirms completion. Follow-up: Retain completion evidence; exclude from repeat execution.\nnode B: failed; evidence: Invocation output reports failure. Follow-up: Retain node B’s failure evidence and route node B alone for review under the supplied procedure; do not repeat execution on node A.\nnode C: unresolved; evidence: Available invocation evidence does not establish completion or failure. Follow-up: Inspect further before assigning an outcome or considering repeat execution.\nNo fleet-wide rerun."
            },
            {
              "item_id": "e3",
              "text": "Record: node A successful; node B failed; node C unresolved. Follow-up: rerun the entire operation on all three nodes to resolve B."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "violates",
            "e2": "meets",
            "e3": "violates"
          },
          "item_feedback": {
            "e1": {
              "message": "C’s evidence establishes neither completion nor failure, so it must remain unresolved pending inspection."
            },
            "e2": {
              "message": "All three outcomes and evidence are separately retained, with scoped follow-up and no repeat on successful A."
            },
            "e3": {
              "message": "A’s successful result must be preserved and excluded from repeat execution; B’s failure does not justify a fleet-wide rerun."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
          "remediation_step_id": "aws_devops.tile.078.r04"
        }
