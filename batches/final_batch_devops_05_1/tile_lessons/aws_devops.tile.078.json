    {
      "step_id": "aws_devops.tile.078.s03",
      "type": "check",
      "concept_ids": [
        "automation.dry_run"
      ],
      "title": "Check preview scope, check permissions",
      "lineage": {
        "concept_ids": [
          "automation.dry_run"
        ],
        "teaching_block_ids": [],
        "fact_ids": [
          "automation.dry_run#f1",
          "automation.dry_run#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "automation.dry_run#assessment:distinguish_ec2_dry_run_permission_results_from_execution_and_change_preview"
        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.078.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "automation.dry_run",
            "capability": "distinguish_ec2_dry_run_permission_results_from_execution_and_change_preview",
            "fact_ids": [
              "f1",
              "f3"
            ]
          }
        ],
        "anchors": [
          "automation.dry_run#assessment:distinguish_ec2_dry_run_permission_results_from_execution_and_change_preview"
        ],
        "public": {
          "prompt": "A supplied EC2 operation supports DryRun. With DryRun enabled, its response is DryRunOperation. What does this establish?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "The operation executed successfully."
            },
            {
              "option_id": "o2",
              "text": "Every later AWS service change has now been previewed and is guaranteed to succeed."
            },
            {
              "option_id": "o3",
              "text": "Sufficient permission for the checked operation, without executing it or guaranteeing later success."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o3"
          ],
          "option_feedback": {
            "o1": {
              "message": "The DryRun request checks permission without executing the operation."
            },
            "o2": {
              "message": "This supported EC2 check is not a universal preview or a guarantee of later success."
            },
            "o3": {
              "message": "DryRunOperation is permission evidence, not an execution result."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "DryRunOperation is permission evidence, not an execution result."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.078.r01"
        }
      }
    },
    {
      "step_id": "aws_devops.tile.078.s04",
      "type": "hands_on",
      "concept_ids": [
        "automation.dry_run"
      ],
      "title": "Review scope and permissions",
      "lineage": {
        "concept_ids": [
          "automation.dry_run"
        ],
        "teaching_block_ids": [],
        "fact_ids": [
          "automation.dry_run#f2"
        ],
        "segment_ids": [],
        "anchors": [
          "automation.dry_run#practice",
          "automation.dry_run#assessment:verify_preview_targets_and_actions_against_approved_scope_without_mutation"
        ]
      },
      "eyebrow": "Evidence judgement",
      "lede": "Read the supplied excerpts in this step and decide which interpretations or proposed actions are correct, defective or unsafe.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.078.s04",
        "difficulty": "core",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "automation.dry_run",
            "capability": "verify_preview_targets_and_actions_against_approved_scope_without_mutation",
            "fact_ids": [
              "f2"
            ]
          }
        ],
        "anchors": [
          "automation.dry_run#practice",
          "automation.dry_run#assessment:verify_preview_targets_and_actions_against_approved_scope_without_mutation"
        ],
        "public": {
          "prompt": "Read each preview review and decide whether its scope judgement and non-mutating settings are supported. Approved targets are exactly those marked approved_target=true in the supplied preview records; each must use its approved_action. Identify discrepancies without enabling mutation. Supplied preview:\n```json\n{\"columns\":[\"target_id\",\"proposed_action\",\"approved_target\",\"approved_action\",\"preview_mode\",\"mutation_enabled\"],\"rows\":[[\"node A\",\"supplied fleet operation\",true,\"supplied fleet operation\",true,false],[\"node B\",\"supplied fleet operation\",true,\"supplied fleet operation\",true,false],[\"node C\",\"supplied fleet operation\",false,null,true,false]]}\n```",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Review: every proposed target is approved because the wrapper listed it. No discrepancy recorded; preview_mode=true; mutation_enabled=false."
            },
            {
              "item_id": "e2",
              "text": "Review: the unapproved target is correctly flagged, but mutation_enabled is changed to true to verify the preview."
            },
            {
              "item_id": "e3",
              "text": "Review:\nnode A, supplied fleet operation: matches approved target/action\nnode B, supplied fleet operation: matches approved target/action\nnode C, supplied fleet operation: scope discrepancy\npreview_mode remains true; mutation_enabled remains false."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "violates",
            "e2": "violates",
            "e3": "meets"
          },
          "item_feedback": {
            "e1": {
              "message": "The supplied records include an unapproved target; appearing in a preview does not establish approval."
            },
            "e2": {
              "message": "Preview verification must remain non-mutating; enabling mutation violates the practice criterion."
            },
            "e3": {
              "message": "The review retains preview-only settings and records both matching scope and the unapproved-target discrepancy."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
          "remediation_step_id": "aws_devops.tile.078.r02"
        }
      }
    },
