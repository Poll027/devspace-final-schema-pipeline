          "automation.dry_run#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Worked review",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare the wrapper’s proposed targets and actions with approved fleet scope and record discrepancies without enabling mutation. Retain that proposed-action evidence separately from the supported EC2 operation’s permission result.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "automation.dry_run"
            ],
            "teaching_block_ids": [
              "automation.dry_run#tb4",
              "automation.dry_run#tb5"
            ],
            "fact_ids": [
              "automation.dry_run#f1",
              "automation.dry_run#f2",
              "automation.dry_run#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "DryRunOperation means the dry-run permission check succeeded, not that the real operation ran. UnauthorizedOperation means insufficient permission. Permission success neither guarantees later operation success nor provides a service-wide change preview.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "automation.dry_run"
            ],
            "teaching_block_ids": [
              "automation.dry_run#tb4",
              "automation.dry_run#tb5"
