      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "For supported EC2 operations, DryRun checks permissions without executing the operation. DryRunOperation means sufficient permission; UnauthorizedOperation means insufficient permission. Neither is a real operation result or a guarantee of later success.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "automation.dry_run"
            ],
            "teaching_block_ids": [
              "automation.dry_run#tb1",
              "automation.dry_run#tb2",
              "automation.dry_run#tb3"
            ],
            "fact_ids": [
              "automation.dry_run#f1",
              "automation.dry_run#f2",
              "automation.dry_run#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "automation.dry_run#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The supplied fleet wrapper’s preview is a separate check: compare proposed targets and actions with approved scope while mutation stays disabled. EC2 DryRun is not a universal preview of every AWS service’s changes.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "automation.dry_run"
            ],
            "teaching_block_ids": [
