        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.078.s07",
        "difficulty": "core",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "automation.partial_failure",
            "capability": "preserve_successful_targets_and_report_scoped_follow_up",
            "fact_ids": [
              "f2",
              "f3"
            ]
          }
        ],
        "anchors": [
          "automation.partial_failure#assessment:preserve_successful_targets_and_report_scoped_follow_up"
        ],
        "public": {
          "prompt": "A fleet command reports node A successful, node B failed with failure output, and node C unresolved. The supplied procedure routes failed targets alone for review and inspects unresolved targets further. Which follow-up preserves the evidence?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Record node C as successful because the command has a successful node."
            },
            {
              "option_id": "o2",
              "text": "Exclude node A from repeat execution, retain node B’s failure and route B alone for review, and keep C unresolved pending inspection."
            },
            {
              "option_id": "o3",
              "text": "Rerun on all nodes because any failure invalidates every successful result."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o2"
          ],
          "option_feedback": {
            "o1": {
              "message": "C’s unresolved evidence does not establish success from A’s separate result."
            },
            "o2": {
              "message": "Per-target evidence supports separate outcomes and scoped follow-up."
            },
            "o3": {
              "message": "A failure on B does not erase A’s successful invocation; blindly repeating successful targets is not supported."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Per-target evidence supports separate outcomes and scoped follow-up."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.078.r03"
        }
      }
    },
