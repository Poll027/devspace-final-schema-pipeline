      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "One fleet command has separate invocation results for individual targets, and those results may differ. Inspect statuses and outputs; record successful, failed and unresolved targets separately. Choose the supplied scoped follow-up from target-specific evidence rather than blindly repeating successful work.",
          "role": "mechanism",
          "lineage": {
