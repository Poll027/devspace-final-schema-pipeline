        "fact_ids": [
          "aws.credential_expiry#f1"
        ],
        "segment_ids": [],
        "anchors": [
          "aws.credential_expiry#assessment:recognize_temporary_credential_expiration"
        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.080.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws.credential_expiry",
            "capability": "recognize_temporary_credential_expiration",
            "fact_ids": [
              "f1"
            ]
          }
        ],
        "anchors": [
          "aws.credential_expiry#assessment:recognize_temporary_credential_expiration"
        ],
        "public": {
          "prompt": "A request made with temporary credentials returns an expired-session error. Which interpretation is supported?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "The expired credentials are no longer usable; a newly authorized session is needed."
            },
            {
              "option_id": "o2",
              "text": "The expired credentials remain usable if the old access key is entered again."
            },
            {
              "option_id": "o3",
              "text": "The error establishes that broader permissions must be granted."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Temporary credentials stop being usable after expiration."
            },
            "o2": {
              "message": "Re-entering an old access key does not renew an expired session."
            },
            "o3": {
              "message": "Expiration calls for renewal through the approved provider, not a permissions change."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Temporary credentials stop being usable after expiration."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.080.r01"
        }
      }
    },
