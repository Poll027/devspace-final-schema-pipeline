      "step_id": "aws_devops.tile.080.s01",
      "type": "explainer",
      "concept_ids": [
        "aws.credential_expiry"
      ],
      "title": "Renew identity, inspect outcomes",
      "lineage": {
        "concept_ids": [
          "aws.credential_expiry"
        ],
        "teaching_block_ids": [
          "aws.credential_expiry#tb1",
          "aws.credential_expiry#tb2",
          "aws.credential_expiry#tb3"
        ],
        "fact_ids": [
          "aws.credential_expiry#f1",
          "aws.credential_expiry#f2",
          "aws.credential_expiry#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "aws.credential_expiry#visual"
        ]
      },
      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "Expired temporary credentials are no longer usable. Renew the approved session through its credential provider and use the new access key, secret key and session token together.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.credential_expiry"
            ],
            "teaching_block_ids": [
              "aws.credential_expiry#tb1",
              "aws.credential_expiry#tb2",
              "aws.credential_expiry#tb3"
            ],
            "fact_ids": [
              "aws.credential_expiry#f1",
              "aws.credential_expiry#f2",
              "aws.credential_expiry#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "aws.credential_expiry#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Before retrying a resource-changing request, inspect its known outcome. Where the supplied operation supports an idempotency token, use it to avoid duplicate effects. Renewed credentials alone do not settle the earlier request’s outcome.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.credential_expiry"
            ],
            "teaching_block_ids": [
              "aws.credential_expiry#tb1",
              "aws.credential_expiry#tb2",
              "aws.credential_expiry#tb3"
            ],
            "fact_ids": [
              "aws.credential_expiry#f1",
              "aws.credential_expiry#f2",
              "aws.credential_expiry#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "aws.credential_expiry#visual"
            ]
          }
        },
        {
          "type": "process_flow",
          "title": "Expired identity and safe retry are separate checks",
          "direction": "LR",
          "nodes": [
            {
              "id": "n0",
              "label": "Expired session"
            },
            {
              "id": "n1",
              "label": "Renew through approved provider"
            },
            {
              "id": "n2",
              "label": "New access key + secret key + token"
            },
            {
              "id": "n3",
              "label": "Inspect original operation outcome"
            },
            {
              "id": "n4",
              "label": "Known completed: do not repeat merely due to expiry"
            },
            {
              "id": "n5",
              "label": "Retry warranted: supported idempotency token where available"
            }
