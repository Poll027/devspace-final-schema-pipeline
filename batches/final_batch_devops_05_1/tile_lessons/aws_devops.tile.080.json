        ]
      },
      "eyebrow": "Evidence judgement",
      "lede": "Read the supplied excerpts in this step and decide which interpretations or proposed actions are correct, defective or unsafe.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.080.s04",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws.credential_expiry",
            "capability": "renew_approved_session_with_complete_credential_set",
            "fact_ids": [
              "f2"
            ]
          },
          {
            "concept_id": "aws.credential_expiry",
            "capability": "determine_safe_retry_from_known_outcome_and_supported_idempotency",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws.credential_expiry#practice",
          "aws.credential_expiry#assessment:renew_approved_session_with_complete_credential_set",
          "aws.credential_expiry#assessment:determine_safe_retry_from_known_outcome_and_supported_idempotency"
        ],
        "public": {
          "prompt": "Read each credential-renewal and retry record. Decide whether it uses the complete newly approved session without exposure or permission changes, checks operation outcome, and uses the supplied supported idempotency token when a retry is warranted. Provider: approved session provider. Case complete: evidence says the resource-changing operation completed. Case retry: supplied outcome evidence warrants retry and the operation supports the original idempotency token.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Session record: approved provider issued new access key, secret key and session token; all three used together; values not displayed; permissions unchanged. Complete case: do not repeat. Retry case: outcome evidence checked, warranted retry uses the original supported idempotency token."
            },
            {
              "item_id": "e2",
              "text": "Session record: new access key used with the old secret key and old session token; values not displayed. Complete case not repeated; retry case uses the original token."
            },
            {
              "item_id": "e3",
              "text": "Session record: approved new three-part session used without display or permission change. Complete case repeated to confirm success; retry case discards the original supported idempotency token."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "meets",
            "e2": "violates",
            "e3": "violates"
          },
          "item_feedback": {
            "e1": {
              "message": "The record renews the complete credential set safely and makes distinct outcome-aware retry decisions."
            },
            "e2": {
              "message": "Renewal requires the new access key, secret key and session token together, not a mixed old/new set."
            },
            "e3": {
              "message": "A known completed operation must not be repeated, and a warranted retry should use the supplied supported token to avoid duplicate effects."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
          "remediation_step_id": "aws_devops.tile.080.r02"
        }
      }
