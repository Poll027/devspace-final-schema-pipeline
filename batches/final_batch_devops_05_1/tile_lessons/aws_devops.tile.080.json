    {
      "step_id": "aws_devops.tile.080.s02",
      "type": "explainer",
      "concept_ids": [
        "aws.credential_expiry"
      ],
      "title": "Inspect the evidence and the contrast",
      "lineage": {
        "concept_ids": [
          "aws.credential_expiry"
        ],
        "teaching_block_ids": [
          "aws.credential_expiry#tb4",
          "aws.credential_expiry#tb5"
        ],
        "fact_ids": [
          "aws.credential_expiry#f1",
          "aws.credential_expiry#f2",
          "aws.credential_expiry#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Worked review",
      "blocks": [
        {
          "type": "prose",
          "text": "Replace the expired credential set through the approved provider, keeping the new access key, secret key and token together. For a mutation, record whether the original request is known to have taken effect before considering a repeat.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.credential_expiry"
            ],
            "teaching_block_ids": [
              "aws.credential_expiry#tb4",
              "aws.credential_expiry#tb5"
            ],
            "fact_ids": [
              "aws.credential_expiry#f1",
              "aws.credential_expiry#f2",
              "aws.credential_expiry#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Compare a known completed mutation with an unresolved result. Neither case makes expired credentials usable again, but completion is not a reason to repeat the mutation. For an unresolved case, inspect available outcome evidence before retrying and use supported idempotency where available.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.credential_expiry"
            ],
            "teaching_block_ids": [
              "aws.credential_expiry#tb4",
              "aws.credential_expiry#tb5"
            ],
            "fact_ids": [
              "aws.credential_expiry#f1",
              "aws.credential_expiry#f2",
              "aws.credential_expiry#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.080.s03",
      "type": "check",
      "concept_ids": [
        "aws.credential_expiry"
      ],
      "title": "Check renew identity, inspect outcomes",
      "lineage": {
        "concept_ids": [
          "aws.credential_expiry"
