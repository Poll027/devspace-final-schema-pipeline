        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.082.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts",
            "capability": "distinguish_preventive_restrictions_from_detective_noncompliance_results",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#assessment:distinguish_preventive_restrictions_from_detective_noncompliance_results"
        ],
        "public": {
          "prompt": "A baseline check reports noncompliance for a detective control. What interpretation is supported?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Preventive controls and detective controls both only report noncompliance and never restrict actions."
            },
            {
              "option_id": "o2",
              "text": "The detective control reports noncompliance; this report is not proof that an action was preventively blocked."
            },
            {
              "option_id": "o3",
              "text": "The report proves the requested action was blocked by the detective control."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o2"
          ],
          "option_feedback": {
            "o1": {
              "message": "Preventive controls restrict actions; detective controls report noncompliance."
            },
            "o2": {
              "message": "Detective reports and preventive restrictions are different control results."
            },
            "o3": {
              "message": "A noncompliance report is not itself evidence of preventive restriction."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Detective reports and preventive restrictions are different control results."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.082.r01"
        }
      }
    },
