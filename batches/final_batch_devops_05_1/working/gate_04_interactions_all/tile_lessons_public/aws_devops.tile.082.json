      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "A governed account baseline applies standardized organizational controls and configuration. Apply the supplied approved configuration to the sandbox account and inspect each stated control’s deployment or evaluation result.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts"
            ],
            "teaching_block_ids": [
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#tb1",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#tb2",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#tb3",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#tb4",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#tb5"
            ],
            "fact_ids": [
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#f1",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#f2",
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Preventive controls restrict actions; detective controls report noncompliance. Record those different checkpoints by control. A detective report is not a preventive restriction, and configuration presence is not verification of every control’s result. This is an established baseline, not a task to design new controls.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts"
            ],
