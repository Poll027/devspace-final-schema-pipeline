            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#practice",
          "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#assessment:verify_stated_baseline_controls_in_a_sandbox_account",
          "aws_devops.apply_an_approved_security_baseline_to_sandbox_accounts#assessment:distinguish_preventive_restrictions_from_detective_noncompliance_results"
        ],
        "public": {
          "prompt": "Read each baseline result record. Decide whether it verifies the exact approved configuration and interprets every stated control correctly. Designated account=sandbox account. Approved configuration has exactly two controls: P (preventive restriction on the supplied disallowed action) and D (detective noncompliance report). No additional controls are approved.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Applied P plus an extra unapproved control. D omitted without an evaluation record. Review marks the approved baseline fully verified."
            },
            {
              "item_id": "e2",
              "text": "Applied approved configuration unchanged to sandbox account. P deployment result recorded; supplied disallowed action restricted. D evaluation result recorded: noncompliant, interpreted as a report rather than action blocking. Every stated control has its own result; no extra controls introduced."
            },
            {
              "item_id": "e3",
              "text": "Applied approved configuration unchanged. P deployment and D noncompliant evaluation recorded. Review says D’s noncompliance result proves D preventively blocked the action."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "violates",
            "e2": "meets",
            "e3": "violates"
          },
          "item_feedback": {
            "e1": {
              "message": "The required D result is absent and an unapproved control was introduced; this is not verification of the exact stated baseline."
            },
            "e2": {
              "message": "The exact approved baseline is applied and both controls have results interpreted according to preventive versus detective behavior."
            },
            "e3": {
              "message": "A detective noncompliance report is not evidence of preventive action restriction."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
