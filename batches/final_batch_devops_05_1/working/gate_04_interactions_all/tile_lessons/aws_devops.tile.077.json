        ]
      },
      "eyebrow": "Evidence judgement",
      "lede": "Read the supplied excerpts in this step and decide which interpretations or proposed actions are correct, defective or unsafe.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.077.s04",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "terraform.destroy_review",
            "capability": "identify_saved_ec2_plan_actions_and_resource_identities",
            "fact_ids": [
              "f1",
              "f2"
            ]
          },
          {
            "concept_id": "terraform.destroy_review",
            "capability": "distinguish_replacement_from_in_place_update",
            "fact_ids": [
              "f2"
            ]
          },
          {
            "concept_id": "terraform.destroy_review",
            "capability": "accept_or_block_plan_scope_and_destructive_impact_with_evidence",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "terraform.destroy_review#practice",
          "terraform.destroy_review#assessment:identify_saved_ec2_plan_actions_and_resource_identities",
          "terraform.destroy_review#assessment:distinguish_replacement_from_in_place_update",
          "terraform.destroy_review#assessment:accept_or_block_plan_scope_and_destructive_impact_with_evidence"
        ],
        "public": {
          "prompt": "Read each saved-plan review and decide whether the action interpretation and accept/block decision meet the supplied scope. Preapproved scaffold evidence: EC2 node A provisioned successfully. Review criteria: allow only an in-place update to node A; block additions, replacements and deletions. Review plans must not be applied.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Evidence: terraform plan -out=review.plan; terraform show review.plan. Cases: node A update in place -> accept; node B addition -> block (outside scope); node A replacement, destruction plus creation -> block (destructive impact); node A deletion -> block (mandatory deletion case). Every decision cites that saved-plan action/resource. No review plan applied."
            },
            {
              "item_id": "e2",
              "text": "Evidence: terraform show review.plan identifies node A replacement. Review: accept as an in-place update; no review plan applied."
            },
            {
              "item_id": "e3",
              "text": "Evidence: terraform show review.plan identifies node A deletion. Review: apply this plan to determine impact, then accept because node A is in scope."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "meets",
            "e2": "violates",
            "e3": "violates"
          },
          "item_feedback": {
            "e1": {
              "message": "All four actions are identified with resource identity; replacement is destruction plus creation, deletion is reviewed, and decisions follow the supplied scope without destructive execution."
            },
            "e2": {
              "message": "Replacement includes destruction and creation, so it violates the permitted in-place-only impact."
            },
            "e3": {
              "message": "The permitted action excludes deletion, and destructive application is not needed for review."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
          "remediation_step_id": "aws_devops.tile.077.r02"
        }
      }
    },
