    {
      "step_id": "aws_devops.tile.077.s01",
      "type": "explainer",
      "concept_ids": [
        "terraform.destroy_review"
      ],
      "title": "Review every Terraform action",
      "lineage": {
        "concept_ids": [
          "terraform.destroy_review"
        ],
        "teaching_block_ids": [
          "terraform.destroy_review#tb1",
          "terraform.destroy_review#tb2",
          "terraform.destroy_review#tb3"
        ],
        "fact_ids": [
          "terraform.destroy_review#f1",
          "terraform.destroy_review#f2",
          "terraform.destroy_review#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "terraform.destroy_review#visual"
        ]
      },
      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "A Terraform plan describes proposed additions, updates, deletions and replacements using configuration, state and observed infrastructure. Save it with terraform plan -out=PLAN_FILE and inspect it with terraform show PLAN_FILE. Replacement includes destruction and creation, not just an in-place update.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "terraform.destroy_review"
            ],
            "teaching_block_ids": [
              "terraform.destroy_review#tb1",
              "terraform.destroy_review#tb2",
              "terraform.destroy_review#tb3"
            ],
            "fact_ids": [
              "terraform.destroy_review#f1",
              "terraform.destroy_review#f2",
              "terraform.destroy_review#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "terraform.destroy_review#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Compare affected resource identities and every proposed action, including the mandatory deletion case, with supplied scope and impact criteria. Record accept or block with plan evidence. Review does not require destructive execution.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "terraform.destroy_review"
            ],
            "teaching_block_ids": [
              "terraform.destroy_review#tb1",
              "terraform.destroy_review#tb2",
              "terraform.destroy_review#tb3"
            ],
            "fact_ids": [
              "terraform.destroy_review#f1",
              "terraform.destroy_review#f2",
              "terraform.destroy_review#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "terraform.destroy_review#visual"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "bash",
          "code": "terraform plan -out=PLAN_FILE\nterraform show PLAN_FILE\n# Approved illustrative scope: add new; update existing; replace replacement; retain retained.\n# + aws_instance.new — addition — ACCEPT: approved addition\n# ~ aws_instance.existing — in-place update — ACCEPT: approved update\n# -/+ aws_instance.replacement — destruction and creation — ACCEPT: both impacts approved\n# - aws_instance.retained — deletion — BLOCK: retention required",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 2,
              "text": "Save and inspect; no destructive execution is required."
            },
            {
              "start_line": 3,
              "end_line": 7,
              "text": "These are illustrative review annotations; inspect the actual saved plan before recording its decision."
            }
          ],
          "lineage": {
            "concept_ids": [
              "terraform.destroy_review"
            ],
            "teaching_block_ids": [
              "terraform.destroy_review#tb1",
              "terraform.destroy_review#tb2",
              "terraform.destroy_review#tb3"
            ],
            "fact_ids": [
              "terraform.destroy_review#f1",
              "terraform.destroy_review#f2",
              "terraform.destroy_review#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "terraform.destroy_review#visual"
            ]
          }
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.077.s02",
      "type": "explainer",
      "concept_ids": [
        "terraform.destroy_review"
      ],
      "title": "Inspect the evidence and the contrast",
      "lineage": {
        "concept_ids": [
          "terraform.destroy_review"
        ],
        "teaching_block_ids": [
          "terraform.destroy_review#tb4",
          "terraform.destroy_review#tb5"
        ],
        "fact_ids": [
          "terraform.destroy_review#f1",
          "terraform.destroy_review#f2",
          "terraform.destroy_review#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "eyebrow": "Worked review",
      "blocks": [
        {
          "type": "prose",
          "text": "Keep each resource identity beside its proposed action. Check additions, updates, replacements and the supplied deletion against approved scope and impact criteria. A replacement includes destruction as well as creation.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "terraform.destroy_review"
            ],
            "teaching_block_ids": [
              "terraform.destroy_review#tb4",
              "terraform.destroy_review#tb5"
            ],
            "fact_ids": [
              "terraform.destroy_review#f1",
              "terraform.destroy_review#f2",
              "terraform.destroy_review#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Record accept or block with the relevant saved-plan evidence. Do not execute a deletion merely to demonstrate that you identified it, and do not treat a general description of an “update” as proof that no infrastructure will be removed.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "terraform.destroy_review"
            ],
            "teaching_block_ids": [
              "terraform.destroy_review#tb4",
              "terraform.destroy_review#tb5"
            ],
            "fact_ids": [
              "terraform.destroy_review#f1",
              "terraform.destroy_review#f2",
              "terraform.destroy_review#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.077.s03",
      "type": "check",
      "concept_ids": [
        "terraform.destroy_review"
      ],
      "title": "Check review every terraform action",
      "lineage": {
        "concept_ids": [
          "terraform.destroy_review"
        ],
        "teaching_block_ids": [],
        "fact_ids": [
          "terraform.destroy_review#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "terraform.destroy_review#assessment:accept_or_block_plan_scope_and_destructive_impact_with_evidence"
        ]
      },
      "eyebrow": "Knowledge check",
      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.077.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "terraform.destroy_review",
            "capability": "accept_or_block_plan_scope_and_destructive_impact_with_evidence",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "terraform.destroy_review#assessment:accept_or_block_plan_scope_and_destructive_impact_with_evidence"
        ],
        "public": {
          "prompt": "The supplied review criteria permit only an in-place update to the approved EC2 instance. terraform show of the saved plan includes deletion of that instance. Which review decision is supported without applying it?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Block the plan and cite the deletion as outside the permitted action and impact."
            },
            {
              "option_id": "o2",
              "text": "Accept because a deletion is an in-place update."
            },
            {
              "option_id": "o3",
              "text": "Apply the plan to determine whether the deletion is destructive before deciding."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The saved plan’s deletion conflicts with the supplied action and impact criteria."
            },
            "o2": {
              "message": "A deletion is not an in-place update."
            },
            "o3": {
              "message": "Plan review uses plan evidence and does not require destructive execution."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The saved plan’s deletion conflicts with the supplied action and impact criteria."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.077.r01"
        }
      }
    },
    {
      "step_id": "aws_devops.tile.077.s04",
      "type": "hands_on",
      "concept_ids": [
