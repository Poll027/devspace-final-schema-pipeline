        "public": {
          "prompt": "A maintenance-window summary says complete, but one approved node’s execution failed and its patch compliance is unresolved. Which record is supported?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "All nodes were patched because the window summary says complete."
            },
            {
              "option_id": "o2",
              "text": "Discard the per-node evidence and widen the next run to every node without reviewing approved bounds."
            },
            {
              "option_id": "o3",
              "text": "That node requires follow-up; retain its execution and compliance evidence separately from patched nodes."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o3"
          ],
          "option_feedback": {
            "o1": {
              "message": "The window summary does not replace per-node evidence."
            },
            "o2": {
              "message": "Follow-up must preserve approved task bounds and target-specific evidence."
            },
            "o3": {
              "message": "Per-node execution and compliance evidence determine follow-up."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Per-node execution and compliance evidence determine follow-up."
