              "end_seconds": 1805,
              "label": "How baseline rules and managed-node targets govern scan and install results",
              "summary": "Patch Manager uses patch baselines to define which available patches are applicable and approved. Operations can run immediately or on a schedule against Systems Manager managed nodes, including targets selected by key/value pairs. A scan checks applicable patches against the baseline and reports noncompliance when required patches are missing. An install applies patches with the aim of bringing the node into compliance with that baseline. AWS provides predefined baselines as examples, not recommended best practices; for this task, retain the already-approved configuration.",
              "fact_ids": [
                "f1"
              ],
              "transcript_ref": "PhIiVsCEBu8:1667-1805"
            }
