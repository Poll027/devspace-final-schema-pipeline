          "bridge": {
            "before": "Watch how baseline rules and managed-node targets lead to scan or install results. The clip calls predefined baselines recommendations; treat them as examples, and retain your already-approved configuration.",
            "after": "The clip explains the patching model, not established maintenance-window execution or per-node result inspection. The text covers approved targets, document parameters, concurrency and error limits, and verification of patched nodes and follow-up needs."
          },
          "default_mode": "video"
