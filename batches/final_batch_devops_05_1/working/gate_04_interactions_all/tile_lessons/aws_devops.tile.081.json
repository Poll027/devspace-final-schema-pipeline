      "eyebrow": "Explain",
      "blocks": [
        {
          "type": "prose",
          "text": "The ECS task role supplies credentials for application containers’ AWS calls. The task execution role instead authorizes startup work such as pulling images and publishing logs. These roles do not substitute for each other.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.ecs_task_identity"
            ],
            "teaching_block_ids": [
              "aws.ecs_task_identity#tb1",
              "aws.ecs_task_identity#tb2",
              "aws.ecs_task_identity#tb3",
              "aws.ecs_task_identity#tb4",
              "aws.ecs_task_identity#tb5"
            ],
            "fact_ids": [
              "aws.ecs_task_identity#f1",
              "aws.ecs_task_identity#f2",
              "aws.ecs_task_identity#f3"
            ],
            "segment_ids": [],
            "anchors": [
              "aws.ecs_task_identity#visual"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Set taskRoleArn in the task definition to the approved least-privilege application role. Test supplied allowed and denied application operations from the task, and associate results with that application identity. Successful startup work does not establish application AWS access.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.ecs_task_identity"
            ],
            "teaching_block_ids": [
              "aws.ecs_task_identity#tb1",
              "aws.ecs_task_identity#tb2",
              "aws.ecs_task_identity#tb3",
              "aws.ecs_task_identity#tb4",
