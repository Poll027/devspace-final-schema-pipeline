      "eyebrow": "Evidence judgement",
      "lede": "Read the supplied excerpts in this step and decide which interpretations or proposed actions are correct, defective or unsafe.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.081.s03",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws.ecs_task_identity",
            "capability": "distinguish_application_task_role_permissions_from_execution_role_startup_permissions",
            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "anchors": [
          "aws.ecs_task_identity#practice",
          "aws.ecs_task_identity#assessment:distinguish_application_task_role_permissions_from_execution_role_startup_permissions"
        ],
        "public": {
          "prompt": "Read each ECS task-definition and application-test excerpt. Decide whether it uses the approved least-privilege application role, preserves the execution role, and verifies allowed and denied application operations. Approved task role=application-role; original execution role=startup-role. The supplied allowed operation is reading the audit object; the denied operation is writing it.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the stated criterion"
            }
          ],
          "items": [
            {
              "item_id": "e1",
              "text": "Task definition: taskRoleArn=startup-role; executionRoleArn=application-role. Review says successful image pulling proves application read/write authority; no application tests retained."
            },
            {
              "item_id": "e2",
              "text": "Task definition: taskRoleArn=application-role; executionRoleArn=startup-role unchanged. Application read succeeds and the operation required to be denied also succeeds. Review marks least-privilege verification complete."
            },
            {
              "item_id": "e3",
              "text": "Task definition: taskRoleArn=application-role; executionRoleArn=startup-role unchanged. Tests from the application container: approved audit read succeeds; denied audit write returns AccessDenied. Review attributes these AWS calls to the task role, not startup authority."
            }
          ]
        },
        "grading": {
          "assignments": {
            "e1": "violates",
            "e2": "violates",
            "e3": "meets"
          },
          "item_feedback": {
            "e1": {
              "message": "Startup authority and application permissions are distinct; taskRoleArn must reference the approved application role, with allowed and denied application tests."
            },
            "e2": {
              "message": "The denied application operation must return access denial; its success contradicts the supplied boundary."
            },
            "e3": {
              "message": "The approved application role is assigned and tested in both directions while the startup role is unchanged."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The judgements match the supplied evidence and the stated operational boundary."
          },
          "incorrect": {
            "message": "At least one excerpt misses or contradicts a stated requirement. Check its settings and evidence, not just its conclusion."
          },
          "hints": [
            "Compare the actual settings and recorded outcomes with every supplied requirement.",
            "Separate an evidence-supported result from a claim based only on a label or summary."
          ],
          "remediation_step_id": "aws_devops.tile.081.r01"
        }
