      "lede": "Choose the interpretation supported by the supplied evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.081.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws.ecs_task_identity",
