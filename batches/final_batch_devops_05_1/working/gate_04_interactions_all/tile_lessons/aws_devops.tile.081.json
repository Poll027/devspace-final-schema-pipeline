        {
          "type": "prose",
          "text": "The task execution role authorizes ECS startup work such as pulling an image and publishing logs; it is distinct from application AWS permissions.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.ecs_task_identity"
