            "fact_ids": [
              "aws.ecs_task_identity#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Contrast: image pulling and log publication concern startup authority, not application AWS permissions under taskRoleArn.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws.ecs_task_identity"
            ],
            "teaching_block_ids": [
              "aws.ecs_task_identity#tb2",
              "aws.ecs_task_identity#tb3",
