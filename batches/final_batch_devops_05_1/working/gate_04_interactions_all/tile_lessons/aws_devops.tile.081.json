            ]
          }
        ],
        "anchors": [
          "aws.ecs_task_identity#assessment:distinguish_application_task_role_permissions_from_execution_role_startup_permissions"
        ],
        "public": {
          "prompt": "In an ECS task definition, which role supplies credentials for AWS calls made by the application container?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "The task execution role solely because it authorizes image pulling and log startup work."
            },
            {
              "option_id": "o2",
              "text": "Neither role; successful image pulling itself grants the application all AWS permissions."
            },
            {
              "option_id": "o3",
              "text": "The application task role referenced by taskRoleArn."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o3"
          ],
          "option_feedback": {
            "o1": {
              "message": "The execution role’s startup authority is distinct from application AWS permissions."
            },
            "o2": {
              "message": "Startup success is not evidence of application authorization."
            },
            "o3": {
              "message": "Application AWS permissions come from the task role."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Application AWS permissions come from the task role."
          },
          "incorrect": {
            "message": "Recheck the stated boundary against the evidence; the selected conclusion is not supported."
          },
          "hints": [
            "Identify what the supplied evidence establishes, rather than what a summary might suggest."
          ],
          "remediation_step_id": "aws_devops.tile.081.r01"
        }
      }
