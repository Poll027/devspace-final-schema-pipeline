              "python.module_search_paths#tb5"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Inspect sys.path for the search locations used by the executing interpreter. Exact paths depend on the environment.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.module_search_paths"
            ],
            "fact_ids": [
              "python.module_search_paths#f3"
