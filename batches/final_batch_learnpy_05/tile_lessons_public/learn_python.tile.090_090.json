              "python.module_search_paths#tb5",
              "python.module_search_paths#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "A same-named local file can shadow a standard-library module. Rename the conflicting local file to remove the ambiguity; a familiar import name alone does not prove its source.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.module_search_paths"
            ],
            "fact_ids": [
              "python.module_search_paths#f2"
