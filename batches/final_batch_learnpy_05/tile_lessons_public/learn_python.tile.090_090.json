      "eyebrow": "Explore",
      "blocks": [
        {
          "type": "prose",
          "text": "An ordinary import checks built-in modules, then searches sys.path. The script directory normally precedes standard-library directories.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.module_search_paths"
            ],
            "fact_ids": [
              "python.module_search_paths#f1"
