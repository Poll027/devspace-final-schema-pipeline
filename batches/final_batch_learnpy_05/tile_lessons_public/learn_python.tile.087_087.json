              "python.logging#tb2",
              "python.logging#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Choose the event level by meaning: DEBUG for detailed diagnostics; INFO for expected progress; WARNING for an unexpected condition while continuing; ERROR for inability to perform a function; CRITICAL for a serious failure.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.logging"
            ],
            "fact_ids": [
              "python.logging#f2"
            ],
            "teaching_block_ids": [
              "python.logging#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Emit events with the corresponding method, such as logger.debug(message) or logger.info(message).",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.logging"
            ],
            "fact_ids": [
              "python.logging#f3"
            ],
            "teaching_block_ids": [
              "python.logging#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "logging.basicConfig(level=logging.INFO) includes INFO and higher events. The default root threshold is WARNING. A missing DEBUG message need not mean that its line was never reached.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.logging"
            ],
            "fact_ids": [
              "python.logging#f4"
            ],
            "teaching_block_ids": [
              "python.logging#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Propagation normally sends events to ancestor handlers. Handlers on both a logger and its ancestors can duplicate output; ordinarily configure a handler at one suitable ancestor.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.logging"
            ],
            "fact_ids": [
              "python.logging#f5"
            ],
            "teaching_block_ids": [
              "python.logging#tb3"
