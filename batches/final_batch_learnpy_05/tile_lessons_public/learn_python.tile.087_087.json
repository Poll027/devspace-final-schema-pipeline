      "eyebrow": "Explore",
      "blocks": [
        {
          "type": "prose",
          "text": "After import logging, logger = logging.getLogger(__name__) obtains a logger named for the module.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.logging"
            ],
            "fact_ids": [
              "python.logging#f1"
            ],
