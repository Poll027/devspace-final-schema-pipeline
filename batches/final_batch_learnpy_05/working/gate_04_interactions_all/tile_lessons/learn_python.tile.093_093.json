        ],
        "fact_ids": [
          "python.regular_expressions#f1",
          "python.regular_expressions#f2",
          "python.regular_expressions#f3",
          "python.regular_expressions#f4"
        ],
        "segment_ids": [],
        "anchors": [
          "python.regular_expressions#visual"
        ]
      },
      "eyebrow": "Explore",
      "blocks": [
        {
          "type": "prose",
          "text": "A regular expression describes a text pattern. [...] selects one character from a set; A-Z is a range; * permits zero or more repetitions.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.regular_expressions"
            ],
            "fact_ids": [
              "python.regular_expressions#f1"
            ],
            "teaching_block_ids": [
              "python.regular_expressions#tb1",
              "python.regular_expressions#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Concatenated elements match in sequence. A raw literal such as r\"...\" avoids Python string-escape processing of pattern backslashes.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.regular_expressions"
            ],
            "fact_ids": [
              "python.regular_expressions#f2"
            ],
            "teaching_block_ids": [
              "python.regular_expressions#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "re.fullmatch(pattern, text) returns a Match for a whole-text match and None otherwise. Test is not None for success.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.regular_expressions"
            ],
            "fact_ids": [
              "python.regular_expressions#f3"
            ],
            "teaching_block_ids": [
              "python.regular_expressions#tb1",
              "python.regular_expressions#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "re.match checks the beginning; re.search looks anywhere. Neither requires the entire text to match, so a matching prefix or substring does not establish whole-label validity.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.regular_expressions"
            ],
            "fact_ids": [
              "python.regular_expressions#f4"
            ],
            "teaching_block_ids": [
              "python.regular_expressions#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "import re\npattern = r\"[A-Z][A-Z]*\"\nfor label in [\"BLUE\", \"Blue\", \"BLUE!\"]:\n    accepted = re.fullmatch(pattern, label) is not None\n    print(label, accepted)\n",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "First character required; later characters may repeat."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "Whole-text match with an explicit success test."
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "python.regular_expressions"
            ],
            "fact_ids": [
              "python.regular_expressions#f1",
              "python.regular_expressions#f2",
              "python.regular_expressions#f3",
              "python.regular_expressions#f4"
            ],
            "teaching_block_ids": [
              "python.regular_expressions#tb4"
            ],
            "anchors": [
              "python.regular_expressions#visual"
            ]
          }
        }
      ]
