            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "random.seed(seed) initializes the pseudo-random generator. Reusing a seed reproduces a sequence under the documented reproducibility conditions, not a guarantee across every environment.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.random_vs_secrets"
            ],
            "fact_ids": [
              "python.random_vs_secrets#f2"
