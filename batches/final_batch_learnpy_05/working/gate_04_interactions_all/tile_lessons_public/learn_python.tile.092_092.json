            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "random.random() returns a floating-point value from 0.0 inclusive to 1.0 exclusive.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.random_vs_secrets"
            ],
            "fact_ids": [
              "python.random_vs_secrets#f3"
