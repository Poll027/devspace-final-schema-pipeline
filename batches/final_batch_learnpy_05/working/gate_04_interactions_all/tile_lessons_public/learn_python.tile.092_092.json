            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "secrets.token_hex(nbytes) generates a random hexadecimal token for security-sensitive use. Choose the module from the requirement, not convenience.",
          "role": "mechanism",
          "lineage": {
