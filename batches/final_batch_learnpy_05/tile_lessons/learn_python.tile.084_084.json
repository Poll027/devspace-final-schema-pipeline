              "python.datetime_operations#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "For numeric year-month-day text, the explicit parsing format is %Y-%m-%d.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.datetime_operations"
            ],
            "fact_ids": [
              "python.datetime_operations#f2"
            ],
