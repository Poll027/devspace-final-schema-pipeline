              "python.datetime_operations#tb4"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Subtracting one date from another produces a timedelta that represents the difference.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.datetime_operations"
            ],
            "fact_ids": [
              "python.datetime_operations#f3"
            ],
            "teaching_block_ids": [
              "python.datetime_operations#tb3",
              "python.datetime_operations#tb4",
              "python.datetime_operations#tb5"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "For calendar dates, (later_date - earlier_date).days gives a signed day difference. Reversing the subtraction reverses the sign in this example, rather than preserving an absolute distance.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.datetime_operations"
            ],
            "fact_ids": [
              "python.datetime_operations#f4"
            ],
            "teaching_block_ids": [
              "python.datetime_operations#tb3",
              "python.datetime_operations#tb4",
              "python.datetime_operations#tb5"
            ],
            "anchors": []
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "from datetime import datetime\nfirst = datetime.strptime(\"2025-03-01\", \"%Y-%m-%d\").date()\nsecond = datetime.strptime(\"2025-03-04\", \"%Y-%m-%d\").date()\nprint(first)\nprint(second)\nprint((second - first).days)\nprint((first - second).days)\n",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 3,
              "text": "Parse with an explicit format and obtain calendar dates."
            },
            {
              "start_line": 4,
