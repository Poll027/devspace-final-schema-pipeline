        ]
      },
      "eyebrow": "Explore",
      "blocks": [
        {
          "type": "prose",
          "text": "os.environ maps process environment names to string values. Configuration arrives as text.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.os_environment"
            ],
            "fact_ids": [
              "python.os_environment#f1"
            ],
            "teaching_block_ids": [
              "python.os_environment#tb2",
              "python.os_environment#tb4",
              "python.os_environment#tb1"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "os.environ.get(\"SETTING\", fallback) returns the configured string or, if absent, the fallback. Without a fallback, absence returns None. An absent name is not the same as a configured empty string.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.os_environment"
            ],
            "fact_ids": [
              "python.os_environment#f2"
            ],
            "teaching_block_ids": [
              "python.os_environment#tb3",
              "python.os_environment#tb4",
              "python.os_environment#tb5"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "For required configuration, check absence explicitly or use bracket lookup, which raises KeyError for a missing key. Report missing configuration instead of proceeding with an unintended value.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.os_environment"
            ],
            "fact_ids": [
              "python.os_environment#f3"
            ],
            "teaching_block_ids": [
              "python.os_environment#tb3",
              "python.os_environment#tb4",
              "python.os_environment#tb5"
            ],
            "anchors": []
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "import os\nlabel = os.environ.get(\"ORDER_LABEL\", \"notebook\")\nrequired = os.environ.get(\"ORDER_SOURCE\")\nprint(label)\nif required is None:\n    print(\"Missing ORDER_SOURCE configuration\")\nelse:\n    print(required)\n",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 3,
              "text": "Optional fallback versus required configuration."
            },
            {
              "start_line": 5,
              "end_line": 6,
              "text": "Check None explicitly for absence."
            },
            {
              "start_line": 7,
              "end_line": 8,
              "text": "Display the configured string when ORDER_SOURCE is present."
            }
          ],
          "reveal": "line_by_line",
