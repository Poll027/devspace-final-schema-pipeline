        ],
        "public": {
          "prompt": "Read each proposed Cost Explorer review note. The selected account is 1001, the selected inclusive period is 2026-01-01 through 2026-01-31, and grouping is by service or usage type. Decide whether the note identifies an avoidable charge with matching billed cost/usage, supplied context, and a recommendation for review only (no deletion or forecast).\nFiltered and comparison records:\n```text\naccount=1001; period=2026-01-01 through 2026-01-31; service=Compute; usage_type=idle-test-usage; billed_cost=24; usage=120 exercise usage units; Supplied owner record: temporary test usage is no longer required; recommend review.\naccount=1001; period=2026-01-01 through 2026-01-31; service=Storage; usage_type=required-data-usage; billed_cost=12; usage=60 exercise usage units; Supplied owner record: workload still requires this usage.\naccount=1002; period=2026-01-01 through 2026-01-31; service=Compute; usage_type=idle-test-usage; billed_cost=48; usage=240 exercise usage units; Different account; exclude from selected report.\naccount=1001; period=2025-12-01 through 2025-12-31; service=Compute; usage_type=idle-test-usage; billed_cost=36; usage=180 exercise usage units; Different period; exclude from selected report.\n```",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the stated review criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Does not meet the stated review criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "```text\naccount=1001; period=2026-01-01 through 2026-01-31; service=Compute; usage_type=idle-test-usage; billed_cost=24; usage=120 exercise usage units\nSupplied owner record: temporary test usage is no longer required; recommend review.\nRecommendation: review this no-longer-required temporary usage with the owner; no deletion or forecast.\n```"
            },
            {
              "item_id": "i2",
              "text": "```text\naccount=1002; period=2026-01-01 through 2026-01-31; service=Compute; usage_type=idle-test-usage; billed_cost=48; usage=240 exercise usage units\nRecommendation: review this as the selected account cost driver.\n```"
            },
            {
              "item_id": "i3",
              "text": "```text\naccount=1001; period=2025-12-01 through 2025-12-31; service=Compute; usage_type=idle-test-usage; billed_cost=36; usage=180 exercise usage units\nRecommendation: review this as the selected period cost driver.\n```"
            },
            {
              "item_id": "i4",
              "text": "```text\naccount=1001; period=2026-01-01 through 2026-01-31; service=Storage; usage_type=required-data-usage; billed_cost=12; usage=60 exercise usage units\nRecommendation: remove this charge because storage resources exist.\n```"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails",
            "i4": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "This cites the selected account/period, grouping, cost and usage, and the owner-supported reason for review."
            },
            "i2": {
              "message": "This record belongs to a different account, so it cannot establish the selected account driver."
            },
            "i3": {
              "message": "This record is outside the selected period."
            },
            "i4": {
              "message": "The owner context says the usage remains required; inventory does not establish avoidability."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The accepted note retains scope, grouping, billed values and an evidence-backed review recommendation."
          },
          "incorrect": {
            "message": "Reject scope mismatches and resource-existence guesses even when they contain real billed numbers."
