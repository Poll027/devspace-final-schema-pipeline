        "interaction_id": "ix.aws_devops.tile.068.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.identify_avoidable_charges_with_cost_explorer",
            "capability": "distinguish_evidence_backed_cost_driver_from_unsupported_guess",
            "fact_ids": [
              "f1",
              "f2",
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.identify_avoidable_charges_with_cost_explorer#assessment:distinguish_evidence_backed_cost_driver_from_unsupported_guess"
        ],
        "public": {
          "prompt": "Read this filtered billed-usage record and owner context. Which recommendation is supported?\n```text\n{\n  \"billing\": {\n    \"account\": 1001,\n    \"period_start\": \"2026-01-01\",\n    \"period_end\": \"2026-01-31\",\n    \"service\": \"Compute\",\n    \"usage_type\": \"idle-test-usage\",\n    \"billed_cost\": 24,\n    \"usage\": 120,\n    \"usage_unit\": \"exercise usage units\",\n    \"supplied_context\": \"Supplied owner record: temporary test usage is no longer required; recommend review.\"\n  }\n}\n```",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Recommend review of idle-test-usage; cite account=1001; period=2026-01-01 through 2026-01-31; service=Compute; usage_type=idle-test-usage; billed_cost=24; usage=120 exercise usage units and the owner record that temporary usage is no longer required."
            },
            {
              "option_id": "o2",
              "text": "Delete every resource with an old name; its existence proves this billed charge."
            },
            {
              "option_id": "o3",
              "text": "Recommend eliminating required-data-usage solely because storage resources exist."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The recommendation ties the avoidable charge to filtered billed cost, usage and supplied owner context, and requests review."
            },
            "o2": {
              "message": "Resource existence and age do not establish a specific charge; the evidence supports review, not independent deletion."
            },
            "o3": {
              "message": "The supplied context says this usage remains required, and resource existence alone does not justify an avoidable billed charge."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The recommendation ties the avoidable charge to filtered billed cost, usage and supplied owner context, and requests review."
          },
          "incorrect": {
            "message": "Check the selected account and period, billed cost and usage, and owner context; resource existence alone does not establish an avoidable charge."
          },
          "hints": [
            "Look for both billed usage attribution and context explaining avoidability."
          ],
          "remediation_step_id": "aws_devops.tile.068.r01"
        }
      }
    },
