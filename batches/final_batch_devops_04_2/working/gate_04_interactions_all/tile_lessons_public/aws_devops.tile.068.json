      "title": "Support a cost-driver recommendation",
      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "Use account 1001 and 2026-01-01 through 2026-01-31. Compare the service or usage-type groups and their billed cost and usage. The supplied owner record for idle-test-usage says its temporary usage is no longer required; cite its report values when recommending review. The required-data-usage context says that usage remains required. Keep account, interval, grouping and values with the recommendation so another reviewer can check the attribution.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer"
            ],
            "teaching_block_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer#tb4"
            ],
            "fact_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer#f1",
              "aws_devops.identify_avoidable_charges_with_cost_explorer#f2",
              "aws_devops.identify_avoidable_charges_with_cost_explorer#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A resource name, age or existence does not establish a numerical charge. Compare suspected drivers within the supplied interval; use billed cost and usage rather than inventing charges from inventory. This is a supported recommendation, not a forecast or an independent deletion decision.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer"
            ],
            "teaching_block_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer#tb5"
            ],
            "fact_ids": [
              "aws_devops.identify_avoidable_charges_with_cost_explorer#f1",
              "aws_devops.identify_avoidable_charges_with_cost_explorer#f3"
            ]
          }
        }
      ]
