      "title": "Judge order recovery by verified prerequisites",
      "eyebrow": "Check your judgement",
      "lede": "Read the supplied excerpts in this step and decide which conclusions or procedures are correct, defective or unsafe.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.070.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order",
            "capability": "identify_required_verification_before_service_resumption",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order#assessment:identify_required_verification_before_service_resumption"
        ],
        "public": {
          "prompt": "A recovery procedure says database restoration finished, but database readiness has not been checked. Application resumption depends on usable database recovery. Which next step is justified?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Verify database readiness before resuming the application."
            },
            {
              "option_id": "o2",
              "text": "Resume the application immediately because the restore command finished."
            },
            {
              "option_id": "o3",
              "text": "Skip verification because the recovery plan lists all components."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Readiness verification prevents completed restoration from being mistaken for usable recovery."
            },
            "o2": {
              "message": "A completed restoration step is not the required readiness verification."
            },
            "o3": {
              "message": "A component list does not verify prerequisite readiness before a dependent service resumes."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Readiness verification prevents completed restoration from being mistaken for usable recovery."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence; configuration or an accepted request alone is not the required outcome."
          },
          "hints": [
            "Does a completed procedure establish the readiness the dependent service needs?"
          ],
          "remediation_step_id": "aws_devops.tile.070.r01"
        }
      }
    },
