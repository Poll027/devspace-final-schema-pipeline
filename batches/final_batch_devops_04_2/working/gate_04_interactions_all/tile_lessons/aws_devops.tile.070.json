            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Account for workload dependencies and the recovery capabilities needed to meet recovery objectives.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order"
            ],
            "teaching_block_ids": [
