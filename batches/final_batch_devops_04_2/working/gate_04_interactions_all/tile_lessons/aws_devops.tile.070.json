      "title": "Order recovery by verified prerequisites",
      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "A component list can still describe an unusable recovery order.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order"
            ],
            "teaching_block_ids": [
