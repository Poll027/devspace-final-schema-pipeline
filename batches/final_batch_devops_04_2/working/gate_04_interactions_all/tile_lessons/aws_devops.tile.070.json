            ],
            "fact_ids": [
              "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "List supplied infrastructure, data and service dependencies. Restore each prerequisite before dependent work, with readiness verification before dependent services resume. Incomplete restoration is not usable recovery.",
          "role": "mechanism",
          "lineage": {
