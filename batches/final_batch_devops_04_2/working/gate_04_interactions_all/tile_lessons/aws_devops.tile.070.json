          "aws_devops.plan_infrastructure_and_data_restoration_in_dependency_order#assessment:identify_required_verification_before_service_resumption"
        ],
        "public": {
          "prompt": "Order these supplied steps using the dependency record below. Each verification must pass before the dependent step. Objective: usable orders service with verified infrastructure and database prerequisites. Only the listed restoration, readiness-check and resumption capabilities are supplied; no numeric recovery target is given. Then judge whether this plan supports that objective. These edges apply only to this workload.\n```text\nrestore_infrastructure <- none; Supplied infrastructure restoration procedure\nverify_infrastructure <- restore_infrastructure; Supplied infrastructure readiness check\nrestore_database <- verify_infrastructure; Supplied database restoration procedure\nverify_database <- restore_database; Supplied database readiness check\nresume_application <- verify_database; Supplied application resumption procedure\n```",
          "items": [
            {
              "item_id": "resume_application",
              "text": "Resume orders application"
            },
            {
              "item_id": "verify_database",
              "text": "Verify database readiness"
            },
            {
              "item_id": "restore_database",
              "text": "Restore database"
            },
            {
              "item_id": "verify_infrastructure",
              "text": "Verify infrastructure readiness"
            },
            {
              "item_id": "restore_infrastructure",
              "text": "Restore infrastructure"
            }
          ],
          "follow_up": {
            "prompt": "Which comparison with the supplied objective and capabilities is supported?",
            "options": [
              {
                "option_id": "supported",
                "text": "The ordered plan uses supplied restoration/readiness capabilities and gates application resumption on verified prerequisites; it supports the stated qualitative objective, but no numerical recovery guarantee is established."
              },
              {
                "option_id": "guaranteed",
                "text": "Listing these steps guarantees any numerical recovery target without checking readiness."
              }
            ]
          }
        },
        "grading": {
          "correct_order": [
            "restore_infrastructure",
            "verify_infrastructure",
            "restore_database",
            "verify_database",
            "resume_application"
          ],
          "follow_up_correct_option_ids": [
