            ],
            "fact_ids": [
              "aws_devops.operate_an_eks_deployment_using_supplied_cluster_access_setup#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Apply the supplied Deployment with kubectl apply -f orders-deployment.yaml. Inspect kubectl get deployment orders and associated Pods. Delete one controlled test Pod through the supplied procedure; verify a replacement restores the requested count.",
