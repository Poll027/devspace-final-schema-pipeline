      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "A removed test Pod and the Deployment target are different evidence.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_deployment_using_supplied_cluster_access_setup"
            ],
            "teaching_block_ids": [
