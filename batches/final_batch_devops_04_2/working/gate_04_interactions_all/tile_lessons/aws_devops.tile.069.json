      "title": "Keep the evidence distinctions",
      "eyebrow": "Takeaways",
      "blocks": [
        {
          "type": "prose",
          "text": "A Deployment manages ReplicaSets to reconcile replicas and template. Apply the supplied Deployment, inspect it and associated Pods, and verify replacement plus restored count after controlled Pod removal. The requested target stays unchanged.",
          "role": "takeaway",
