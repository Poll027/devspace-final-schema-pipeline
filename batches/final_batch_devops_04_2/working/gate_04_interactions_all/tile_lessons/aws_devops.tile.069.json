          ],
          "option_feedback": {
            "o1": {
              "message": "Replacement identity and restored observed count verify the controller has restored the requested target."
            },
            "o2": {
              "message": "Accepted deletion does not establish creation of a replacement or restoration of the requested count."
            },
            "o3": {
              "message": "The requested target remains unchanged while the observed count temporarily falls during reconciliation."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Replacement identity and restored observed count verify the controller has restored the requested target."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence; configuration or an accepted request alone is not the required outcome."
          },
