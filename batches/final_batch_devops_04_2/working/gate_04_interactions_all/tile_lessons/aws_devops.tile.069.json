            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "A Deployment manages ReplicaSets to reconcile requested Pod replicas and the Pod template.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_eks_deployment_using_supplied_cluster_access_setup"
            ],
            "teaching_block_ids": [
