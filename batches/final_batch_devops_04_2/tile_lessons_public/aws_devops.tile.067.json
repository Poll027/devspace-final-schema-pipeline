      "title": "Bound retries and preserve error evidence",
      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "With the approved total_max_attempts budget of 3, the initial request leaves at most 2 retries. Config max_attempts=3 instead allows 3 retries after the first request. Invoke the supplied call once at application level; let standard SDK backoff handle eligible retries. Catch ClientError and report Code and Message, retaining RequestId if present.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#tb4"
            ],
            "fact_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f1",
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f2",
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f3",
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The two settings count different things. Selected retry support does not justify repeating every error indefinitely; terminal or exhausted-retry failures need a final report.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting"
            ],
            "teaching_block_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#tb5"
            ],
            "fact_ids": [
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f1",
              "aws_devops.handle_aws_automation_errors_with_bounded_retries_and_useful_reporting#f4"
            ]
          }
        }
