tile_086.s04 scaffold import json
from pathlib import Path
import stripe
import hashlib,hmac,json
from fastapi import FastAPI, Request
from fastapi.testclient import TestClient
from starter import webhook
config = json.loads(Path('test_config.json').read_text())
raw_body = Path('signed_body.json').read_bytes()
processed_events = []
def process_event(event):
    processed_events.append(event)
# Supplied raw-byte contract adapter; SDK execution is unavailable here.
def provider_verify(raw, signature, signing_secret):
    parts=dict(part.split('=',1) for part in signature.split(','))
    expected=hmac.new(signing_secret.encode(),parts['t'].encode()+b'.'+raw,hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected,parts.get('v1','')):raise stripe.error.SignatureVerificationError('Invalid signature')
    return json.loads(raw)
def publisher_verifier(raw, signature, signing_secret):
    return provider_verify(raw, signature, signing_secret)
# Check the supplied signed fixture against the raw-byte contract.
publisher_verifier(raw_body, config['signature'], config['endpoint_signing_secret'])
app = FastAPI()
@app.post('/webhook')
async def endpoint(request: Request):
    return await webhook(request, config['endpoint_signing_secret'],
                         publisher_verifier, config['signature_header'], process_event)
def client():
    return TestClient(app)

