      "eyebrow": "Learn the rule",
      "blocks": [
        {
          "type": "prose",
          "text": "Build makes the executable artifact. Release pairs it with deploy-specific configuration. Run starts processes from the selected release.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "deployment.release_rollback_boundaries"
            ],
            "fact_ids": [
              "deployment.release_rollback_boundaries#f1"
            ],
            "teaching_block_ids": [
              "deployment.release_rollback_boundaries#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Each release has a unique, immutable identifier: changes create a new release, not edits to the running one.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "deployment.release_rollback_boundaries"
            ],
            "fact_ids": [
              "deployment.release_rollback_boundaries#f2"
            ],
            "teaching_block_ids": [
              "deployment.release_rollback_boundaries#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Record each artifact/configuration pair. Rollback redeploys a known prior release with its intended configuration.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "deployment.release_rollback_boundaries"
            ],
            "fact_ids": [
              "deployment.release_rollback_boundaries#f3"
            ],
            "teaching_block_ids": [
              "deployment.release_rollback_boundaries#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Before rollback, check compatibility with the current database schema. Replacing the application release does not reverse a migration.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "deployment.release_rollback_boundaries"
            ],
            "fact_ids": [
              "deployment.release_rollback_boundaries#f4"
            ],
            "teaching_block_ids": [
              "deployment.release_rollback_boundaries#tb3"
            ],
            "anchors": []
          }
        },
