        "feedback": {
          "correct": {
            "message": "Releases have unique identifiers and are immutable; a new change produces a new release rather than mutating a running release. Record the artifact and configuration for each release and define rollback by redeploying a known prior release with its intended configuration. Check the prior release's compatibility with the current database schema before selecting it for rollback; replacing an application release does not itself reverse a database migration."
          },
          "incorrect": {
            "message": "Check this rule: Releases have unique identifiers and are immutable; a new change produces a new release rather than mutating a running release. Record the artifact and configuration for each release and define rollback by redeploying a known prior release with its intended configuration. Check the prior release's compatibility with the current database schema before selecting it for rollback; replacing an application release does not itself reverse a database migration."
          },
          "hints": [
            "Trace the inputs, the decision boundary, and the observable output separately."
          ],
          "remediation_step_id": "tile_082.r01"
        },
        "public": {
          "prompt": "A known prior release is compatible with the current database schema. Which rollback selection respects the release record?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Redeploy its recorded artifact with its intended configuration; leave the database schema unchanged."
            },
            {
              "option_id": "o2",
              "text": "Redeploy the old artifact with the current release configuration without checking the pair."
            },
            {
              "option_id": "o3",
              "text": "Edit the running release record and assume its database migration is undone."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This option applies the taught boundary to the evidence."
            },
            "o2": {
              "message": "A rollback selects the recorded artifact/configuration pair, not an unverified mixed pair."
            },
            "o3": {
              "message": "Release records are immutable, and application rollback does not reverse migrations."
            }
          }
        }
      }
