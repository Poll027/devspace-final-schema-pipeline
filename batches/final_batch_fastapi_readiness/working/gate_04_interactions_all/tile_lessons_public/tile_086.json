        "feedback": {
          "correct": {
            "message": "Reject missing or invalid signatures before processing the event, and do not disclose the verification secret or failure's internal details in the response. Test a valid signed delivery and deliveries with a modified body or absent signature, checking that only the valid delivery reaches event processing."
          },
          "incorrect": {
            "message": "Check this rule: Reject missing or invalid signatures before processing the event, and do not disclose the verification secret or failure's internal details in the response. Test a valid signed delivery and deliveries with a modified body or absent signature, checking that only the valid delivery reaches event processing."
          },
          "hints": [
            "Trace the inputs, the decision boundary, and the observable output separately."
          ],
          "remediation_step_id": "tile_086.r01"
        },
        "public": {
          "prompt": "A valid signed delivery is copied, but its raw body bytes are modified while the signature is unchanged. What must the webhook do before processing?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "Reject the signature failure without exposing secrets or verification internals."
            },
            {
              "option_id": "o2",
              "text": "Process it because an earlier copy had a valid signature."
            },
            {
              "option_id": "o3",
              "text": "Process it if its parsed JSON still contains an event identifier."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This option applies the taught boundary to the evidence."
            },
            "o2": {
              "message": "Every delivery must be verified against its own raw bytes."
            },
            "o3": {
              "message": "An event identifier does not establish authenticity; failed verification must prevent processing."
            }
          }
        }
      }
