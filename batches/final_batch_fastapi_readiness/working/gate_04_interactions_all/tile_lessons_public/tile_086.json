        "public": {
          "prompt": "Review candidate webhook gates and their test coverage. Accept only a gate where valid signatures reach processing and modified/absent-signature deliveries cannot. Each excerpt is a hypothetical candidate, not a report of observed execution. Classify every item.",
          "buckets": [
            {
              "bucket_id": "good",
              "label": "Meets the stated review requirements"
            },
            {
              "bucket_id": "bad",
              "label": "Fails the stated review requirements"
