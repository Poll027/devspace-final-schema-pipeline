{
  "bearer_scheme": {
    "OrderBearer": {
      "type": "http",
      "scheme": "bearer"
    }
  },
  "authorization_code_scheme": {
    "OrderAuthorizationCode": {
      "type": "oauth2",
      "flows": {
        "authorizationCode": {
          "authorizationUrl": "http://127.0.0.1:37353/authorize",
          "tokenUrl": "http://127.0.0.1:37353/token",
          "scopes": {
            "orders:read": "Read orders",
            "orders:write": "Create orders"
          }
        }
      }
    }
  },
  "operation_requirements": {
    "GET /orders/{order_id}": {
      "dependency": "read_orders",
      "scope": "orders:read"
    },
    "POST /orders": {
      "dependency": "write_orders",
      "scope": "orders:write"
    }
  },
  "dependency_graph": [
    "operation -> read_orders/write_orders -> authenticated -> HTTPBearer extraction -> ExistingVerifier.verify -> JWKS signature/issuer/audience/required claims",
    "read_orders/write_orders -> enforce_permission -> required scope"
  ],
  "authorization_code_issuer": {
    "issuer": "http://127.0.0.1:37353",
    "authorization_url": "http://127.0.0.1:37353/authorize",
    "token_url": "http://127.0.0.1:37353/token",
    "jwks_url": "http://127.0.0.1:37353/jwks",
    "client_id": "order-training-client",
    "redirect_uri": "http://127.0.0.1:37353/client/callback",
    "algorithms": [
      "RS256"
    ],
    "required_claims": [
      "iss",
      "aud",
      "sub",
      "exp",
      "iat"
    ],
    "audience": "order-api",
    "scopes": {
      "orders:read": "Read orders",
      "orders:write": "Create orders"
    },
    "pkce": {
      "required": true,
      "code_challenge_method": "S256"
    },
    "runtime_boundary": "Publisher-provisioned isolated loopback training issuer; not a public production service."
  },
  "representation": "Bearer presentation and issuer acquisition describe the same access-token authority, not separate independently accepted credentials."
}
