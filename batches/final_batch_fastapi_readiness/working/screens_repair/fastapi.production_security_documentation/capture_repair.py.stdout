{
  "components": {
    "securitySchemes": {
      "OrderBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "OrderAuthorizationCode": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "scopes": {
              "orders:read": "Read orders",
              "orders:write": "Create orders"
            },
            "authorizationUrl": "http://127.0.0.1:37353/authorize",
            "tokenUrl": "http://127.0.0.1:37353/token"
          }
        }
      }
    }
  },
  "operations": {
    "GET /orders/{order_id}": [
      {
        "OrderBearer": []
      },
      {
        "OrderAuthorizationCode": [
          "orders:read"
        ]
      }
    ],
    "POST /orders": [
      {
        "OrderBearer": []
      },
      {
        "OrderAuthorizationCode": [
          "orders:write"
        ]
      }
    ]
  }
}
