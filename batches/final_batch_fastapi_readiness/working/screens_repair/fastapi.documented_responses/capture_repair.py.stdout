{
  "responses": {
    "200": {
      "description": "The public order state",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PublicModel"
          }
        }
      }
    },
    "409": {
      "description": "The requested order conflicts",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ConflictModel"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicModel": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "PublicModel"
      },
      "ConflictModel": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ConflictModel"
      }
    }
  }
}
