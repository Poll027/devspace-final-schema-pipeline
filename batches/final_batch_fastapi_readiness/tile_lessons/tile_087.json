        ],
        "feedback": {
          "correct": {
            "message": "Compare integration timeout evidence and emitted database work with the failing request's log context to distinguish an upstream wait from persistence work or a local input rejection."
          },
          "incorrect": {
            "message": "Check this rule: Compare integration timeout evidence and emitted database work with the failing request's log context to distinguish an upstream wait from persistence work or a local input rejection."
          },
          "hints": [
            "Trace the inputs, the decision boundary, and the observable output separately."
          ],
          "remediation_step_id": "tile_087.r01"
        },
        "public": {
          "prompt": "Synthetic evidence for one interaction records an accepted input, a small completed database operation, then a long outbound wait ending in a timeout before the final endpoint error. Which boundary is supported for investigation?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "o1",
              "text": "The upstream wait, traced by the same interaction identifier."
            },
            {
              "option_id": "o2",
              "text": "Persistence, solely because the endpoint accesses a database."
            },
            {
              "option_id": "o3",
              "text": "Local input rejection, solely because the final endpoint response is an error."
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This option applies the taught boundary to the evidence."
            },
            "o2": {
              "message": "Completed small database work does not locate this recorded wait in persistence."
            },
            "o3": {
              "message": "The packet records accepted input; the final response alone does not identify the origin."
            }
          }
        }
      }
