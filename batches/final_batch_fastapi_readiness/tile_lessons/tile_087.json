        "anchors": [
          "observability.evidence_based_service_diagnosis#practice",
          "observability.evidence_based_service_diagnosis#assessment:distinguish_traffic_growth_from_failures_and_latency",
          "observability.evidence_based_service_diagnosis#assessment:locate_first_recorded_failure_in_correlated_logs",
          "observability.evidence_based_service_diagnosis#assessment:verify_suspected_boundary_with_controlled_reproduction"
        ],
        "feedback": {
          "correct": {
            "message": "Your response respects the stated boundary and the supplied evidence."
          },
          "incorrect": {
            "message": "Recheck which evidence establishes the boundary; a declaration or successful single case is not a substitute for the required checks."
          },
          "hints": [
            "Trace the inputs, the decision boundary, and the observable output separately."
          ]
        },
        "public": {
          "prompt": "Review independent investigation candidates. The timing/count packet is authored synthetic evidence, not measurements from the controlled reproduction. Accept a candidate only when it records reproduction separately and supports its chosen boundary. Each excerpt is a hypothetical candidate, not a report of observed execution. Classify every item.",
          "buckets": [
            {
              "bucket_id": "good",
              "label": "Meets the stated review requirements"
            },
            {
              "bucket_id": "bad",
              "label": "Fails the stated review requirements"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Synthetic operation-window comparison: [{\"window\": \"baseline\", \"rate\": 1.0, \"failure_fraction\": 0.0, \"latency_ms\": 25.0}, {\"window\": \"affected\", \"rate\": 1.0, \"failure_fraction\": 0.2, \"latency_ms\": 2025.0}]\nSynthetic correlated records: [{\"interaction_id\": \"interaction_fixture\", \"offset_ms\": 0, \"boundary\": \"local\", \"event\": \"request_received\", \"sql_statement_count\": 0}, {\"interaction_id\": \"interaction_fixture\", \"offset_ms\": 5, \"boundary\": \"database\", \"event\": \"lookup_complete\", \"sql_statement_count\": 1}, {\"interaction_id\": \"interaction_fixture\", \"offset_ms\": 10, \"boundary\": \"outbound\", \"event\": \"lookup_started\", \"sql_statement_count\": 0}, {\"interaction_id\": \"interaction_fixture\", \"offset_ms\": 2010, \"boundary\": \"outbound\", \"event\": \"timeout\", \"sql_statement_count\": 0}, {\"interaction_id\": \"interaction_fixture\", \"offset_ms\": 2025, \"boundary\": \"local\", \"event\": \"response_504\", \"sql_statement_count\": 0}]\nwith client() as http:\n    response = http.post('/orders', json=packet['failing_order_payload'])\n    controlled_outcome = {'status':response.status_code, 'body':response.json(), 'interaction':response.headers[packet['interaction_header']]}\n    reproduction_evidence = list(runtime_evidence)\n# Compare the reproduced timeout control-flow and interaction to the packet, label its simulated database boundary.\n# Rate unchanged, failure fraction and latency increased in synthetic packet; completed database lookup precedes outbound delay/timeout. Investigate upstream waiting, not final local response. Keep proposed timeout-boundary change separate from observations.\nControlled reproduction assertions (not a measured timing claim):\nfrom application import client, packet, runtime_evidence\nruntime_evidence.clear()\nwith client() as http:\n    response = http.post('/orders',json=packet['failing_order_payload'])\nrecorded_outcome = {'status':response.status_code,'body':response.json(),'interaction':response.headers[packet['interaction_header']]}\nrecorded_control_flow = list(runtime_evidence)\nassert response.status_code == 504\nassert response.json() == {'detail':'Lookup timeout'}\nassert response.headers[packet['interaction_header']] == packet['interaction_id']\nassert all(r['interaction_id']==packet['interaction_id'] for r in recorded_control_flow)\nassert any(r['boundary']=='outbound' and r['event']=='timeout' for r in recorded_control_flow)\n# Keep runtime flow/provenance and the synthetic SQL-count/timing packet separate; no actual database SQL or remote timing is measured by this injection."
            },
            {
              "item_id": "i2",
              "text": "# Read only the final local response error in the packet.\nsuspected_boundary = 'database'\nproposed_change = 'change persistence immediately'\n# Do not execute controlled request, inspect correlation, compare operation windows or examine upstream timeout."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "good",
            "i2": "bad"
          },
          "item_feedback": {
            "i1": {
              "message": "The investigation records a controlled HTTP outcome and control-flow separately, compares all operation signals and traces the first delay to outbound work."
            },
            "i2": {
              "message": "The selected boundary lacks correlated support, the controlled reproduction is missing and the proposed change is not separated from observed evidence."
            }
          }
        }
