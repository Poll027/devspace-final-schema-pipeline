    {
      "step_id": "tile_087.s01",
      "type": "explainer",
      "concept_ids": [
        "observability.evidence_based_service_diagnosis"
      ],
      "title": "Diagnose service failures from emitted and interpreted evidence",
      "lineage": {
        "teaching_block_ids": [
          "observability.evidence_based_service_diagnosis#tb1",
          "observability.evidence_based_service_diagnosis#tb2",
          "observability.evidence_based_service_diagnosis#tb3"
        ],
        "fact_ids": [
          "observability.evidence_based_service_diagnosis#f1",
          "observability.evidence_based_service_diagnosis#f2",
          "observability.evidence_based_service_diagnosis#f3",
          "observability.evidence_based_service_diagnosis#f4"
        ],
        "segment_ids": [],
        "anchors": [
          "observability.evidence_based_service_diagnosis#visual"
        ]
      },
      "eyebrow": "Learn the rule",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare request rate, failure fraction and latency for the same affected operation and window. Separate traffic growth from more failures or longer waits before choosing a boundary.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "observability.evidence_based_service_diagnosis"
            ],
            "fact_ids": [
              "observability.evidence_based_service_diagnosis#f1"
            ],
            "teaching_block_ids": [
              "observability.evidence_based_service_diagnosis#tb2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Trace the interaction identifier through local and outbound logs to the first recorded failure or delay; the final endpoint error need not identify its origin.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "observability.evidence_based_service_diagnosis"
            ],
            "fact_ids": [
              "observability.evidence_based_service_diagnosis#f2"
            ],
            "teaching_block_ids": [
              "observability.evidence_based_service_diagnosis#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Compare integration timeouts and emitted database work with that request’s log context to separate upstream waiting, persistence work and local input rejection.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "observability.evidence_based_service_diagnosis"
            ],
            "fact_ids": [
              "observability.evidence_based_service_diagnosis#f3"
            ],
            "teaching_block_ids": [
              "observability.evidence_based_service_diagnosis#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Reproduce the supplied failure with a controlled request. Record outcome and related evidence; change the suspected boundary only when evidence supports that location.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "observability.evidence_based_service_diagnosis"
            ],
            "fact_ids": [
              "observability.evidence_based_service_diagnosis#f4"
            ],
            "teaching_block_ids": [
              "observability.evidence_based_service_diagnosis#tb3"
            ],
            "anchors": []
          }
        },
        {
          "type": "side_by_side",
          "left": {
            "type": "data_table",
            "caption": "Compare the same operation/window: rate, failure fraction and latency.",
            "lineage": {
