      "blocks": [
        {
          "type": "prose",
          "text": "The sandbox publication is Lab/Orders | QueueDepth | Environment=sandbox, Service=orders, with supplied value 7. Publish using put-metric-data with that namespace, name, value and both dimensions. The staging publication is Lab/Orders | QueueDepth | Environment=staging, Service=orders, with supplied value 3. It is a distinct metric despite sharing the name.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions"
            ],
            "fact_ids": [
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions#f1",
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions#f2",
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions#tb4"
            ],
            "anchors": []
          },
          "block_id": "aws_devops.tile.014.s02.b01"
        },
        {
          "type": "prose",
          "text": "The complete sandbox query selects Lab/Orders | QueueDepth | Environment=sandbox, Service=orders. A query omitting Service uses Lab/Orders | QueueDepth | Environment=sandbox: that is not the published sandbox orders combination. Compare the full published and queried identities, not only the metric name. These query records describe selections, not returned values; do not describe a staging series as the sandbox orders value.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.publish_workload_metrics_with_interpretable_dimensions"
