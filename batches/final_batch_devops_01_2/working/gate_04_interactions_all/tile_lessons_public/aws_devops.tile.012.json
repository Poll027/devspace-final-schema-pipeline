      "blocks": [
        {
          "type": "prose",
          "text": "The observed instance i-0c000000000000001 matches the approved AMI ami-0a000000000000001, type t3.micro and subnet subnet-0b000000000000001. The AMI is its initial software image. The supplied profile orders-sandbox-instance-profile attaches orders-sandbox-instance-role; applications can use that role’s temporary credentials.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_ec2_instance"
            ],
            "fact_ids": [
              "aws_devops.operate_an_ec2_instance#f1",
              "aws_devops.operate_an_ec2_instance#f2",
              "aws_devops.operate_an_ec2_instance#f3"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_ec2_instance#tb4"
            ],
            "anchors": []
          },
          "block_id": "aws_devops.tile.012.s02.b01"
        },
        {
          "type": "prose",
          "text": "Its lifecycle state is running, while the system check is ok and the instance check is impaired. Keep both kinds of evidence: running is not proof of health, and a completed launch does not replace status checks. The profile is a role container, not embedded application access keys.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.operate_an_ec2_instance"
            ],
            "fact_ids": [
              "aws_devops.operate_an_ec2_instance#f3",
              "aws_devops.operate_an_ec2_instance#f4"
            ],
            "teaching_block_ids": [
              "aws_devops.operate_an_ec2_instance#tb4",
              "aws_devops.operate_an_ec2_instance#tb5"
            ],
            "anchors": []
          },
          "block_id": "aws_devops.tile.012.s02.b02"
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.012.s03",
      "type": "check",
      "concept_ids": [
        "aws_devops.operate_an_ec2_instance"
      ],
      "title": "Distinguish state from health",
      "eyebrow": "Quick check",
      "lineage": {
        "concept_ids": [
          "aws_devops.operate_an_ec2_instance"
        ],
        "teaching_block_ids": [],
        "fact_ids": [
          "aws_devops.operate_an_ec2_instance#f4"
        ],
        "segment_ids": [],
        "anchors": [
          "aws_devops.operate_an_ec2_instance#assessment:distinguish_lifecycle_state_from_status_check_health"
        ]
      },
      "lede": "Read the supplied evidence and choose the interpretation that keeps lifecycle and health separate.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.012.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.operate_an_ec2_instance",
            "capability": "distinguish_lifecycle_state_from_status_check_health",
            "fact_ids": [
              "f4"
            ]
          }
        ],
        "anchors": [
          "aws_devops.operate_an_ec2_instance#assessment:distinguish_lifecycle_state_from_status_check_health"
        ],
        "public": {
          "prompt": "Read this instance excerpt. Which conclusion preserves the distinction between lifecycle and reported health?\n```text\ninstance_id: i-0c000000000000001\nlifecycle_state: running\nsystem_status_check: ok\ninstance_status_check: impaired\n```",
          "options": [
            {
              "option_id": "o1",
              "text": "Record the running lifecycle state and the status-check results separately; running does not prove health."
            },
            {
              "option_id": "o2",
              "text": "Mark the instance healthy because it is running."
            },
            {
              "option_id": "o3",
              "text": "Replace the lifecycle state with impaired."
            },
            {
              "option_id": "o4",
              "text": "Discard the instance check because the system check is ok."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "State and status checks answer different questions; retain both observations."
            },
            "o2": {
              "message": "Running is lifecycle evidence, not proof that the status checks report health."
            },
            "o3": {
              "message": "Impaired is the instance status-check result here, not the lifecycle state."
            },
            "o4": {
              "message": "The system and instance checks are separate reported health evidence; the ok system check does not erase the impaired instance check."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "You kept lifecycle and health evidence separate."
          },
          "incorrect": {
            "message": "Read the state and each status check as distinct evidence."
          },
          "hints": [
            "Ask which field describes lifecycle, and which fields report health."
          ],
          "remediation_step_id": "aws_devops.tile.012.r01"
        }
      }
    },
