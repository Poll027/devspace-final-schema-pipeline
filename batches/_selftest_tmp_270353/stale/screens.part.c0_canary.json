            ]
          }
        },
        {
          "step_id": "tile_spreadsheet_grid_references.r02",
          "type": "remediation",
          "concept_ids": [
            "spreadsheet.grid_model"
          ],
          "title": "Re-check: grid structure and sheet names",
          "lede": "Rows, columns, and sheet tabs — a quick contrast to clear up confusion.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_spreadsheet_grid_references.r02.b1",
              "role": "misconception",
              "text": "Columns run left to right and are labelled with letters (A, B, C…). Rows run top to bottom and are labelled with numbers (1, 2, 3…). A workbook can hold multiple sheets; by default they are named Sheet1, Sheet2 and so on, and each name appears on its tab at the bottom of the screen.",
              "lineage": {
                "concept_ids": [
                  "spreadsheet.grid_model"
                ],
                "fact_ids": [
                  "spreadsheet.grid_model#f1",
                  "spreadsheet.grid_model#f2",
                  "spreadsheet.grid_model#f3",
                  "spreadsheet.grid_model#f4"
                ],
