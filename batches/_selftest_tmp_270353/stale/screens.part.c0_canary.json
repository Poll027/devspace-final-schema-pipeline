        {
          "step_id": "tile_spreadsheet_grid_references.s05",
          "type": "explainer",
          "concept_ids": [
            "spreadsheet.cell_references_ranges"
          ],
          "eyebrow": "Cell References and Ranges",
          "title": "Pointing at one cell or many",
          "lede": "A reference tells Excel exactly which cell or cells to use in a formula.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_spreadsheet_grid_references.s05.b1",
              "role": "intro",
              "text": "A reference identifies a cell or a range of cells on a worksheet and tells Excel where to look for the values a formula needs. Without a reference, a formula can only work with numbers you type directly — references let it reach into the grid.",
              "lineage": {
                "concept_ids": [
                  "spreadsheet.cell_references_ranges"
                ],
                "fact_ids": [
                  "spreadsheet.cell_references_ranges#f1"
                ],
                "teaching_block_ids": [
                  "spreadsheet.cell_references_ranges#tb1"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_spreadsheet_grid_references.s05.b2",
              "role": "definition",
              "text": "In the A1 reference style, a single cell is referred to by its column letter followed by its row number — for example B2. That is the same address you would use to describe one order's city in the Orders sheet.",
              "lineage": {
                "concept_ids": [
                  "spreadsheet.cell_references_ranges"
                ],
                "fact_ids": [
                  "spreadsheet.cell_references_ranges#f2"
                ],
                "teaching_block_ids": [
                  "spreadsheet.cell_references_ranges#tb2"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_spreadsheet_grid_references.s05.b3",
              "role": "mechanism",
              "text": "A reference can also point at a block of cells at once. A10:A20 refers to the range in column A, rows 10 through 20. A10:E20 refers to the range in columns A through E, rows 10 through 20. If delivery times sit in column C, rows 2 through 21, then C2:C21 covers every delivery time in that batch.",
              "lineage": {
                "concept_ids": [
                  "spreadsheet.cell_references_ranges"
                ],
                "fact_ids": [
                  "spreadsheet.cell_references_ranges#f3"
                ],
                "teaching_block_ids": [
                  "spreadsheet.cell_references_ranges#tb3"
                ]
              }
            },
            {
              "type": "spreadsheet_grid",
              "block_id": "tile_spreadsheet_grid_references.s05.b4",
              "asset_ref": {
                "asset_id": "asset_orders_clean"
              },
              "range": "A1:E21",
              "selection": "A10:E20",
              "annotations": [
                {
                  "target": "A10:E20",
                  "text": "Rectangular range A10:E20 — rows 10 through 20, columns A through E"
                }
              ],
              "lineage": {
