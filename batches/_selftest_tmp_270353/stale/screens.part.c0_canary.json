            ]
          }
        },
        {
          "step_id": "tile_spreadsheet_grid_references.s06",
          "type": "explainer",
          "concept_ids": [
            "spreadsheet.cell_references_ranges"
          ],
          "eyebrow": "Cell References and Ranges",
          "title": "Referencing an entire row or column",
          "lede": "Use a repeated letter or number to select every cell in a column or row.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_spreadsheet_grid_references.s06.b1",
              "role": "mechanism",
              "text": "You can reference an entire row or column by repeating its letter or number on either side of a colon: 5:5 selects all cells in row 5, and H:H selects all cells in column H. If new orders keep being added to the Orders sheet and you want a reference that always covers the whole city column, B:B does that.",
              "lineage": {
                "concept_ids": [
                  "spreadsheet.cell_references_ranges"
                ],
                "fact_ids": [
                  "spreadsheet.cell_references_ranges#f4"
                ],
                "teaching_block_ids": [
                  "spreadsheet.cell_references_ranges#tb4"
                ]
              }
            }
          ],
          "reward": {
