  "steps": [
    {
      "step_id": "tile_spreadsheet_grid_references.s01",
      "type": "explainer",
      "concept_ids": [
        "spreadsheet.grid_model"
      ],
      "eyebrow": "The Spreadsheet Grid",
      "title": "Every cell has an address",
      "lede": "A spreadsheet is a grid of cells, each one named by its column letter and row number.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_spreadsheet_grid_references.s01.b1",
          "role": "intro",
          "text": "Open a new workbook and you already have structure before you type anything. Cells are grouped into rows and columns, forming a grid, and each cell can hold a number, text, or a formula. Think of it like a table where every slot has its own name.",
          "lineage": {
            "concept_ids": [
              "spreadsheet.grid_model"
            ],
            "fact_ids": [
              "spreadsheet.grid_model#f1"
            ],
            "teaching_block_ids": [
              "spreadsheet.grid_model#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_spreadsheet_grid_references.s01.b2",
          "role": "definition",
          "text": "Each cell's name is its address: the column letter followed by the row number. Excel uses the A1 reference style by default — columns are letters, rows are numbers. So the cell at the intersection of column B and row 2 is called B2. If you type a delivery city into the second row of the second column, you're typing into B2.",
          "lineage": {
            "concept_ids": [
              "spreadsheet.grid_model"
            ],
            "fact_ids": [
              "spreadsheet.grid_model#f2"
            ],
            "teaching_block_ids": [
