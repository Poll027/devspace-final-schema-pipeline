    {
      "step_id": "tile_spreadsheet_grid_references.s02",
      "type": "explainer",
      "concept_ids": [
        "spreadsheet.grid_model"
      ],
      "eyebrow": "The Spreadsheet Grid",
      "title": "One workbook, many sheets",
      "lede": "A workbook can hold multiple sheets, each with its own grid.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_spreadsheet_grid_references.s02.b1",
          "role": "mechanism",
          "text": "A workbook is not limited to one grid. It can contain multiple sheets — you can add as many as you need. By default Excel names them Sheet1, Sheet2, Sheet3 and so on; the name appears on the sheet tab at the bottom and can be renamed. A QuickDeliver workbook might start with Sheet1 for orders and Sheet2 for drivers, then you rename each tab to Orders and Drivers.",
          "lineage": {
            "concept_ids": [
              "spreadsheet.grid_model"
            ],
            "fact_ids": [
              "spreadsheet.grid_model#f3",
              "spreadsheet.grid_model#f4"
            ],
            "teaching_block_ids": [
              "spreadsheet.grid_model#tb3"
            ]
          }
        }
      ],
      "reward": {
        "gems": 5
      },
      "lineage": {
        "concept_ids": [
          "spreadsheet.grid_model"
        ],
        "fact_ids": [
          "spreadsheet.grid_model#f3",
          "spreadsheet.grid_model#f4"
        ],
        "teaching_block_ids": [
          "spreadsheet.grid_model#tb3"
        ]
      }
    },
    {
      "step_id": "tile_spreadsheet_grid_references.s03",
      "type": "check",
      "concept_ids": [
        "spreadsheet.grid_model"
      ],
      "eyebrow": "Quick Check",
      "title": "Cell address vs. cell contents",
      "lede": "Test your understanding of what a cell address is and what a cell can contain.",
      "reward": {
        "gems": 5,
        "first_try_bonus": 3
      },
      "lineage": {
        "concept_ids": [
          "spreadsheet.grid_model"
        ],
        "fact_ids": [
          "spreadsheet.grid_model#f1",
          "spreadsheet.grid_model#f2"
        ],
        "teaching_block_ids": [],
        "anchors": [
          "spreadsheet.grid_model#assessment:distinguish_cell_contents_and_address"
        ]
      },
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.tile_spreadsheet_grid_references.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": false,
        "measures": [
          {
            "concept_id": "spreadsheet.grid_model",
            "capability": "distinguish_cell_contents_and_address",
            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "anchors": [
          "spreadsheet.grid_model#assessment:distinguish_cell_contents_and_address"
        ],
        "public": {
          "prompt": "A cell in the Orders sheet displays the text \"Lagos\". Which of the following best describes the difference between the cell's address and its contents?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "The address is the column-letter/row-number label (e.g., B2) that identifies where the cell sits in the grid; the contents are the value stored inside it (e.g., \"Lagos\")."
            },
            {
              "option_id": "opt_b",
              "text": "The address is the value stored in the cell (e.g., \"Lagos\"); the column letter and row number are just display labels."
            },
            {
              "option_id": "opt_c",
              "text": "The address and the contents are the same thing — both refer to the text \"Lagos\" shown in the cell."
            },
            {
              "option_id": "opt_d",
              "text": "The address is the row number only (e.g., 2); the column letter is part of the contents."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_a"
          ],
          "option_feedback": {
            "opt_b": {
              "message": "That is reversed. The value \"Lagos\" is the cell's contents — what is stored inside it. The address is the column-letter/row-number label (like B2) that tells you where the cell lives in the grid."
            },
            "opt_c": {
              "message": "They are different things. The address (e.g., B2) is a fixed location label; the contents (e.g., \"Lagos\") are what you typed or calculated. You could change the contents without changing the address."
            },
            "opt_d": {
              "message": "A cell address includes both the column letter and the row number together (e.g., B2). Neither part alone is the address, and neither is part of the contents."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Exactly right. The address (B2) is the fixed grid location; the contents (\"Lagos\") are the value stored there. You can change the contents without changing the address."
          },
          "incorrect": {
            "message": "The address is the column-letter/row-number label that locates the cell in the grid (e.g., B2). The contents are the value stored inside that cell (e.g., \"Lagos\"). They are two separate things."
          },
          "hints": [
            "Think about what stays the same when you type something new into a cell — the location label or the value?",
            "In Excel, the Name Box (top-left) shows the address; the cell itself shows the contents."
          ],
          "remediation_step_id": "tile_spreadsheet_grid_references.r01"
        }
      }
    },
