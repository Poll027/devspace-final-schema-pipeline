        "public": {
          "prompt": "The QuickDeliver workbook has a sheet named Orders. In that sheet, column B holds the delivery city and row 2 holds the first order. Type a formula in cell A1 that returns the value stored at the intersection of column B and row 2.",
          "asset_ref": {
            "asset_id": "asset_orders_clean",
            "variant_id": null
          },
          "sheet_name": "Orders",
          "target_cell": "A1",
          "allowed_functions": []
        },
        "grading": {
          "expected_value": "Lagos",
          "reference_formula": "=B2",
          "must_use_functions": [],
          "forbid_hardcoded_values": true
        },
        "feedback": {
          "correct": {
            "message": "Correct! =B2 points at column B, row 2 — the first order's city in the Orders sheet. The address B2 is the column letter followed by the row number, exactly as the A1 reference style works."
          },
          "incorrect": {
            "message": "Remember: a cell address is the column letter followed by the row number. Column B, row 2 gives the address B2. Type =B2 to return the value stored there."
          },
          "hints": [
            "The column letter comes first, then the row number — no space between them.",
            "Start your formula with = so Excel knows it is a formula, not plain text."
          ],
          "remediation_step_id": "tile_spreadsheet_grid_references.r02"
        }
