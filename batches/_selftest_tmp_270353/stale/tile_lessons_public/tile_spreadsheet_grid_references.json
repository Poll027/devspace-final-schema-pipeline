        "public": {
          "prompt": "New delivery orders are added to the Orders sheet every day, so the city column keeps growing. Which reference covers every cell in column B, no matter how many rows are added?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "B:B"
            },
            {
              "option_id": "opt_b",
              "text": "B2:B51"
            },
            {
              "option_id": "opt_c",
              "text": "B1"
            },
            {
              "option_id": "opt_d",
              "text": "B:2"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_a"
          ],
          "option_feedback": {
            "opt_b": {
              "message": "B2:B51 covers only rows 2 through 51. If a 52nd order is added, that row is outside the range. A whole-column reference like B:B always covers every row, past and future."
            },
            "opt_c": {
