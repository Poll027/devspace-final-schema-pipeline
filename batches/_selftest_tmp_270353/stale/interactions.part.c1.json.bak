{
  "schema_version": "0.1.0",
  "kind": "interactions_part",
  "path_id": "data_analyst",
  "batch_id": "final_batch_011_da_spreadsheet",
  "tiles": [
    {
      "tile_id": "tile_spreadsheet_formula_syntax_refs",
      "interactions": [
        {
          "step_id": "tile_spreadsheet_formula_syntax_refs.s04",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_formula_syntax_refs.s04",
            "difficulty": "intro",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "identify_required_equal_sign_prefix",
                "fact_ids": [
                  "f1"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.formula_syntax#assessment:identify_required_equal_sign_prefix"
            ],
            "public": {
              "prompt": "You type the following into cell D4 of the Orders sheet: D2+D3\n\nWhat happens when you press Enter?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "Excel treats it as text and displays the string \"D2+D3\" in the cell."
                },
                {
                  "option_id": "opt_b",
                  "text": "Excel adds the values in D2 and D3 and shows the numeric result."
                },
                {
                  "option_id": "opt_c",
                  "text": "Excel shows a #NAME? error because the cell addresses are invalid."
                },
                {
                  "option_id": "opt_d",
                  "text": "Excel shows a #VALUE! error because + requires numbers."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "Without a leading = Excel does not evaluate the entry as a formula. It stores the literal text \"D2+D3\" instead of computing a sum."
                },
                "opt_c": {
                  "message": "#NAME? appears when Excel cannot recognise a name inside a formula. Here there is no formula at all \u2014 the entry has no = prefix, so Excel stores it as plain text."
                },
                "opt_d": {
                  "message": "#VALUE! occurs when a formula receives the wrong type of argument. But without a leading = there is no formula to evaluate, so no error is raised \u2014 the entry is stored as text."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! Without the = prefix Excel treats the entry as plain text and displays \"D2+D3\" literally. Every formula must start with = to tell Excel to compute a value."
              },
              "incorrect": {
                "message": "Formulas in Excel always begin with the equal sign (=). Without it, Excel treats the entry as plain text and displays it as-is, not as a computed result."
              },
              "hints": [
                "Think about what tells Excel that an entry is a formula rather than a label.",
                "Try typing just the letter A in a cell \u2014 Excel shows 'A', not an error."
              ],
              "remediation_step_id": "tile_spreadsheet_formula_syntax_refs.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_formula_syntax_refs.s05",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_formula_syntax_refs.s05",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "construct_function_call_formula_with_range",
                "fact_ids": [
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.formula_syntax#assessment:construct_function_call_formula_with_range"
            ],
            "public": {
              "prompt": "Which formula correctly sums the range D2:D21 on the Orders sheet?\n\nThe Orders sheet has 20 rows of data in rows 2\u201321. You want to add up all the values in the amount column (D2:D21) using the SUM function. Which formula is correctly structured?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=SUM(D2:D21)"
                },
                {
                  "option_id": "opt_b",
                  "text": "SUM(D2:D21)"
                },
                {
                  "option_id": "opt_c",
                  "text": "=SUM D2:D21"
                },
                {
                  "option_id": "opt_d",
                  "text": "=SUM(D2,D21)"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "This is missing the = prefix. Without it, Excel stores the entry as text rather than evaluating the SUM function."
                },
                "opt_c": {
                  "message": "The parentheses are required. The correct syntax is =SUM(range) \u2014 the opening parenthesis immediately follows the function name, and the range goes inside."
                },
                "opt_d": {
                  "message": "=SUM(D2,D21) adds only two individual cells: D2 and D21. To sum a continuous range of cells, use the colon notation: D2:D21."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =SUM(D2:D21) follows the required structure: = prefix, function name, opening parenthesis, the range D2:D21, closing parenthesis. This sums all 20 amount values."
              },
              "incorrect": {
                "message": "A function formula needs: = prefix, the function name, an opening parenthesis, the range argument, and a closing parenthesis \u2014 for example =SUM(D2:D21)."
              },
              "hints": [
                "Every formula starts with =. Then comes the function name, then the range inside parentheses.",
                "D2:D21 uses a colon to mean 'from D2 to D21'. A comma would list only two separate cells."
              ],
              "remediation_step_id": "tile_spreadsheet_formula_syntax_refs.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_formula_syntax_refs.s06",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_formula_syntax_refs.s06",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "apply_arithmetic_operators_in_formula",
                "fact_ids": [
                  "f2"
                ]
              },
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "build_cell_reference_formula_with_operator",
                "fact_ids": [
                  "f4"
                ]
              },
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "apply_operator_precedence_and_parentheses",
                "fact_ids": [
                  "f5"
                ]
              },
              {
                "concept_id": "spreadsheet.formula_syntax",
                "capability": "write_syntactically_correct_formula_for_given_computation",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f3",
                  "f4",
                  "f5"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.formula_syntax#practice",
              "spreadsheet.formula_syntax#assessment:apply_arithmetic_operators_in_formula",
              "spreadsheet.formula_syntax#assessment:build_cell_reference_formula_with_operator",
              "spreadsheet.formula_syntax#assessment:apply_operator_precedence_and_parentheses",
              "spreadsheet.formula_syntax#assessment:write_syntactically_correct_formula_for_given_computation"
            ],
            "public": {
              "prompt": "The **orders** sheet has order amounts in column D (rows 2\u201321). Row 2 (LG-2001) has amount **4500** and row 3 (LG-2002) has amount **7200**.\n\n**Task 1 \u2014 subtraction:** In cell E1, write a formula that subtracts the amount in D2 from the amount in D3 (D3 minus D2). The result should be **2700**.\n\n**Task 2 \u2014 operator precedence:** In cell E2, write a formula that first adds D2 and D3, then multiplies the sum by 2. Use parentheses to force the addition before the multiplication. The result should be **23400**.",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// The orders sheet has order amounts in column D.\n// D2 = 4500 (LG-2001), D3 = 7200 (LG-2002)\n\n// Task 1: In E1, write a formula that computes D3 minus D2.\n// Expected result: 2700\n\n// Task 2: In E2, write a formula that adds D2 and D3, then multiplies by 2.\n// Use parentheses so the addition happens before the multiplication.\n// Expected result: 23400\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "+ - * /",
                  "parentheses",
                  "relative cell references",
                  "numbers"
                ],
                "blocked_syntax": [
                  "SUM",
                  "IF",
                  "VLOOKUP"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "E1: =D3-D2\nE2: =(D2+D3)*2\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_subtraction_result",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "E1",
                    "expected": 2700.0
                  },
                  "visible": true,
                  "message_on_fail": "E1 should equal 2700 (D3 minus D2 = 7200 - 4500). Make sure your formula starts with = and uses the - operator between D3 and D2."
                },
                {
                  "test_id": "test_precedence_result",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "E2",
                    "expected": 23400.0
                  },
                  "visible": true,
                  "message_on_fail": "E2 should equal 23400 ((D2+D3)*2 = (4500+7200)*2 = 11700*2). Without parentheses, =D2+D3*2 gives 18600 because * is evaluated before +. Wrap the addition in parentheses: =(D2+D3)*2."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Well done! E1 uses = and the - operator to subtract D2 from D3, returning 2700. E2 uses parentheses to force the addition (D2+D3) before the multiplication by 2, returning 23400. Without parentheses, =D2+D3*2 would give 18600 because * has higher precedence than +."
              },
              "incorrect": {
                "message": "Check both cells. E1 needs =D3-D2 (the = prefix, then D3, then -, then D2). E2 needs parentheses around the addition: =(D2+D3)*2. Without parentheses, multiplication happens before addition and the result is wrong."
              },
              "hints": [
                "Every formula must start with =. Without it, Excel stores the entry as text.",
                "Parentheses change the order of operations: =(D2+D3)*2 adds first, then multiplies."
              ],
              "remediation_step_id": "tile_spreadsheet_formula_syntax_refs.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_formula_syntax_refs.s10",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_formula_syntax_refs.s10",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.relative_absolute_references",
                "capability": "construct_mixed_reference_locking_one_dimension",
                "fact_ids": [
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.relative_absolute_references#assessment:construct_mixed_reference_locking_one_dimension"
            ],
            "public": {
              "prompt": "You are building a multiplication table. Row 1 holds the column multipliers (B1, C1, D1, \u2026) and column A holds the row multipliers (A2, A3, A4, \u2026). You want to enter one formula in B2 and copy it across the entire table so that it always multiplies the correct row multiplier by the correct column multiplier.\n\nWhich formula should you enter in B2?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=$A2*B$1"
                },
                {
                  "option_id": "opt_b",
                  "text": "=$A$2*$B$1"
                },
                {
                  "option_id": "opt_c",
                  "text": "=A2*B1"
                },
                {
                  "option_id": "opt_d",
                  "text": "=$A$2*B1"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "$A$2 locks both the column and the row of the row multiplier. When you copy the formula down, the row part ($2) never changes, so every row in the table uses A2 instead of A3, A4, etc."
                },
                "opt_c": {
                  "message": "=A2*B1 uses fully relative references. When copied across columns, A2 shifts to B2, C2, etc., so the formula no longer reads from column A. When copied down, B1 shifts to B2, B3, etc., losing the header row."
                },
                "opt_d": {
                  "message": "$A$2 locks both dimensions of the row multiplier, so copying down always reads A2 instead of A3, A4, etc. You need $A2 (lock column A, let the row adjust) to keep the row multiplier in column A while allowing the row to change."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =$A2*B$1 uses two mixed references. $A2 locks column A so the row multiplier always comes from column A, while the row number adjusts as you copy down. B$1 locks row 1 so the column multiplier always comes from row 1, while the column letter adjusts as you copy across."
              },
              "incorrect": {
                "message": "A mixed reference locks one dimension and lets the other adjust. $A2 locks the column (A stays fixed) but lets the row change when copied down. B$1 locks the row (1 stays fixed) but lets the column change when copied across. Together, =$A2*B$1 fills the entire multiplication table correctly from one formula."
              },
              "hints": [
                "The $ sign locks the part that follows it: $A locks the column, $1 locks the row.",
                "Ask yourself: when I copy this formula down, which part must NOT change? When I copy across, which part must NOT change?"
              ],
              "remediation_step_id": "tile_spreadsheet_formula_syntax_refs.r03"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_formula_syntax_refs.s11",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_formula_syntax_refs.s11",
            "difficulty": "stretch",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.relative_absolute_references",
                "capability": "identify_relative_reference_adjustment_on_copy",
                "fact_ids": [
                  "f1"
                ]
              },
              {
                "concept_id": "spreadsheet.relative_absolute_references",
                "capability": "apply_absolute_reference_to_fix_cell_on_copy",
                "fact_ids": [
                  "f2"
                ]
              },
              {
                "concept_id": "spreadsheet.relative_absolute_references",
                "capability": "select_correct_reference_type_for_copy_scenario",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.relative_absolute_references#practice",
              "spreadsheet.relative_absolute_references#assessment:identify_relative_reference_adjustment_on_copy",
              "spreadsheet.relative_absolute_references#assessment:apply_absolute_reference_to_fix_cell_on_copy",
              "spreadsheet.relative_absolute_references#assessment:select_correct_reference_type_for_copy_scenario"
            ],
            "public": {
              "prompt": "The **orders** sheet has order amounts in column D (rows 2\u20134). Cell H1 holds the tax rate **0.075** (7.5%).\n\n**Task:** In cells E2, E3, and E4, write a formula that multiplies each row's amount (D2, D3, D4) by the shared tax rate in H1. Use an **absolute reference** for H1 so the tax-rate address does not change when the formula is copied down. Use a **relative reference** for the amount cell so it adjusts to the correct row.\n\n- E2 should equal **337.5** (4500 \u00d7 0.075)\n- E3 should equal **540** (7200 \u00d7 0.075)\n- E4 should equal **232.5** (3100 \u00d7 0.075)",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// H1 holds the shared tax rate.\nH1: 0.075\n\n// Task: In E2, write a formula that multiplies D2 by the tax rate in H1.\n// Use $H$1 (absolute) for the tax rate so it does not shift when copied.\n// Use D2 (relative) for the amount so it adjusts to D3, D4 when copied down.\n// Then write the same pattern in E3 and E4.\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "+ - * /",
                  "relative cell references",
                  "absolute references ($A$1)"
                ],
                "blocked_syntax": [
                  "SUM",
                  "IF",
                  "VLOOKUP"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "H1: 0.075\nE2: =D2*$H$1\nE3: =D3*$H$1\nE4: =D4*$H$1\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_e2_tax",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "E2",
                    "expected": 337.5,
                    "tolerance": 0.01
                  },
                  "visible": true,
                  "message_on_fail": "E2 should equal 337.5 (D2 \u00d7 H1 = 4500 \u00d7 0.075). Use =D2*$H$1 \u2014 the $ signs lock H1 so it does not shift when copied."
                },
                {
                  "test_id": "test_e3_tax",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "E3",
                    "expected": 540.0,
                    "tolerance": 0.01
                  },
                  "visible": true,
                  "message_on_fail": "E3 should equal 540 (D3 \u00d7 H1 = 7200 \u00d7 0.075). If you copied =D2*$H$1 down, D2 should have adjusted to D3 while $H$1 stayed fixed."
                },
                {
                  "test_id": "test_e4_tax",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "E4",
                    "expected": 232.5,
                    "tolerance": 0.01
                  },
                  "visible": true,
                  "message_on_fail": "E4 should equal 232.5 (D4 \u00d7 H1 = 3100 \u00d7 0.075). Check that E4 uses D4 (relative, adjusts per row) and $H$1 (absolute, stays fixed)."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Excellent! =D2*$H$1 uses a relative reference for D2 (it adjusts to D3, D4 as you copy down) and an absolute reference for $H$1 (the $ signs lock both the column H and row 1, so the tax-rate cell never shifts). This is the key pattern for applying a shared rate to a column of values."
              },
              "incorrect": {
                "message": "Use =D2*$H$1 in E2. The $ signs in $H$1 lock the tax-rate cell so it does not shift when the formula is copied. D2 has no $ signs, so it adjusts to D3 in E3 and D4 in E4. If you used =D2*H1 (no $), H1 would shift to H2, H3, etc. when copied down."
              },
              "hints": [
                "Add $ before both the column letter and the row number of H1 to lock it: $H$1.",
                "Leave D2 without $ signs so it automatically becomes D3 when you copy the formula to E3."
              ],
              "remediation_step_id": "tile_spreadsheet_formula_syntax_refs.r03"
            }
          }
        }
      ]
    },
    {
      "tile_id": "tile_spreadsheet_aggregation_logical",
      "interactions": [
        {
          "step_id": "tile_spreadsheet_aggregation_logical.s04",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_aggregation_logical.s04",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "select_correct_aggregation_function_for_a_summarization_requirement",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f3",
                  "f4"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.aggregation_functions#assessment:select_correct_aggregation_function_for_a_summarization_requirement"
            ],
            "public": {
              "prompt": "The Orders sheet has 20 rows. Column A holds order IDs (text like \"LG-2001\"), column C holds delivery_minutes (numbers for delivered orders, blank for pending/cancelled), and column D holds order amounts (all numbers).\n\nA manager asks: \"How many orders have a recorded delivery time?\" Which function should you use, and why?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "COUNT(C2:C21) \u2014 because COUNT counts only numeric cells and delivery_minutes is blank for undelivered orders."
                },
                {
                  "option_id": "opt_b",
                  "text": "COUNTA(C2:C21) \u2014 because COUNTA counts all non-empty cells, including text."
                },
                {
                  "option_id": "opt_c",
                  "text": "SUM(C2:C21) \u2014 because SUM adds up all the delivery times to give a total count."
                },
                {
                  "option_id": "opt_d",
                  "text": "AVERAGE(C2:C21) \u2014 because AVERAGE returns the number of values in the range."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "COUNTA counts any non-empty cell, including text. For delivery_minutes, all non-blank cells are numbers, so COUNTA and COUNT give the same result here. But COUNT is the precise choice: it counts only numeric cells, which is exactly what 'has a recorded delivery time' means."
                },
                "opt_c": {
                  "message": "SUM adds the values together and returns a total number of minutes, not a count of rows. To count how many rows have a value, use COUNT or COUNTA."
                },
                "opt_d": {
                  "message": "AVERAGE returns the arithmetic mean of the values, not the number of values. To count how many cells contain a number, use COUNT."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! COUNT(C2:C21) counts only the numeric cells in the delivery_minutes column. Blank cells (for pending/cancelled orders) are skipped, so the result equals the number of orders with a recorded delivery time."
              },
              "incorrect": {
                "message": "COUNT counts only numeric cells and ignores blanks, text, and logical values. Because delivery_minutes is blank for undelivered orders, COUNT(C2:C21) returns exactly the number of orders that have a recorded delivery time."
              },
              "hints": [
                "COUNT counts only numbers. COUNTA counts anything that is not empty. SUM adds values. AVERAGE computes a mean.",
                "Blank cells in delivery_minutes represent orders with no recorded time \u2014 COUNT skips them automatically."
              ],
              "remediation_step_id": "tile_spreadsheet_aggregation_logical.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_aggregation_logical.s05",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_aggregation_logical.s05",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "apply_counta_and_distinguish_from_count",
                "fact_ids": [
                  "f3",
                  "f4"
                ]
              },
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "choose_count_vs_counta_for_a_given_summarization_requirement",
                "fact_ids": [
                  "f3",
                  "f4"
                ]
              },
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "apply_sum_to_a_range",
                "fact_ids": [
                  "f1"
                ]
              },
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "apply_average_and_identify_ignored_values",
                "fact_ids": [
                  "f2"
                ]
              },
              {
                "concept_id": "spreadsheet.aggregation_functions",
                "capability": "apply_count_and_identify_what_is_excluded",
                "fact_ids": [
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.aggregation_functions#assessment:apply_counta_and_distinguish_from_count",
              "spreadsheet.aggregation_functions#assessment:choose_count_vs_counta_for_a_given_summarization_requirement",
              "spreadsheet.aggregation_functions#assessment:apply_sum_to_a_range",
              "spreadsheet.aggregation_functions#assessment:apply_average_and_identify_ignored_values",
              "spreadsheet.aggregation_functions#assessment:apply_count_and_identify_what_is_excluded"
            ],
            "public": {
              "prompt": "The **orders** sheet has 20 rows of data (rows 2\u201321). Column A holds order IDs \u2014 text values like \"LG-2001\". Column D holds order amounts \u2014 all numeric.\n\n**Task 1 \u2014 SUM:** In cell H1, write a formula using **SUM** that totals all amounts in D2:D21. Expected result: **99100**.\n\n**Task 2 \u2014 AVERAGE:** In cell H2, write a formula using **AVERAGE** that computes the mean amount in D2:D21. Expected result: **4955**.\n\n**Task 3 \u2014 COUNT:** In cell H3, write a formula using **COUNT** that counts numeric cells in A2:A21 (the order_id column). Because order IDs are text, COUNT returns **0**.\n\n**Task 4 \u2014 COUNTA:** In cell H4, write a formula using **COUNTA** that counts all non-empty cells in A2:A21. Because COUNTA counts any non-empty cell regardless of type, it returns **20**. This demonstrates why COUNTA > COUNT when a column contains text.",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// The orders sheet has order IDs in column A (text) and amounts in column D (numbers).\n// Data rows: 2\u201321 (20 rows).\n\n// Task 1: In H1, write a SUM formula for amounts D2:D21.\n// Expected result: 99100\n\n// Task 2: In H2, write an AVERAGE formula for amounts D2:D21.\n// Expected result: 4955\n\n// Task 3: In H3, write a COUNT formula for order IDs A2:A21.\n// COUNT counts only numeric cells \u2014 order IDs are text, so the result is 0.\n\n// Task 4: In H4, write a COUNTA formula for order IDs A2:A21.\n// COUNTA counts all non-empty cells regardless of type \u2014 result is 20.\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "SUM(range)",
                  "AVERAGE(range)",
                  "COUNT(range)",
                  "COUNTA(range)",
                  "relative cell references"
                ],
                "blocked_syntax": [
                  "IF",
                  "VLOOKUP",
                  "SUMIF",
                  "COUNTIF"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "H1: =SUM(D2:D21)\nH2: =AVERAGE(D2:D21)\nH3: =COUNT(A2:A21)\nH4: =COUNTA(A2:A21)\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_h1_sum",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "H1",
                    "expected": 99100
                  },
                  "visible": true,
                  "message_on_fail": "H1 should equal 99100. Use =SUM(D2:D21) to total all 20 order amounts."
                },
                {
                  "test_id": "test_h2_average",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "H2",
                    "expected": 4955,
                    "tolerance": 0.01
                  },
                  "visible": true,
                  "message_on_fail": "H2 should equal 4955. Use =AVERAGE(D2:D21) to compute the mean of the 20 amounts."
                },
                {
                  "test_id": "test_h3_count",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "H3",
                    "expected": 0
                  },
                  "visible": true,
                  "message_on_fail": "H3 should equal 0. COUNT(A2:A21) returns 0 because order IDs are text \u2014 COUNT counts only numeric cells."
                },
                {
                  "test_id": "test_h4_counta",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "H4",
                    "expected": 20
                  },
                  "visible": true,
                  "message_on_fail": "H4 should equal 20. COUNTA(A2:A21) counts all 20 non-empty cells regardless of type."
                },
                {
                  "test_id": "test_h1_uses_sum",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "H1",
                    "functions": [
                      "SUM"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "H1 must contain a SUM formula."
                },
                {
                  "test_id": "test_h2_uses_average",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "H2",
                    "functions": [
                      "AVERAGE"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "H2 must contain an AVERAGE formula."
                },
                {
                  "test_id": "test_h3_uses_count",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "H3",
                    "functions": [
                      "COUNT"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "H3 must contain a COUNT formula."
                },
                {
                  "test_id": "test_h4_uses_counta",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "H4",
                    "functions": [
                      "COUNTA"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "H4 must contain a COUNTA formula."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Excellent! All four formulas are correct. =SUM(D2:D21) totals the amounts (99100). =AVERAGE(D2:D21) computes the mean (4955). =COUNT(A2:A21) returns 0 because COUNT ignores text \u2014 order IDs are text strings. =COUNTA(A2:A21) returns 20 because COUNTA counts any non-empty cell regardless of type. The difference (COUNTA=20, COUNT=0) shows that COUNTA is higher by the number of non-numeric non-blank cells."
              },
              "incorrect": {
                "message": "Check each formula: H1: =SUM(D2:D21) totals amounts. H2: =AVERAGE(D2:D21) computes the mean. H3: =COUNT(A2:A21) counts only numeric cells (returns 0 for text order IDs). H4: =COUNTA(A2:A21) counts all non-empty cells (returns 20 including text)."
              },
              "hints": [
                "SUM and AVERAGE work on numeric ranges. COUNT counts only numbers. COUNTA counts any non-empty cell.",
                "Apply COUNT and COUNTA to the same column (A2:A21) to see the difference: COUNT returns 0 (text), COUNTA returns 20 (non-empty)."
              ],
              "remediation_step_id": "tile_spreadsheet_aggregation_logical.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_aggregation_logical.s09",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_aggregation_logical.s09",
            "difficulty": "intro",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.logical_functions",
                "capability": "write_basic_if_formula_with_quoted_text",
                "fact_ids": [
                  "f1",
                  "f5"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.logical_functions#assessment:write_basic_if_formula_with_quoted_text"
            ],
            "public": {
              "prompt": "Cell C2 holds a delivery time in minutes. You want a formula in F2 that displays \"Late\" if the delivery took more than 60 minutes, or \"On Time\" otherwise.\n\nWhich formula is correct?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=IF(C2>60,\"Late\",\"On Time\")"
                },
                {
                  "option_id": "opt_b",
                  "text": "=IF(C2>60,Late,On Time)"
                },
                {
                  "option_id": "opt_c",
                  "text": "=IF(\"C2>60\",\"Late\",\"On Time\")"
                },
                {
                  "option_id": "opt_d",
                  "text": "=IF(C2>60,\"On Time\",\"Late\")"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "Text results in an IF formula must be enclosed in double quotation marks. Without quotes, Excel tries to interpret Late and On Time as cell names or named ranges and returns a #NAME? error."
                },
                "opt_c": {
                  "message": "The logical_test (C2>60) must not be in quotes. Putting it in quotes makes Excel treat it as a text string rather than evaluating it as a comparison, so the condition is never tested."
                },
                "opt_d": {
                  "message": "The arguments are in the wrong order. IF(logical_test, value_if_true, value_if_false): the second argument is returned when the condition is TRUE (C2>60), so \"Late\" must come second, not \"On Time\"."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =IF(C2>60,\"Late\",\"On Time\") tests whether C2 is greater than 60. If TRUE it returns the text \"Late\"; if FALSE it returns \"On Time\". Text values in formulas must always be wrapped in double quotation marks."
              },
              "incorrect": {
                "message": "The IF syntax is IF(logical_test, value_if_true, value_if_false). Text results must be in double quotes: \"Late\" and \"On Time\". The logical test (C2>60) must not be in quotes \u2014 it is a comparison, not text."
              },
              "hints": [
                "Text in a formula always goes inside double quotation marks, like \"Late\".",
                "The second argument of IF is what is returned when the condition is TRUE."
              ],
              "remediation_step_id": "tile_spreadsheet_aggregation_logical.r02"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_aggregation_logical.s10",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_aggregation_logical.s10",
            "difficulty": "stretch",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.logical_functions",
                "capability": "construct_nested_if_for_multi_band_classification",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f6"
                ]
              },
              {
                "concept_id": "spreadsheet.logical_functions",
                "capability": "use_and_as_if_logical_test_for_multiple_conditions",
                "fact_ids": [
                  "f3"
                ]
              },
              {
                "concept_id": "spreadsheet.logical_functions",
                "capability": "select_and_combine_if_and_or_for_given_decision_logic",
                "fact_ids": [
                  "f1",
                  "f3",
                  "f4",
                  "f5"
                ]
              },
              {
                "concept_id": "spreadsheet.logical_functions",
                "capability": "use_or_as_if_logical_test_for_any_condition",
                "fact_ids": [
                  "f4"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.logical_functions#practice",
              "spreadsheet.logical_functions#assessment:construct_nested_if_for_multi_band_classification",
              "spreadsheet.logical_functions#assessment:use_and_as_if_logical_test_for_multiple_conditions",
              "spreadsheet.logical_functions#assessment:use_or_as_if_logical_test_for_any_condition",
              "spreadsheet.logical_functions#assessment:select_and_combine_if_and_or_for_given_decision_logic"
            ],
            "public": {
              "prompt": "The **orders** sheet has delivery times in column C (rows 2\u20135). You need to classify each delivery into one of three bands:\n\n- **\"Late\"** if delivery_minutes > 60\n- **\"On Time\"** if delivery_minutes is between 30 and 60 (inclusive on both ends)\n- **\"Fast\"** if delivery_minutes < 30\n\n**Task 1 \u2014 nested IF with AND:** In cell F2, write a nested IF formula that classifies the delivery time in C2. Use **AND** as the logical_test of the inner IF to enforce both the lower bound (>=30) and the upper bound (<=60) of the \"On Time\" band. Then write the same formula in F3 and F4.\n\nExpected results:\n- F2: **\"Fast\"** (C2 = 28)\n- F3: **\"Fast\"** (C3 = 25)\n- F4: **\"On Time\"** (C4 = 56)\n\n**Task 2 \u2014 OR flag:** In cell F5, write an IF formula that returns **\"Extreme\"** if C5 is less than 20 **OR** greater than 70, and **\"Normal\"** otherwise. Use **OR** as the logical_test.\n\nExpected result:\n- F5: **\"Extreme\"** (C5 = 19)",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// The orders sheet has delivery_minutes in column C.\n// Input cells (typed constants - the gate will mutate these):\norders!C2: 28\norders!C3: 25\norders!C4: 56\norders!C5: 19\n\n// Task 1: In F2, write a nested IF formula that classifies C2 as:\n//   'Late'    if C2 > 60\n//   'On Time' if C2 >= 30 AND C2 <= 60  (use AND for both bounds)\n//   'Fast'    if C2 < 30\n// Then write the same pattern in F3 and F4.\n\n// Task 2: In F5, write an IF formula that returns 'Extreme' if\n//   C5 < 20 OR C5 > 70, and 'Normal' otherwise. Use OR.\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "IF(logical_test, value_if_true, value_if_false)",
                  "AND(condition1, condition2)",
                  "OR(condition1, condition2)",
                  "comparison operators",
                  "text in quotes",
                  "numbers",
                  "relative cell references"
                ],
                "blocked_syntax": [
                  "IFS",
                  "SWITCH",
                  "CHOOSE"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "// Input cells (typed constants):\norders!C2: 28\norders!C3: 25\norders!C4: 56\norders!C5: 19\n\n// Formula cells:\nF2: =IF(C2>60,\"Late\",IF(AND(C2>=30,C2<=60),\"On Time\",\"Fast\"))\nF3: =IF(C3>60,\"Late\",IF(AND(C3>=30,C3<=60),\"On Time\",\"Fast\"))\nF4: =IF(C4>60,\"Late\",IF(AND(C4>=30,C4<=60),\"On Time\",\"Fast\"))\nF5: =IF(OR(C5<20,C5>70),\"Extreme\",\"Normal\")\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_f2_fast",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "F2",
                    "expected": "Fast"
                  },
                  "visible": true,
                  "message_on_fail": "F2 should be \"Fast\" because C2=28 is less than 30. Check the order of your IF conditions: test >60 first, then AND(>=30,<=60), then the else is Fast."
                },
                {
                  "test_id": "test_f3_fast",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "F3",
                    "expected": "Fast"
                  },
                  "visible": true,
                  "message_on_fail": "F3 should be \"Fast\" because C3=25 is less than 30. Check the order of your IF conditions: test >60 first, then AND(>=30,<=60), then the else is Fast."
                },
                {
                  "test_id": "test_f4_on_time",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "F4",
                    "expected": "On Time"
                  },
                  "visible": true,
                  "message_on_fail": "F4 should be \"On Time\" because C4=56 is between 30 and 60. Use AND(C4>=30,C4<=60) as the logical_test of the inner IF."
                },
                {
                  "test_id": "test_f2_uses_if_and",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "F2",
                    "functions": [
                      "IF",
                      "AND"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "F2 must use both IF and AND. Use AND(C2>=30,C2<=60) as the logical_test of the inner IF to enforce both bounds of the 'On Time' band."
                },
                {
                  "test_id": "test_f5_extreme",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "F5",
                    "expected": "Extreme"
                  },
                  "visible": true,
                  "message_on_fail": "F5 should be \"Extreme\" because C5=19 is less than 20. Use =IF(OR(C5<20,C5>70),\"Extreme\",\"Normal\"). OR returns TRUE when any condition is met."
                },
                {
                  "test_id": "test_f5_uses_or",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "F5",
                    "functions": [
                      "IF",
                      "OR"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "F5 must use both IF and OR. Use OR(C5<20,C5>70) as the logical_test: OR returns TRUE when any one of its conditions is TRUE."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Well done! Your nested IF correctly classifies all three delivery times using AND for the On Time band. AND returns TRUE only when BOTH conditions are met. Your OR formula in F5 correctly flags C5=19 as Extreme because OR returns TRUE when ANY condition is met (19 < 20 is TRUE)."
              },
              "incorrect": {
                "message": "For F2\u2013F4: use =IF(C2>60,\"Late\",IF(AND(C2>=30,C2<=60),\"On Time\",\"Fast\")). AND requires BOTH bounds to be true. For F5: use =IF(OR(C5<20,C5>70),\"Extreme\",\"Normal\"). OR returns TRUE when ANY condition is true."
              },
              "hints": [
                "Start with the outer IF: =IF(C2>60,\"Late\", ...). Then nest another IF for the middle band.",
                "AND(C2>=30,C2<=60) returns TRUE only when C2 is at least 30 AND at most 60."
              ],
              "remediation_step_id": "tile_spreadsheet_aggregation_logical.r02"
            }
          }
        }
      ]
    },
    {
      "tile_id": "tile_spreadsheet_text_date_conditional_agg",
      "interactions": [
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s02",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s02",
            "difficulty": "intro",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.text_combining",
                "capability": "identify_concatenate_syntax_and_deprecation_caveat",
                "fact_ids": [
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.text_combining#assessment:identify_concatenate_syntax_and_deprecation_caveat"
            ],
            "public": {
              "prompt": "A colleague shares a workbook that uses =CONCATENATE(A2,\" \",B2) to join a first name and a last name. Which statement about CONCATENATE is accurate?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "CONCATENATE works but Microsoft recommends using CONCAT instead, as CONCATENATE may not be available in future versions of Excel."
                },
                {
                  "option_id": "opt_b",
                  "text": "CONCATENATE is the current recommended function and CONCAT is the deprecated one."
                },
                {
                  "option_id": "opt_c",
                  "text": "CONCATENATE automatically skips empty cells, so no ignore_empty argument is needed."
                },
                {
                  "option_id": "opt_d",
                  "text": "CONCATENATE can only join two text strings at a time."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "This is reversed. Microsoft recommends the newer CONCAT function and notes that CONCATENATE may not be available in future versions of Excel."
                },
                "opt_c": {
                  "message": "CONCATENATE does not skip empty cells \u2014 it joins them as blank values, which can produce unwanted extra spaces. TEXTJOIN with ignore_empty=TRUE is the function that skips empty cells."
                },
                "opt_d": {
                  "message": "CONCATENATE accepts multiple text arguments: CONCATENATE(text1, [text2], ...). It can join more than two strings in a single formula."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! CONCATENATE joins text strings and its syntax is CONCATENATE(text1, [text2], ...). However, Microsoft recommends using the newer CONCAT function instead, since CONCATENATE may not be available in future versions of Excel."
              },
              "incorrect": {
                "message": "CONCATENATE joins two or more text strings. Microsoft recommends using CONCAT instead, as CONCATENATE may not be available in future versions of Excel. Neither function automatically skips empty cells \u2014 use TEXTJOIN with ignore_empty=TRUE for that."
              },
              "hints": [
                "Think about which function Microsoft says is the newer, recommended replacement.",
                "TEXTJOIN is the function with the ignore_empty argument, not CONCATENATE."
              ]
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s03",
          "interaction": {
            "type": "formula_entry",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s03",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.text_combining",
                "capability": "build_combined_string_from_cells_with_delimiter",
                "fact_ids": [
                  "f1"
                ]
              },
              {
                "concept_id": "spreadsheet.text_combining",
                "capability": "apply_textjoin_with_ignore_empty",
                "fact_ids": [
                  "f1",
                  "f2"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.text_combining#practice",
              "spreadsheet.text_combining#assessment:build_combined_string_from_cells_with_delimiter",
              "spreadsheet.text_combining#assessment:apply_textjoin_with_ignore_empty"
            ],
            "public": {
              "prompt": "The Orders sheet has the delivery city in column B and the order status in column E. Row 2 has city **\"Lagos\"** and status **\"Delivered\"**.\n\nIn cell H2, write a TEXTJOIN formula that combines the city (B2) and status (E2) with the delimiter **\" | \"** (space-pipe-space) and sets ignore_empty to **TRUE**.\n\nThe expected result is **\"Lagos | Delivered\"**.",
              "asset_ref": {
                "asset_id": "asset_orders_clean",
                "variant_id": null
              },
              "target_cell": "H2",
              "allowed_functions": [
                "TEXTJOIN"
              ],
              "sheet_name": "orders"
            },
            "grading": {
              "expected_value": "Lagos | Delivered",
              "reference_formula": "=TEXTJOIN(\" | \",1,B2,E2)",
              "must_use_functions": [
                "TEXTJOIN"
              ],
              "forbid_hardcoded_values": true
            },
            "feedback": {
              "correct": {
                "message": "Correct! =TEXTJOIN(\" | \",1 (or TRUE()),B2,E2) joins B2 (\"Lagos\") and E2 (\"Delivered\") with the delimiter \" | \", returning \"Lagos | Delivered\". Setting ignore_empty to 1 (or TRUE()) means any blank cells in the argument list are skipped rather than producing an extra delimiter."
              },
              "incorrect": {
                "message": "Use =TEXTJOIN(\" | \",1 (or TRUE()),B2,E2). The first argument is the delimiter (\" | \"), the second is ignore_empty (1 (or TRUE())), and the remaining arguments are the cells to join (B2 and E2). Make sure the delimiter is in double quotes."
              },
              "hints": [
                "TEXTJOIN syntax: TEXTJOIN(delimiter, ignore_empty, text1, [text2], ...)",
                "The delimiter \" | \" includes spaces on both sides of the pipe character."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r01"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s05",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s05",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.text_extraction",
                "capability": "apply_mid_to_extract_characters_by_position",
                "fact_ids": [
                  "f3"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.text_extraction#assessment:apply_mid_to_extract_characters_by_position"
            ],
            "public": {
              "prompt": "Cell A2 contains the order ID **\"LG-2001\"**. You want to extract the 4-digit number starting at position 4 (the \"2001\" part).\n\nWhich formula correctly extracts exactly 4 characters starting at position 4?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=MID(A2,4,4)"
                },
                {
                  "option_id": "opt_b",
                  "text": "=MID(A2,4,3)"
                },
                {
                  "option_id": "opt_c",
                  "text": "=LEFT(A2,4)"
                },
                {
                  "option_id": "opt_d",
                  "text": "=MID(A2,3,4)"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "=MID(A2,4,3) starts at position 4 but extracts only 3 characters, returning \"200\" instead of \"2001\". The third argument of MID is the number of characters to extract."
                },
                "opt_c": {
                  "message": "=LEFT(A2,4) extracts the first 4 characters from the left, returning \"LG-2\" instead of \"2001\". LEFT always starts from the beginning of the string."
                },
                "opt_d": {
                  "message": "=MID(A2,3,4) starts at position 3, which is the \"-\" character in \"LG-2001\". This returns \"-200\" instead of \"2001\". The start position must be 4 to begin at the \"2\" character."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =MID(A2,4,4) starts at position 4 (the \"2\" in \"2001\") and extracts 4 characters, returning \"2001\". MID syntax: MID(text, start_num, num_chars)."
              },
              "incorrect": {
                "message": "MID(text, start_num, num_chars) extracts num_chars characters starting at start_num. In \"LG-2001\": position 1=L, 2=G, 3=-, 4=2, 5=0, 6=0, 7=1. To get \"2001\", start at position 4 and extract 4 characters: =MID(A2,4,4)."
              },
              "hints": [
                "Count the characters in \"LG-2001\": L=1, G=2, -=3, 2=4, 0=5, 0=6, 1=7.",
                "MID's third argument is how many characters to return, not the end position."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r02"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s06",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s06",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.text_extraction",
                "capability": "select_correct_extraction_function_for_given_text_task",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f3",
                  "f4"
                ]
              },
              {
                "concept_id": "spreadsheet.text_extraction",
                "capability": "apply_trim_to_remove_extraneous_whitespace",
                "fact_ids": [
                  "f4"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.text_extraction#assessment:select_correct_extraction_function_for_given_text_task",
              "spreadsheet.text_extraction#assessment:apply_trim_to_remove_extraneous_whitespace"
            ],
            "public": {
              "prompt": "A city name imported from an external system is stored in cell B2 as **\"  Lagos  \"** (with two leading spaces and two trailing spaces). You want to clean it so it reads **\"Lagos\"** with no extra spaces.\n\nWhich function should you use?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=TRIM(B2)"
                },
                {
                  "option_id": "opt_b",
                  "text": "=LEFT(B2,5)"
                },
                {
                  "option_id": "opt_c",
                  "text": "=MID(B2,3,5)"
                },
                {
                  "option_id": "opt_d",
                  "text": "=RIGHT(B2,5)"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "=LEFT(B2,5) extracts the first 5 characters from the left. Because the string starts with two spaces, LEFT(B2,5) returns \"  Lag\" \u2014 the spaces are included and the full city name is cut off."
                },
                "opt_c": {
                  "message": "=MID(B2,3,5) starts at position 3 (the first non-space character) and extracts 5 characters, returning \"Lagos\". This works for this specific string, but it relies on knowing exactly how many leading spaces there are. TRIM is the robust solution because it removes all leading and trailing spaces regardless of count."
                },
                "opt_d": {
                  "message": "=RIGHT(B2,5) extracts the last 5 characters. Because the string ends with two spaces, RIGHT(B2,5) returns \"gos  \" \u2014 the trailing spaces are included."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =TRIM(B2) removes all leading and trailing spaces from the text, returning \"Lagos\". TRIM also collapses multiple spaces between words to a single space, making it the standard tool for cleaning imported text."
              },
              "incorrect": {
                "message": "TRIM removes all spaces from a text value except for single spaces between words. It is the right tool when you need to clean leading or trailing spaces from imported data. LEFT, RIGHT, and MID extract characters by position \u2014 they do not remove spaces."
              },
              "hints": [
                "TRIM is designed specifically to remove leading and trailing spaces from text.",
                "LEFT and RIGHT extract characters from the start or end \u2014 they include any spaces that are there."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r02"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s07",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s07",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.text_extraction",
                "capability": "apply_right_to_extract_trailing_characters",
                "fact_ids": [
                  "f2"
                ]
              },
              {
                "concept_id": "spreadsheet.text_extraction",
                "capability": "apply_left_to_extract_leading_characters",
                "fact_ids": [
                  "f1"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.text_extraction#practice",
              "spreadsheet.text_extraction#assessment:apply_right_to_extract_trailing_characters",
              "spreadsheet.text_extraction#assessment:apply_left_to_extract_leading_characters"
            ],
            "public": {
              "prompt": "The **orders** sheet has order IDs in column A (e.g., **\"LG-2001\"**). Each order ID has a 2-letter prefix (\"LG\") followed by a hyphen and a 4-digit number.\n\n**Task 1 \u2014 RIGHT:** In cell H2, write a formula using **RIGHT** that extracts the last 4 characters of the order ID in A2 \u2014 the 4-digit number part. Expected result: **\"2001\"**.\n\n**Task 2 \u2014 LEFT:** In cell G2, write a formula using **LEFT** that extracts the first 2 characters of the order ID in A2 \u2014 the 2-letter prefix. Expected result: **\"LG\"**.",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// The orders sheet has order IDs in column A (e.g., 'LG-2001').\n// Each ID: 2-letter prefix + hyphen + 4-digit number (7 characters total).\n\n// Task 1: In H2, write a RIGHT formula that extracts the last 4 characters of A2.\n// Expected result: '2001'\n\n// Task 2: In G2, write a LEFT formula that extracts the first 2 characters of A2.\n// Expected result: 'LG'\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "LEFT(text, num_chars)",
                  "RIGHT(text, num_chars)",
                  "relative cell references",
                  "numbers"
                ],
                "blocked_syntax": [
                  "MID",
                  "TRIM",
                  "IF",
                  "VLOOKUP"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "H2: =RIGHT(A2,4)\nG2: =LEFT(A2,2)\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_h2_right",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "H2",
                    "expected": "2001"
                  },
                  "visible": true,
                  "message_on_fail": "H2 should equal \"2001\". Use =RIGHT(A2,4) \u2014 RIGHT extracts the last 4 characters of \"LG-2001\"."
                },
                {
                  "test_id": "test_g2_left",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "G2",
                    "expected": "LG"
                  },
                  "visible": true,
                  "message_on_fail": "G2 should equal \"LG\". Use =LEFT(A2,2) \u2014 LEFT extracts the first 2 characters of \"LG-2001\"."
                },
                {
                  "test_id": "test_h2_uses_right",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "H2",
                    "functions": [
                      "RIGHT"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "H2 must contain a RIGHT formula."
                },
                {
                  "test_id": "test_g2_uses_left",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "G2",
                    "functions": [
                      "LEFT"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "G2 must contain a LEFT formula."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Correct! =RIGHT(A2,4) extracts the last 4 characters of \"LG-2001\", returning \"2001\". =LEFT(A2,2) extracts the first 2 characters, returning \"LG\". RIGHT counts from the end of the string; LEFT counts from the beginning."
              },
              "incorrect": {
                "message": "Use =RIGHT(A2,4) in H2 to get the last 4 characters (\"2001\"), and =LEFT(A2,2) in G2 to get the first 2 characters (\"LG\"). RIGHT(text, num_chars) counts from the right end; LEFT(text, num_chars) counts from the left."
              },
              "hints": [
                "RIGHT(text, num_chars) extracts characters from the right end. \"LG-2001\" has 7 characters; the last 4 are \"2001\".",
                "LEFT(text, num_chars) extracts characters from the left end. The first 2 characters of \"LG-2001\" are \"LG\"."
              ]
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s09",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s09",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "select_correct_date_function_for_given_calculation_requirement",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f5"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.date_functions#assessment:select_correct_date_function_for_given_calculation_requirement"
            ],
            "public": {
              "prompt": "Cell G2 holds an order date. You want a formula that calculates how many **days** have elapsed between the order date in G2 and today's date.\n\nWhich formula uses **DATEDIF** to calculate how many days have elapsed between the order date in G2 and today's date?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=DATEDIF(G2,TODAY(),\"D\")"
                },
                {
                  "option_id": "opt_b",
                  "text": "=DATEDIF(TODAY(),G2,\"D\")"
                },
                {
                  "option_id": "opt_c",
                  "text": "=DATEDIF(G2,TODAY(),\"Y\")"
                },
                {
                  "option_id": "opt_d",
                  "text": "=TODAY()-G2"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "DATEDIF(start_date, end_date, unit): the start_date must come before the end_date. Putting TODAY() as the start_date and G2 as the end_date reverses the order \u2014 if G2 is in the past, this returns a negative number or an error."
                },
                "opt_c": {
                  "message": "The unit \"Y\" returns the number of complete years, not days. To count days, use the unit \"D\"."
                },
                "opt_d": {
                  "message": "=TODAY()-G2 does return the number of days as a serial-number difference, and it works. However, the question asks for DATEDIF, which is the explicit function for date-difference calculations and makes the intent clearer. =DATEDIF(G2,TODAY(),\"D\") is the correct DATEDIF form."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =DATEDIF(G2,TODAY(),\"D\") computes the number of complete days between the order date (G2) and today. DATEDIF syntax: DATEDIF(start_date, end_date, unit). The unit \"D\" returns days; \"Y\" would return complete years."
              },
              "incorrect": {
                "message": "DATEDIF(start_date, end_date, unit) requires the earlier date as start_date and the later date as end_date. TODAY() supplies today's date as the end_date. The unit \"D\" returns the number of days in the period."
              },
              "hints": [
                "DATEDIF argument order: start_date first, end_date second. The order date (G2) is the start.",
                "The unit controls what is counted: \"D\" = days, \"Y\" = complete years."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r03"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s10",
          "interaction": {
            "type": "code_exercise",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s10",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "write_datedif_with_correct_arguments_and_unit",
                "fact_ids": [
                  "f2"
                ]
              },
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "construct_age_calculation_formula_using_datedif_and_today",
                "fact_ids": [
                  "f2",
                  "f3"
                ]
              },
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "explain_date_serial_number_model",
                "fact_ids": [
                  "f4"
                ]
              },
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "select_correct_date_function_for_given_calculation_requirement",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f5"
                ]
              },
              {
                "concept_id": "spreadsheet.date_functions",
                "capability": "write_today_function_with_correct_syntax",
                "fact_ids": [
                  "f1"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.date_functions#practice",
              "spreadsheet.date_functions#assessment:write_datedif_with_correct_arguments_and_unit",
              "spreadsheet.date_functions#assessment:construct_age_calculation_formula_using_datedif_and_today",
              "spreadsheet.date_functions#assessment:explain_date_serial_number_model",
              "spreadsheet.date_functions#assessment:select_correct_date_function_for_given_calculation_requirement",
              "spreadsheet.date_functions#assessment:write_today_function_with_correct_syntax"
            ],
            "public": {
              "prompt": "The **orders** sheet has order dates in column G (rows 2\u201321). The starter file provides the order-date serial numbers for rows 2 and 3 in cells G2 and G3 (both are **45355**, representing 2024-03-04), and a fixed reference date in H1 (**45361**, representing 2024-03-10).\n\n**Task 1 \u2014 days elapsed (fixed date):** In cell I2, write a DATEDIF formula that calculates the number of **days** (unit \"D\") between the order date in G2 and the reference date in H1. The result should be **6**.\n\n**Task 2 \u2014 days for row 3:** In cell I3, write the same DATEDIF formula for G3. The result should also be **6**.\n\n**Task 3 \u2014 age in years (TODAY):** In cell J2, write a formula using **DATEDIF** and **TODAY()** that calculates the number of complete **years** (unit \"Y\") between the order date in G2 and today's date. Use TODAY() as the end_date argument. This is the standard pattern for age calculations: =DATEDIF(G2,TODAY(),\"Y\").",
              "runtime": {
                "kind": "spreadsheet",
                "version": "3.4.0"
              },
              "workspace": {
                "files": [
                  {
                    "path": "book.sheet",
                    "role": "editable",
                    "language": "sheet",
                    "content": "// H1 holds the reference date as a serial number (45361 = 2024-03-10).\nH1: 45361\n// G2 and G3 hold order-date serial numbers (45355 = 2024-03-04).\nG2: 45355\nG3: 45355\n\n// Task 1: In I2, write a DATEDIF formula that returns the number of days\n// between the order date in G2 and the reference date in H1.\n// DATEDIF syntax: DATEDIF(start_date, end_date, unit)\n// Use unit \"D\" for days. Expected result: 6\n\n// Task 2: In I3, write the same DATEDIF formula for G3.\n// Expected result: 6\n"
                  }
                ],
                "entry": "book.sheet",
                "asset_mounts": [
                  {
                    "asset_id": "asset_orders_clean",
                    "mount_path": "orders.csv"
                  }
                ]
              },
              "constraints": {
                "allowed_syntax": [
                  "DATEDIF(start_date, end_date, unit)",
                  "TODAY()",
                  "relative cell references",
                  "text in quotes"
                ],
                "blocked_syntax": [
                  "NOW",
                  "DAYS"
                ]
              }
            },
            "grading": {
              "solution_files": [
                {
                  "path": "book.sheet",
                  "content": "H1: 45361\nG2: 45355\nG3: 45355\nI2: =DATEDIF(G2,H1,\"D\")\nI3: =DATEDIF(G3,H1,\"D\")\nJ2: =DATEDIF(G2,TODAY(),\"Y\")\n"
                }
              ],
              "tests": [
                {
                  "test_id": "test_i2_days",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "I2",
                    "expected": 6
                  },
                  "visible": true,
                  "message_on_fail": "I2 should equal 6 (days from 2024-03-04 to 2024-03-10). Use =DATEDIF(G2,H1,\"D\") \u2014 G2 is the start_date, H1 is the end_date, \"D\" counts days."
                },
                {
                  "test_id": "test_i3_days",
                  "kind": "cell_equals",
                  "spec": {
                    "cell": "I3",
                    "expected": 6
                  },
                  "visible": true,
                  "message_on_fail": "I3 should equal 6 (days from 2024-03-04 to 2024-03-10). Use =DATEDIF(G3,H1,\"D\") \u2014 same pattern as I2 but referencing G3."
                },
                {
                  "test_id": "test_i2_uses_datedif",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "I2",
                    "functions": [
                      "DATEDIF"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "I2 must contain a DATEDIF formula."
                },
                {
                  "test_id": "test_j2_uses_today_datedif",
                  "kind": "formula_uses",
                  "spec": {
                    "cell": "J2",
                    "functions": [
                      "DATEDIF",
                      "TODAY"
                    ]
                  },
                  "visible": true,
                  "message_on_fail": "J2 must contain a formula using both DATEDIF and TODAY(). Use =DATEDIF(G2,TODAY(),\"Y\") \u2014 TODAY() supplies the current date as the end_date, and \"Y\" returns complete years."
                }
              ]
            },
            "feedback": {
              "correct": {
                "message": "Well done! =DATEDIF(G2,H1,\"D\") correctly places the earlier date (G2) as start_date and the later date (H1) as end_date, with unit \"D\" for days. =DATEDIF(G2,TODAY(),\"Y\") uses TODAY() as the end_date to compute the age in complete years \u2014 TODAY() returns today's date as a serial number, and \"Y\" counts complete years. Excel stores dates as serial numbers, so DATEDIF can subtract them to count days or years."
              },
              "incorrect": {
                "message": "For Tasks 1 and 2: Use =DATEDIF(G2,H1,\"D\") and =DATEDIF(G3,H1,\"D\"). The argument order is: start_date (earlier date), end_date (later date), unit (\"D\" for days). For Task 3: Use =DATEDIF(G2,TODAY(),\"Y\") \u2014 TODAY() supplies today's date as the end_date, and \"Y\" returns the number of complete years."
              },
              "hints": [
                "DATEDIF(start_date, end_date, unit): the earlier date goes first.",
                "The unit \"D\" counts days. Use \"Y\" for complete years, \"M\" for complete months."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r03"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s15",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s15",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.conditional_aggregation",
                "capability": "write_single_condition_countif_sumif",
                "fact_ids": [
                  "f1",
                  "f3"
                ]
              },
              {
                "concept_id": "spreadsheet.conditional_aggregation",
                "capability": "write_multi_condition_countifs_sumifs",
                "fact_ids": [
                  "f2",
                  "f4"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.conditional_aggregation#assessment:write_single_condition_countif_sumif",
              "spreadsheet.conditional_aggregation#assessment:write_multi_condition_countifs_sumifs"
            ],
            "public": {
              "prompt": "The Orders sheet has city in column B (B2:B21), status in column E (E2:E21), and amount in column D (D2:D21).\n\nYou want the total amount for orders that are **both** from Lagos **and** have status Delivered. Which formula is correct?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=SUMIFS(D2:D21,B2:B21,\"Lagos\",E2:E21,\"Delivered\")"
                },
                {
                  "option_id": "opt_b",
                  "text": "=SUMIF(D2:D21,\"Lagos\",E2:E21,\"Delivered\")"
                },
                {
                  "option_id": "opt_c",
                  "text": "=SUMIFS(B2:B21,\"Lagos\",E2:E21,\"Delivered\",D2:D21)"
                },
                {
                  "option_id": "opt_d",
                  "text": "=SUMIF(B2:B21,\"Lagos\",D2:D21)+SUMIF(E2:E21,\"Delivered\",D2:D21)"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "SUMIF handles only one condition. Its syntax is SUMIF(range, criteria, [sum_range]) \u2014 it takes one criteria range and one criterion. To apply two conditions at once, use SUMIFS."
                },
                "opt_c": {
                  "message": "SUMIFS syntax is SUMIFS(sum_range, criteria_range1, criteria1, ...). The sum_range (D2:D21) must come first. This formula puts the criteria ranges first and the sum_range last, which is the SUMIF order, not SUMIFS."
                },
                "opt_d": {
                  "message": "Adding two SUMIF results double-counts orders that are both from Lagos AND Delivered. An order that meets both conditions is included in both SUMIF results, so the total is inflated. SUMIFS applies both conditions simultaneously to avoid double-counting."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =SUMIFS(D2:D21,B2:B21,\"Lagos\",E2:E21,\"Delivered\") sums the amounts in D2:D21 where the city is Lagos AND the status is Delivered. SUMIFS syntax: SUMIFS(sum_range, criteria_range1, criteria1, [criteria_range2, criteria2], ...)."
              },
              "incorrect": {
                "message": "SUMIFS(sum_range, criteria_range1, criteria1, criteria_range2, criteria2, ...) applies multiple conditions simultaneously. The sum_range (D2:D21) comes first, then each criteria_range/criteria pair. SUMIF handles only one condition."
              },
              "hints": [
                "SUMIFS (plural) handles multiple conditions; SUMIF (singular) handles one.",
                "In SUMIFS, the sum_range is the first argument, followed by criteria_range/criteria pairs."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r04"
            }
          }
        },
        {
          "step_id": "tile_spreadsheet_text_date_conditional_agg.s16",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_spreadsheet_text_date_conditional_agg.s16",
            "difficulty": "stretch",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "spreadsheet.conditional_aggregation",
                "capability": "use_same_range_twice_for_between_condition",
                "fact_ids": [
                  "f6"
                ]
              }
            ],
            "anchors": [
              "spreadsheet.conditional_aggregation#assessment:use_same_range_twice_for_between_condition"
            ],
            "public": {
              "prompt": "The Orders sheet has delivery times in column C (C2:C21). You want to count how many deliveries took between 30 and 60 minutes (inclusive).\n\nWhich formula correctly counts deliveries where delivery_minutes >= 30 AND <= 60?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "=COUNTIFS(C2:C21,\">=30\",C2:C21,\"<=60\")"
                },
                {
                  "option_id": "opt_b",
                  "text": "=COUNTIF(C2:C21,\">=30 AND <=60\")"
                },
                {
                  "option_id": "opt_c",
                  "text": "=COUNTIFS(C2:C21,\">=30 AND <=60\")"
                },
                {
                  "option_id": "opt_d",
                  "text": "=COUNTIF(C2:C21,\">=30\")+COUNTIF(C2:C21,\"<=60\")"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_b": {
                  "message": "COUNTIF does not support compound criteria like \">=30 AND <=60\" in a single criterion string. Each condition must be a separate criteria_range/criteria pair in COUNTIFS."
                },
                "opt_c": {
                  "message": "COUNTIFS does not support compound criteria in a single string. \">=30 AND <=60\" is not valid syntax. Use two separate criteria pairs: COUNTIFS(C2:C21,\">=30\",C2:C21,\"<=60\")."
                },
                "opt_d": {
                  "message": "This formula adds the count of deliveries >= 30 to the count of deliveries <= 60. Every delivery between 30 and 60 minutes is counted twice (once in each COUNTIF), so the result is inflated. COUNTIFS with two criteria counts each matching row exactly once."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct! =COUNTIFS(C2:C21,\">=30\",C2:C21,\"<=60\") uses the same range (C2:C21) twice \u2014 once with the lower bound (\">=30\") and once with the upper bound (\"<=60\"). COUNTIFS counts only rows where both conditions are met simultaneously."
              },
              "incorrect": {
                "message": "To test a range condition (between two values), list the same range twice in COUNTIFS: COUNTIFS(C2:C21,\">=30\",C2:C21,\"<=60\"). Each criteria_range/criteria pair adds another condition that must be met. COUNTIF cannot handle two conditions at once."
              },
              "hints": [
                "COUNTIFS allows you to use the same range more than once \u2014 once for each bound of the between condition.",
                "Criteria containing comparison operators like >= and <= must be in quotation marks."
              ],
              "remediation_step_id": "tile_spreadsheet_text_date_conditional_agg.r05"
            }
          }
        },
