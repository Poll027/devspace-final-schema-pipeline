            "feedback": {
              "correct": {
                "message": "Correct! =SUMIF(B2:B21,\"Lagos\",D2:D21) sums the amounts in D2:D21 where the corresponding city in B2:B21 equals \"Lagos\". The text criterion \"Lagos\" is enclosed in double quotation marks, as required for text and expression criteria."
              },
              "incorrect": {
                "message": "Use =SUMIF(B2:B21,\"Lagos\",D2:D21). SUMIF syntax: SUMIF(range, criteria, [sum_range]). The criteria \"Lagos\" is a text value and must be in double quotation marks. Without quotes, Excel returns a #NAME? or #VALUE! error."
              },
              "hints": [
                "SUMIF syntax: SUMIF(range, criteria, sum_range). The range is where you check the condition.",
                "Text criteria must be in double quotes: \"Lagos\". Number criteria do not need quotes."
