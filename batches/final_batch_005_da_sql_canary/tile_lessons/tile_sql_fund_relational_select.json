      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_relational_select.r01.b01",
          "role": "misconception",
          "text": "A poorly-formed table might mix customer details and order details in the same rows, or repeat the same customer row twice. A well-formed table has a unique name, no duplicate rows, and covers exactly one kind of thing — so customers and orders each get their own table in Greenleaf's database.",
          "lineage": {
