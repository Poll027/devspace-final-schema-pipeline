      "type": "check",
      "concept_ids": [
        "sql.relational_model"
      ],
      "eyebrow": "Quick check",
      "title": "Is this table well-formed?",
      "lede": "Apply the three properties of a well-formed table to a short scenario.",
      "reward": {
        "gems": 3,
        "first_try_bonus": 1
      },
      "lineage": {
        "concept_ids": [
          "sql.relational_model"
        ],
        "teaching_block_ids": [],
        "fact_ids": [
          "sql.relational_model#f3",
