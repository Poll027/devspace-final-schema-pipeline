      "interaction": {
        "type": "choice",
        "interaction_id": "ix.tile_sql_fund_relational_select.s03",
        "difficulty": "core",
        "grading_mode": "client",
        "standalone": false,
        "measures": [
          {
            "concept_id": "sql.relational_model",
            "capability": "judge_whether_a_table_design_is_well_formed",
            "fact_ids": [
              "f3",
              "f5"
            ]
          }
        ],
        "anchors": [
          "sql.relational_model#assessment:judge_whether_a_table_design_is_well_formed"
        ],
        "public": {
          "prompt": "A designer creates one table called 'shop_data' with columns: customer_name, customer_city, order_id, and product_name. Which statement best describes this design?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "It is well-formed because all the data is in one place."
            },
            {
              "option_id": "opt_b",
              "text": "It is not well-formed because it mixes two kinds of thing — customer details and order details — in one table."
            },
            {
              "option_id": "opt_c",
              "text": "It is not well-formed because the table name 'shop_data' is too short."
            },
            {
              "option_id": "opt_d",
              "text": "It is well-formed as long as no two rows are identical."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "Keeping all data in one table is not a sign of good design. A well-formed table covers one kind of thing only — mixing customer details and order details in the same rows creates a table that is not well-formed."
            },
            "opt_b": {
              "message": "Correct. A well-formed table should contain information about one kind of thing only. Mixing customer details (customer_name, customer_city) with order details (order_id, product_name) in one table violates that rule."
            },
            "opt_c": {
              "message": "Table name length is not a well-formedness rule. The problem here is that the table mixes two kinds of thing — customer details and order details — rather than keeping them in separate tables."
            },
            "opt_d": {
              "message": "Having no duplicate rows is one property of a well-formed table, but it is not sufficient on its own. This table also violates the rule that each table should contain information about one kind of thing only."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Exactly right. A well-formed table covers one kind of thing only. Mixing customer and order data in one table is a design flaw, regardless of whether rows are unique."
          },
          "incorrect": {
            "message": "A well-formed table must contain information about one kind of thing only — such as the Customer or the Order — rather than mixing unrelated things in one table."
          },
          "hints": [
            "Look at the column names. Do they all describe the same kind of thing?",
            "QuickDeliver keeps customers and orders in two separate tables for a reason."
          ],
          "remediation_step_id": "tile_sql_fund_relational_select.r01"
        }
      }
    },
