    {
      "step_id": "tile_sql_fund_relational_select.s07",
      "type": "explainer",
      "concept_ids": [
        "sql.select_fundamentals"
      ],
      "eyebrow": "SELECT Basics",
      "title": "SELECT * — all columns at once",
      "lede": "Writing * in the SELECT list is shorthand for every column of the selected rows.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_relational_select.s07.b01",
          "role": "example",
          "text": "Writing * in the SELECT list is shorthand for all columns of the selected rows — SELECT * FROM customers returns every column of every customer row without listing them one by one. When reading from more than one table, table_name.* narrows that to just one table's columns.",
          "lineage": {
            "concept_ids": [
              "sql.select_fundamentals"
            ],
            "teaching_block_ids": [
