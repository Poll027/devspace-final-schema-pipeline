    {
      "step_id": "tile_sql_fund_relational_select.s02",
      "type": "explainer",
      "concept_ids": [
        "sql.relational_model"
      ],
      "eyebrow": "Relational Model",
      "title": "What makes a table well-formed",
      "lede": "A well-formed table has a unique name, no duplicate rows, and covers exactly one kind of thing.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_relational_select.s02.b01",
          "role": "definition",
          "text": "A table has a name distinct from every other table in the database — 'customers' is not reused for anything else. It contains no duplicate rows, and the order its rows and columns happen to be listed in is not meaningful.",
          "lineage": {
            "concept_ids": [
              "sql.relational_model"
            ],
            "teaching_block_ids": [
              "sql.relational_model#tb3"
            ],
            "fact_ids": [
              "sql.relational_model#f3"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_fund_relational_select.s02.b02",
          "role": "practical_context",
          "text": "Each table should contain information about one kind of thing only — the Customer or the Order — rather than mixing unrelated things together. That is why Greenleaf keeps customer details and order details in two separate tables instead of one merged one.",
          "lineage": {
            "concept_ids": [
              "sql.relational_model"
            ],
            "teaching_block_ids": [
              "sql.relational_model#tb3"
            ],
            "fact_ids": [
              "sql.relational_model#f5"
            ]
          }
        }
      ],
      "reward": {
        "gems": 2
      },
      "lineage": {
        "concept_ids": [
          "sql.relational_model"
        ],
        "teaching_block_ids": [
          "sql.relational_model#tb3"
        ],
        "fact_ids": [
          "sql.relational_model#f3",
          "sql.relational_model#f5"
        ]
      }
    },
    {
