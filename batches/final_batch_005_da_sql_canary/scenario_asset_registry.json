      "variants": [
        {
          "variant_id": "ds_customers_messy",
          "derived_from": "ds_customers",
          "purpose": "find_issues practice: one inconsistent-casing city value and one duplicate row",
          "ops": [
            {
              "op": "set_cell",
              "where": {
                "customer_id": 1
              },
              "column": "city",
              "value": "lagos"
            },
            {
              "op": "duplicate_row",
              "where": {
                "customer_id": 4
              },
              "insert": "end"
            }
          ],
          "planted_issues": [
            {
              "issue_id": "issue_cust_city_casing",
              "kind": "inconsistent_category",
              "locations": [
                {
                  "where": {
                    "customer_id": 1
                  },
                  "column": "city"
                }
              ],
              "description": "City value 'lagos' uses lower-case while all other city values use title-case (e.g. 'Lagos').",
              "rule": {
                "column": "city",
                "op": "casing_differs_from_siblings"
              }
            },
            {
              "issue_id": "issue_cust_duplicate",
              "kind": "duplicate_row",
              "locations": [
                {
                  "where": {
                    "customer_id": 4
                  },
                  "occurrence": 1,
                  "column": "customer_id"
                }
              ],
              "description": "Customer 4 (Emeka Eze, Kano) appears twice \u2014 the second row is an exact duplicate."
            }
          ]
        }
      ],
      "provenance": "authored"
    },
