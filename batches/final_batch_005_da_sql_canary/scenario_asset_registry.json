          "variant_id": "ds_orders_messy",
          "derived_from": "ds_orders",
          "purpose": "find_issues practice: one impossible negative delivery time and one missing customer_id",
          "ops": [
            {
              "op": "set_cell",
              "where": {
                "order_id": 1006
              },
              "column": "delivery_time_minutes",
              "value": -5
