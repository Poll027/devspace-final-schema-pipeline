            {
              "op": "set_cell",
              "where": {
                "order_id": 1003
              },
              "column": "customer_id",
              "value": null
            }
          ],
          "planted_issues": [
            {
              "issue_id": "issue_ord_negative_delivery",
              "kind": "impossible_value",
              "locations": [
                {
                  "where": {
                    "order_id": 1006
                  },
                  "column": "delivery_time_minutes"
                }
              ],
              "description": "delivery_time_minutes is -5, which is impossible \u2014 delivery time cannot be negative.",
              "rule": {
                "column": "delivery_time_minutes",
                "op": "lt",
                "value": 0
              }
            },
            {
              "issue_id": "issue_ord_missing_customer",
              "kind": "missing_value",
              "locations": [
                {
                  "where": {
                    "order_id": 1003
                  },
                  "column": "customer_id"
                }
              ],
              "description": "customer_id is NULL for order 1003 \u2014 every order must reference a customer."
