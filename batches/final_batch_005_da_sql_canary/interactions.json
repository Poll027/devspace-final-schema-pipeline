      "tile_id": "tile_sql_fund_relational_select",
      "interactions": [
        {
          "step_id": "tile_sql_fund_relational_select.s03",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_sql_fund_relational_select.s03",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "sql.relational_model",
                "capability": "judge_whether_a_table_design_is_well_formed",
                "fact_ids": [
                  "f3",
                  "f5"
                ]
              }
            ],
            "anchors": [
              "sql.relational_model#assessment:judge_whether_a_table_design_is_well_formed"
            ],
            "public": {
              "prompt": "A designer creates one table called 'shop_data' with columns: customer_name, customer_city, order_id, and product_name. Which statement best describes this design?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "It is well-formed because all the data is in one place."
                },
                {
                  "option_id": "opt_b",
                  "text": "It is not well-formed because it mixes two kinds of thing \u2014 customer details and order details \u2014 in one table."
                },
                {
                  "option_id": "opt_c",
                  "text": "It is not well-formed because the table name 'shop_data' is too short."
                },
                {
                  "option_id": "opt_d",
                  "text": "It is well-formed as long as no two rows are identical."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_b"
              ],
              "option_feedback": {
                "opt_a": {
                  "message": "Keeping all data in one table is not a sign of good design. A well-formed table covers one kind of thing only \u2014 mixing customer details and order details in the same rows creates a table that is not well-formed."
                },
                "opt_b": {
                  "message": "Correct. A well-formed table should contain information about one kind of thing only. Mixing customer details (customer_name, customer_city) with order details (order_id, product_name) in one table violates that rule."
                },
                "opt_c": {
                  "message": "Table name length is not a well-formedness rule. The problem here is that the table mixes two kinds of thing \u2014 customer details and order details \u2014 rather than keeping them in separate tables."
                },
                "opt_d": {
                  "message": "Having no duplicate rows is one property of a well-formed table, but it is not sufficient on its own. This table also violates the rule that each table should contain information about one kind of thing only."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Exactly right. A well-formed table covers one kind of thing only. Mixing customer and order data in one table is a design flaw, regardless of whether rows are unique."
              },
              "incorrect": {
                "message": "A well-formed table must contain information about one kind of thing only \u2014 such as the Customer or the Order \u2014 rather than mixing unrelated things in one table."
              },
              "hints": [
                "Look at the column names. Do they all describe the same kind of thing?",
                "QuickDeliver keeps customers and orders in two separate tables for a reason."
              ],
              "remediation_step_id": "tile_sql_fund_relational_select.r01"
            }
          }
        },
        {
          "step_id": "tile_sql_fund_relational_select.s04",
          "interaction": {
            "type": "table_select",
            "interaction_id": "ix.tile_sql_fund_relational_select.s04",
            "difficulty": "intro",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "sql.relational_model",
                "capability": "identify_table_rows_columns_in_scenario",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f4"
                ]
              }
            ],
            "anchors": [
              "sql.relational_model#practice",
              "sql.relational_model#assessment:identify_table_rows_columns_in_scenario"
            ],
            "public": {
              "asset_ref": {
                "asset_id": "ds.customers",
                "variant_id": null,
                "columns": [
                  "customer_id",
                  "name",
                  "city"
                ],
                "max_rows": 4
              },
              "intro": "Use the customers table shown above to answer the questions below.",
              "tasks": [
                {
                  "task_id": "task_row",
                  "prompt": "Click the row (record/tuple) that represents the customer named Fatima Bello.",
                  "target_kind": "row"
                },
                {
                  "task_id": "task_col",
                  "prompt": "Click the column (field/attribute) that stores each customer's city.",
                  "target_kind": "column"
                }
              ]
            },
            "grading": {
              "answers": [
                {
                  "task_id": "task_row",
                  "row": {
                    "where": {
                      "customer_id": 3
                    },
                    "occurrence": 0
                  }
                },
                {
                  "task_id": "task_col",
                  "column": "city"
                }
              ],
              "task_feedback": {
                "task_row": {
                  "correct": "Right \u2014 row 3 is Fatima Bello's record. Each row in the customers table represents one customer (a record or tuple).",
                  "incorrect": "Not quite. Look for the row where the name column shows 'Fatima Bello'. Each row represents one customer."
                },
                "task_col": {
                  "correct": "Correct \u2014 'city' is the column (field/attribute) that stores each customer's city.",
                  "incorrect": "Not quite. A column (also called a field or attribute) holds one kind of value for every row. Which column header says 'city'?"
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Well done. Each row in a table represents one thing \u2014 here, one customer. Each column is an attribute of that thing, such as the city where the customer lives."
              },
              "incorrect": {
                "message": "Remember: a row (record/tuple) represents one group of related values \u2014 one customer. A column (field/attribute) holds one kind of value for every row."
              },
              "hints": [
                "A row runs across the table; a column runs down it.",
                "Find the row where the 'name' column reads 'Fatima Bello'."
              ],
              "remediation_step_id": "tile_sql_fund_relational_select.r02"
            }
          }
        },
        {
          "step_id": "tile_sql_fund_relational_select.s08",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_sql_fund_relational_select.s08",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "sql.select_fundamentals",
                "capability": "write_select_for_listed_columns",
                "fact_ids": [
                  "f1",
                  "f3"
                ]
              }
            ],
            "anchors": [
              "sql.select_fundamentals#assessment:write_select_for_listed_columns"
            ],
            "public": {
              "prompt": "Which SELECT statement returns only the name and city columns from the customers table?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "SELECT name, city FROM customers"
                },
                {
                  "option_id": "opt_b",
                  "text": "FROM customers SELECT name, city"
                },
                {
                  "option_id": "opt_c",
                  "text": "SELECT customers FROM name, city"
                },
                {
                  "option_id": "opt_d",
                  "text": "SELECT * FROM customers"
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_a": {
                  "message": "Correct. The SELECT list (name, city) specifies the output columns, and FROM customers names the table to read from."
                },
                "opt_b": {
                  "message": "The clause order is wrong. In SQL, SELECT always comes before FROM \u2014 the SELECT list specifies the output columns, and FROM names the table."
                },
                "opt_c": {
                  "message": "The table name belongs after FROM, not after SELECT. SELECT lists the column names; FROM names the table."
                },
                "opt_d": {
                  "message": "SELECT * returns every column, not just name and city. To return specific columns, list them by name in the SELECT list."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Correct. SELECT name, city FROM customers \u2014 the SELECT list names the columns to return, and FROM names the table to read from."
              },
              "incorrect": {
                "message": "The SELECT list (between SELECT and FROM) specifies which columns to return. The FROM clause names the table. The order is always SELECT ... FROM ..."
              },
              "hints": [
                "The SELECT list comes first, then FROM.",
                "To return specific columns, list their names after SELECT, separated by commas."
              ],
              "remediation_step_id": "tile_sql_fund_relational_select.r03"
            }
          }
        },
