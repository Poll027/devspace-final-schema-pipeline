    {
      "step_id": "tile_sql_fund_alias_distinct.r01",
      "type": "remediation",
      "concept_ids": [
        "sql.aliasing"
      ],
      "eyebrow": "Let's revisit",
      "title": "Alias assigned — must use the alias",
      "lede": "A contrast showing what happens when you mix the alias and the original name.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_alias_distinct.r01.b01",
          "role": "misconception",
          "text": "Once you write FROM orders AS o, the alias o is the only valid name for that table in the rest of the query — referencing orders again would be an error. Think of it as: the alias replaces the original name for the duration of the query, not just as an optional shortcut alongside it.",
          "lineage": {
            "concept_ids": [
              "sql.aliasing"
            ],
            "teaching_block_ids": [
