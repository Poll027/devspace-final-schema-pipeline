    {
      "step_id": "tile_sql_fund_alias_distinct.r02",
      "type": "remediation",
      "concept_ids": [
        "sql.distinct"
      ],
      "eyebrow": "Let's revisit",
      "title": "DISTINCT vs. ALL — the same column, two row counts",
      "lede": "See the difference in row count between SELECT city and SELECT DISTINCT city on the customers table.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_alias_distinct.r02.b01",
          "role": "misconception",
          "text": "SELECT city FROM customers returns one row per customer — 8 rows because there are 8 customers, even though only 3 cities appear. SELECT DISTINCT city FROM customers returns 3 rows — one per unique city. SELECT ALL (the default) keeps duplicates; DISTINCT removes them.",
          "lineage": {
            "concept_ids": [
              "sql.distinct"
