    {
      "step_id": "tile_sql_fund_alias_distinct.s05",
      "type": "explainer",
      "concept_ids": [
        "sql.distinct"
      ],
      "eyebrow": "DISTINCT",
      "title": "DISTINCT: one row per unique value",
      "lede": "Add DISTINCT after SELECT to collapse duplicate rows so each unique value appears exactly once.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_fund_alias_distinct.s05.b01",
          "role": "definition",
          "text": "SELECT DISTINCT removes duplicate rows from the result, keeping one row from each group of duplicates. SELECT DISTINCT city FROM customers returns each city exactly once, no matter how many customers share it. SELECT ALL — the default when DISTINCT is not written — keeps every row, duplicates included.",
          "lineage": {
            "concept_ids": [
              "sql.distinct"
            ],
            "teaching_block_ids": [
              "sql.distinct#tb1",
              "sql.distinct#tb2"
            ],
            "fact_ids": [
              "sql.distinct#f1",
              "sql.distinct#f2"
            ]
          }
        },
        {
          "type": "before_after",
          "block_id": "tile_sql_fund_alias_distinct.s05.b02",
          "before": {
            "type": "data_table",
            "asset_ref": {
              "asset_id": "ds_customers",
              "variant_id": null,
              "columns": [
                "city"
              ]
            },
            "caption": "SELECT city FROM customers — one row per customer (duplicates kept)"
          },
          "after": {
            "type": "data_table",
            "asset_ref": {
              "asset_id": "ds_customers",
              "variant_id": null,
              "columns": [
                "city"
              ],
              "max_rows": 3
            },
            "caption": "SELECT DISTINCT city FROM customers — one row per unique city"
          },
          "change_summary": "Adding DISTINCT collapses the 8 city rows to 3 unique cities (Lagos, Abuja, Kano).",
          "lineage": {
            "concept_ids": [
              "sql.distinct"
            ],
            "teaching_block_ids": [
