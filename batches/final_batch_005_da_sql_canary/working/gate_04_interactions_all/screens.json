                ]
              }
            },
            {
              "type": "up_next",
              "block_id": "tile_sql_fund_relational_select.s10.b02",
              "title": "Up next: Aliasing and DISTINCT",
              "text": "In the next tile you will give tables short temporary names with AS and use DISTINCT to list each unique city in the customers table exactly once."
            }
