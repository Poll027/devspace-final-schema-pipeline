    {
      "tile_id": "tile_sql_fund_alias_distinct",
      "title": "Aliasing and DISTINCT",
      "summary": "Covers table and column aliases for readability and DISTINCT for collapsing duplicate rows in query results.",
      "steps": [
        {
          "step_id": "tile_sql_fund_alias_distinct.s01",
          "type": "explainer",
          "concept_ids": [
            "sql.aliasing"
          ],
          "eyebrow": "Aliasing",
          "title": "Giving tables a short temporary name",
          "lede": "SQL lets you give a table a short alias for the current query so you don't have to type its full name every time.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_alias_distinct.s01.b01",
              "role": "intro",
              "text": "Typing orders or customers in full every time gets tedious, especially once a query refers to a table's columns repeatedly. SQL lets you give a table a short temporary name for the query instead.",
              "lineage": {
                "concept_ids": [
                  "sql.aliasing"
                ],
                "teaching_block_ids": [
                  "sql.aliasing#tb1"
                ],
                "fact_ids": [
                  "sql.aliasing#f1"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_sql_fund_alias_distinct.s01.b02",
              "role": "definition",
              "text": "A table alias is a temporary name given to a table reference, written FROM table_reference AS alias — AS is optional. FROM orders AS o gives the orders table the short name o for the rest of that query. Once assigned, the table must be referred to by its alias, not its original name — writing FROM orders AS o and then referencing orders again later would be an error.",
              "lineage": {
                "concept_ids": [
                  "sql.aliasing"
                ],
                "teaching_block_ids": [
                  "sql.aliasing#tb2"
                ],
                "fact_ids": [
                  "sql.aliasing#f1",
                  "sql.aliasing#f2"
                ]
              }
            },
            {
              "type": "code_walkthrough",
              "block_id": "tile_sql_fund_alias_distinct.s01.b03",
              "language": "sql",
              "code": "SELECT o.order_id,\n       o.delivery_time_minutes AS delivery_min\nFROM   orders AS o;",
              "annotations": [
                {
                  "start_line": 1,
                  "end_line": 2,
                  "text": "o. qualifies each column with the alias — o is the alias for orders defined in FROM."
                },
                {
                  "start_line": 2,
                  "end_line": 2,
                  "text": "AS delivery_min renames the output column — same AS syntax as column aliasing."
                },
                {
                  "start_line": 3,
                  "end_line": 3,
                  "text": "FROM orders AS o — assigns the alias o to the orders table for this query."
                }
              ],
              "reveal": "line_by_line",
              "lineage": {
                "concept_ids": [
                  "sql.aliasing"
                ],
                "teaching_block_ids": [
                  "sql.aliasing#tb2"
                ],
                "fact_ids": [
                  "sql.aliasing#f1",
                  "sql.aliasing#f2"
                ],
                "anchors": [
                  "sql.aliasing#visual"
                ]
              }
            }
          ],
          "reward": {
            "gems": 2
          },
          "lineage": {
            "concept_ids": [
              "sql.aliasing"
            ],
            "teaching_block_ids": [
              "sql.aliasing#tb1",
              "sql.aliasing#tb2"
            ],
            "fact_ids": [
              "sql.aliasing#f1",
              "sql.aliasing#f2"
            ],
