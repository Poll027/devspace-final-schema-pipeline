      "remediation_steps": [
        {
          "step_id": "tile_sql_fund_relational_select.r01",
          "type": "remediation",
          "concept_ids": [
            "sql.relational_model"
          ],
          "eyebrow": "Let's revisit",
          "title": "Well-formed vs. poorly-formed tables — a contrast",
          "lede": "Compare two designs for the same data to see which properties matter.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_relational_select.r01.b01",
              "role": "misconception",
              "text": "A poorly-formed table might mix customer details and order details in the same rows, or repeat the same customer row twice. A well-formed table has a unique name, no duplicate rows, and covers exactly one kind of thing — so customers and orders each get their own table in Greenleaf's database.",
              "lineage": {
                "concept_ids": [
                  "sql.relational_model"
                ],
                "teaching_block_ids": [
                  "sql.relational_model#tb3"
                ],
                "fact_ids": [
                  "sql.relational_model#f3",
                  "sql.relational_model#f5"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.relational_model"
            ],
            "teaching_block_ids": [
              "sql.relational_model#tb3"
            ],
            "fact_ids": [
              "sql.relational_model#f3",
              "sql.relational_model#f5"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_relational_select.r02",
          "type": "remediation",
          "concept_ids": [
            "sql.select_fundamentals"
          ],
          "eyebrow": "Let's revisit",
          "title": "SELECT list vs. FROM clause — what each part does",
          "lede": "A quick contrast between the two required parts of every SELECT statement.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_relational_select.r02.b01",
              "role": "misconception",
              "text": "The FROM clause names the table to read — it does not choose columns. The SELECT list names the columns (or expressions) that appear in the output — it does not name the table. SELECT name, city FROM customers: the SELECT list picks two columns; FROM customers supplies all the rows.",
              "lineage": {
                "concept_ids": [
                  "sql.select_fundamentals"
                ],
                "teaching_block_ids": [
