        "public": {
          "prompt": "The orders table is aliased to o. Which SELECT clause correctly qualifies the delivery_time_minutes column with the alias and renames it to delivery_min?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "SELECT o.delivery_time_minutes AS delivery_min"
            },
            {
              "option_id": "opt_b",
              "text": "SELECT orders.delivery_time_minutes AS delivery_min"
            },
            {
              "option_id": "opt_c",
              "text": "SELECT delivery_time_minutes AS o.delivery_min"
            },
            {
              "option_id": "opt_d",
              "text": "SELECT o AS delivery_time_minutes.delivery_min"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_a"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "Correct. o.delivery_time_minutes qualifies the column with the alias, and AS delivery_min renames the output column."
            },
            "opt_b": {
              "message": "Once a table alias is assigned, the table must be referred to by its alias — not its original name — for the rest of that query. Use o.delivery_time_minutes, not orders.delivery_time_minutes."
            },
            "opt_c": {
              "message": "The alias goes before the dot, not after AS. The output column name (delivery_min) comes after AS, not after the dot. The correct form is o.delivery_time_minutes AS delivery_min."
            },
            "opt_d": {
              "message": "The syntax is wrong. The alias qualifies the column name with a dot (o.delivery_time_minutes), and AS renames the output column (AS delivery_min). They are separate parts of the expression."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. alias.column_name qualifies the reference, and AS output_name renames the result column. These are two separate things written together: o.delivery_time_minutes AS delivery_min."
          },
          "incorrect": {
            "message": "Use the alias (not the original table name) before the dot to qualify the column. Then write AS and the new output name after the column expression."
          },
          "hints": [
            "The alias replaces the table name: write o.delivery_time_minutes, not orders.delivery_time_minutes.",
            "AS comes after the full column reference: o.delivery_time_minutes AS delivery_min."
          ],
          "remediation_step_id": "tile_sql_fund_alias_distinct.r01"
        }
      }
