          "security.safe_outbound_requests#f4"
        ],
        "anchors": [
          "security.safe_outbound_requests#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "For known destinations, map untrusted provider input to an allowed destination instead of accepting an arbitrary outbound URL.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "security.safe_outbound_requests"
            ],
            "teaching_block_ids": [
              "security.safe_outbound_requests#tb1",
              "security.safe_outbound_requests#tb2"
            ],
            "fact_ids": [
              "security.safe_outbound_requests#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "For public-only access, reject private, loopback, link-local and other non-public addresses, including IPv6 equivalents.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "security.safe_outbound_requests"
            ],
            "teaching_block_ids": [
              "security.safe_outbound_requests#tb3"
            ],
            "fact_ids": [
              "security.safe_outbound_requests#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Validate the resolved address actually used for the connection. Checking a hostname earlier is insufficient against a DNS rebinding gap.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "security.safe_outbound_requests"
            ],
            "teaching_block_ids": [
              "security.safe_outbound_requests#tb3"
            ],
            "fact_ids": [
              "security.safe_outbound_requests#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Disable automatic redirects or enforce the same destination checks on every redirect target. An allowed starting URL can redirect somewhere forbidden.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "security.safe_outbound_requests"
            ],
            "teaching_block_ids": [
              "security.safe_outbound_requests#tb3"
            ],
            "fact_ids": [
              "security.safe_outbound_requests#f4"
            ]
          }
        },
