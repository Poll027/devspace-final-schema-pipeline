      "practice_anchor": {
        "type": "field_selection",
        "objective": "Given a small table of delivery orders, mark which part answers each question: a whole row for one order, or a whole column for one attribute across all orders.",
        "success": "The learner picks a full row when asked about one delivery and a full column when asked about one kind of information across all deliveries, and names the table as the dataset."
      },
      "visual_anchor": {
