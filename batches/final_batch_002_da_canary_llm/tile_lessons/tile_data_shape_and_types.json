            "capability": "classify_variable_type",
            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "anchors": [
          "data.categorical_numeric_types#assessment:classify_variable_type"
        ],
        "public": {
          "prompt": "The driver column in the Kwik Courier table holds values like 'Emeka Obi' and 'Fatima Bello'. What type of variable is driver?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "Numerical — because drivers can be ranked by performance"
            },
            {
              "option_id": "opt_b",
              "text": "Categorical — because the values are labels for a group, not quantities"
            },
            {
              "option_id": "opt_c",
              "text": "Numerical — because each driver has a unique identifier"
            },
            {
              "option_id": "opt_d",
              "text": "Numerical — because the values can be sorted in alphabetical order"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "Ranking is a separate idea. The test for numerical is whether adding or subtracting the values produces a meaningful result — 'Emeka Obi' minus 'Fatima Bello' means nothing."
            },
            "opt_b": {
              "message": "Correct. Driver names are category labels — levels of the variable. There is nothing to add or subtract between them."
            },
            "opt_c": {
              "message": "Having a unique identifier does not make a variable numerical. The test is whether arithmetic on the values is meaningful, not whether values are unique."
            },
            "opt_d": {
              "message": "Sorting is not the test for numerical. The test is whether adding or subtracting values produces a meaningful result. Driver names can be sorted alphabetically, but that does not make them quantities — they are still category labels."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. A categorical variable's values are labels for groups — driver names are levels, not quantities."
          },
          "incorrect": {
            "message": "Not quite. Ask: would adding or subtracting two driver names produce a meaningful result? If not, the variable is categorical."
          },
          "hints": [
            "Apply the arithmetic test: does 'Emeka Obi' minus 'Fatima Bello' mean anything?",
            "A categorical variable's values are called levels — they name groups, not amounts."
          ],
