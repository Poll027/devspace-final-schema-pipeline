              "segment_id": "seg_mle.prediction_task_definition_zCu19zBMZXM_54_105",
              "video_id": "zCu19zBMZXM",
              "youtube_url": "https://www.youtube.com/watch?v=zCu19zBMZXM",
              "review_url": "https://www.youtube.com/watch?v=zCu19zBMZXM&t=54s",
              "start_seconds": 54,
              "end_seconds": 105,
              "label": "An order-level task with checkout-time inputs",
              "summary": "A task record connects the intended prediction to the examples needed to support it. Here, each example represents one order. The speaker describes two possible targets: minutes from checkout to arrival, and whether arrival occurs after the delivery promise fixed at checkout. Predictions are made at checkout, so later dispatch information, the courier’s route and actual delivery cannot be inputs. The record also identifies the business decision the prediction supports, such as setting a delivery promise or offering an express upgrade, and whether the intended population includes future orders, unseen customers or both.",
              "fact_ids": [
                "f1",
                "f2"
              ],
              "transcript_ref": "zCu19zBMZXM:54-105"
            }
          ],
          "group_title": "Define the task and its prediction-time inputs",
          "bridge": {
            "before": "Watch how one order, its target and checkout-time inputs form a task record, called a “contract” here. The clip’s lateness target uses a checkout promise; our example uses 30 minutes after acceptance.",
            "after": "The clip establishes the prediction-time input boundary but supplies neither outcome-proportion calculations nor an explicit observation horizon. The text supplies both, including the full-population and zone-specific denominators."
          },
          "default_mode": "video"
        }
      ]
