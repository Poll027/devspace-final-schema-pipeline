      "blocks": [
        {
          "type": "prose",
          "text": "In this fictional task, the order at acceptance is the unit. The task record separates target, decision time, horizon and permitted inputs. Later arrival establishes the target but is excluded from acceptance-time inputs. Divide each outcome count by the total for its own declared population: all orders and the specified zone answer different questions. Changing the unit or horizon changes the task, not merely its implementation.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "mle.prediction_task_definition"
            ],
            "teaching_block_ids": [
              "mle.prediction_task_definition#tb4"
            ],
            "fact_ids": [
              "mle.prediction_task_definition#f1",
              "mle.prediction_task_definition#f2",
              "mle.prediction_task_definition#f3",
              "mle.prediction_task_definition#f4"
            ],
            "anchors": []
          }
        }
      ]
    },
