          "mle.prediction_task_definition#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "An operations team needs a delivery estimate at order acceptance. First define exactly what each prediction means and which inputs are available then.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "mle.prediction_task_definition"
            ],
            "teaching_block_ids": [
              "mle.prediction_task_definition#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Start with the inference you need and the example data that supports it. Use only inputs available when the prediction is made, not information arriving afterward. Empirical outcome proportion is outcome count divided by the specified population total. A conditional proportion uses only members of its stated group.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "mle.prediction_task_definition"
            ],
            "teaching_block_ids": [
              "mle.prediction_task_definition#tb2"
            ],
            "fact_ids": [
              "mle.prediction_task_definition#f1",
              "mle.prediction_task_definition#f2",
              "mle.prediction_task_definition#f3"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Specify one prediction unit, the target event or value, prediction time and judgement horizon so each example has an unambiguous target.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "mle.prediction_task_definition"
            ],
            "teaching_block_ids": [
              "mle.prediction_task_definition#tb3"
