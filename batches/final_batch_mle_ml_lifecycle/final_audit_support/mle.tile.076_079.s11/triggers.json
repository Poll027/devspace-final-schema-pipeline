{
  "repository_commit": {
    "id": "fixture-commit-trigger",
    "repository": "local_repo",
    "branch_filter": "^main$",
    "bindings": {
      "_SNAPSHOT": "snapshot_id"
    },
    "fixtures": [
      {
        "branch": "main",
        "snapshot_id": "valid"
      },
      {
        "branch": "main",
        "snapshot_id": "missing_required_feature"
      },
      {
        "branch": "other",
        "snapshot_id": "valid"
      }
    ]
  },
  "pubsub": {
    "id": "fixture-artifact-trigger",
    "topic": "projects/fixture-project/topics/artifacts",
    "bindings": {
      "_CASE": "case_id",
      "_ARTIFACT": "artifact_id"
    },
    "filters": {
      "event_type": "artifact_ready"
    },
    "fixtures": [
      {
        "event_type": "artifact_ready",
        "case_id": "accepted",
        "artifact_id": "A"
      },
      {
        "event_type": "artifact_ready",
        "case_id": "unauthorized",
        "artifact_id": "A"
      },
      {
        "event_type": "unrelated",
        "case_id": "accepted",
        "artifact_id": "A"
      }
    ]
  }
}
