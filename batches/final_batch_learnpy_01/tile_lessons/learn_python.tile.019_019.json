      "step_id": "learn_python.tile.019_019.s01",
      "type": "explainer",
      "concept_ids": [
        "python.import_statements"
      ],
      "title": "Import Statements",
      "lineage": {
        "teaching_block_ids": [
          "python.import_statements#tb1",
          "python.import_statements#tb2",
          "python.import_statements#tb3",
          "python.import_statements#tb4",
          "python.import_statements#tb5"
        ],
        "fact_ids": [
          "python.import_statements#f1",
          "python.import_statements#f2",
          "python.import_statements#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "python.import_statements#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Choose the name that gives access to the math operation.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "import module binds the module name. Access functionality with module.member.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb2"
            ],
            "fact_ids": [
              "python.import_statements#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "from module import member binds that member directly in the importing namespace.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb3"
            ],
            "fact_ids": [
              "python.import_statements#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "After import math, math.cos(value) accesses a math function.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb3"
            ],
            "fact_ids": [
              "python.import_statements#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Connect import math to math.cos, and from math import cos to the bare cos name. Both call forms access the same member; their name bindings differ.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb4"
            ],
            "fact_ids": [
              "python.import_statements#f1",
              "python.import_statements#f2",
              "python.import_statements#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "import math does not bind every member as a bare name. Use math.cos, or explicitly import cos before using that name.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb5"
            ],
            "fact_ids": [
              "python.import_statements#f1",
              "python.import_statements#f2"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "import math\nprint(math.cos(0))\nfrom math import cos\nprint(cos(0))",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 1,
              "text": "Bind the module name; the following call uses math.cos."
            },
            {
              "start_line": 3,
              "end_line": 3,
              "text": "Bind cos directly; the following call uses cos without the module prefix."
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "python.import_statements"
            ],
            "teaching_block_ids": [
              "python.import_statements#tb4"
            ],
            "fact_ids": [
              "python.import_statements#f1",
              "python.import_statements#f2",
              "python.import_statements#f3"
            ],
            "anchors": [
              "python.import_statements#visual"
            ]
          }
        }
      ]
    },
