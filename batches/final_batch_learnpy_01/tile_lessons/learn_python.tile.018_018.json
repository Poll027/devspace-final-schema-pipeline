        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Give unsuitable quantity text a defined recovery path.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Put the operation in an indented try: body; align except ExceptionType: with try and indent the recovery body.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb2"
            ],
            "fact_ids": [
              "python.error_handling#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A matching exception skips the rest of try and runs the handler. With no exception, the handler is skipped.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb3"
            ],
            "fact_ids": [
              "python.error_handling#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "An unmatched exception passes to an outer handler, or stops execution if no handler is found.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb3"
            ],
            "fact_ids": [
              "python.error_handling#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "except ValueError: handles an invalid numeric conversion from entered text.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb3"
            ],
            "fact_ids": [
              "python.error_handling#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Read the conversion before the multiplication. Invalid numeric text reaches the matching ValueError handler and skips the remaining try operations. Suitable numeric text takes the success path and skips that handler.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb4"
            ],
            "fact_ids": [
              "python.error_handling#f1",
              "python.error_handling#f2",
              "python.error_handling#f3",
              "python.error_handling#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Handling the failure does not make conversion succeed. The multiplication remaining in try is skipped after the conversion raises.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb5"
            ],
            "fact_ids": [
              "python.error_handling#f2",
              "python.error_handling#f3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "text = \"three\"\ntry:\n    quantity = int(text)\n    print(quantity * 4)\nexcept ValueError:\n    print(\"Enter a numeric quantity\")",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Begin the protected body."
            },
            {
              "start_line": 3,
              "end_line": 3,
              "text": "A conversion failure transfers control to a matching handler."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "This operation is skipped if the preceding conversion raises."
            },
            {
              "start_line": 5,
              "end_line": 5,
              "text": "The aligned handler matches invalid numeric conversion."
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "python.error_handling"
            ],
            "teaching_block_ids": [
              "python.error_handling#tb4"
            ],
            "fact_ids": [
              "python.error_handling#f1",
