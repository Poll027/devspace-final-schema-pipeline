      },
      "blocks": [
        {
          "type": "prose",
          "text": "Build a readable notebook-cost message from text and values.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Strings represent text; single or double quotes delimit their literals.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb2"
            ],
            "fact_ids": [
              "python.string_basics_formatting#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Prefix a literal with f and put expressions inside braces to insert their values: f\"{expression}\".",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb3"
            ],
            "fact_ids": [
              "python.string_basics_formatting#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A colon introduces a presentation specification. f\"{value:.2f}\" displays fixed-point form with two digits after the decimal point.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb3"
            ],
            "fact_ids": [
              "python.string_basics_formatting#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Separate the f prefix, literal text, braced expression and colon-led format specification. The expression supplies a value; .2f controls how that value appears in the message.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb4"
            ],
            "fact_ids": [
              "python.string_basics_formatting#f1",
              "python.string_basics_formatting#f2",
              "python.string_basics_formatting#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Two decimal digits describe the formatted text. Formatting does not change the underlying numeric calculation.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.string_basics_formatting"
            ],
            "teaching_block_ids": [
              "python.string_basics_formatting#tb5"
            ],
            "fact_ids": [
              "python.string_basics_formatting#f3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "quantity = 3\ncost = 13.5\nmessage = f\"The total is {quantity * cost:.2f}.\"\nprint(message)",
          "annotations": [
            {
              "start_line": 3,
              "end_line": 3,
              "text": "f enables insertion; braces hold the expression; :.2f sets fixed-point presentation."
            }
          ],
