      "blocks": [
        {
          "type": "prose",
          "text": "Choose one order-size response by testing conditions in order.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.conditional_statements"
            ],
            "teaching_block_ids": [
              "python.conditional_statements#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Write if condition: with an indented body. Align any elif condition: headers and the optional else: header with if; indent their bodies.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.conditional_statements"
            ],
            "teaching_block_ids": [
              "python.conditional_statements#tb2"
            ],
            "fact_ids": [
              "python.conditional_statements#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Test conditions in order. Execute the first true condition’s body; execute else only if none is true.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.conditional_statements"
            ],
            "teaching_block_ids": [
              "python.conditional_statements#tb3"
            ],
            "fact_ids": [
              "python.conditional_statements#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Read the size branches top to bottom. Stop at the first true condition; do not run another branch just because its test could also be true.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.conditional_statements"
            ],
            "teaching_block_ids": [
              "python.conditional_statements#tb4"
            ],
            "fact_ids": [
              "python.conditional_statements#f1",
              "python.conditional_statements#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "An elif chain chooses the first true branch, not every true branch. else is the fallback only when all tests fail.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.conditional_statements"
            ],
            "teaching_block_ids": [
              "python.conditional_statements#tb5"
            ],
            "fact_ids": [
              "python.conditional_statements#f2"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "quantity = 5\nif quantity >= 10:\n    print(\"Large\")\nelif quantity >= 3:\n    print(\"Medium\")\nelse:\n    print(\"Small\")",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Begin with the first condition."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "Test this only if the earlier condition was false."
            },
            {
              "start_line": 6,
              "end_line": 6,
              "text": "Use this body only when no condition was true."
            },
            {
              "start_line": 2,
              "end_line": 7,
              "text": "Boundary trace: quantity 12 or 10 selects Large; quantity 5 or 3 selects Medium; quantity 2 selects Small. At each input, only the first true branch runs."
            }
          ],
          "reveal": "line_by_line",
