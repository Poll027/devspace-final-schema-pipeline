      "blocks": [
        {
          "type": "prose",
          "text": "Keep asking for labels until the response reaches the stopping condition.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Write while condition: with an indented body. Test before each repetition; stop when the condition is false.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb2"
            ],
            "fact_ids": [
              "python.while_loops#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "If the initial condition is false, the body never runs.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb3"
            ],
            "fact_ids": [
              "python.while_loops#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Update values used by the condition inside the body so the loop can reach its stopping condition.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb3"
            ],
            "fact_ids": [
              "python.while_loops#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "input(prompt) displays a prompt and returns the entered line as text without its trailing newline. Assign another input result inside the loop to get a fresh response.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb3"
            ],
            "fact_ids": [
              "python.while_loops#f4"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "response = input(\"Enter a label, or done: \")\nwhile response != \"done\":\n    print(response)\n    response = input(\"Enter a label, or done: \")",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Test the response before entering or repeating the body."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "Get a new text response before the next test."
            },
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Trace A: the first response is red, so the condition is True and the body runs. The next response is done, so the next test is False and the loop stops. Trace B: the first response is done, so the body runs zero times."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "In Trace A, this repeated prompt obtains done and rebinds response before the next test."
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
