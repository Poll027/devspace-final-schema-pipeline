      "blocks": [
        {
          "type": "prose",
          "text": "The first input provides the response tested at entry. The input inside the body replaces it before the next test. A stopping response at the first prompt skips the body entirely.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb4"
            ],
            "fact_ids": [
              "python.while_loops#f1",
              "python.while_loops#f2",
              "python.while_loops#f3",
              "python.while_loops#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Testing before the body means zero repetitions are possible. Reusing the old response without updating it can keep the loop repeating.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.while_loops"
            ],
            "teaching_block_ids": [
              "python.while_loops#tb5"
            ],
            "fact_ids": [
              "python.while_loops#f1",
              "python.while_loops#f2",
              "python.while_loops#f3"
            ]
          }
        }
      ]
