      "blocks": [
        {
          "type": "prose",
          "text": "Read saved notebook orders with managed file opening.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "open(path, mode) returns a file object. r reads; w writes and replaces existing contents.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb2"
            ],
            "fact_ids": [
              "python.file_io#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "with open(path, mode) as f: uses an indented body and closes f after use.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb3"
            ],
            "fact_ids": [
              "python.file_io#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "f.read() reads remaining contents. f.write(text) writes text through a text-mode file object.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb3"
            ],
            "fact_ids": [
              "python.file_io#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Without managed opening, call f.close() when finished.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb3"
            ],
            "fact_ids": [
              "python.file_io#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Open CSV input with newline=\"\" for the reader.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb3"
            ],
            "fact_ids": [
              "python.file_io#f5"
            ]
          }
        },
        {
          "type": "prose",
          "text": "By default, csv.DictReader(f) uses the first row as dictionary keys, not a result row. list(csv.DictReader(f)) collects the row dictionaries.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.file_io"
            ],
            "teaching_block_ids": [
              "python.file_io#tb3"
            ],
            "fact_ids": [
              "python.file_io#f6"
            ]
          }
        },
        {
          "type": "data_table",
          "asset_ref": {
