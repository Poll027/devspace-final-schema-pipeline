              "python.file_io#f4",
              "python.file_io#f5",
              "python.file_io#f6"
            ]
          }
        },
        {
          "type": "prose",
          "text": "w replaces existing contents; it is not a reading mode. The CSV header supplies keys by default, rather than appearing as a returned data row.",
