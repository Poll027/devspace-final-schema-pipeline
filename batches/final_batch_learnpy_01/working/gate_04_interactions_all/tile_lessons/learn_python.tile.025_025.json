          "remediation_step_id": "learn_python.tile.025_025.r01"
        },
        "public": {
          "prompt": "Which group reads existing text, writes replacement text, and closes an unmanaged file, respectively?",
          "selection": "single",
          "shuffle": true,
          "options": [
            {
              "option_id": "a",
              "text": "open(path, \"r\") followed by f.read(); open(path, \"w\") followed by f.write(text); f.close()"
            },
            {
              "option_id": "b",
              "text": "open(path, \"w\") followed by f.read(); open(path, \"r\") followed by f.write(text); f.close()"
            },
            {
              "option_id": "c",
              "text": "f.write(text); f.read(); leave the unmanaged file open"
            }
          ]
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Mode \"r\" opens for reading with read(); mode \"w\" opens for replacement writing with write(text); close() releases the unmanaged file."
            },
            "b": {
              "message": "The modes are swapped: \"w\" is for writing, not read(), and \"r\" is for reading, not write(text). f.close() is the correct closure operation."
            },
            "c": {
              "message": "write(text) writes rather than reads, and read() reads rather than writes. An unmanaged file must be closed after use, not left open."
            }
          }
        }
      }
