        "public": {
          "prompt": "One application’s deployment frequency increased. With no other measures supplied, which interpretation respects the limits taught here?",
          "options": [
            {
              "option_id": "o1",
              "text": "This shows more frequent deployment, but cannot alone establish overall performance or rank individuals."
            },
            {
              "option_id": "o2",
              "text": "This alone proves lower change fail rate."
            },
            {
              "option_id": "o3",
              "text": "This alone establishes which individual is the best performer."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Interpret throughput and instability together over time and in application context."
            },
            "o2": {
              "message": "Deployment frequency and change fail rate measure different things."
            },
            "o3": {
              "message": "One measure is not a complete performance score or a basis for ranking individuals."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Keep the same application context and reporting periods when comparing throughput with instability."
          ],
          "remediation_step_id": "aws_devops.tile.010.r01"
        }
