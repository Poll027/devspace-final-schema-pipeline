          "text": "Deployment frequency measures how often changes are deployed; change lead time measures the elapsed time for a committed change to reach production.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb2",
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb4"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Change fail rate measures the proportion of deployments requiring intervention; failed deployment recovery time measures how long recovery from a failed deployment takes.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
