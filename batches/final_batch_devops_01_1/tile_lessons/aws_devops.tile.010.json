      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Read throughput and instability together before interpreting a delivery report.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Deployment frequency measures how often changes are deployed; change lead time measures the elapsed time for a committed change to reach production.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb2"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Change fail rate measures the proportion of deployments requiring intervention; failed deployment recovery time measures how long recovery from a failed deployment takes.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb3"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Compare throughput and instability measures together over time and within application context rather than using one measure to rank individuals.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb3"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "For the same application, more deployments and shorter commit-to-production time concern throughput. A greater proportion needing intervention concerns change fail rate; recovery duration supplies the other instability measure. Keep all four measures together across reporting periods, rather than ranking individuals by one improving measure.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb4"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f1",
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f2",
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Frequent delivery alone does not describe stability. Interpret the combined evidence within application context.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#tb5"
            ],
            "fact_ids": [
              "aws_devops.interpret_dora_delivery_and_recovery_evidence#f3"
            ]
          }
        },
