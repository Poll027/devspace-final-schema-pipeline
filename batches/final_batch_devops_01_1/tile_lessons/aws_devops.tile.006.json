      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Separate ordinary demand from the service requirement after a component fails.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Redundant components and multiple locations can keep a workload available when a component fails.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#tb2"
            ],
            "fact_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Capacity must accommodate workload demand; adding or removing resources helps match capacity to changing demand.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#tb3"
            ],
            "fact_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "For a component-failure constraint, evaluate independent redundant capacity rather than merely increasing the size of the same component.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
