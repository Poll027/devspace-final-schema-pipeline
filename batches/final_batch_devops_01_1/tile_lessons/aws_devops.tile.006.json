      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Both proposals have equal total capacity. Evaluate that capacity against ordinary demand, then evaluate independent surviving capacity against the post-loss service requirement. A larger single component can address demand without answering the failure requirement.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#tb4"
            ],
            "fact_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f1",
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f2",
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Increasing one component’s size is not independent redundancy. Ordinary capacity and post-loss capacity answer separate requirements.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#tb5"
            ],
            "fact_ids": [
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f1",
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f2",
              "aws_devops.distinguish_capacity_requirements_from_availability_requirements#f3"
            ]
          }
        }
      ]
