        "public": {
          "prompt": "Read this evidence from one supplied execution: YAML lists Build and Test; the same run’s logs show Build: success, Test: failure. What conclusion is supported?",
          "options": [
            {
              "option_id": "o1",
              "text": "Build and Test ran; Build succeeded and Test failed."
            },
            {
              "option_id": "o2",
              "text": "Both succeeded because both appear in YAML."
            },
            {
              "option_id": "o3",
              "text": "Test never ran because it failed."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The same execution’s step logs establish both execution and results."
            },
            "o2": {
              "message": "YAML defines steps; it does not prove they succeeded. The Test log says failure."
            },
            "o3": {
              "message": "A logged failure is evidence of a failed executed step, not proof that the step never ran."
            }
          }
        },
        "feedback": {
