      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare each recovery approach with both business limits in the table. Meeting restoration time while losing too much recent data fails the data-loss requirement. Recent data alone does not establish timely restoration. These are illustrative business limits, not recommended AWS defaults.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
            ],
            "teaching_block_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#tb4"
            ],
            "fact_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#f1",
              "aws_devops.define_recovery_time_and_recovery_point_objectives#f2",
              "aws_devops.define_recovery_time_and_recovery_point_objectives#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "RTO bounds restoration time; RPO bounds data loss measured in time. Neither substitutes for the other.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
