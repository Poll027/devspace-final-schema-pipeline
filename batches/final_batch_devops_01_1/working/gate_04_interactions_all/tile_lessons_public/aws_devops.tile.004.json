      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Name tolerated downtime and tolerated data loss separately; they are different business requirements.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
            ],
            "teaching_block_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Recovery time objective (RTO) is the maximum acceptable time to restore service after a disruption.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
            ],
            "teaching_block_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#tb2"
            ],
            "fact_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Recovery point objective (RPO) is the maximum acceptable data loss measured in time.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
            ],
            "teaching_block_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#tb3"
            ],
            "fact_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Set recovery objectives from business requirements and use them to choose recovery capabilities that meet the tolerated downtime and data loss.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives"
            ],
            "teaching_block_ids": [
              "aws_devops.define_recovery_time_and_recovery_point_objectives#tb3"
