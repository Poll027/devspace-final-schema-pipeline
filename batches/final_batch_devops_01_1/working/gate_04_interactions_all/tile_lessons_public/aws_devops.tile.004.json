        "public": {
          "prompt": "A business tolerates at most 30 minutes to restore service and at most 5 minutes of data loss. Which labels express these requirements?",
          "options": [
            {
              "option_id": "o1",
              "text": "RTO = 30 minutes; RPO = 5 minutes."
            },
            {
              "option_id": "o2",
              "text": "RTO = 5 minutes; RPO = 30 minutes."
            },
            {
              "option_id": "o3",
              "text": "RTO = 30 minutes; RPO = 30 minutes because recovery has one shared limit."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "RTO measures restoration time; RPO measures tolerated data loss in time."
            },
            "o2": {
              "message": "This reverses restoration tolerance and data-loss tolerance."
            },
            "o3": {
              "message": "The business supplied distinct downtime and data-loss limits."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Compare each recovery capability with the business limit for that same kind of time."
          ],
          "remediation_step_id": "aws_devops.tile.004.r01"
        }
      }
