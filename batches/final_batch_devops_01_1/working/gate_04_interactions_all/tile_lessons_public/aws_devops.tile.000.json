        "public": {
          "prompt": "The approved profile is lab-operator. Which command explicitly selects that named profile for the caller check?",
          "options": [
            {
              "option_id": "o1",
              "text": "aws sts get-caller-identity --profile lab-operator"
            },
            {
              "option_id": "o2",
              "text": "aws sts get-caller-identity --region lab-operator"
            },
            {
              "option_id": "o3",
              "text": "aws sts get-caller-identity"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "--profile selects the named credential and configuration group."
            },
            "o2": {
              "message": "--region selects a Region, not a named profile."
            },
            "o3": {
              "message": "This command does not explicitly select the supplied named profile."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Keep caller identity evidence separate from configuration evidence, and distinguish profile selection from Region selection."
          ],
          "remediation_step_id": "aws_devops.tile.000.r01"
        }
      }
