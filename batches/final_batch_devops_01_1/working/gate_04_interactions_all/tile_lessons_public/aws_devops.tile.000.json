    {
      "step_id": "aws_devops.tile.000.s01",
      "type": "explainer",
      "concept_ids": [
        "aws.operator_profiles"
      ],
      "title": "Check the operating model",
      "lineage": {
        "concept_ids": [
          "aws.operator_profiles"
        ],
        "teaching_block_ids": [
          "aws.operator_profiles#tb1",
          "aws.operator_profiles#tb2",
          "aws.operator_profiles#tb3"
        ],
        "fact_ids": [
          "aws.operator_profiles#f1",
          "aws.operator_profiles#f2",
          "aws.operator_profiles#f3"
        ],
        "anchors": [
          "aws.operator_profiles#visual"
        ]
      },
      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Make the sandbox context explicit before changing resources. A profile name starts the identity check; it does not replace it.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "A named AWS CLI profile groups credential and configuration settings; select it with --profile NAME.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb2"
            ],
            "fact_ids": [
              "aws.operator_profiles#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Run aws sts get-caller-identity --profile NAME to inspect the caller ARN and account ID.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb3"
            ],
            "fact_ids": [
              "aws.operator_profiles#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Run aws configure list --profile NAME to inspect the effective configuration and where its values came from; --region REGION overrides the configured Region for a command.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb3"
            ],
            "fact_ids": [
              "aws.operator_profiles#f3"
            ]
          }
        },
        {
          "type": "diagram",
          "diagram_kind": "layers",
          "title": "Illustrative operator-context checks",
          "nodes": [
            {
              "id": "n0",
              "label": "aws sts get-caller-identity --profile lab-operator",
              "fields": [
                "Account: [REDACTED_ACCOUNT]",
                "Arn: arn:aws:iam::[REDACTED_ACCOUNT]:user/[REDACTED_OPERATOR]"
              ]
            },
            {
              "id": "n1",
              "label": "aws configure list --profile lab-operator",
              "fields": [
