        "anchors": [
          "aws.operator_profiles#practice",
          "aws.operator_profiles#assessment:verify_caller_arn_and_account_id",
          "aws.operator_profiles#assessment:verify_effective_region_and_configuration_origin",
          "aws.operator_profiles#assessment:identify_command_region_override"
        ],
        "public": {
          "prompt": "Read each supplied operator-context review and decide whether its conclusion meets the stated check. Expected caller: Account: [REDACTED_ACCOUNT]\nArn: arn:aws:iam::[REDACTED_ACCOUNT]:user/[REDACTED_OPERATOR]; configured Region us-west-2; approved command target differs and is supplied as TARGET_REGION. Do not change credentials.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the supplied criterion"
            },
            {
              "bucket_id": "violates",
              "label": "Violates the supplied criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "aws sts get-caller-identity --profile lab-operator\nAccount: [REDACTED_ACCOUNT]\nArn: arn:aws:iam::[REDACTED_ACCOUNT]:user/[REDACTED_OPERATOR]\nReview: both returned values agree with the expected context."
            },
            {
              "item_id": "i2",
              "text": "aws configure list --profile lab-operator\nRegion Value: us-west-2; Type: config-file; Location: ~/.aws/config\nReview: configuration evidence identifies the effective Region and its origin."
            },
            {
              "item_id": "i3",
              "text": "Review: caller and configuration were checked first without changing credentials. The supplied sandbox command retains --profile lab-operator and adds --region TARGET_REGION for its differing approved target."
            },
            {
              "item_id": "i4",
              "text": "Review: the profile label alone confirms the expected ARN and account, so skip get-caller-identity."
            },
            {
              "item_id": "i5",
              "text": "Region Value: us-west-2; Type: config-file; Location: ~/.aws/config\nReview: because a Region is configured, ignore the different approved command target and omit --region."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "meets",
            "i3": "meets",
            "i4": "violates",
            "i5": "violates"
          },
          "item_feedback": {
            "i1": {
              "message": "Both caller ARN and account are compared, using the explicit profile."
            },
            "i2": {
              "message": "The Region row supplies value, type and location, not caller evidence."
            },
            "i3": {
              "message": "The explicit profile is retained and the differing command Region overrides configuration."
            },
            "i4": {
              "message": "A profile label is not caller evidence; returned ARN and account must be compared."
            },
            "i5": {
              "message": "The differing approved command target requires an explicit Region override, not ignoring the target."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Keep caller identity evidence separate from configuration evidence, and distinguish profile selection from Region selection."
          ],
          "remediation_step_id": "aws_devops.tile.000.r02"
        }
