          "aws.operator_profiles#f2",
          "aws.operator_profiles#f3"
        ],
        "anchors": []
      },
      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Select lab-operator explicitly with --profile. The illustrative caller check shows Account: [REDACTED_ACCOUNT] and Arn: arn:aws:iam::[REDACTED_ACCOUNT]:user/[REDACTED_OPERATOR]. Compare both with the supplied operator context.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb4"
            ],
            "fact_ids": [
              "aws.operator_profiles#f1",
              "aws.operator_profiles#f2",
              "aws.operator_profiles#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The illustrative configure list Region row shows us-west-2, Type config-file, Location ~/.aws/config. That evidence answers configuration and origin, not caller identity. A command's explicit --region option overrides this configured Region; keep the same explicit profile.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb4"
            ],
            "fact_ids": [
              "aws.operator_profiles#f1",
              "aws.operator_profiles#f2",
              "aws.operator_profiles#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A profile label is not caller evidence, and caller evidence is not a Region check.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws.operator_profiles"
            ],
            "teaching_block_ids": [
              "aws.operator_profiles#tb5"
            ],
            "fact_ids": [
              "aws.operator_profiles#f2",
              "aws.operator_profiles#f3"
            ]
          }
        }
