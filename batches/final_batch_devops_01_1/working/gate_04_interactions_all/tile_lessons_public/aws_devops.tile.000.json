    {
      "step_id": "aws_devops.tile.000.s02",
      "type": "explainer",
      "concept_ids": [
        "aws.operator_profiles"
      ],
      "title": "Read the sandbox case",
      "lineage": {
        "concept_ids": [
          "aws.operator_profiles"
