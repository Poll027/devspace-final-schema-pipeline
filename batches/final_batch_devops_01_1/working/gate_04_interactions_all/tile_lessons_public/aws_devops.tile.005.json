      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "The EC2 OS-update report concerns customer guest-OS work. The RDS parameter-check report concerns customer-controlled engine configuration values, not AWS-managed OS maintenance. Name that boundary in the handoff; customer data and access duties remain.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb4"
            ],
            "fact_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f1",
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f2",
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f3",
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "EC2 guest-OS patching is customer work; RDS OS maintenance is AWS work. RDS customer configuration and data duties remain.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb5"
            ],
            "fact_ids": [
