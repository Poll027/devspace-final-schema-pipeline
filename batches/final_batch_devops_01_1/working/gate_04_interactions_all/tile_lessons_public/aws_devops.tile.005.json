        ]
      },
      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Route the EC2 update and RDS parameter-check reports by the service boundary.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "With EC2, customers manage the guest operating system, including updates and security patches.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb2"
            ],
            "fact_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "With RDS, AWS manages database infrastructure and operating-system maintenance, while customers manage their data and application use.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb3"
            ],
            "fact_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Assign duties by the service boundary: AWS manages its infrastructure, while customers retain responsibilities for data, access and customer-controlled configuration.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb3"
            ],
            "fact_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Interpret the supplied EC2 OS-update report as customer guest-OS work and the supplied RDS parameter-check report as customer-controlled database configuration; RDS parameter groups contain database engine configuration values.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities"
            ],
            "teaching_block_ids": [
              "aws_devops.distinguish_aws_managed_and_customer_operational_responsibilities#tb3"
            ],
