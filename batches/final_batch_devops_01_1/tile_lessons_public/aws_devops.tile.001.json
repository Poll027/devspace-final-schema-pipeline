      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "The allocation worksheet places separate, nonintersecting subnets inside the VPC in different zones. Compare usable addresses, not total addresses, with the requirement. The overlapping candidate remains invalid even though it fits inside the VPC.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb4"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f1",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f2",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f3",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "VPC containment does not excuse overlap, and total addresses do not establish usable capacity. One subnet cannot span zones.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb5"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f1",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f2",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f3",
              "aws_devops.allocate_vpc_and_subnet_cidrs#f4"
            ]
          }
        }
      ]
