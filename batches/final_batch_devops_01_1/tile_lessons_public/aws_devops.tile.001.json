      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "For two Availability Zones, check both address fit and usable capacity. Complete the external IP-addressing and CIDR preparation first.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "An IPv4 subnet CIDR must be within its VPC CIDR and must not overlap another subnet in that VPC.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb2"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "IPv4 subnet sizes range from /16 to /28; AWS reserves the first four addresses and the last address of each subnet.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb3"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Choose subnet ranges inside the VPC that do not intersect, and allow for the five reserved addresses when checking usable capacity.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb3"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Each subnet resides entirely in one Availability Zone; create separate subnets for workloads in different Availability Zones.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs"
            ],
            "teaching_block_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#tb3"
            ],
            "fact_ids": [
              "aws_devops.allocate_vpc_and_subnet_cidrs#f4"
            ]
