      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare the object-read request with Action, Resource and Condition. An unmet condition or unmatched resource can leave no applicable allow: implicit deny. When an applicable Deny also covers the request, it overrides the Allow. The supplied table evaluates these identity-policy rules, not every AWS policy type.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
            "teaching_block_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#tb4"
            ],
            "fact_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#f1",
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#f2",
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "An Allow elsewhere does not allow this request. Scope and conditions must match; applicable explicit deny wins.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
            "teaching_block_ids": [
