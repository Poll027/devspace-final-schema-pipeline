      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Evaluate the requested action and resource, not whether the policy looks permissive. Complete the external access-control preparation first.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
            "teaching_block_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "An identity-based policy attaches to an identity and specifies permitted or denied actions on resources.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
            "teaching_block_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#tb2"
            ],
            "fact_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A statement uses Effect, Action and Resource, with optional Condition tests to scope when it applies.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
            "teaching_block_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#tb3"
            ],
            "fact_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "For a request, compare action, resource and condition values with applicable statements; explicit deny overrides an allow, and absent an applicable allow the request is implicitly denied.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation"
            ],
