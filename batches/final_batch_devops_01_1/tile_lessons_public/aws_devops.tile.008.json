      "eyebrow": "Review",
      "lede": "Read the supplied excerpts in this step and decide which conclusions are correct, defective or unsafe.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.008.s04",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation",
            "capability": "determine_request_outcome_under_supplied_identity_policy_conditions",
            "fact_ids": [
              "f1",
              "f2",
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#practice",
          "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#assessment:determine_request_outcome_under_supplied_identity_policy_conditions"
        ],
        "public": {
          "prompt": "Read this supplied identity policy and decide each request outcome. Scope: only these identity statements, with no other policies. Compare action, resource and both supplied principal-tag conditions; distinguish implicit from explicit denial.\nHere, the resource ending in `sandbox-orders/*` matches objects under `sandbox-orders/`. `StringEquals` requires the named principal-tag value to equal `yes`.\n```json\n{\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": \"arn:aws:s3:::sandbox-orders/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:PrincipalTag/approved\": \"yes\"\n        }\n      }\n    },\n    {\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": \"arn:aws:s3:::sandbox-orders/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:PrincipalTag/blocked\": \"yes\"\n        }\n      }\n    }\n  ]\n}\n```",
          "buckets": [
            {
              "bucket_id": "allow",
              "label": "Allow"
            },
            {
              "bucket_id": "implicit_deny",
              "label": "Implicit deny: no applicable allow"
            },
            {
              "bucket_id": "explicit_deny",
              "label": "Explicit deny overrides allow"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "{\n  \"request_id\": \"request.allowed\",\n  \"Action\": \"s3:GetObject\",\n  \"Resource\": \"arn:aws:s3:::sandbox-orders/order-a\",\n  \"principal_tags\": {\n    \"approved\": \"yes\",\n    \"blocked\": \"no\"\n  }\n}"
            },
            {
              "item_id": "i2",
              "text": "{\n  \"request_id\": \"request.condition\",\n  \"Action\": \"s3:GetObject\",\n  \"Resource\": \"arn:aws:s3:::sandbox-orders/order-a\",\n  \"principal_tags\": {\n    \"approved\": \"no\",\n    \"blocked\": \"no\"\n  }\n}"
            },
            {
              "item_id": "i3",
              "text": "{\n  \"request_id\": \"request.resource\",\n  \"Action\": \"s3:GetObject\",\n  \"Resource\": \"arn:aws:s3:::other-sandbox/order-a\",\n  \"principal_tags\": {\n    \"approved\": \"yes\",\n    \"blocked\": \"no\"\n  }\n}"
            },
            {
              "item_id": "i4",
              "text": "{\n  \"request_id\": \"request.denied\",\n  \"Action\": \"s3:GetObject\",\n  \"Resource\": \"arn:aws:s3:::sandbox-orders/order-a\",\n  \"principal_tags\": {\n    \"approved\": \"yes\",\n    \"blocked\": \"yes\"\n  }\n}"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "allow",
            "i2": "implicit_deny",
            "i3": "implicit_deny",
            "i4": "explicit_deny"
          },
          "item_feedback": {
            "i1": {
              "message": "Action and resource match; approved satisfies the allow and blocked does not satisfy the deny."
            },
            "i2": {
              "message": "No applicable allow: compare the supplied resource and approved condition with the allow statement."
            },
            "i3": {
              "message": "No applicable allow: compare the supplied resource and approved condition with the allow statement."
            },
            "i4": {
              "message": "Both statements apply; blocked satisfies the explicit deny, which overrides the allow."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Compare action, resource and conditions for every statement before combining the outcomes."
          ],
          "remediation_step_id": "aws_devops.tile.008.r01"
        }
      }
