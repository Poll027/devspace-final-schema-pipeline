        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation",
            "capability": "determine_request_outcome_under_supplied_identity_policy_conditions",
            "fact_ids": [
              "f1",
              "f2",
              "f3"
            ]
          }
        ],
        "anchors": [
          "aws_devops.evaluate_an_iam_identity_policy_for_a_requested_operation#assessment:determine_request_outcome_under_supplied_identity_policy_conditions"
        ],
        "public": {
          "prompt": "In this isolated identity-policy exercise, an Allow and a Deny both apply to the same request after action, resource and condition comparisons. What is the outcome?",
          "options": [
            {
              "option_id": "o1",
              "text": "Explicit deny."
            },
            {
              "option_id": "o2",
              "text": "Allow, because one matching allow is enough even with a matching deny."
            },
            {
              "option_id": "o3",
              "text": "Implicit deny, because no statement applies."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "An applicable explicit deny overrides an applicable allow."
            },
            "o2": {
              "message": "The explicit deny overrides that allow."
            },
            "o3": {
              "message": "Statements do apply; this is explicit deny, not absent applicable allow."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Your selections match the supplied evidence and the taught criteria."
          },
          "incorrect": {
            "message": "Recheck the supplied evidence against each criterion; a label or a partial match is not enough."
          },
          "hints": [
            "Compare action, resource and conditions for every statement before combining the outcomes."
          ],
          "remediation_step_id": "aws_devops.tile.008.r01"
        }
