        ]
      },
      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare platform work with the application work the team retains, not just the word managed.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "ECS is a managed container orchestration service that schedules container workloads; customers supply and operate their applications.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb2"
            ],
            "fact_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Managed EKS runs the Kubernetes control plane; customers retain responsibility for workload configuration and, depending on the compute option, worker nodes.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb3"
            ],
            "fact_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Choose between ECS and EKS by comparing the need for Kubernetes APIs and ecosystem with the team’s willingness to operate Kubernetes workloads.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb3"
            ],
            "fact_ids": [
