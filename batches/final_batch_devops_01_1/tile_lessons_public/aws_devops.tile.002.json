      "eyebrow": "Learn",
      "blocks": [
        {
          "type": "prose",
          "text": "A Kubernetes API and ecosystem requirement points the comparison toward managed EKS, provided the team is willing to operate Kubernetes workloads. Without that dependency, compare the ECS scheduling option. Neither proposal transfers application operation to AWS; retain the compute-option qualification for EKS worker-node duties.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb4"
            ],
            "fact_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#f1",
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#f2",
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Managed does not mean AWS operates the application. EKS worker-node duties remain compute-dependent.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership"
            ],
            "teaching_block_ids": [
              "aws_devops.compare_ecs_and_managed_eks_operational_ownership#tb5"
            ],
