        {
          "step_id": "tile_stakeholder_chart_matching_simplifying.r03",
          "type": "remediation",
          "concept_ids": [
            "stakeholder.simplifying_charts_for_audience"
          ],
          "eyebrow": "Let's revisit",
          "title": "Clutter elements and why they slow your audience down",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.r03.b1",
              "role": "mechanism",
              "text": "Every element in a chart that does not add information adds cognitive effort. Gridlines can be deleted; if precise values matter, label the data point directly instead. A chart border is not adding informative value — white space separates parts of a visual better than a border. Data labels should be used sparingly, only where exact values are important; otherwise use the axis. Trailing zeroes on axis labels ('22.00') can be dropped ('22 min'). Diagonally rotated axis text is slower to read; abbreviate labels so they render horizontally.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.simplifying_charts_for_audience"
                ],
                "teaching_block_ids": [
                  "stakeholder.simplifying_charts_for_audience#tb2",
                  "stakeholder.simplifying_charts_for_audience#tb3"
                ],
                "fact_ids": [
                  "stakeholder.simplifying_charts_for_audience#f1",
                  "stakeholder.simplifying_charts_for_audience#f2",
                  "stakeholder.simplifying_charts_for_audience#f3",
                  "stakeholder.simplifying_charts_for_audience#f5",
                  "stakeholder.simplifying_charts_for_audience#f6"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.r03.b2",
              "role": "takeaway",
              "text": "Reducing clutter lets the audience use their attention to decide what actions might be warranted, rather than working out how to read the graph. None of these changes alter the underlying delivery-time values — only how much visual effort it takes to read them.",
              "lineage": {
                "concept_ids": [
