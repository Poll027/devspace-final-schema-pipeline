        {
          "step_id": "tile_stakeholder_chart_matching_simplifying.r04",
          "type": "remediation",
          "concept_ids": [
            "stakeholder.simplifying_charts_for_audience"
          ],
          "eyebrow": "Let's revisit",
          "title": "Border removal and white space — why it works",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.r04.b1",
              "role": "mechanism",
              "text": "A chart border might seem to help by visually containing the chart on the slide. But the border is not adding informative value — it is adding a line the eye must process. White space around the chart already differentiates it from the surrounding content. Removing the border reduces one more element the audience must look past to reach the data. The same principle applies to gridlines: if the audience needs a precise value, label that data point directly rather than restoring the gridlines.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.simplifying_charts_for_audience"
                ],
                "teaching_block_ids": [
