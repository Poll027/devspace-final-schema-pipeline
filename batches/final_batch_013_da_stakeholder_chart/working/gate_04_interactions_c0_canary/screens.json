  "tiles": [
    {
      "tile_id": "tile_stakeholder_chart_matching_simplifying",
      "title": "Matching and Simplifying Charts for an Audience",
      "summary": "Learn to match chart type to the specific stakeholder point (bar for comparison, line for trend, pie for part-to-whole, boxplot with caution), then simplify the chosen chart by removing gridlines, borders, trailing zeros, rotated labels, and unnecessary data labels.",
      "steps": [
        {
          "step_id": "tile_stakeholder_chart_matching_simplifying.s01",
          "type": "explainer",
          "concept_ids": [
            "stakeholder.chart_type_to_point_matching"
          ],
          "eyebrow": "Chart Type Matching",
          "title": "The chart you pick should match the point you are making",
          "lede": "The same delivery data can be shown as a bar chart, a pie chart, or a line plot — but only one will make your specific point land for the operations manager.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.s01.b1",
              "role": "intro",
              "text": "During your own exploration you might have built several charts of SwiftMove Nigeria's delivery data. Presenting to the operations manager, the question changes: which chart actually makes the point you need to make, for this audience? Chart choice is driven by the point, not by the data alone.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.chart_type_to_point_matching"
                ],
                "teaching_block_ids": [
                  "stakeholder.chart_type_to_point_matching#tb1"
                ],
                "fact_ids": []
              }
            },
            {
              "type": "prose",
              "block_id": "tile_stakeholder_chart_matching_simplifying.s01.b2",
              "role": "mechanism",
              "text": "A bar chart is used for graphing categorical data and comparing values across categories — showing average delivery time side by side for Lagos, Abuja, and Kano. A line graph is best when you want to show how a value changes over time — for example, Lagos delivery time rising week over week. Boxplots offer a condensed display for comparing distributions side by side, but they may be unfamiliar to many audiences and could introduce a learning curve; a bar chart or line plot can often make the same point more directly.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.chart_type_to_point_matching"
                ],
                "teaching_block_ids": [
                  "stakeholder.chart_type_to_point_matching#tb2"
                ],
                "fact_ids": [
                  "stakeholder.chart_type_to_point_matching#f1",
                  "stakeholder.chart_type_to_point_matching#f2",
                  "stakeholder.chart_type_to_point_matching#f3",
                  "stakeholder.chart_type_to_point_matching#f5"
                ]
              }
            },
            {
              "type": "side_by_side",
              "block_id": "tile_stakeholder_chart_matching_simplifying.s01.b3",
              "left_label": "Bar chart — compare cities",
              "right_label": "Line graph — Lagos trend over weeks",
              "left": {
                "type": "chart",
                "chart_kind": "bar",
                "asset_ref": {
