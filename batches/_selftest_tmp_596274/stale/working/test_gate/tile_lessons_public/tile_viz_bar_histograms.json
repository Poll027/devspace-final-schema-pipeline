  "steps": [
    {
      "step_id": "tile_viz_bar_histograms.s01",
      "type": "explainer",
      "concept_ids": [
        "viz.bar_charts"
      ],
      "eyebrow": "bar charts",
      "title": "Comparing Cities with a Bar Chart",
      "lede": "When you want to compare a number across discrete categories, a bar chart aligns every bar to a shared baseline so the eye can judge lengths at a glance.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_viz_bar_histograms.s01.b02",
          "role": "intro",
          "text": "Suppose you want to compare average delivery time across Lagos, Abuja, and Kano. A bar chart is a common chart type for graphing categorical data or data sorted into groups — which fits this comparison exactly.",
          "lineage": {
            "concept_ids": [
              "viz.bar_charts"
            ],
            "teaching_block_ids": [
              "viz.bar_charts#tb1"
            ],
            "fact_ids": [
              "viz.bar_charts#f2"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_viz_bar_histograms.s01.b03",
          "role": "syntax",
          "text": "`plt.bar(x, height)` (or `ax.bar(x, height)`) makes a bar plot with bars positioned at the given x coordinates and given heights, with the baseline defaulting to 0. Categorical names can be passed directly as the x argument: `plt.bar(city_avg.index, city_avg)` plots the three city names as bar positions and each city's average delivery time as the bar height.",
          "lineage": {
            "concept_ids": [
              "viz.bar_charts"
            ],
            "teaching_block_ids": [
              "viz.bar_charts#tb2"
            ],
            "fact_ids": [
              "viz.bar_charts#f1",
              "viz.bar_charts#f4"
            ]
          }
        },
        {
          "type": "before_after",
          "block_id": "tile_viz_bar_histograms.s01.b04",
          "before": {
            "type": "code_walkthrough",
            "block_id": "tile_viz_bar_histograms.s01.b01.before",
            "language": "python",
            "code": "# Delivery times as a raw list — hard to compare cities\nprint(orders['delivery_time_minutes'].tolist())",
            "annotations": [
              {
                "start_line": 2,
                "end_line": 2,
                "text": "A flat list gives no per-city comparison"
              }
            ],
            "reveal": "line_by_line",
            "lineage": {
              "concept_ids": [
                "viz.bar_charts"
              ],
              "teaching_block_ids": [
                "viz.bar_charts#tb1"
              ],
              "fact_ids": [
                "viz.bar_charts#f2"
              ]
            }
          },
          "after": {
            "type": "code_walkthrough",
            "block_id": "tile_viz_bar_histograms.s01.b01.after",
            "language": "python",
            "code": "city_avg = orders.groupby('city')['delivery_time_minutes'].mean()\nplt.bar(city_avg.index, city_avg)",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 1,
                "text": "groupby + mean produces one average per city"
              },
              {
                "start_line": 2,
                "end_line": 2,
                "text": "plt.bar(city_avg.index, city_avg) passes city names as x and averages as heights"
              }
            ],
            "reveal": "line_by_line",
            "lineage": {
              "concept_ids": [
                "viz.bar_charts"
              ],
              "teaching_block_ids": [
                "viz.bar_charts#tb2"
              ],
              "fact_ids": [
                "viz.bar_charts#f1",
                "viz.bar_charts#f4"
              ]
            }
          },
          "change_summary": "Adding groupby + plt.bar turns a flat list into a per-city comparison chart.",
          "lineage": {
            "concept_ids": [
              "viz.bar_charts"
            ],
            "teaching_block_ids": [
              "viz.bar_charts#tb1",
              "viz.bar_charts#tb2"
            ],
            "fact_ids": [
              "viz.bar_charts#f1",
              "viz.bar_charts#f2",
              "viz.bar_charts#f4"
            ],
            "anchors": [
              "viz.bar_charts#visual"
            ]
          }
        }
      ],
