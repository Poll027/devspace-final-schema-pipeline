    {
      "step_id": "tile_viz_bar_histograms.s03",
      "type": "explainer",
      "concept_ids": [
        "viz.bar_charts"
      ],
      "eyebrow": "bar charts",
      "title": "Why the Baseline Must Start at Zero",
      "lede": "The bar chart's power comes from comparing lengths — and that only works when every bar starts at the same point.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_viz_bar_histograms.s03.b01",
          "role": "mental_model",
          "text": "Bar charts are easy to interpret because the eye is good at comparing lengths when the objects being compared are aligned to a common baseline. Every bar starts at 0, so a taller bar genuinely represents a larger value — Kano's bar looks taller than Lagos's because its average delivery time is higher.",
          "lineage": {
            "concept_ids": [
              "viz.bar_charts"
            ],
            "teaching_block_ids": [
              "viz.bar_charts#tb3"
            ],
            "fact_ids": [
              "viz.bar_charts#f3"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_viz_bar_histograms.s03.b02",
          "role": "misconception",
          "text": "Starting bars at a value other than 0 — say 20 minutes — distorts the comparison. If Kano averages 30 minutes and Lagos 25, bars starting at 20 are 10 and 5 units tall: Kano's bar looks twice as long even though its average is only 5 minutes higher. Keep the baseline at 0.",
          "lineage": {
            "concept_ids": [
              "viz.bar_charts"
            ],
            "teaching_block_ids": [
              "viz.bar_charts#tb4"
            ],
            "fact_ids": [
              "viz.bar_charts#f3",
              "viz.bar_charts#m1"
            ]
          }
        }
      ],
      "reward": {
        "gems": 5
      },
      "lineage": {
        "concept_ids": [
          "viz.bar_charts"
        ],
        "teaching_block_ids": [
          "viz.bar_charts#tb3",
          "viz.bar_charts#tb4"
