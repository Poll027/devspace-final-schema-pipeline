            "anchors": []
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "def convert_quantity(text):\n    text = ' 3 '\n    print(\"raw text\", repr(text))\n    quantity = int(text)\n    print(\"converted quantity\", quantity)\n    return quantity\n\nconvert_quantity(' 3 ')",
