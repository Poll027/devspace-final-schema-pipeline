            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "role": "misconception",
          "text": "Place the diagnostic after the binding or before the operation you are investigating. A print before a later reassignment cannot show the later value. Remove the print call when that diagnostic output is no longer needed.",
          "lineage": {
            "concept_ids": [
              "python.diagnostic_printing"
            ],
            "fact_ids": [
              "python.diagnostic_printing#f3"
            ],
            "teaching_block_ids": [
