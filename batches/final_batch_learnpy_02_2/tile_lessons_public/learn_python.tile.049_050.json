          }
        },
        {
          "type": "prose",
          "role": "mechanism",
          "text": "repr(value) returns a printable representation that can expose details ordinary string display obscures. Here it makes surrounding spaces and quotes visible.",
          "lineage": {
            "concept_ids": [
              "python.diagnostic_printing"
            ],
            "fact_ids": [
              "python.diagnostic_printing#f2"
