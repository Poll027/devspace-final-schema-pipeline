      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "Define an application-specific exception with `class InvalidRecordError(Exception):` and an indented `pass` body.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.custom_exceptions"
            ],
            "teaching_block_ids": [
              "python.custom_exceptions#tb2",
              "python.custom_exceptions#tb4",
              "python.custom_exceptions#tb5"
            ],
            "fact_ids": [
              "python.custom_exceptions#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "`raise InvalidRecordError(message)` signals the custom failure. A surrounding `except InvalidRecordError:` handles that failure at the caller’s recovery boundary.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.custom_exceptions"
            ],
            "teaching_block_ids": [
              "python.custom_exceptions#tb3",
              "python.custom_exceptions#tb4",
              "python.custom_exceptions#tb5"
            ],
            "fact_ids": [
              "python.custom_exceptions#f2"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "class InvalidRecordError(Exception):\n    pass\n\ndef check_quantity(quantity):\n    if quantity < 0:\n        raise InvalidRecordError(\"negative quantity\")\n    return quantity\n\ntry:\n    check_quantity(-1)\nexcept InvalidRecordError:\n    print(\"Order rejected\")",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 1,
              "text": "Exception subclass with an empty body."
            },
            {
              "start_line": 6,
              "end_line": 6,
              "text": "Negative quantity signals the application-specific failure."
            },
            {
              "start_line": 11,
              "end_line": 11,
              "text": "The surrounding boundary handles the matching custom failure."
            }
          ],
