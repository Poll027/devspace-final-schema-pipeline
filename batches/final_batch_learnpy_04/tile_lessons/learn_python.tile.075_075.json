      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "Class variables hold attributes shared by instances; instance variables hold data unique to an instance.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.instance_vs_class_attributes"
            ],
            "teaching_block_ids": [
              "python.instance_vs_class_attributes#tb1",
              "python.instance_vs_class_attributes#tb2",
              "python.instance_vs_class_attributes#tb4"
            ],
            "fact_ids": [
              "python.instance_vs_class_attributes#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A mutable list assigned in the class body is shared by instances unless an instance attribute shadows it.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.instance_vs_class_attributes"
            ],
            "teaching_block_ids": [
              "python.instance_vs_class_attributes#tb1",
              "python.instance_vs_class_attributes#tb3",
              "python.instance_vs_class_attributes#tb4",
              "python.instance_vs_class_attributes#tb5"
            ],
            "fact_ids": [
              "python.instance_vs_class_attributes#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Assign `self.labels = []` in `__init__` for a new list on each instance. Then updating first’s list does not mutate a shared class list.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
