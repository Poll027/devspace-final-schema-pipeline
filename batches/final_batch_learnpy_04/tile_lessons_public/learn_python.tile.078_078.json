      "eyebrow": "Understand",
      "blocks": [
        {
          "type": "prose",
          "text": "`mkdir(parents=True, exist_ok=True)` creates the directory and missing parents, allowing an existing directory; both options default to False.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.pathlib_filesystem_operations"
            ],
            "teaching_block_ids": [
              "python.pathlib_filesystem_operations#tb2"
            ],
            "fact_ids": [
              "python.pathlib_filesystem_operations#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "`directory.iterdir()` traverses immediate entries in arbitrary order.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.pathlib_filesystem_operations"
            ],
            "teaching_block_ids": [
              "python.pathlib_filesystem_operations#tb3"
            ],
            "fact_ids": [
              "python.pathlib_filesystem_operations#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "`source.rename(target)` moves or renames the entry. Relative targets use the working directory, not the source’s parent.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.pathlib_filesystem_operations"
            ],
            "teaching_block_ids": [
              "python.pathlib_filesystem_operations#tb3"
            ],
            "fact_ids": [
              "python.pathlib_filesystem_operations#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Rename can silently replace an existing target file on Unix when permitted; on Windows it raises `FileExistsError`.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.pathlib_filesystem_operations"
            ],
            "teaching_block_ids": [
              "python.pathlib_filesystem_operations#tb3"
            ],
            "fact_ids": [
              "python.pathlib_filesystem_operations#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Build `target = directory / filename` to select the output directory, not a bare relative filename.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
