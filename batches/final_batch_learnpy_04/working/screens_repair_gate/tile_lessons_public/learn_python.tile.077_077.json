        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "class Order:\n    def __init__(self):\n        self.quantity = 3\n\ndef make_order():\n    return Order()\n\norder = make_order()\nprint(type(order))\nprint(isinstance(order, Order))\nprint(getattr(order, \"quantity\"))\nprint(getattr(order, \"missing\", None))\nprint(dir(order))",
          "annotations": [
            {
              "start_line": 9,
              "end_line": 9,
              "text": "Inspect the object’s type. Returns the Order class."
            },
            {
              "start_line": 10,
              "end_line": 10,
              "text": "Class membership includes subclasses. Returns True."
            },
            {
              "start_line": 11,
              "end_line": 11,
              "text": "Retrieve the quantity attribute by name. Returns 3."
            },
            {
              "start_line": 12,
              "end_line": 12,
              "text": "Use a fallback when the named attribute is absent. Returns None."
            },
            {
              "start_line": 13,
              "end_line": 13,
              "text": "Includes quantity and underscore-prefixed names such as __dict__. Candidate relevant names, not a guaranteed complete public API; underscores signal internal use."
            }
          ],
