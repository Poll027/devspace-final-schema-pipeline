        },
        {
          "type": "prose",
          "text": "`isinstance(order, Order)` checks membership in Order or one of its subclasses.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.object_introspection"
            ],
            "teaching_block_ids": [
