            ]
          }
        },
        {
          "type": "prose",
          "text": "`getattr(order, name)` retrieves a named attribute. Supply an optional fallback for an absent attribute.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.object_introspection"
            ],
            "teaching_block_ids": [
              "python.object_introspection#tb3",
              "python.object_introspection#tb4"
            ],
            "fact_ids": [
              "python.object_introspection#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Underscore-prefixed names conventionally signal internal use rather than the public interface.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.object_introspection"
            ],
            "teaching_block_ids": [
              "python.object_introspection#tb3",
