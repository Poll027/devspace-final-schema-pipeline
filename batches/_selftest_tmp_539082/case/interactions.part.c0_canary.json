            "public": {
              "prompt": "A colleague sends you two files: `deliveries.csv` (a comma-separated text file) and `deliveries.xlsx` (an Excel workbook). Which pandas functions do you use to load each file into a DataFrame?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "`pd.read_csv()` for the CSV and `pd.read_excel()` for the Excel file."
                },
                {
                  "option_id": "opt_b",
                  "text": "`pd.read_excel()` for both, because Excel can also open CSV files."
                },
                {
                  "option_id": "opt_c",
                  "text": "`pd.read_csv()` for both, because CSV is the universal format."
                },
                {
                  "option_id": "opt_d",
                  "text": "`pd.read_table()` for the CSV and `pd.read_csv()` for the Excel file."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_a": {
                  "message": "Correct. `pd.read_csv()` reads delimited text files like CSV, and `pd.read_excel()` reads Excel workbooks (.xlsx)."
                },
                "opt_b": {
                  "message": "While Excel can open CSV files in the application, `pd.read_excel()` expects a binary Excel workbook format. Use `pd.read_csv()` for `.csv` files."
                },
                "opt_c": {
                  "message": "`pd.read_csv()` reads delimited text files, not Excel workbooks. Passing an `.xlsx` file to `pd.read_csv()` will raise an error."
                },
                "opt_d": {
                  "message": "`pd.read_table()` is not the main function taught here, and `pd.read_csv()` does not read Excel workbooks. Use `pd.read_csv()` for CSV and `pd.read_excel()` for `.xlsx`."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Right. Each file format has its own reader: `read_csv` for delimited text, `read_excel` for Excel workbooks."
              },
              "incorrect": {
                "message": "Each file format needs its own reader. `pd.read_csv()` is for delimited text files like `.csv`; `pd.read_excel()` is for Excel workbooks like `.xlsx`."
              },
              "hints": [
                "The function name matches the file type: `read_csv` for CSV, `read_excel` for Excel.",
                "Think about what each function name describes."
              ],
              "remediation_step_id": "tile_pandas_dataframe_reading.r03"
            }
