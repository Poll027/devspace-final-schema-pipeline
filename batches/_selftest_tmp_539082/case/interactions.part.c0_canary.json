                  "text": "`pd.read_csv(\"deliveries.csv\", delimiter=\",\")`"
                },
                {
                  "option_id": "opt_c",
                  "text": "`pd.read_excel(\"deliveries.csv\", sheet_name=\"Sheet1\")`"
                },
                {
                  "option_id": "opt_d",
                  "text": "`pd.read_csv(\"deliveries.csv\")`"
                }
