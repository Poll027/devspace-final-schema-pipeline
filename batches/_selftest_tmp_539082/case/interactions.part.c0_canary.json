              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_a": {
                  "message": "Correct. `sep=\";\"` tells `read_csv()` to split fields on semicolons instead of the default comma."
                },
                "opt_b": {
                  "message": "The argument name is `sep`, not `delimiter` (though `delimiter` is an alias, the value here is wrong: passing `\",\"` keeps the default comma separator, which won't parse a semicolon-delimited file correctly)."
                },
                "opt_c": {
                  "message": "`pd.read_excel()` reads Excel workbooks, not CSV files. The `sheet_name` argument is for Excel sheets, not CSV files."
                },
                "opt_d": {
                  "message": "Without `sep=\";\"`, `read_csv()` uses the default comma separator. A semicolon-delimited file would be read as a single column."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Exactly. `sep` lets you override the default comma delimiter. The file path is always the first argument."
              },
              "incorrect": {
                "message": "When the delimiter is not a comma, pass `sep=\";\"` (or whatever character is used) as a keyword argument to `pd.read_csv()`."
