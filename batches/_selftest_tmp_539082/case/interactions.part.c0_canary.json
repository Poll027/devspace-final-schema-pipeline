            "standalone": false,
            "measures": [
              {
                "concept_id": "pandas.dataframe_series_model",
                "capability": "relate_dataframe_columns_to_series",
                "fact_ids": [
                  "f1",
                  "f2",
                  "f5"
                ]
              }
            ],
            "anchors": [
              "pandas.dataframe_series_model#assessment:relate_dataframe_columns_to_series"
            ],
            "public": {
              "prompt": "You have a DataFrame called `orders` with columns `order_id`, `city`, and `delivery_time_minutes`. What is the type of `orders['city']`, and how does it relate to the DataFrame?",
              "options": [
                {
                  "option_id": "opt_a",
                  "text": "It is a pandas Series that shares the same index as the DataFrame."
                },
                {
                  "option_id": "opt_b",
                  "text": "It is a Python list extracted from the DataFrame."
                },
                {
                  "option_id": "opt_c",
                  "text": "It is a new DataFrame containing only the `city` column."
                },
                {
                  "option_id": "opt_d",
                  "text": "It is a dict mapping index labels to city values."
                }
              ],
              "selection": "single",
              "shuffle": true
            },
            "grading": {
              "correct_option_ids": [
                "opt_a"
              ],
              "option_feedback": {
                "opt_a": {
                  "message": "Correct. `df['col']` returns a Series — the same one-dimensional, indexed structure that a DataFrame is built from. It shares the DataFrame's index."
                },
                "opt_b": {
                  "message": "Not quite. `df['col']` uses dict-like syntax, but the result is a pandas Series, not a plain Python list. A Series carries index labels alongside its values."
                },
                "opt_c": {
                  "message": "A single-column selection with `df['col']` returns a Series, not a DataFrame. To get a one-column DataFrame you would use double brackets: `df[['col']]`."
                },
                "opt_d": {
                  "message": "A pandas Series is not a dict, even though a DataFrame can be thought of as a dict of Series. `df['city']` returns a Series with an integer index, not a dict."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Exactly right. A DataFrame is a collection of like-indexed Series objects, so pulling out a column with `df['col']` gives you back one of those Series."
              },
              "incorrect": {
                "message": "Remember: a DataFrame can be thought of as a dict of Series that share an index. Selecting a column with `df['col']` returns one of those Series."
              },
              "hints": [
                "Think about what a DataFrame is made of at its core.",
                "The teaching block said: 'A DataFrame can be treated like a dict of like-indexed Series.'"
              ],
              "remediation_step_id": "tile_pandas_dataframe_reading.r01"
            }
          }
        },
