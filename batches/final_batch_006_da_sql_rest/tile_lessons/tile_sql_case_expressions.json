      "eyebrow": "Quick check",
      "title": "Recognising the simple CASE form",
      "lede": "Identify when the simple CASE form is appropriate and how it differs from the searched form.",
      "reward": {
        "gems": 5
      },
      "lineage": {
        "concept_ids": [
