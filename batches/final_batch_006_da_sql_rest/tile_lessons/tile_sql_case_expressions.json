      },
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.tile_sql_case_expressions.s04",
        "difficulty": "core",
        "grading_mode": "client",
        "standalone": false,
        "measures": [
          {
            "concept_id": "sql.case_expressions",
            "capability": "rewrite_as_simple_case_form",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "anchors": [
          "sql.case_expressions#assessment:rewrite_as_simple_case_form"
        ],
        "public": {
          "prompt": "Which of the following is the correct **simple CASE** form that produces the same result as:\n```sql\nCASE\n  WHEN region = 'north' THEN 'N'\n  WHEN region = 'south' THEN 'S'\n  WHEN region = 'other' THEN 'O'\nEND\n```",
          "options": [
            {
              "option_id": "opt_a",
              "text": "`CASE region WHEN 'north' THEN 'N' WHEN 'south' THEN 'S' WHEN 'other' THEN 'O' END`"
            },
            {
              "option_id": "opt_b",
              "text": "`CASE WHEN region THEN 'north' = 'N' WHEN 'south' = 'S' WHEN 'other' = 'O' END`"
            },
            {
              "option_id": "opt_c",
              "text": "`CASE region = 'north' THEN 'N' WHEN region = 'south' THEN 'S' END`"
            },
            {
              "option_id": "opt_d",
              "text": "`CASE (region) WHEN = 'north' THEN 'N' WHEN = 'south' THEN 'S' WHEN = 'other' THEN 'O' END`"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_a"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "Correct. The simple CASE form places the expression (region) right after CASE, then each WHEN lists only the value to compare against."
            },
            "opt_b": {
              "message": "Incorrect. The syntax is reversed. In the simple form, WHEN is followed by the value, not by an expression with THEN inside it."
            },
            "opt_c": {
              "message": "Incorrect. The simple form requires WHEN followed by just the value, not a full condition. Also, the first branch is missing the WHEN keyword."
            },
            "opt_d": {
              "message": "Incorrect. In the simple form, WHEN is followed directly by the value — no `=` operator. The comparison is implicit."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "In the simple CASE form, the expression goes right after CASE, and each WHEN lists only the value to match — the `=` comparison is implicit."
          },
          "incorrect": {
            "message": "The simple CASE form is: `CASE expression WHEN value1 THEN result1 WHEN value2 THEN result2 ... END`. The expression is written once after CASE; each WHEN gives only the value."
          },
          "hints": [
            "In the simple form, the expression to test is written once, right after the CASE keyword.",
            "Each WHEN in the simple form contains only the value to compare against, not a full condition."
          ],
          "remediation_step_id": "tile_sql_case_expressions.r03"
        }
      }
    },
