  "steps": [
    {
      "step_id": "tile_sql_case_expressions.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.case_expressions"
      ],
      "eyebrow": "Conditional labels",
      "title": "Labelling rows with CASE WHEN … THEN … END",
      "lede": "Sometimes a query needs a label computed per row — calling each order 'fast', 'normal' or 'slow' based on its delivery time.",
      "blocks": [
        {
          "type": "prose",
          "text": "A CASE WHEN condition THEN result … END expression evaluates its WHEN conditions in order and returns the result of the first one that is true. The conditions are tested top to bottom; once one matches, the rest are skipped.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.case_expressions"
            ],
            "fact_ids": [
              "sql.case_expressions#f1"
            ],
            "teaching_block_ids": [
              "sql.case_expressions#tb1",
              "sql.case_expressions#tb2"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "block_id": "tile_sql_case_expressions.s01.cw",
          "language": "sql",
          "code": "SELECT\n  order_id,\n  delivery_time_minutes,\n  CASE\n    WHEN delivery_time_minutes < 20 THEN 'fast'    -- branch 1\n    WHEN delivery_time_minutes < 40 THEN 'normal'  -- branch 2\n    ELSE 'slow'                                     -- fallback\n  END AS speed\nFROM orders",
          "annotations": [
            {
              "start_line": 4,
              "end_line": 4,
              "text": "CASE starts the expression; conditions are tested in the order they appear."
            },
            {
              "start_line": 5,
              "end_line": 5,
              "text": "Branch 1: if delivery_time_minutes < 20, return 'fast' and stop."
            },
            {
              "start_line": 6,
              "end_line": 6,
              "text": "Branch 2: only reached if branch 1 was false. Returns 'normal' for times 20–39."
            },
            {
              "start_line": 7,
              "end_line": 7,
              "text": "ELSE is the fallback for any row that matched no WHEN condition."
            },
            {
              "start_line": 8,
              "end_line": 8,
              "text": "END closes the CASE expression; AS speed names the output column."
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "sql.case_expressions"
            ],
            "fact_ids": [
              "sql.case_expressions#f1"
            ],
            "teaching_block_ids": [
              "sql.case_expressions#tb2"
            ],
            "anchors": [
              "sql.case_expressions#visual"
            ]
          }
        }
      ],
      "reward": {
