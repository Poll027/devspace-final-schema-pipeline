              "label": "stacked + deduplicated",
              "directed": true
            }
          ],
          "layout": "auto",
          "alt_text": "Two query result sets stacked by UNION ALL (keeping the duplicate customer_id 1) and by UNION (removing the duplicate, leaving four distinct ids).",
          "lineage": {
