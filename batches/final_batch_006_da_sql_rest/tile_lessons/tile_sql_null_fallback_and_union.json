      "step_id": "tile_sql_null_fallback_and_union.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.coalesce"
      ],
      "title": "Replacing NULL with a default using COALESCE",
      "eyebrow": "COALESCE",
      "lede": "COALESCE returns the first non-null argument — use it to substitute a default for missing values.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.s01.p1",
          "text": "COALESCE(value [, ...]) returns the first of its arguments that is not null, and returns null only if every argument is null. COALESCE(city, 'unknown') returns the customer's actual city when it is recorded, and 'unknown' when it is missing. It is commonly used to substitute a default value for null — COALESCE(name, 'unnamed customer') falls back to a fixed label whenever a name was not recorded.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.coalesce"
            ],
            "fact_ids": [
              "sql.coalesce#f1",
              "sql.coalesce#f2"
