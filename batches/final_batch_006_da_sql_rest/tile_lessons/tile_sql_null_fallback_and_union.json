    {
      "step_id": "tile_sql_null_fallback_and_union.s05",
      "type": "explainer",
      "concept_ids": [
        "sql.union"
      ],
      "title": "Stacking query results with UNION and UNION ALL",
      "eyebrow": "UNION",
      "lede": "UNION appends one result set to another; UNION removes duplicates while UNION ALL keeps every row.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.s05.p1",
          "text": "UNION effectively appends the result rows of the second query to the result of the first, although there is no guarantee that this is the order the rows actually come back in. SELECT customer_id FROM customers WHERE city = 'Lagos' UNION SELECT customer_id FROM orders WHERE delivery_time_minutes > 60 combines Lagos customers with customers who had a slow order into one list.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.union"
            ],
            "fact_ids": [
              "sql.union#f1"
            ],
            "teaching_block_ids": [
              "sql.union#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.s05.p2",
          "text": "UNION eliminates duplicate rows from its combined result, the same way DISTINCT does, unless UNION ALL is used, which keeps every row. A Lagos customer who also placed two orders over 60 minutes appears once under UNION but three times under UNION ALL — once from the first query, twice from the second.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.union"
            ],
            "fact_ids": [
              "sql.union#f2"
            ],
            "teaching_block_ids": [
              "sql.union#tb2"
            ]
          }
        },
        {
          "type": "diagram",
          "block_id": "tile_sql_null_fallback_and_union.s05.diag",
          "diagram_kind": "container",
          "title": "UNION vs UNION ALL",
          "nodes": [
            {
              "id": "q1",
              "label": "Query 1 result\ncustomer_id: 1, 2, 3",
              "kind": "result_set",
              "group": "input"
            },
            {
              "id": "q2",
              "label": "Query 2 result\ncustomer_id: 1, 4",
              "kind": "result_set",
              "group": "input"
            },
            {
              "id": "union_all",
              "label": "UNION ALL\ncustomer_id: 1, 2, 3, 1, 4\n(duplicate 1 kept)",
              "kind": "result_set",
              "group": "union_all"
            },
            {
              "id": "union",
              "label": "UNION\ncustomer_id: 1, 2, 3, 4\n(duplicate 1 removed)",
              "kind": "result_set",
              "group": "union"
            }
          ],
          "edges": [
