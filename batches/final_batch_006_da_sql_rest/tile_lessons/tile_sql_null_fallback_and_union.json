  "remediation_steps": [
    {
      "step_id": "tile_sql_null_fallback_and_union.r01",
      "type": "remediation",
      "concept_ids": [
        "sql.coalesce"
      ],
      "title": "How COALESCE picks its return value",
      "eyebrow": "Let's review",
      "lede": "COALESCE returns the first non-null argument, or null if all arguments are null.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.r01.p1",
          "text": "COALESCE evaluates its arguments from left to right and returns the first one that is not null. COALESCE(city, 'unknown') returns city when city is not null, and 'unknown' when city is null. COALESCE returns null only when every argument is null — COALESCE(NULL, NULL) returns null.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.coalesce"
            ],
            "fact_ids": [
              "sql.coalesce#f1"
            ],
            "teaching_block_ids": [
              "sql.coalesce#tb1"
            ]
          }
        }
      ],
      "lineage": {
        "concept_ids": [
          "sql.coalesce"
        ],
        "fact_ids": [
          "sql.coalesce#f1"
        ],
        "teaching_block_ids": [
          "sql.coalesce#tb1"
        ]
      }
    },
    {
      "step_id": "tile_sql_null_fallback_and_union.r02",
      "type": "remediation",
      "concept_ids": [
        "sql.coalesce"
      ],
      "title": "COALESCE as a default-value substitution",
      "eyebrow": "Let's review",
      "lede": "Use COALESCE(column, default) to replace NULL with a fixed fallback value.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.r02.p1",
          "text": "COALESCE is commonly used to substitute a default value for null. COALESCE(name, 'unnamed customer') returns the customer's actual name when it is recorded, and the fixed string 'unnamed customer' when the name column is null. This pattern keeps downstream calculations and labels clean even when source data has gaps.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.coalesce"
            ],
            "fact_ids": [
              "sql.coalesce#f2"
            ],
            "teaching_block_ids": [
              "sql.coalesce#tb2"
            ]
          }
        }
      ],
      "lineage": {
        "concept_ids": [
          "sql.coalesce"
        ],
        "fact_ids": [
          "sql.coalesce#f2"
        ],
        "teaching_block_ids": [
          "sql.coalesce#tb2"
        ]
      }
    },
    {
      "step_id": "tile_sql_null_fallback_and_union.r03",
      "type": "remediation",
      "concept_ids": [
        "sql.union"
      ],
      "title": "UNION compatibility rules",
      "eyebrow": "Let's review",
      "lede": "Both queries must return the same number of columns with compatible types.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.r03.p1",
          "text": "UNION requires both queries to return the same number of columns, with corresponding columns having compatible data types. If the first query returns one integer column and the second also returns one integer column, they are compatible. If the column counts differ, or if a text column is paired with an integer column, the UNION will fail.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
              "sql.union"
            ],
            "fact_ids": [
              "sql.union#f3"
            ],
            "teaching_block_ids": [
              "sql.union#tb3"
            ]
          }
        }
      ],
      "lineage": {
        "concept_ids": [
          "sql.union"
        ],
        "fact_ids": [
          "sql.union#f3"
        ],
        "teaching_block_ids": [
          "sql.union#tb3"
        ]
      }
    },
    {
      "step_id": "tile_sql_null_fallback_and_union.r04",
      "type": "remediation",
      "concept_ids": [
        "sql.union"
      ],
      "title": "UNION vs UNION ALL: deduplication",
      "eyebrow": "Let's review",
      "lede": "UNION removes duplicates; UNION ALL keeps every row.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_null_fallback_and_union.r04.p1",
          "text": "UNION appends the rows of the second query to the rows of the first. UNION removes duplicate rows from the combined result, the same way DISTINCT does. UNION ALL keeps every row, including duplicates. Use UNION when you want a distinct list; use UNION ALL when you need every occurrence, including rows that appear in both queries.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.union"
            ],
