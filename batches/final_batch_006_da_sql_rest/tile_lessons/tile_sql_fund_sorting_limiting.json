    {
      "step_id": "tile_sql_fund_sorting_limiting.s04",
      "type": "explainer",
      "concept_ids": [
        "sql.limit_offset"
      ],
      "eyebrow": "Slicing results",
      "title": "Returning a slice of rows with LIMIT and OFFSET",
      "lede": "Once results are sorted, LIMIT and OFFSET let you take just the rows you need — the top five, or the next page.",
      "blocks": [
        {
          "type": "prose",
          "text": "LIMIT restricts the maximum number of rows a query returns. OFFSET specifies how many rows to skip before returning rows. `SELECT order_id, delivery_time_minutes FROM orders ORDER BY delivery_time_minutes DESC LIMIT 3` returns the three slowest deliveries in the QuickCart dataset.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.limit_offset"
            ],
            "fact_ids": [
              "sql.limit_offset#f1"
            ],
            "teaching_block_ids": [
              "sql.limit_offset#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "When both are specified, OFFSET rows are skipped first, then up to LIMIT rows of what remains are returned. Adding `OFFSET 3` to that same query skips the three slowest and returns the next three — a second page of results.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.limit_offset"
            ],
            "fact_ids": [
              "sql.limit_offset#f2"
            ],
            "teaching_block_ids": [
              "sql.limit_offset#tb2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Without ORDER BY, LIMIT and OFFSET return an unpredictable subset. SQL promises no particular sequence unless ORDER BY is present.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "sql.limit_offset"
            ],
            "fact_ids": [
              "sql.limit_offset#m1"
            ],
            "teaching_block_ids": [
              "sql.limit_offset#tb3"
            ]
          }
        },
        {
          "type": "process_flow",
          "block_id": "tile_sql_fund_sorting_limiting.s04.pf",
          "title": "How OFFSET and LIMIT slice a sorted result",
          "direction": "TB",
          "nodes": [
            {
              "id": "n_sort",
              "label": "Sorted result (all rows)",
              "kind": "start"
            },
            {
              "id": "n_offset",
              "label": "OFFSET: skip first N rows",
              "kind": "step",
              "detail": "e.g. OFFSET 3 discards the first 3 rows"
            },
            {
              "id": "n_limit",
              "label": "LIMIT: keep next M rows",
              "kind": "step",
              "detail": "e.g. LIMIT 3 returns rows 4–6"
            },
            {
              "id": "n_out",
              "label": "Returned rows",
              "kind": "end"
            }
          ],
          "edges": [
            {
              "from": "n_sort",
