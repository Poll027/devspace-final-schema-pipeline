              "kind": "next"
            },
            {
              "from": "n_limit",
              "to": "n_out",
              "kind": "next"
            }
          ],
          "alt_text": "A sorted list passes through an OFFSET step that discards the first rows, then a LIMIT step that keeps the next rows, producing the final output.",
          "lineage": {
