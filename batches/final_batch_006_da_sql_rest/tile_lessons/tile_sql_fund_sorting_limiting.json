    {
      "step_id": "tile_sql_fund_sorting_limiting.s07",
      "type": "recap",
      "concept_ids": [
        "sql.order_by",
        "sql.limit_offset"
      ],
      "eyebrow": "Recap",
      "title": "Sorting and limiting results",
      "lede": "Two clauses that shape what comes back and in what order.",
      "blocks": [
        {
          "type": "prose",
          "text": "ORDER BY sorts result rows by one or more expressions. Omitting a direction defaults to ASC; add DESC to reverse. A second column in ORDER BY breaks ties on the first.",
          "role": "takeaway",
          "lineage": {
            "concept_ids": [
              "sql.order_by"
            ],
            "fact_ids": [
              "sql.order_by#f1",
              "sql.order_by#f2",
              "sql.order_by#f3"
            ],
            "teaching_block_ids": []
          }
        },
        {
          "type": "prose",
          "text": "LIMIT caps the number of rows returned; OFFSET skips rows before the limit is applied. Always pair them with ORDER BY — without it the subset returned is unpredictable.",
          "role": "takeaway",
          "lineage": {
            "concept_ids": [
              "sql.limit_offset"
            ],
            "fact_ids": [
              "sql.limit_offset#f1",
              "sql.limit_offset#f2",
              "sql.limit_offset#m1"
            ],
            "teaching_block_ids": []
          }
        },
        {
          "type": "up_next",
          "block_id": "tile_sql_fund_sorting_limiting.s07.un",
          "title": "Up next: Aggregating Data with GROUP BY",
          "text": "Next you'll collapse many rows into summary numbers using COUNT, SUM, AVG, MIN and MAX — and group those summaries by category with GROUP BY."
        }
