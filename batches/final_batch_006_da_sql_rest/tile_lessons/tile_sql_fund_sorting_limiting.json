  "steps": [
    {
      "step_id": "tile_sql_fund_sorting_limiting.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.order_by"
      ],
      "eyebrow": "Sorting results",
      "title": "Controlling the order of your results with ORDER BY",
      "lede": "A WHERE clause decides which orders come back, but not what order they appear in. ORDER BY gives you that control.",
      "blocks": [
        {
          "type": "prose",
          "text": "ORDER BY sorts result rows by the expression you name. If you don't specify a direction, ascending (ASC) order is assumed by default — so `ORDER BY delivery_time_minutes` lists the fastest QuickCart deliveries first. Add DESC to reverse it: `ORDER BY delivery_time_minutes DESC` puts the slowest deliveries at the top.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.order_by"
            ],
            "fact_ids": [
              "sql.order_by#f1",
              "sql.order_by#f2"
            ],
            "teaching_block_ids": [
              "sql.order_by#tb1",
              "sql.order_by#tb2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "When two rows tie on the first sort expression, SQL compares them on the next one. `ORDER BY customer_id, delivery_time_minutes DESC` groups each customer's orders together (ascending by customer_id) and within each customer shows the slowest delivery first. You can chain as many tiebreaker columns as you need.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
              "sql.order_by"
            ],
            "fact_ids": [
              "sql.order_by#f3"
            ],
            "teaching_block_ids": [
              "sql.order_by#tb3"
            ]
          }
        },
        {
