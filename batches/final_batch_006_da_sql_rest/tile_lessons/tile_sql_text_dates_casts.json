    {
      "step_id": "tile_sql_text_dates_casts.r02",
      "type": "remediation",
      "concept_ids": [
        "sql.string_functions"
      ],
      "title": "TRIM, CONCAT, and LENGTH",
      "eyebrow": "Let's review",
      "lede": "TRIM removes spaces; CONCAT joins strings; LENGTH counts characters.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.r02.p1",
          "text": "TRIM removes the longest string of the given characters (a space by default) from the start, end, or both ends of a string. TRIM(city) strips accidental leading or trailing spaces from a city value. CONCAT joins its arguments into one string and ignores any NULL arguments: CONCAT(name, ' (', city, ')') builds a label even when city is NULL. LENGTH(text) returns the number of characters: LENGTH(name) gives the character count of a customer's name.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
              "sql.string_functions"
            ],
            "fact_ids": [
              "sql.string_functions#f2",
              "sql.string_functions#f3",
