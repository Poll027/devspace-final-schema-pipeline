    {
      "step_id": "tile_sql_text_dates_casts.r06",
      "type": "remediation",
      "concept_ids": [
        "sql.type_casting"
      ],
      "title": "Two cast syntaxes: CAST and ::",
      "eyebrow": "Let's review",
      "lede": "CAST(expression AS type) and expression::type are equivalent — use either.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.r06.p1",
          "text": "PostgreSQL provides two equivalent syntaxes for a type cast. The standard form is CAST(expression AS type): CAST(delivery_time_minutes AS text). The shorthand is expression::type: delivery_time_minutes::text. Both produce exactly the same result. The :: shorthand is specific to PostgreSQL; CAST(... AS type) is portable across SQL dialects.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.type_casting"
            ],
            "fact_ids": [
