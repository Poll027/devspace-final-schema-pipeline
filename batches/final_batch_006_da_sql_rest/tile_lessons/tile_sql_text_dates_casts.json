    {
      "step_id": "tile_sql_text_dates_casts.s07",
      "type": "explainer",
      "concept_ids": [
        "sql.type_casting"
      ],
      "title": "Type casting: CAST and :: syntax",
      "eyebrow": "Type casting",
      "lede": "Convert a value from one type to another using CAST or the :: shorthand.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.s07.p1",
          "text": "PostgreSQL accepts two equivalent syntaxes for a type cast. CAST(expression AS type) is the standard form; expression::type is the shorthand. CAST(delivery_time_minutes AS text) and delivery_time_minutes::text both convert that numeric column to text — same result, two ways to write it.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.type_casting"
            ],
            "fact_ids": [
              "sql.type_casting#f1"
            ],
            "teaching_block_ids": [
              "sql.type_casting#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.s07.p2",
          "text": "A cast succeeds only if a suitable type conversion is defined between the source type and the target type. Converting delivery_time_minutes (an integer) to text works because an integer-to-text conversion is defined. A cast between two types with no defined conversion does not succeed.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.type_casting"
            ],
            "fact_ids": [
              "sql.type_casting#f2"
            ],
            "teaching_block_ids": [
              "sql.type_casting#tb2"
            ]
          }
        },
        {
          "type": "side_by_side",
          "block_id": "tile_sql_text_dates_casts.s07.sbs",
          "left_label": "CAST(... AS type) syntax",
          "right_label": "expression::type shorthand",
          "left": {
            "type": "code_walkthrough",
            "block_id": "tile_sql_text_dates_casts.s07.sbs_left",
            "language": "sql",
            "code": "SELECT CAST(delivery_time_minutes AS text) AS minutes_text\n  FROM orders\n LIMIT 3",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 1,
                "text": "Standard SQL CAST syntax: CAST(value AS target_type)"
              }
            ],
            "reveal": "all"
          },
          "right": {
            "type": "code_walkthrough",
            "block_id": "tile_sql_text_dates_casts.s07.sbs_right",
            "language": "sql",
            "code": "SELECT delivery_time_minutes::text AS minutes_text\n  FROM orders\n LIMIT 3",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 1,
                "text": "PostgreSQL shorthand: value::target_type — identical result"
              }
            ],
            "reveal": "all"
          },
          "takeaway": "Both expressions produce the same result. Use whichever your team's style guide prefers; the :: shorthand is common in PostgreSQL codebases.",
          "lineage": {
            "concept_ids": [
              "sql.type_casting"
            ],
            "fact_ids": [
              "sql.type_casting#f1"
            ],
            "teaching_block_ids": [
              "sql.type_casting#tb1"
            ],
            "anchors": [
              "sql.type_casting#visual"
            ]
          }
        }
      ],
