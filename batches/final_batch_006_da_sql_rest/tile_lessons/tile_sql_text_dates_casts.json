    {
      "step_id": "tile_sql_text_dates_casts.s04",
      "type": "explainer",
      "concept_ids": [
        "sql.date_time_functions"
      ],
      "title": "Extracting date parts and computing elapsed days",
      "eyebrow": "Date functions",
      "lede": "Pull year, month, or hour from a date; subtract two dates to get the number of days between them.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.s04.p1",
          "text": "EXTRACT(field FROM source) retrieves a subfield — year, month, day, hour — from a date or timestamp. EXTRACT(month FROM order_date) returns the month number an order was placed. Subtracting two dates gives the number of days between them: a later order_date minus an earlier one gives the elapsed days.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.date_time_functions"
            ],
            "fact_ids": [
              "sql.date_time_functions#f1",
              "sql.date_time_functions#f2"
            ],
            "teaching_block_ids": [
              "sql.date_time_functions#tb1",
              "sql.date_time_functions#tb2"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "block_id": "tile_sql_text_dates_casts.s04.cw",
          "language": "sql",
          "code": "SELECT order_id,\n       order_date,\n       EXTRACT(year  FROM order_date) AS order_year,\n       EXTRACT(month FROM order_date) AS order_month,\n       order_date - '2024-01-01'      AS days_since_jan1\n  FROM orders\n LIMIT 5",
          "annotations": [
            {
              "start_line": 3,
              "end_line": 3,
              "text": "EXTRACT(year FROM order_date) pulls the 4-digit year"
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "EXTRACT(month FROM order_date) pulls the month number (1–12)"
            },
            {
              "start_line": 5,
              "end_line": 5,
              "text": "date - date gives the number of elapsed days as an integer"
            }
          ],
          "reveal": "line_by_line",
          "lineage": {
            "concept_ids": [
              "sql.date_time_functions"
            ],
            "fact_ids": [
              "sql.date_time_functions#f1",
