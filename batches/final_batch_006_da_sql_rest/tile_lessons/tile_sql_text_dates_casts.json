  "steps": [
    {
      "step_id": "tile_sql_text_dates_casts.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.string_functions"
      ],
      "title": "Cleaning text with LOWER, UPPER, TRIM, CONCAT, and LENGTH",
      "eyebrow": "String functions",
      "lede": "Four functions that clean, combine, and measure text values in a query.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.s01.p1",
          "text": "LOWER(text) converts a string to all lower case; UPPER(text) converts it to all upper case. LOWER(city) turns 'LAGOS' or 'Lagos' into 'lagos', which is useful for comparing city names that were entered inconsistently.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.string_functions"
            ],
            "fact_ids": [
              "sql.string_functions#f1"
            ],
            "teaching_block_ids": [
              "sql.string_functions#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.s01.p2",
          "text": "TRIM removes leading or trailing spaces (by default) from a string — TRIM(city) strips accidental spaces from a city value. CONCAT joins its arguments into one string and ignores any NULL arguments: CONCAT(name, ' (', city, ')') builds a single label. LENGTH(text) returns the number of characters: LENGTH(name) gives the character count of a customer's name.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
              "sql.string_functions"
            ],
            "fact_ids": [
              "sql.string_functions#f2",
              "sql.string_functions#f3",
              "sql.string_functions#f4"
            ],
            "teaching_block_ids": [
              "sql.string_functions#tb2"
            ]
          }
        },
