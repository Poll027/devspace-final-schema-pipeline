    {
      "step_id": "tile_sql_text_dates_casts.r05",
      "type": "remediation",
      "concept_ids": [
        "sql.type_casting"
      ],
      "title": "When does a cast succeed?",
      "eyebrow": "Let's review",
      "lede": "A cast succeeds only when a conversion between the two types is defined.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_text_dates_casts.r05.p1",
          "text": "A type cast succeeds only if a suitable conversion is defined between the source type and the target type. Converting an integer to text works because that conversion is defined. A cast between two types that have no defined conversion does not succeed — the database will return an error. Always check that the conversion you need is supported before relying on it in a query.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "sql.type_casting"
            ],
            "fact_ids": [
              "sql.type_casting#f2"
