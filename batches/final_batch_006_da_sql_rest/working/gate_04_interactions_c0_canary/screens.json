            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.s06",
          "type": "explainer",
          "concept_ids": [
            "sql.logical_operators"
          ],
          "title": "Evaluation order and parentheses",
          "eyebrow": "Operator precedence",
          "lede": "NOT binds tightest, then AND, then OR — use parentheses to override.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s06.p1",
              "text": "Without parentheses, NOT is evaluated before AND, and AND before OR. WHERE customer_id = 1 AND delivery_time_minutes > 30 OR customer_id = 2 is read as (customer_id = 1 AND delivery_time_minutes > 30) OR customer_id = 2, keeping any order from customer 2 regardless of delivery time.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f2"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb3"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s06.p2",
              "text": "Parentheses force a different evaluation order. WHERE customer_id = 1 AND (delivery_time_minutes > 30 OR customer_id = 2) evaluates the OR first; because customer_id = 1 already rules out customer_id = 2, this version keeps only customer 1 orders that took longer than 30 minutes. NOT reverses a condition: WHERE NOT (customer_id = 1) keeps every order not from customer 1.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f2"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb3"
                ]
              }
            }
          ],
          "reward": {
            "gems": 5
          },
          "lineage": {
            "concept_ids": [
              "sql.logical_operators"
            ],
            "fact_ids": [
              "sql.logical_operators#f2"
            ],
            "teaching_block_ids": [
              "sql.logical_operators#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.s07",
