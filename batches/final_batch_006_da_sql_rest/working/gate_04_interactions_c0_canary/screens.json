        {
          "step_id": "tile_sql_fund_filtering_rows.s14",
          "type": "recap",
          "concept_ids": [
            "sql.where_filtering",
            "sql.logical_operators",
            "sql.null_handling"
          ],
          "title": "Recap: Filtering Rows",
          "eyebrow": "Recap",
          "lede": "Three tools for precise row selection: WHERE, logical operators, and IS NULL.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s14.p1",
              "text": "WHERE evaluates a condition for every row and keeps only those where it is true. Comparison operators (<, >, <=, >=, =, <>) produce the boolean result. AND, OR, and NOT combine conditions; AND binds before OR unless you add parentheses. NULL means unknown — use IS NULL or IS NOT NULL to test for missing values; = NULL never matches.",
              "role": "takeaway",
              "lineage": {
                "concept_ids": [
                  "sql.where_filtering",
                  "sql.logical_operators",
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.where_filtering#f1",
                  "sql.where_filtering#f2"
                ],
                "teaching_block_ids": [
                  "sql.where_filtering#tb4"
                ]
              }
            },
            {
              "type": "up_next",
              "block_id": "tile_sql_fund_filtering_rows.s14.un",
              "title": "Next: Sorting Results with ORDER BY",
              "text": "WHERE decides which rows come back, but not what order they appear in. Next you will use ORDER BY to sort results from slowest to fastest delivery — or any other direction you need."
            }
          ],
          "reward": {
            "gems": 5
          },
