        {
          "step_id": "tile_sql_fund_filtering_rows.s10",
          "type": "explainer",
          "concept_ids": [
            "sql.null_handling"
          ],
          "title": "Testing for missing values with IS NULL",
          "eyebrow": "NULL handling",
          "lede": "Missing values are unknown — use IS NULL and IS NOT NULL, never = NULL.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s10.p1",
              "text": "Some orders in the QuickCart database have no recorded delivery time — the value is missing, not zero. SQL represents a missing value with NULL. NULL means unknown: it is not known whether two unknown values are equal, so testing for NULL with an ordinary comparison operator does not work.",
              "role": "intro",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#f1"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb1"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s10.p2",
              "text": "To test whether a value is or is not null, use the predicates IS NULL and IS NOT NULL. WHERE delivery_time_minutes IS NULL finds the orders with a missing delivery time; WHERE delivery_time_minutes IS NOT NULL finds the rest.",
              "role": "definition",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#f2"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb2"
                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s10.p3",
              "text": "Writing WHERE delivery_time_minutes = NULL does not test for null. NULL is not considered 'equal to' NULL, so that comparison never evaluates to true, and the query silently returns zero rows instead of the missing-time orders you meant to find.",
              "role": "misconception",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#m1"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb3"
                ]
              }
            },
            {
              "type": "before_after",
              "block_id": "tile_sql_fund_filtering_rows.s10.ba",
              "before": {
                "type": "data_table",
                "block_id": "tile_sql_fund_filtering_rows.s10.before",
                "result_of": {
                  "runtime": "sql",
                  "sql": "SELECT order_id, customer_id, delivery_time_minutes FROM orders WHERE delivery_time_minutes = NULL",
                  "asset_mounts": [
                    {
                      "asset_id": "ds_orders",
                      "mount_path": "orders"
                    }
                  ]
                },
                "caption": "WHERE delivery_time_minutes = NULL — returns no rows (= NULL never evaluates to true)"
              },
              "after": {
                "type": "data_table",
                "block_id": "tile_sql_fund_filtering_rows.s10.after",
                "result_of": {
                  "runtime": "sql",
                  "sql": "SELECT order_id, customer_id, delivery_time_minutes FROM orders WHERE delivery_time_minutes IS NULL",
                  "asset_mounts": [
                    {
                      "asset_id": "ds_orders",
                      "mount_path": "orders"
                    }
                  ]
                },
                "caption": "WHERE delivery_time_minutes IS NULL — returns the two orders with a missing delivery time"
              },
              "change_summary": "Replacing = NULL with IS NULL returns the rows with a missing delivery time; = NULL silently returns nothing because NULL is not considered equal to NULL.",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#f1",
                  "sql.null_handling#f2",
                  "sql.null_handling#m1"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb2",
                  "sql.null_handling#tb3"
                ],
                "anchors": [
                  "sql.null_handling#visual"
                ]
              }
            }
          ],
          "reward": {
            "gems": 5
          },
          "lineage": {
            "concept_ids": [
              "sql.null_handling"
            ],
            "fact_ids": [
              "sql.null_handling#f1",
              "sql.null_handling#f2",
