      ],
      "remediation_steps": [
        {
          "step_id": "tile_sql_fund_filtering_rows.r01",
          "type": "remediation",
          "concept_ids": [
            "sql.where_filtering"
          ],
          "title": "Comparison operators: which one to use",
          "eyebrow": "Let's review",
          "lede": "Each comparison operator tests a different relationship between two values.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r01.p1",
              "text": "The six comparison operators are <, >, <=, >=, =, and <>. = tests whether two values are equal; <> (or !=) tests whether they are not equal. < and > test strict less-than and greater-than; <= and >= include the boundary value. WHERE delivery_time_minutes > 40 keeps rows where the time is strictly above 40; WHERE delivery_time_minutes >= 40 would also keep a row with exactly 40 minutes.",
              "role": "syntax",
              "lineage": {
                "concept_ids": [
                  "sql.where_filtering"
                ],
                "fact_ids": [
                  "sql.where_filtering#f2"
                ],
                "teaching_block_ids": [
                  "sql.where_filtering#tb3"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.where_filtering"
            ],
            "fact_ids": [
              "sql.where_filtering#f2"
            ],
            "teaching_block_ids": [
              "sql.where_filtering#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r02",
          "type": "remediation",
          "concept_ids": [
            "sql.where_filtering"
          ],
          "title": "How WHERE evaluates each row",
          "eyebrow": "Let's review",
          "lede": "WHERE tests the condition against every row and keeps only those where it is true.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r02.p1",
              "text": "WHERE takes a search condition and evaluates it for each row in the table. A row is kept only if the condition evaluates to true; rows where it is false are discarded. SELECT order_id FROM orders WHERE customer_id = 2 keeps only the rows where customer_id equals 2 and discards every other row.",
              "role": "definition",
              "lineage": {
                "concept_ids": [
                  "sql.where_filtering"
                ],
                "fact_ids": [
                  "sql.where_filtering#f1",
                  "sql.where_filtering#f2"
                ],
                "teaching_block_ids": [
                  "sql.where_filtering#tb2",
                  "sql.where_filtering#tb3"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.where_filtering"
            ],
            "fact_ids": [
              "sql.where_filtering#f1",
              "sql.where_filtering#f2"
            ],
            "teaching_block_ids": [
              "sql.where_filtering#tb2",
              "sql.where_filtering#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r03",
          "type": "remediation",
          "concept_ids": [
            "sql.where_filtering"
          ],
          "title": "Which rows does WHERE keep?",
          "eyebrow": "Let's review",
          "lede": "WHERE keeps a row only when the condition is true for that row.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r03.p1",
              "text": "Think of WHERE as a row-by-row question: for each row, is this condition true? If yes, the row appears in the result. If no, it is discarded. WHERE delivery_time_minutes > 40 asks that question for every order in the QuickCart table and returns only the orders where the delivery time is above 40 minutes.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "sql.where_filtering"
                ],
                "fact_ids": [
                  "sql.where_filtering#f1"
                ],
                "teaching_block_ids": [
                  "sql.where_filtering#tb2"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.where_filtering"
            ],
            "fact_ids": [
              "sql.where_filtering#f1"
            ],
            "teaching_block_ids": [
              "sql.where_filtering#tb2"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r04",
          "type": "remediation",
          "concept_ids": [
            "sql.logical_operators"
          ],
          "title": "Default evaluation order: NOT, then AND, then OR",
          "eyebrow": "Let's review",
          "lede": "Without parentheses, AND always binds before OR — which can change the rows you get.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r04.p1",
              "text": "When you write multiple conditions without parentheses, SQL evaluates NOT first, then AND, then OR. WHERE customer_id = 1 AND delivery_time_minutes > 30 OR customer_id = 2 is treated as (customer_id = 1 AND delivery_time_minutes > 30) OR customer_id = 2. That keeps every order from customer 2, regardless of delivery time — which may not be what you intended.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f2"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb3"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.logical_operators"
            ],
            "fact_ids": [
              "sql.logical_operators#f2"
            ],
            "teaching_block_ids": [
              "sql.logical_operators#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r05",
          "type": "remediation",
          "concept_ids": [
            "sql.logical_operators"
          ],
          "title": "Using parentheses to control AND/OR grouping",
          "eyebrow": "Let's review",
          "lede": "Parentheses override the default precedence so the OR is evaluated where you need it.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r05.p1",
              "text": "AND, OR, and NOT combine boolean conditions. AND is true only when both sides are true; OR is true when at least one side is true. By default AND binds before OR. Adding parentheses forces the OR to be evaluated first: WHERE customer_id = 1 AND (delivery_time_minutes > 30 OR customer_id = 2) evaluates the OR group first, then applies the AND — giving a different result set.",
              "role": "mechanism",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f1",
                  "sql.logical_operators#f2"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb2",
                  "sql.logical_operators#tb3"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.logical_operators"
            ],
            "fact_ids": [
              "sql.logical_operators#f1",
              "sql.logical_operators#f2"
            ],
            "teaching_block_ids": [
              "sql.logical_operators#tb2",
              "sql.logical_operators#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r06",
          "type": "remediation",
          "concept_ids": [
            "sql.logical_operators"
          ],
          "title": "AND, OR, and NOT: combining conditions",
          "eyebrow": "Let's review",
          "lede": "Use AND to require both conditions, OR to accept either, and NOT to exclude.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r06.p1",
              "text": "AND requires both conditions to be true: WHERE customer_id = 1 AND delivery_time_minutes > 30 keeps only customer 1's slow orders. OR accepts either: WHERE customer_id = 1 OR customer_id = 2 keeps orders from either customer. NOT reverses a condition: WHERE NOT (customer_id = 1) keeps every order that is not from customer 1.",
              "role": "definition",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f1"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb2"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.logical_operators"
            ],
            "fact_ids": [
              "sql.logical_operators#f1"
            ],
            "teaching_block_ids": [
              "sql.logical_operators#tb2"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r07",
          "type": "remediation",
          "concept_ids": [
            "sql.null_handling"
          ],
          "title": "Why = NULL never matches",
          "eyebrow": "Let's review",
          "lede": "NULL means unknown — and an unknown value is not considered equal to anything, including another unknown.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r07.p1",
              "text": "NULL represents an unknown value. It is not known whether two unknown values are equal, so the comparison delivery_time_minutes = NULL never evaluates to true — not even when the value is actually missing. The query runs without error but silently returns zero rows, which is not what you want when looking for missing delivery times.",
              "role": "misconception",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#f1",
                  "sql.null_handling#m1"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb1",
                  "sql.null_handling#tb3"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.null_handling"
            ],
            "fact_ids": [
              "sql.null_handling#f1",
              "sql.null_handling#m1"
            ],
            "teaching_block_ids": [
              "sql.null_handling#tb1",
              "sql.null_handling#tb3"
            ]
          }
        },
        {
          "step_id": "tile_sql_fund_filtering_rows.r08",
          "type": "remediation",
          "concept_ids": [
            "sql.null_handling"
          ],
          "title": "IS NULL and IS NOT NULL: the right predicates",
          "eyebrow": "Let's review",
          "lede": "Use IS NULL to find missing values and IS NOT NULL to find present ones.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.r08.p1",
              "text": "To test whether a value is missing, use IS NULL. To test whether a value is present, use IS NOT NULL. WHERE delivery_time_minutes IS NULL returns the orders with no recorded delivery time; WHERE delivery_time_minutes IS NOT NULL returns the orders that do have one. Together these two predicates cover the whole table.",
              "role": "definition",
              "lineage": {
                "concept_ids": [
                  "sql.null_handling"
                ],
                "fact_ids": [
                  "sql.null_handling#f2"
                ],
                "teaching_block_ids": [
                  "sql.null_handling#tb2"
                ]
              }
            }
          ],
          "lineage": {
            "concept_ids": [
              "sql.null_handling"
            ],
            "fact_ids": [
              "sql.null_handling#f2"
            ],
            "teaching_block_ids": [
              "sql.null_handling#tb2"
            ]
          }
        }
      ]
