        {
          "step_id": "tile_sql_fund_filtering_rows.s05",
          "type": "explainer",
          "concept_ids": [
            "sql.logical_operators"
          ],
          "title": "Combining conditions with AND, OR, and NOT",
          "eyebrow": "Logical operators",
          "lede": "Join multiple filter conditions to express precise requirements.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_sql_fund_filtering_rows.s05.p1",
              "text": "A WHERE clause often needs more than one condition at once — for example, orders from customer 1 that also took longer than 30 minutes. AND, OR, and NOT let you combine boolean conditions. AND is true only when both sides are true; OR is true when at least one side is true; NOT reverses a true or false value.",
              "role": "definition",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f1"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb1",
                  "sql.logical_operators#tb2"
                ]
              }
            },
            {
              "type": "side_by_side",
              "block_id": "tile_sql_fund_filtering_rows.s05.sbs",
              "left": {
                "type": "data_table",
                "block_id": "tile_sql_fund_filtering_rows.s05.left",
                "result_of": {
                  "runtime": "sql",
                  "sql": "SELECT order_id, customer_id, delivery_time_minutes FROM orders WHERE customer_id = 1 AND delivery_time_minutes > 30 OR customer_id = 2",
                  "asset_mounts": [
                    {
                      "asset_id": "ds_orders",
                      "mount_path": "orders"
                    }
                  ]
                },
                "caption": "Without parentheses: AND binds first, then OR"
              },
              "right": {
                "type": "data_table",
                "block_id": "tile_sql_fund_filtering_rows.s05.right",
                "result_of": {
                  "runtime": "sql",
                  "sql": "SELECT order_id, customer_id, delivery_time_minutes FROM orders WHERE customer_id = 1 AND (delivery_time_minutes > 30 OR customer_id = 2)",
                  "asset_mounts": [
                    {
                      "asset_id": "ds_orders",
                      "mount_path": "orders"
                    }
                  ]
                },
                "caption": "With parentheses: OR is evaluated first inside the group"
              },
              "left_label": "No parentheses",
              "right_label": "Parentheses around OR",
              "takeaway": "The same three conditions produce different result sets depending on where the parentheses go — AND always binds before OR unless you override it.",
              "lineage": {
                "concept_ids": [
                  "sql.logical_operators"
                ],
                "fact_ids": [
                  "sql.logical_operators#f1",
                  "sql.logical_operators#f2"
                ],
                "teaching_block_ids": [
                  "sql.logical_operators#tb2",
                  "sql.logical_operators#tb3"
                ],
                "anchors": [
                  "sql.logical_operators#visual"
                ]
              }
            }
          ],
          "reward": {
            "gems": 5
          },
          "lineage": {
            "concept_ids": [
              "sql.logical_operators"
            ],
            "fact_ids": [
              "sql.logical_operators#f1"
            ],
            "teaching_block_ids": [
              "sql.logical_operators#tb1",
              "sql.logical_operators#tb2"
            ],
            "anchors": [
