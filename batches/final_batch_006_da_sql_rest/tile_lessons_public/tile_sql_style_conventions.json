    {
      "step_id": "tile_sql_style_conventions.s04",
      "type": "recap",
      "concept_ids": [
        "sql.style_conventions"
      ],
      "title": "Recap: SQL Style Conventions",
      "eyebrow": "Recap",
      "lede": "Five rules that keep every query readable at a glance.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_style_conventions.s04.p1",
          "text": "Write reserved keywords in uppercase and column names in lowercase. Alias with AS and choose a name derived from the object — FROM orders AS o. Right-align root keywords to form a 'river', put each clause on its own line, and place a newline before AND or OR so every condition is easy to scan.",
          "role": "takeaway",
          "lineage": {
            "concept_ids": [
              "sql.style_conventions"
