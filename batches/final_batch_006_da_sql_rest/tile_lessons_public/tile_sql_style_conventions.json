        "anchors": [
          "sql.style_conventions#assessment:lay_out_a_query_with_line_breaks_and_spacing"
        ],
        "public": {
          "prompt": "Which version of this query follows the style-guide rules for keyword alignment, spacing, and line breaks?\n\n**A.**\n```sql\nSELECT order_id, amount FROM orders WHERE region='south' AND amount>5000\n```\n\n**B.**\n```sql\nSELECT order_id,\n       amount\n  FROM orders AS o\n WHERE o.region = 'south'\n   AND o.amount > 5000\n```\n\n**C.**\n```sql\nSELECT order_id, amount\nFROM orders\nWHERE region = 'south' AND\namount > 5000\n```\n\n**D.**\n```sql\nSELECT order_id,\n       amount\nFROM orders AS o\nWHERE o.region = 'south' AND o.amount > 5000\n```",
          "options": [
            {
              "option_id": "opt_a",
              "text": "A — single line, no spaces around ="
            },
            {
              "option_id": "opt_b",
              "text": "B — keywords right-aligned, AND on its own line"
            },
            {
              "option_id": "opt_c",
              "text": "C — AND at end of line, FROM not indented"
            },
            {
              "option_id": "opt_d",
              "text": "D — FROM not right-aligned, AND on same line as condition"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "A puts everything on one line with no spaces around = and no line breaks. The style guide requires each root keyword on its own line, spaces around =, and a newline before AND."
            },
            "opt_b": {
              "message": "Correct. B right-aligns the root keywords (SELECT, FROM, WHERE) so they end on the same character boundary, puts AND on its own line, and uses spaces around = — all required by the style guide."
            },
            "opt_c": {
              "message": "C puts AND at the end of the WHERE line rather than at the start of the next line. The style guide requires a newline *before* AND or OR, not after."
            },
            "opt_d": {
              "message": "D keeps AND on the same line as the first condition instead of starting a new line before it, and FROM is not right-aligned to the same column as SELECT and WHERE."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Each root keyword starts a new line and is right-aligned to the same column. AND and OR always start their own line. Spaces appear around = and after commas."
          },
          "incorrect": {
            "message": "Review the layout rules: each root keyword (SELECT, FROM, WHERE) starts a new line and is right-aligned so the keywords end on the same column. AND and OR always begin a new line, not end the previous one."
          },
          "hints": [
            "Look at where AND appears — does it end the previous line or start the next one?",
            "Check whether SELECT, FROM, and WHERE all end on the same character column."
          ],
          "remediation_step_id": "tile_sql_style_conventions.r01"
        }
      }
