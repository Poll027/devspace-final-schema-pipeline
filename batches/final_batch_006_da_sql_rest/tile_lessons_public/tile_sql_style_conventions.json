  "steps": [
    {
      "step_id": "tile_sql_style_conventions.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.style_conventions"
      ],
      "title": "SQL style conventions",
      "eyebrow": "Style guide",
      "lede": "Consistent formatting makes queries easier to read, review, and debug.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_style_conventions.s01.p1",
          "text": "Reserved keywords — SELECT, FROM, WHERE, AND, OR — should always be written in uppercase. Column names should always be written in lowercase, except where it makes sense not to, such as proper nouns. So SELECT customer_id, city FROM customers WHERE city = 'Lagos' follows the convention; a mix like select Customer_ID from Customers where City = 'Lagos' does not.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "sql.style_conventions"
            ],
            "fact_ids": [
              "sql.style_conventions#f1",
              "sql.style_conventions#f2"
            ],
            "teaching_block_ids": [
              "sql.style_conventions#tb1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_style_conventions.s01.p2",
          "text": "An alias name should relate to the object it aliases — as a rule of thumb, the first letter of each word in the object's name — and the AS keyword should always be included: FROM orders AS o, not FROM orders o or FROM orders AS x. Each root keyword starts a new line and is right-aligned so all keywords end on the same character boundary (a 'river'). Values sit left-aligned after them; spaces go around '=' and after commas; a newline comes before AND or OR so each condition starts its own line.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
              "sql.style_conventions"
            ],
            "fact_ids": [
              "sql.style_conventions#f3",
              "sql.style_conventions#f4",
              "sql.style_conventions#f5"
            ],
            "teaching_block_ids": [
              "sql.style_conventions#tb2"
            ]
          }
        },
        {
          "type": "before_after",
          "block_id": "tile_sql_style_conventions.s01.ba",
          "before": {
            "type": "code_walkthrough",
            "block_id": "tile_sql_style_conventions.s01.cw_before",
            "language": "sql",
            "code": "select customer_id,city from customers where city='Lagos' and customer_id>1",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 1,
                "text": "Keywords lowercase, column names lowercase, no line breaks, no spaces around operators"
              }
            ],
            "reveal": "all"
          },
          "after": {
            "type": "code_walkthrough",
            "block_id": "tile_sql_style_conventions.s01.cw_after",
            "language": "sql",
            "code": "  SELECT customer_id, city\n    FROM customers\n   WHERE city = 'Lagos'\n     AND customer_id > 1",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 1,
                "text": "Keywords uppercase; column names lowercase"
              },
              {
                "start_line": 2,
                "end_line": 2,
                "text": "FROM starts a new line, right-aligned to the 'river'"
              },
              {
                "start_line": 3,
                "end_line": 3,
                "text": "WHERE starts a new line; spaces around '='"
              },
              {
                "start_line": 4,
                "end_line": 4,
                "text": "AND on its own line, right-aligned"
              }
            ],
            "reveal": "all"
          },
          "change_summary": "The same query reformatted: keywords uppercased, each clause on its own right-aligned line, spaces around operators.",
