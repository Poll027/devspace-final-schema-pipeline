      "title": "Keyword and column casing",
      "eyebrow": "Let's review",
      "lede": "Keywords uppercase, column names lowercase — every time.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_style_conventions.r02.p1",
          "text": "Reserved keywords — SELECT, FROM, WHERE, AND, OR, AS, GROUP BY, ORDER BY — should always be uppercase. Column names should always be lowercase, except proper nouns. SELECT customer_id, city FROM customers WHERE city = 'Lagos' is correct; select Customer_ID from Customers where City = 'Lagos' breaks both rules.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
