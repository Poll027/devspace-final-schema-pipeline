  "remediation_steps": [
    {
      "step_id": "tile_sql_style_conventions.r01",
      "type": "remediation",
      "concept_ids": [
        "sql.style_conventions"
      ],
      "title": "The keyword 'river' and line-break rules",
      "eyebrow": "Let's review",
      "lede": "Right-align keywords to form a 'river'; put each clause and each AND/OR condition on its own line.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_style_conventions.r01.p1",
          "text": "Each root keyword — SELECT, FROM, WHERE — starts its own line and is right-aligned so all keywords end on the same character boundary, forming a vertical 'river'. Values sit left-aligned after them on the same line. Spaces go before and after '=' and after every comma. A newline always comes before AND or OR so each condition starts its own line: WHERE city = 'Lagos' / AND customer_id > 1, not WHERE city = 'Lagos' AND customer_id > 1 on one line.",
          "role": "syntax",
          "lineage": {
            "concept_ids": [
