  "steps": [
    {
      "step_id": "tile_sql_adv_execution_order_subquery_where.s01",
      "type": "explainer",
      "concept_ids": [
        "sql.clause_execution_order"
      ],
      "eyebrow": "Clause Execution Order",
      "title": "SQL clauses run in a different order than you write them",
      "lede": "You write SELECT first, but the database processes FROM first. Knowing the real order explains many surprising errors.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s01.b1",
          "role": "intro",
          "text": "A query like SELECT customer_id, AVG(delivery_time_minutes) AS avg_time FROM orders WHERE delivery_time_minutes > 0 GROUP BY customer_id HAVING AVG(delivery_time_minutes) > 30 ORDER BY avg_time DESC is written top to bottom, SELECT first — but that is not the order it is logically processed in.",
          "lineage": {
            "concept_ids": [
              "sql.clause_execution_order"
            ],
            "teaching_block_ids": [
              "sql.clause_execution_order#tb1"
            ],
            "fact_ids": [
              "sql.clause_execution_order#f1"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s01.b2",
          "role": "mechanism",
          "text": "In a SELECT's general processing order, the FROM list is computed first, then WHERE eliminates non-matching rows, then GROUP BY groups the rows and HAVING eliminates groups, then the SELECT output expressions are computed, and ORDER BY sorts the rows last. In the query above: orders is read, rows with delivery_time_minutes ≤ 0 are dropped, the remaining rows are grouped by customer_id, groups with an average ≤ 30 are removed, the SELECT computes avg_time, and ORDER BY sorts by it.",
          "lineage": {
            "concept_ids": [
              "sql.clause_execution_order"
            ],
            "teaching_block_ids": [
              "sql.clause_execution_order#tb2"
            ],
            "fact_ids": [
              "sql.clause_execution_order#f1"
            ]
          }
        },
        {
          "type": "process_flow",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s01.b3",
          "title": "SQL clause processing order",
          "direction": "LR",
