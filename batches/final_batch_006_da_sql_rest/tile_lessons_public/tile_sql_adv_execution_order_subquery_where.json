    {
      "step_id": "tile_sql_adv_execution_order_subquery_where.s10",
      "type": "recap",
      "concept_ids": [
        "sql.clause_execution_order",
        "sql.subquery_in_where"
      ],
      "eyebrow": "Recap",
      "title": "Execution order and WHERE subqueries",
      "lede": "Two ideas that explain how SQL really runs.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s10.b1",
          "role": "takeaway",
          "text": "SQL processes clauses in this order: FROM → WHERE → GROUP BY → HAVING → SELECT → ORDER BY. An alias defined in SELECT is visible in ORDER BY and GROUP BY, but not in WHERE or HAVING. A subquery in WHERE can return a single value for a comparison or a list of values for IN — the inner query runs first and its result is used by the outer WHERE.",
          "lineage": {
            "concept_ids": [
              "sql.clause_execution_order",
              "sql.subquery_in_where"
            ],
            "teaching_block_ids": [],
            "fact_ids": [
              "sql.clause_execution_order#f1",
              "sql.clause_execution_order#f2",
              "sql.subquery_in_where#f1",
              "sql.subquery_in_where#f2"
            ]
          }
        },
        {
          "type": "up_next",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s10.b2",
          "title": "Up next: Subqueries in FROM and CTEs",
          "text": "A subquery can also appear in FROM, acting as a virtual table. CTEs let you name that virtual table once with WITH and reuse it — making complex queries easier to read."
        }
      ],
