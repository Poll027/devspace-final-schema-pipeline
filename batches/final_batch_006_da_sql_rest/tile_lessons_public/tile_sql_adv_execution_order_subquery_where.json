    {
      "step_id": "tile_sql_adv_execution_order_subquery_where.s03",
      "type": "explainer",
      "concept_ids": [
        "sql.clause_execution_order"
      ],
      "eyebrow": "Clause Execution Order",
      "title": "Where an alias can — and cannot — be used",
      "lede": "SELECT runs after WHERE and HAVING, so an alias defined in SELECT isn't visible to those clauses.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_execution_order_subquery_where.s03.b1",
          "role": "misconception",
          "text": "An output column's alias, assigned with AS in the SELECT list, can be referred to in ORDER BY and GROUP BY, but not in WHERE or HAVING — those clauses run before SELECT, so the alias doesn't exist yet. In the example query, WHERE avg_time > 30 would fail; the expression must be written out in HAVING as AVG(delivery_time_minutes) > 30.",
          "lineage": {
            "concept_ids": [
              "sql.clause_execution_order"
            ],
            "teaching_block_ids": [
              "sql.clause_execution_order#tb3"
            ],
            "fact_ids": [
              "sql.clause_execution_order#f2"
            ]
          }
        }
      ],
