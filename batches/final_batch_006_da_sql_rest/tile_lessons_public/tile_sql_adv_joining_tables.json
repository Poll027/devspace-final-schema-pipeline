      "type": "remediation",
      "concept_ids": [
        "sql.composite_join_conditions"
      ],
      "eyebrow": "Let's revisit",
      "title": "Extending ON with AND: a clear contrast",
      "lede": "See what changes when you add a second condition to ON.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_joining_tables.r02.b1",
          "role": "example",
          "text": "Single-column join: FROM order_items AS oi JOIN shipments AS s ON oi.order_id = s.order_id — this matches every shipment for the same order, even if the product_id differs. Composite join: ON oi.order_id = s.order_id AND oi.product_id = s.product_id — now both columns must agree. Only the shipment for the exact same order and the exact same product is joined. The ON clause accepts any boolean expression, so AND works the same way it does in WHERE.",
          "lineage": {
