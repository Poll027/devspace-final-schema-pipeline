      "eyebrow": "Recap",
      "title": "Joins: what you've learned",
      "lede": "Three join patterns cover most real-world needs.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_joining_tables.s16.b1",
          "role": "takeaway",
          "text": "INNER JOIN keeps only rows with a match on both sides. Extend ON with AND to match on multiple columns, or use USING when the column names are identical. LEFT JOIN keeps every left-side row and NULL-fills the right side for unmatched rows; RIGHT and FULL extend that logic. OUTER is always optional.",
          "lineage": {
            "concept_ids": [
              "sql.inner_join",
              "sql.composite_join_conditions",
              "sql.outer_joins"
            ],
            "teaching_block_ids": [
