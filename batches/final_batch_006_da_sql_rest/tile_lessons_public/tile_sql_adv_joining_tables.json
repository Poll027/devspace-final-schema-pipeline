    {
      "step_id": "tile_sql_adv_joining_tables.s11",
      "type": "explainer",
      "concept_ids": [
        "sql.outer_joins"
      ],
      "eyebrow": "Outer Joins",
      "title": "RIGHT, FULL, and the optional OUTER keyword",
      "lede": "LEFT JOIN keeps every left-side row. RIGHT and FULL extend that logic to the other side or both sides.",
      "blocks": [
        {
          "type": "prose",
          "block_id": "tile_sql_adv_joining_tables.s11.b1",
          "role": "mechanism",
          "text": "A RIGHT OUTER JOIN is the converse of a left join: it keeps every row of T2, NULL-filling T1's columns for rows of T2 with no match. A FULL OUTER JOIN performs an inner join, then adds NULL-filled rows for the unmatched rows of both T1 and T2 — so no row from either table is lost.",
          "lineage": {
            "concept_ids": [
              "sql.outer_joins"
            ],
            "teaching_block_ids": [
              "sql.outer_joins#tb3"
            ],
            "fact_ids": [
              "sql.outer_joins#f2",
              "sql.outer_joins#f3"
            ]
          }
        },
        {
          "type": "prose",
          "block_id": "tile_sql_adv_joining_tables.s11.b2",
          "role": "syntax",
          "text": "INNER and OUTER are both optional keywords. LEFT, RIGHT, and FULL each already imply an outer join even without writing OUTER, so LEFT JOIN and LEFT OUTER JOIN mean exactly the same thing.",
          "lineage": {
            "concept_ids": [
              "sql.outer_joins"
