            ],
            "fact_ids": [
              "sql.inner_join#f1"
            ]
          }
        },
        {
          "type": "up_next",
          "block_id": "tile_sql_adv_joining_tables.s16.b2",
          "title": "Up next: Query Execution Order",
          "text": "SQL clauses are written in one order but processed in another — FROM first, SELECT last. Next you'll trace that order and learn where aliases can and cannot be used."
        }
