{
  "schema_version": "0.1.0",
  "kind": "interactions_part",
  "path_id": "data_analyst",
  "batch_id": "final_batch_001_da_canary",
  "tiles": [
    {
      "tile_id": "tile_data_shape_and_types",
      "interactions": [
        {
          "step_id": "tile_data_shape_and_types.s03",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_data_shape_and_types.s03",
            "difficulty": "intro",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "data.dataset_rows_columns",
                "capability": "identify_column_as_variable",
                "fact_ids": [
                  "f4"
                ]
              }
            ],
            "anchors": [],
            "public": {
              "prompt": "In Northstar's table, what does the `payment_method` column represent?",
              "selection": "single",
              "shuffle": true,
              "options": [
                {
                  "option_id": "o1",
                  "text": "One observation"
                },
                {
                  "option_id": "o2",
                  "text": "One individual value"
                },
                {
                  "option_id": "o3",
                  "text": "One variable recorded for every order"
                },
                {
                  "option_id": "o4",
                  "text": "The whole dataset"
                }
              ]
            },
            "grading": {
              "correct_option_ids": [
                "o3"
              ],
              "option_feedback": {
                "o1": {
                  "message": "A single observation is a row -- one order -- not a column."
                },
                "o2": {
                  "message": "One value is a single cell. The column is the whole attribute, recorded for every order."
                },
                "o4": {
                  "message": "The dataset is the whole table; a column is just one attribute within it."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Right: each column is one variable -- one attribute recorded for every observation."
              },
              "incorrect": {
                "message": "Not quite. Think about what runs down a column: one kind of information for every order."
              },
              "hints": [
                "Look at what is the same all the way down the payment_method column."
              ],
              "remediation_step_id": "tile_data_shape_and_types.r01"
            }
          }
        },
        {
          "step_id": "tile_data_shape_and_types.s04",
          "interaction": {
            "type": "table_select",
            "interaction_id": "ix.tile_data_shape_and_types.s04",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "data.dataset_rows_columns",
                "capability": "describe_dataset_structure",
                "fact_ids": [
                  "f1",
                  "f2"
                ]
              },
              {
                "concept_id": "data.dataset_rows_columns",
                "capability": "identify_row_as_observation",
                "fact_ids": [
                  "f3"
                ]
              },
              {
                "concept_id": "data.dataset_rows_columns",
                "capability": "identify_column_as_variable",
                "fact_ids": [
                  "f4"
                ]
              }
            ],
            "anchors": [
              "data.dataset_rows_columns#practice"
            ],
            "public": {
              "asset_ref": {
                "asset_id": "northstar_orders",
                "variant_id": null,
                "columns": [
                  "order_id",
                  "customer_segment",
                  "city",
                  "driver",
                  "items",
                  "order_value_ngn",
                  "delivery_minutes"
                ]
              },
              "intro": "Click a row, a column or a single cell, depending on the task.",
              "tasks": [
                {
                  "task_id": "t1",
                  "prompt": "Select the row for order NS1004.",
                  "target_kind": "row"
                },
                {
                  "task_id": "t2",
                  "prompt": "Select the column that tells us how long each delivery took.",
                  "target_kind": "column"
                },
                {
                  "task_id": "t3",
                  "prompt": "Select the exact cell that tells us how long order NS1003 took to arrive.",
                  "target_kind": "cell"
                }
              ]
            },
            "grading": {
              "answers": [
                {
                  "task_id": "t1",
                  "row": {
                    "where": {
                      "order_id": "NS1004"
                    }
                  }
                },
                {
                  "task_id": "t2",
                  "column": "delivery_minutes"
                },
                {
                  "task_id": "t3",
                  "row": {
                    "where": {
                      "order_id": "NS1003"
                    }
                  },
                  "column": "delivery_minutes",
                  "expect_value": 41
                }
              ],
              "task_feedback": {
                "t1": {
                  "incorrect": "Rows run across the table -- find the line for NS1004."
                },
                "t2": {
                  "incorrect": "Delivery time is one attribute recorded for every order, so it is a whole column."
                },
                "t3": {
                  "incorrect": "A single cell is where one order's row meets one variable's column."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Nice work. You can now read the basic shape of a dataset."
              },
              "incorrect": {
                "message": "Check the three tasks again: a row is one order, a column is one attribute."
              },
              "hints": [
                "Rows go across; columns go down."
              ],
              "remediation_step_id": "tile_data_shape_and_types.r01"
            }
          }
        },
        {
          "step_id": "tile_data_shape_and_types.s06",
          "interaction": {
            "type": "choice",
            "interaction_id": "ix.tile_data_shape_and_types.s06",
            "difficulty": "core",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "data.categorical_numeric_types",
                "capability": "classify_variable_type",
                "fact_ids": [
                  "f1",
                  "f2"
                ]
              }
            ],
            "anchors": [],
            "public": {
              "prompt": "Which column of Northstar's table is a numerical variable?",
              "selection": "single",
              "shuffle": true,
              "options": [
                {
                  "option_id": "o1",
                  "text": "city"
                },
                {
                  "option_id": "o2",
                  "text": "customer_segment"
                },
                {
                  "option_id": "o3",
                  "text": "delivery_minutes"
                },
                {
                  "option_id": "o4",
                  "text": "payment_method"
                }
              ]
            },
            "grading": {
              "correct_option_ids": [
                "o3"
              ],
              "option_feedback": {
                "o1": {
                  "message": "city's values (Lagos, Abuja, Kano) are labels for groups; there is nothing to add or subtract."
                },
                "o2": {
                  "message": "customer_segment holds group labels such as Student and Business, so it is categorical."
                },
                "o4": {
                  "message": "payment_method holds labels such as Card and Cash, so it is categorical."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Yes: delivery times can be added or subtracted meaningfully, so delivery_minutes is numerical."
              },
              "incorrect": {
                "message": "Ask of each column: does adding or subtracting its values mean anything?"
              },
              "hints": [
                "35 minutes plus 41 minutes means something -- does Lagos plus Abuja?"
              ]
            }
          }
        },
        {
          "step_id": "tile_data_shape_and_types.s07",
          "interaction": {
            "type": "classify",
            "interaction_id": "ix.tile_data_shape_and_types.s07",
            "difficulty": "stretch",
            "grading_mode": "client",
            "standalone": false,
            "measures": [
              {
                "concept_id": "data.categorical_numeric_types",
                "capability": "recognize_numeric_looking_categorical",
                "fact_ids": [
                  "m1"
                ]
              },
              {
                "concept_id": "data.categorical_numeric_types",
                "capability": "classify_variable_type",
                "fact_ids": [
                  "f1",
                  "f2"
                ]
              }
            ],
            "anchors": [
              "data.categorical_numeric_types#practice"
            ],
            "public": {
              "prompt": "Sort each value into the kind of variable its column is.",
              "buckets": [
                {
                  "bucket_id": "b_cat",
                  "label": "Categorical"
                },
                {
                  "bucket_id": "b_num",
                  "label": "Numerical"
                }
              ],
              "items": [
                {
                  "item_id": "i1",
                  "text": "Lagos",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1001"
                      }
                    },
                    "column": "city"
                  }
                },
                {
                  "item_id": "i2",
                  "text": "₦12,400",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1002"
                      }
                    },
                    "column": "order_value_ngn"
                  }
                },
                {
                  "item_id": "i3",
                  "text": "Student",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1001"
                      }
                    },
                    "column": "customer_segment"
                  }
                },
                {
                  "item_id": "i4",
                  "text": "48 minutes",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1002"
                      }
                    },
                    "column": "delivery_minutes"
                  }
                },
                {
                  "item_id": "i5",
                  "text": "103",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1006"
                      }
                    },
                    "column": "zone_code"
                  }
                },
                {
                  "item_id": "i6",
                  "text": "5 items",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1004"
                      }
                    },
                    "column": "items"
                  }
                },
                {
                  "item_id": "i7",
                  "text": "Card",
                  "source": {
                    "asset_id": "northstar_orders",
                    "row": {
                      "where": {
                        "order_id": "NS1002"
                      }
                    },
                    "column": "payment_method"
                  }
                }
              ]
            },
            "grading": {
              "assignments": {
                "i1": "b_cat",
                "i2": "b_num",
                "i3": "b_cat",
                "i4": "b_num",
                "i5": "b_cat",
                "i6": "b_num",
                "i7": "b_cat"
              },
              "role_map": {
                "b_cat": "categorical",
                "b_num": "numerical"
              },
              "item_feedback": {
                "i5": {
                  "message": "zone_code is written as digits, but adding or subtracting two zone codes means nothing -- it is a label, so it is categorical."
                },
                "i2": {
                  "message": "Order values can be added and subtracted, so this is numerical."
                },
                "i1": {
                  "message": "Lagos is a label for a group (a level), so it is categorical."
                }
              }
            },
            "feedback": {
              "correct": {
                "message": "Sorted. Note the zone code: digits do not make a variable numerical."
              },
              "incorrect": {
                "message": "At least one value is in the wrong group. Test each with: does adding or subtracting these values mean anything?"
              },
              "hints": [
                "Watch for a column that is stored as numbers but used as a label."
              ]
            }
          }
        }
      ]
    }
  ]
}
