          ],
          "title": "Rows run across, columns run down",
          "blocks": [
            {
              "type": "data_table",
              "asset_ref": {
                "asset_id": "northstar_orders",
                "variant_id": null,
                "columns": [
                  "order_id",
                  "city",
                  "payment_method",
                  "delivery_minutes"
                ]
              },
              "highlight": [
                {
                  "target": {
                    "kind": "row",
                    "row": {
                      "where": {
                        "order_id": "NS1002"
                      }
                    }
                  },
                  "label": "One order = one row",
                  "tone": "focus"
                },
                {
                  "target": {
                    "kind": "column",
                    "column": "payment_method"
                  },
                  "label": "One variable = one column",
                  "tone": "good"
                }
              ]
            },
            {
              "type": "prose",
              "text": "A row is one order -- everything we know about NS1002. A column is one attribute -- payment_method -- recorded for every order. A single value, like Card, is just one cell where a row and a column meet.",
              "role": "mechanism",
              "lineage": {
