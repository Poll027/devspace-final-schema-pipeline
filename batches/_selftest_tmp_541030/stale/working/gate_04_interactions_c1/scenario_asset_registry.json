      "currency": "NGN",
      "domain": "logistics / last-mile delivery",
      "glossary_example_vocab": [
        "order_id",
        "city",
        "delivery_time_minutes",
        "courier",
        "driver_id",
        "customer_id",
        "distance_km",
        "pickup_date",
