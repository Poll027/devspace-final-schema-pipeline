      "eyebrow": "Understand",
      "title": "Operating model",
      "blocks": [
        {
          "type": "prose",
          "text": "Configuration alone does not demonstrate behavior under disruption. Before the approved sandbox fault, define its limited scope, expected signals and abort conditions. During the fault, inspect alarm state history and actual notification receipt. Then remove the fault and verify recovery.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior"
            ],
