      "eyebrow": "Understand",
      "title": "Keep the evidence distinct",
      "blocks": [
        {
          "type": "prose",
          "text": "Keep the sandbox record in order: approved limits, fault, alarm behavior, notification receipt, then recovery. An absent notification is a result to preserve, not a successful test inferred from configuration.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior"
            ],
            "teaching_block_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#tb4",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#tb5"
            ],
            "fact_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f1",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f2",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "If an abort condition is reached, follow the approved stop path. Do not extend the fault to obtain a desired alarm. Retain missed signals, absent notifications and unsuccessful recovery honestly; this exercise does not authorize production disruption.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior"
            ],
            "teaching_block_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#tb4",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#tb5"
            ],
            "fact_ids": [
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f1",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f2",
              "aws_devops.inject_a_controlled_failure_and_verify_alarm_behavior#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        }
      ]
