      "eyebrow": "Understand",
      "title": "Operating model",
      "blocks": [
        {
          "type": "prose",
          "text": "Rightsizing matches resource type and size to workload performance and capacity requirements, not simply the smallest instance. Compare supplied load, utilization and performance with service constraints. Recommend a smaller instance only if those constraints remain satisfied. Include peak and changing demand; one low-utilization sample is not enough.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline"
            ],
