      "eyebrow": "Understand",
      "title": "Keep the evidence distinct",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare the current size and smaller candidate across normal, peak and changing demand. Keep observed load, measured utilization and latency separate from the recommendation they support.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline"
            ],
            "teaching_block_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#tb4",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#tb5"
            ],
            "fact_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f1",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f2",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "The current peak reaches the supplied latency boundary. The smaller candidate’s peak and changing-demand latency exceed the supplied bound, so the normal sample cannot justify that reduction. Preserve the constraints and withhold the unsupported reduction; do not invent a price comparison.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline"
            ],
            "teaching_block_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#tb4",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#tb5"
            ],
            "fact_ids": [
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f1",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f2",
              "aws_devops.rightsize_a_resource_using_a_supplied_workload_baseline#f3"
            ],
            "segment_ids": [],
            "anchors": []
          }
        }
      ]
