      "eyebrow": "Understand",
      "title": "Operating model",
      "blocks": [
        {
          "type": "prose",
          "text": "Terraform normally refreshes tracked resources before planning, exposing relevant out-of-band changes. Compare observed EC2 settings with configuration and choose an approved intent: restore the declaration or update it. Inspect a new plan, follow the approval/apply workflow, and verify live settings. Refresh-only planning proposes state and output updates; planning does not persist them. Applying the approved refresh-only plan persists those updates without restoring remote infrastructure to configuration.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.reconcile_terraform_ec2_drift"
            ],
