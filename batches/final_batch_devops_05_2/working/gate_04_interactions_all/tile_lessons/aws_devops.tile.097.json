        "public": {
          "prompt": "Finding excerpt: ID finding-sandbox; affected resource sandbox-workload-resource; reported activity ‘Finding reports suspicious activity on the affected resource.’ The excerpt contains no confirmed-compromise conclusion. Which handoff treatment preserves this excerpt’s evidentiary meaning?",
          "options": [
            {
              "option_id": "o1",
              "text": "Remove the finding reference and activity to make the handoff shorter."
            },
            {
              "option_id": "o2",
              "text": "Retain the finding reference and reported activity without declaring compromise unsupported by the record."
            },
            {
              "option_id": "o3",
              "text": "Replace the activity description with \"the resource is compromised\"."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o2"
          ],
          "option_feedback": {
            "o1": {
              "message": "A concise handoff must not erase the evidence needed by the responder."
            },
            "o2": {
              "message": "Preserve the evidence and avoid unsupported conclusions."
            },
            "o3": {
              "message": "A stronger unsupported compromise claim is not a substitute for the finding evidence."
            }
          }
        }
      }
