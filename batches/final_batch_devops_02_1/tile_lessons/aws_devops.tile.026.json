      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare the registered complete-sample windows with their evaluation settings and threshold comparisons. Then inspect all-missing windows under each policy. Keep real zero observations distinct from missing samples. Retain configuration, prior state and resulting state together rather than interpreting a gap as an observed zero or breach.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#tb4"
            ],
            "fact_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f1",
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f2",
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f3",
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "EvaluationPeriods is not the required breach count. Default missing does not mean every isolated gap immediately produces INSUFFICIENT_DATA.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
