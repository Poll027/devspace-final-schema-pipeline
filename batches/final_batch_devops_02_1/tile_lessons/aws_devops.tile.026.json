          ],
          "option_feedback": {
            "o1": {
              "message": "ignore retains the supplied current state."
            },
            "o2": {
              "message": "notBreaching, not ignore, yields OK for the all-missing window."
            },
            "o3": {
              "message": "missing yields INSUFFICIENT_DATA when all datapoints are missing; ignore retains state."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. A metric alarm evaluates a statistic over periods against a threshold and has OK, ALARM and INSUFFICIENT_DATA states. Missing-data settings are breaching, notBreaching, ignore (retain current state), and missing (insufficient data when all datapoints are missing); missing is the default."
          },
