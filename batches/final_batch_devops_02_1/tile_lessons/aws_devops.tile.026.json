      "eyebrow": "Understand",
      "title": "Configure CloudWatch alarm evaluation and missing-data behavior from supplied signals and thresholds",
      "blocks": [
        {
          "type": "prose",
          "text": "A metric alarm compares a statistic over periods with a threshold. Its states are OK, ALARM and INSUFFICIENT_DATA.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#tb2"
            ],
            "fact_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "EvaluationPeriods counts evaluated periods; DatapointsToAlarm counts breaches required within that window.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#tb3"
            ],
            "fact_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Set the supplied metric, statistic, period, comparison operator, threshold and evaluation counts. Compare the resulting state with the supplied samples.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#tb3"
            ],
            "fact_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Missing-data policies are breaching, notBreaching, ignore (retain current state), and missing (INSUFFICIENT_DATA when all datapoints are missing). The default is missing.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#tb3"
            ],
            "fact_ids": [
              "aws_devops.configure_cloudwatch_alarm_evaluation_and_missing_data_behavior_from_supplied_signals_and_thresholds#f4"
            ]
          }
        },
