          }
        ],
        "public": {
          "prompt": "Read each supplied validator review. Decide whether its configuration AND both rejection boundaries meet the approval. Approval: i-00000000000000001,i-00000000000000002; maximum targets 2.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the supplied criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Violates the supplied criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "FLEET_ALLOWED_INSTANCE_IDS='i-00000000000000001,i-00000000000000002'\nFLEET_MAX_TARGETS='2'\nmalformed: REJECTED; resource-changing calls=0\nout-of-scope i-00000000000000003: REJECTED; resource-changing calls=0"
            },
            {
              "item_id": "i2",
              "text": "FLEET_ALLOWED_INSTANCE_IDS='i-00000000000000001,i-00000000000000002,i-00000000000000003'\nFLEET_MAX_TARGETS='2'\nmalformed: REJECTED; resource-changing calls=0\nout-of-scope i-00000000000000003: ACCEPTED; resource-changing calls=1"
            },
            {
              "item_id": "i3",
              "text": "FLEET_ALLOWED_INSTANCE_IDS='i-00000000000000001,i-00000000000000002'\nFLEET_MAX_TARGETS='2'\nmalformed: REJECTED; resource-changing calls=1 before rejection\nout-of-scope i-00000000000000003: REJECTED; resource-changing calls=0"
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "Both string configuration values match approval; both cases reject before mutation."
            },
            "i2": {
              "message": "The configuration expands approved scope and the out-of-scope case is not rejected."
            },
            "i3": {
              "message": "Matching configuration does not excuse mutation before malformed-input rejection."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Process environment variables provide named string values that a supplied program can read as configuration. Set the supplied allowlist environment variable FLEET_ALLOWED_INSTANCE_IDS to the approved comma-separated IDs and the supplied FLEET_MAX_TARGETS variable to the approved positive integer limit; these are configuration inputs to the supplied validator, not Python language keywords."
          },
          "incorrect": {
