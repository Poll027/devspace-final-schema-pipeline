            "capability": "verify_malformed_input_rejection_before_mutation",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "A malformed-input test is rejected, but the operation trace shows a resource-changing call before rejection. What does this establish?",
          "options": [
            {
              "option_id": "o1",
              "text": "The required rejection boundary failed."
            },
            {
              "option_id": "o2",
              "text": "The test passed because rejection eventually occurred."
            },
            {
              "option_id": "o3",
              "text": "The configuration names alone establish safe enforcement."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Malformed input must be rejected before any resource-changing operation."
            },
            "o2": {
              "message": "A late rejection does not meet the before-mutation requirement."
            },
            "o3": {
              "message": "Configuration is not proof; the rejection case and operation evidence must agree."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Exercise malformed and out-of-scope inputs and check the supplied validator rejects them before invoking a resource-changing operation."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. Exercise malformed and out-of-scope inputs and check the supplied validator rejects them before invoking a resource-changing operation."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
