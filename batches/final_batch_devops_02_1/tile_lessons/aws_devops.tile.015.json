      "eyebrow": "Understand",
      "title": "Input target validation",
      "blocks": [
        {
          "type": "prose",
          "text": "Environment variables are named strings that a supplied program reads as configuration.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "automation.input_target_validation"
            ],
            "teaching_block_ids": [
              "automation.input_target_validation#tb2"
            ],
            "fact_ids": [
              "automation.input_target_validation#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Configure FLEET_ALLOWED_INSTANCE_IDS with approved comma-separated IDs and FLEET_MAX_TARGETS with the approved positive integer limit. These names configure the supplied validator; they are not Python keywords.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "automation.input_target_validation"
            ],
            "teaching_block_ids": [
              "automation.input_target_validation#tb3"
            ],
            "fact_ids": [
              "automation.input_target_validation#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Test malformed and out-of-scope inputs. Confirm rejection happens before any resource-changing operation.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "automation.input_target_validation"
            ],
            "teaching_block_ids": [
              "automation.input_target_validation#tb3"
