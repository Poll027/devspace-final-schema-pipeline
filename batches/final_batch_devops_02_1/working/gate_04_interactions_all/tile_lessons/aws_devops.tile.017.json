      "eyebrow": "Check your understanding",
      "title": "Judge the evidence",
      "lede": "Read the supplied case and choose the interpretation supported by its evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.017.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws.mfa_enforcement#assessment:distinguish_permitted_mfa_access_from_denied_non_mfa_access"
        ],
        "measures": [
          {
            "concept_id": "aws.mfa_enforcement",
            "capability": "distinguish_permitted_mfa_access_from_denied_non_mfa_access",
            "fact_ids": [
              "f1",
              "f2",
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "For a statement-scoped action, an existing Allow applies. The only relevant Deny uses BoolIfExists with aws:MultiFactorAuthPresent = false. The request has no such context key. Which outcome follows?",
          "options": [
            {
              "option_id": "o1",
              "text": "Denied by the supplied statement."
            },
            {
              "option_id": "o2",
              "text": "Allowed because absence always avoids BoolIfExists."
            },
            {
              "option_id": "o3",
              "text": "Denied for every action, even outside the statement scope."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "The scoped BoolIfExists Deny set to false also covers an absent key."
            },
            "o2": {
              "message": "This Deny also covers the absent-key case within its action scope."
            },
            "o3": {
              "message": "The statement only establishes a denial for its scoped actions."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. The aws:MultiFactorAuthPresent condition indicates whether qualifying temporary credentials were authenticated with MFA. A Deny with BoolIfExists on aws:MultiFactorAuthPresent set to false can block non-MFA requests, including requests where the key is absent, subject to the statement’s scoped actions. Apply the supplied scoped MFA policy and compare an allowed MFA-authenticated request with a denied request without MFA."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. The aws:MultiFactorAuthPresent condition indicates whether qualifying temporary credentials were authenticated with MFA. A Deny with BoolIfExists on aws:MultiFactorAuthPresent set to false can block non-MFA requests, including requests where the key is absent, subject to the statement’s scoped actions. Apply the supplied scoped MFA policy and compare an allowed MFA-authenticated request with a denied request without MFA."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.017.r01"
        }
      }
    },
