      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "Compare covered actions under the supplied policy. For qualifying MFA-authenticated temporary credentials, the true context does not match this Deny. False and absent contexts match the BoolIfExists Deny set to false. Compare the allowed MFA case with the denied non-MFA case without extending the result to actions outside the statement’s scope.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.mfa_enforcement"
            ],
            "teaching_block_ids": [
              "aws.mfa_enforcement#tb4"
            ],
            "fact_ids": [
              "aws.mfa_enforcement#f1",
              "aws.mfa_enforcement#f2",
              "aws.mfa_enforcement#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "An absent key is not automatically exempt from this scoped BoolIfExists Deny.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws.mfa_enforcement"
            ],
            "teaching_block_ids": [
              "aws.mfa_enforcement#tb5"
            ],
            "fact_ids": [
              "aws.mfa_enforcement#f1",
              "aws.mfa_enforcement#f2"
            ]
          }
        }
