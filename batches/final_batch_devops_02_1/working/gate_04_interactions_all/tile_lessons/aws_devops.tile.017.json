      "eyebrow": "Understand",
      "title": "MFA enforcement",
      "blocks": [
        {
          "type": "prose",
          "text": "aws:MultiFactorAuthPresent describes MFA authentication for qualifying temporary credentials.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.mfa_enforcement"
            ],
            "teaching_block_ids": [
              "aws.mfa_enforcement#tb2"
            ],
            "fact_ids": [
              "aws.mfa_enforcement#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A scoped Deny using BoolIfExists with aws:MultiFactorAuthPresent set to false can block non-MFA requests, including an absent key. Keep the statement’s action scope in view.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.mfa_enforcement"
            ],
            "teaching_block_ids": [
              "aws.mfa_enforcement#tb3"
            ],
            "fact_ids": [
              "aws.mfa_enforcement#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Apply the supplied scoped policy and compare an allowed MFA-authenticated request with a denied request without MFA.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.mfa_enforcement"
            ],
            "teaching_block_ids": [
              "aws.mfa_enforcement#tb3"
            ],
            "fact_ids": [
              "aws.mfa_enforcement#f3"
            ]
          }
