        "measures": [
          {
            "concept_id": "aws_devops.change_and_validate_a_linux_service_configuration",
            "capability": "restore_and_reactivate_supplied_prior_configuration_on_failure",
            "fact_ids": [
              "f2",
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "After activation, service status is running but the effective-setting check fails. Which response meets the taught failure procedure?",
          "options": [
            {
              "option_id": "o1",
              "text": "Restore the saved configuration, reactivate it, and verify status and the previous effective setting."
            },
            {
              "option_id": "o2",
              "text": "Restore the file without reactivation or checks."
            },
            {
              "option_id": "o3",
              "text": "Ignore the failed setting check because status is running."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Failure recovery requires restoration, reactivation and outcome checks."
            },
            "o2": {
              "message": "Restoring a file alone does not verify the active configuration."
            },
            "o3": {
              "message": "Running status is not proof that the intended setting is effective."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Identify and verify the supplied rollback files, change the supplied setting and run the supplied syntax or configuration check before activation. Use the service’s supported reload or restart procedure to activate a valid change, then inspect status and the supplied effective-setting check; on failure restore and reactivate the saved configuration."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. Identify and verify the supplied rollback files, change the supplied setting and run the supplied syntax or configuration check before activation. Use the service’s supported reload or restart procedure to activate a valid change, then inspect status and the supplied effective-setting check; on failure restore and reactivate the saved configuration."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.023.r01"
        }
