      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "For the sandbox service, verify rollback files before changing the supplied setting. Check syntax before activation, then inspect service status and the effective setting. If validation fails, restore the saved configuration and reactivate it. Retain each result separately: a reload or restart request is not a verified outcome.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.change_and_validate_a_linux_service_configuration"
            ],
            "teaching_block_ids": [
              "aws_devops.change_and_validate_a_linux_service_configuration#tb4"
            ],
            "fact_ids": [
              "aws_devops.change_and_validate_a_linux_service_configuration#f1",
              "aws_devops.change_and_validate_a_linux_service_configuration#f2",
              "aws_devops.change_and_validate_a_linux_service_configuration#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Activation is not validation. Restoring a file also needs reactivation.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.change_and_validate_a_linux_service_configuration"
            ],
            "teaching_block_ids": [
