            "concept_id": "aws_devops.attribute_workload_spend_using_resource_tags",
            "capability": "identify_spend_unallocated_to_the_intended_workload",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "A Cost Explorer report grouped by the active Workload tag includes spend from orders-untagged with Workload absent. How should that spend be treated?",
          "options": [
            {
              "option_id": "o1",
              "text": "Keep it unallocated and investigate missing tag evidence."
            },
            {
              "option_id": "o2",
              "text": "Assign it to orders from the resource name alone."
            },
            {
              "option_id": "o3",
              "text": "Claim activation necessarily allocates every resource."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Without the relevant active tag, spend can remain unallocated to the intended workload."
            },
            "o2": {
              "message": "Resource-associated tag evidence, not a suggestive name, establishes billing allocation."
            },
            "o3": {
              "message": "Activation does not supply a missing resource tag value."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Resources without the relevant active tag can leave spend unallocated to the intended workload category."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. Resources without the relevant active tag can leave spend unallocated to the intended workload category."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.021.r01"
        }
