      "eyebrow": "Understand",
      "title": "Attribute workload spend using resource tags",
      "blocks": [
        {
          "type": "prose",
          "text": "After billing activation, cost-allocation tags categorize costs by resource-associated tag keys and values.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags#tb2"
            ],
            "fact_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Activate the desired cost-allocation tag, then group Cost Explorer costs by that tag for the chosen period.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags#tb3"
            ],
            "fact_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Without the relevant active tag, resource spend can remain unallocated to the intended workload.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_workload_spend_using_resource_tags"
            ],
