      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "For the supplied 09:00–09:15 example, filter by the relevant attribute and compare candidate events. Use the operation and target fields as well as the timestamp. Record actor, operation, target and time together; a nearby event or a guessed resource owner is not attribution evidence.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#tb4"
            ],
            "fact_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f1",
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f2",
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Event history covers recent regional management events, not the sequence of all application requests.",
          "role": "misconception",
