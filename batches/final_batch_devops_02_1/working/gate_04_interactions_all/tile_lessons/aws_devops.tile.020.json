      "eyebrow": "Check your understanding",
      "title": "Judge the evidence",
      "lede": "Read the supplied case and choose the interpretation supported by its evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.020.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#assessment:identify_actor_operation_resource_and_time_from_event_fields"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence",
            "capability": "identify_actor_operation_resource_and_time_from_event_fields",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "A nearby CloudTrail event has the requested operation but a different target. What is the defensible attribution decision?",
          "options": [
            {
              "option_id": "o1",
              "text": "Compare operation and target, then record actor and time from the matching event."
            },
            {
              "option_id": "o2",
              "text": "Use the closest timestamp regardless of target."
            },
            {
              "option_id": "o3",
              "text": "Use the resource’s apparent owner instead of userIdentity."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Attribution requires eventName, target fields, userIdentity and eventTime together."
            },
            "o2": {
              "message": "Timestamp proximity alone cannot establish the requested change."
            },
            "o3": {
              "message": "The event’s userIdentity supplies actor evidence; an assumed owner is not attribution."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Inspect eventTime, eventName, userIdentity and requestParameters or resources to attribute a change to an actor, operation, target and time."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. Inspect eventTime, eventName, userIdentity and requestParameters or resources to attribute a change to an actor, operation, target and time."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.020.r01"
        }
      }
