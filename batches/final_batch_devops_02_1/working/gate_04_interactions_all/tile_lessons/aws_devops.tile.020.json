      "eyebrow": "Understand",
      "title": "Attribute an AWS change using CloudTrail evidence",
      "blocks": [
        {
          "type": "prose",
          "text": "CloudTrail event history shows recent management events in the selected Region, not all application activity.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#tb2"
            ],
            "fact_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Filter by an attribute such as event name, resource name or user name, plus the relevant time interval.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#tb3"
            ],
            "fact_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Read eventTime, eventName, userIdentity and requestParameters or resources to identify the time, operation, actor and target of a change.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence"
            ],
            "teaching_block_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#tb3"
            ],
            "fact_ids": [
              "aws_devops.attribute_an_aws_change_using_cloudtrail_evidence#f3"
            ]
          }
        },
        {
          "type": "diagram",
          "diagram_kind": "container",
          "title": "Authored read-only event-history example",
          "nodes": [
            {
              "id": "n1",
              "label": "Event history filter",
              "fields": [
                "Region: us-east-1; filter: Event name = StopInstances; interval: 09:00–09:15 UTC, 2026-01-15; requested target: i-00000000000000001"
              ]
            },
            {
              "id": "n2",
              "label": "Candidate comparison",
              "fields": [
                "Candidate A: eventTime 2026-01-15T09:05:00Z; eventName StopInstances; userIdentity arn:aws:iam::111122223333:user/orders-operator; requestParameters instanceId i-00000000000000002",
                "Candidate B: eventTime 2026-01-15T09:10:00Z; eventName StopInstances; userIdentity arn:aws:iam::111122223333:user/orders-operator; requestParameters instanceId i-00000000000000001"
              ]
            },
            {
              "id": "n3",
              "label": "Matching event fields",
              "fields": [
                "B matches the requested operation and target; A does not match the target"
