      "title": "Collect host telemetry with the CloudWatch agent",
      "blocks": [
        {
          "type": "prose",
          "text": "The CloudWatch agent sends configured host metrics and logs to CloudWatch.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.collect_host_telemetry_with_the_cloudwatch_agent"
            ],
