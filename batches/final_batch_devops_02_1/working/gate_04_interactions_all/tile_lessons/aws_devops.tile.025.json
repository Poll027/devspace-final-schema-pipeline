            "fact_ids": [
              "aws_devops.collect_host_telemetry_with_the_cloudwatch_agent#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Choose metrics under metrics_collected and append instance-identifying dimensions such as InstanceId.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.collect_host_telemetry_with_the_cloudwatch_agent"
            ],
