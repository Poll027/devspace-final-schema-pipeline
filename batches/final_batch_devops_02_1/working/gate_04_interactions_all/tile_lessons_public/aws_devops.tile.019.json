      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "Review the supplied root checklist item by item. Keep MFA protection, routine identity use and existing-key hygiene separate. A satisfactory MFA finding does not erase routine root use. Check whether each existing key remains needed and its removal status; do not create keys during the review.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.root_protection"
            ],
            "teaching_block_ids": [
              "aws.root_protection#tb4"
            ],
            "fact_ids": [
              "aws.root_protection#f1",
              "aws.root_protection#f2",
              "aws.root_protection#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Root’s broad authority is not a reason to use it for routine operations.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws.root_protection"
            ],
            "teaching_block_ids": [
              "aws.root_protection#tb5"
            ],
            "fact_ids": [
              "aws.root_protection#f1",
              "aws.root_protection#f2",
              "aws.root_protection#f3"
            ]
          }
        }
      ]
    },
