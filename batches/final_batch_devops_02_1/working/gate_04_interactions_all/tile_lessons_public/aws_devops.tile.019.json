        ],
        "measures": [
          {
            "concept_id": "aws.root_protection",
            "capability": "identify_routine_root_use_policy_violations",
            "fact_ids": [
              "f1",
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "Root MFA is enabled, but the checklist records root performing routine operations. How should that use be judged?",
          "options": [
            {
              "option_id": "o1",
              "text": "A routine-root-use violation; use non-root identities for routine work."
            },
            {
              "option_id": "o2",
              "text": "Acceptable because MFA removes the routine-use restriction."
            },
            {
              "option_id": "o3",
              "text": "Acceptable if no root access key was created."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Root has broad authority and should not perform routine tasks."
            },
            "o2": {
              "message": "MFA protection and routine-root-use findings are separate checks."
            },
            "o3": {
              "message": "Key hygiene does not make routine root operations appropriate."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. The AWS account root user has broad account authority and should not be used for routine tasks. Review root-use and access-key evidence against the root-protection checklist, using non-root identities for routine operations."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. The AWS account root user has broad account authority and should not be used for routine tasks. Review root-use and access-key evidence against the root-protection checklist, using non-root identities for routine operations."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.019.r01"
        }
      }
    },
