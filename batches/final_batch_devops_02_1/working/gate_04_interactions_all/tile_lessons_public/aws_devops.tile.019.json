      "eyebrow": "Understand",
      "title": "Root protection",
      "blocks": [
        {
          "type": "prose",
          "text": "Root has broad account authority, but routine tasks belong under non-root identities.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.root_protection"
            ],
            "teaching_block_ids": [
              "aws.root_protection#tb2"
            ],
            "fact_ids": [
              "aws.root_protection#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Protect root access with MFA. Do not create root access keys; delete existing keys when they are no longer needed.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.root_protection"
            ],
            "teaching_block_ids": [
              "aws.root_protection#tb3"
            ],
            "fact_ids": [
              "aws.root_protection#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Compare root-use and access-key evidence with the protection checklist. Use non-root identities for routine operations.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.root_protection"
            ],
            "teaching_block_ids": [
