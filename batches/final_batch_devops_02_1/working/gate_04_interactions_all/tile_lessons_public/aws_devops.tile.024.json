      "eyebrow": "Understand",
      "title": "Choose rolling, blue/green or canary delivery for stated availability and rollback requirements",
      "blocks": [
        {
          "type": "prose",
          "text": "Rolling delivery replaces workload portions progressively, not all instances simultaneously.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#tb2"
            ],
            "fact_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Blue/green keeps separate old and new environments, then switches traffic to the new environment.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#tb3"
            ],
            "fact_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Canary exposes a new version to a limited traffic share before broader rollout.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements"
            ],
            "teaching_block_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#tb3"
            ],
            "fact_ids": [
              "aws_devops.choose_rolling_blue_green_or_canary_delivery_for_stated_availability_and_rollback_requirements#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Compare traffic exposure, available parallel capacity and the route back to a known-good version when choosing a strategy.",
          "role": "mechanism",
