        "public": {
          "prompt": "Read these supplied proposals:\n```text\nRequirement: initial new-version traffic <=10%; extra capacity <= one full workload; retain a return route to known-good.\nRolling: first batch 25%; extra capacity one batch; replace changed portions to return.\nBlue/green: switch 100%; extra capacity one full workload; switch back to retained old environment.\nCanary: initial 10%; extra capacity 10% workload; route back to retained known-good.\n```\nWhich proposal meets all requirements?",
          "options": [
            {
              "option_id": "o1",
              "text": "Canary: limited exposure fits the bound and the retained version supplies the return route."
            },
            {
              "option_id": "o2",
              "text": "Blue/green: a return route makes the 100% switch meet the 10% bound."
            },
            {
              "option_id": "o3",
              "text": "Rolling: progressive replacement necessarily means at most 10% initial traffic."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "This proposal matches exposure, capacity and the stated return arrangement."
            },
            "o2": {
              "message": "Its return route does not remove the initial exposure violation."
            },
            "o3": {
              "message": "The supplied first batch exposes 25%; progressive replacement alone does not meet the bound."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Rolling delivery replaces portions of the workload progressively rather than replacing all instances simultaneously. Blue/green delivery maintains separate old and new environments and switches traffic to the new environment. Canary delivery exposes a new version to a limited share of traffic before broader rollout. Choose a strategy by comparing traffic exposure, available parallel capacity and the ability to return traffic to a known-good version."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. Rolling delivery replaces portions of the workload progressively rather than replacing all instances simultaneously. Blue/green delivery maintains separate old and new environments and switches traffic to the new environment. Canary delivery exposes a new version to a limited share of traffic before broader rollout. Choose a strategy by comparing traffic exposure, available parallel capacity and the ability to return traffic to a known-good version."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
