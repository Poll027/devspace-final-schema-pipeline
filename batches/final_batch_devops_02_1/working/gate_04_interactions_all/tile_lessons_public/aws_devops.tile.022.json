            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "public": {
          "prompt": "The orders collector is configured, but the known JSON event is found only in a different stream. What does the evidence establish?",
          "options": [
            {
              "option_id": "o1",
              "text": "Arrival in the intended stream is not verified."
            },
            {
              "option_id": "o2",
              "text": "The intended stream is verified because its group exists."
            },
            {
              "option_id": "o3",
              "text": "Any stream in the group proves the intended source arrived."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Verify the known event’s arrival in the configured group and stream."
            },
            "o2": {
              "message": "Group creation does not prove event delivery to the intended stream."
            },
            "o3": {
              "message": "A stream is an event sequence from one source; the intended destination matters."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. A log group holds log streams with shared retention and access settings; a stream is a sequence of events from one source. Configure the supplied log collector with the application file path, log group and stream name, and verify a known JSON event arrives in that stream."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. A log group holds log streams with shared retention and access settings; a stream is a sequence of events from one source. Configure the supplied log collector with the application file path, log group and stream name, and verify a known JSON event arrives in that stream."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.022.r01"
        }
