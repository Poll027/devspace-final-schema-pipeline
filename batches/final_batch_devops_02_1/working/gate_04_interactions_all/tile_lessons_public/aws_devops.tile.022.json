            "fact_ids": [
              "aws_devops.centralize_structured_application_logs_in_cloudwatch_logs#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Set the supplied collector’s application file path, group and stream name. Verify a known JSON event arrives in that stream.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.centralize_structured_application_logs_in_cloudwatch_logs"
            ],
            "teaching_block_ids": [
              "aws_devops.centralize_structured_application_logs_in_cloudwatch_logs#tb3"
            ],
            "fact_ids": [
              "aws_devops.centralize_structured_application_logs_in_cloudwatch_logs#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Preserve structured fields: CloudWatch Logs Insights can discover fields in JSON events and make them queryable.",
