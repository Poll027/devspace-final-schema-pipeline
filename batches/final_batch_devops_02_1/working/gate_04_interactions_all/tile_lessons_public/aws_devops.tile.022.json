      "eyebrow": "Understand",
      "title": "Centralize structured application logs in CloudWatch Logs",
      "blocks": [
        {
          "type": "prose",
          "text": "A log group shares retention and access settings across streams. A stream sequences events from one source.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.centralize_structured_application_logs_in_cloudwatch_logs"
            ],
