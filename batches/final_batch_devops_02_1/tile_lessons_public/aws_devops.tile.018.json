      },
      "eyebrow": "Check your understanding",
      "title": "Judge the evidence",
      "lede": "Read the supplied case and choose the interpretation supported by its evidence.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.018.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws.role_trust#assessment:distinguish_role_entry_from_assumed_session_permissions"
        ],
        "measures": [
          {
            "concept_id": "aws.role_trust",
            "capability": "distinguish_role_entry_from_assumed_session_permissions",
            "fact_ids": [
              "f4"
            ]
          }
        ],
        "public": {
          "prompt": "Read this review: Trust policy: Principal=approved caller; Action=sts:AssumeRole; supplied conditions preserved. Role permissions policy: permits the assumed session’s EC2 work. Reviewer conclusion: ‘The EC2 permissions determine who may assume the role.’ Which judgement is supported?",
          "options": [
            {
              "option_id": "o1",
              "text": "The conclusion is wrong: trust identifies permitted principals and assumption conditions; role permissions govern session work."
            },
            {
              "option_id": "o2",
              "text": "The conclusion is correct: EC2 permissions replace the trust policy."
            },
            {
              "option_id": "o3",
              "text": "The conclusion is correct: session permissions remove assumption conditions."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Trust identifies permitted principals and assumption conditions."
            },
            "o2": {
              "message": "Session permissions do not replace role trust"
            },
            "o3": {
              "message": "Session permissions do not remove trust-policy conditions."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. A role’s permissions policy controls what an assumed session may do, rather than who may assume it."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. A role’s permissions policy controls what an assumed session may do, rather than who may assume it."
          },
          "hints": [
            "Separate the configuration or approval from the recorded outcome.",
            "Check every named criterion, not only a successful status or familiar label."
          ],
          "remediation_step_id": "aws_devops.tile.018.r01"
        }
      }
