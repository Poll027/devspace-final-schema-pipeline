          }
        ],
        "public": {
          "prompt": "Read each cross-account role review and decide whether it satisfies the supplied approval. Only the supplied approved orders-operator caller may enter; Action must remain sts:AssumeRole and supplied conditions must be preserved. The approved caller must have permission on this role and both caller tests must be retained.",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the supplied criterion"
            },
            {
              "bucket_id": "fails",
              "label": "Violates the supplied criterion"
            }
          ],
          "items": [
            {
              "item_id": "i1",
              "text": "Trust Principal=only approved orders-operator caller; Action=sts:AssumeRole; supplied conditions unchanged. Caller permission=sts:AssumeRole on this role. Approved caller with conditions met: succeeds. Unapproved caller: rejected. Both outcomes retained."
            },
            {
              "item_id": "i2",
              "text": "Trust Principal=only approved orders-operator caller; Action=sts:AssumeRole; supplied conditions unchanged. Approved cross-account caller permission on this role: absent. Claimed result: approved caller succeeds because role permissions allow EC2 work. Unapproved caller rejected."
            },
            {
              "item_id": "i3",
              "text": "Trust Principal=approved caller plus unapproved caller; Action=sts:AssumeRole; supplied conditions removed. Both callers succeed."
            }
          ]
        },
        "grading": {
          "assignments": {
            "i1": "meets",
            "i2": "fails",
            "i3": "fails"
          },
          "item_feedback": {
            "i1": {
              "message": "The trust, caller permission and paired test outcomes meet the approval."
            },
            "i2": {
              "message": "Session permissions do not replace the cross-account caller’s AssumeRole permission."
            },
            "i3": {
              "message": "Trust must preserve the approved principal boundary and supplied conditions; the unapproved caller should be rejected."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. A role trust policy identifies principals allowed to assume the role and any conditions for assumption. Set Principal to the approved principal and Action to sts:AssumeRole with the supplied conditions in the role’s trust policy. For cross-account assumption, the caller also needs permission to call sts:AssumeRole on the role; test approved and unapproved principals."
          },
          "incorrect": {
            "message": "Compare the supplied evidence with the required criterion. A role trust policy identifies principals allowed to assume the role and any conditions for assumption. Set Principal to the approved principal and Action to sts:AssumeRole with the supplied conditions in the role’s trust policy. For cross-account assumption, the caller also needs permission to call sts:AssumeRole on the role; test approved and unapproved principals."
          },
