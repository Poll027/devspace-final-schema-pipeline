      },
      "eyebrow": "Apply the evidence",
      "title": "Compare the evidence, not the label",
      "blocks": [
        {
          "type": "prose",
          "text": "For cross-account entry to the orders-operator role, inspect both trust and caller-side AssumeRole permission. Compare approved and unapproved principals under the supplied conditions. After assumption, look to the role’s permissions policy for the session’s allowed work; the trust policy is not an operations allowlist.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb4"
            ],
            "fact_ids": [
              "aws.role_trust#f1",
              "aws.role_trust#f2",
              "aws.role_trust#f3",
              "aws.role_trust#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Role entry and session work are different checks; trust alone does not complete cross-account caller permission.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb5"
            ],
            "fact_ids": [
              "aws.role_trust#f1",
              "aws.role_trust#f3",
              "aws.role_trust#f4"
            ]
          }
        }
      ]
