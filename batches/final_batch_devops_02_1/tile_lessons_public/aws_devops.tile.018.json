      "eyebrow": "Understand",
      "title": "Configure role trust",
      "blocks": [
        {
          "type": "prose",
          "text": "A role trust policy identifies who may assume the role and the conditions for assumption.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb2"
            ],
            "fact_ids": [
              "aws.role_trust#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "In the trust policy, use the approved Principal, Action sts:AssumeRole and the supplied conditions.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb3"
            ],
            "fact_ids": [
              "aws.role_trust#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Cross-account callers also need permission to call sts:AssumeRole on the role. Test approved and unapproved principals.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb3"
            ],
            "fact_ids": [
              "aws.role_trust#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The role’s permissions policy governs an assumed session’s work, not who may enter the role.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws.role_trust"
            ],
            "teaching_block_ids": [
              "aws.role_trust#tb3"
            ],
            "fact_ids": [
              "aws.role_trust#f4"
            ]
          }
        },
