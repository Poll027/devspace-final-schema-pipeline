                ]
              }
            },
            {
              "type": "prose",
              "block_id": "tile_pandas_dataframe_reading.r01.b2",
              "role": "mechanism",
              "text": "Use `orders['delivery_time_minutes']` to pull the delivery-time column out of the SwiftDrop orders table. The result is a Series — the same one-dimensional, indexed structure — sharing the DataFrame's index. `orders['courier'] = ['Ada', 'Bayo', 'Chidi']` adds a new column using the same dict-style syntax.",
              "lineage": {
                "concept_ids": [
                  "pandas.dataframe_series_model"
