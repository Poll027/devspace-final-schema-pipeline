          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_pandas_dataframe_reading.r01.b1",
              "role": "definition",
              "text": "A **Series** is a one-dimensional labeled array — its labels are the index. A **DataFrame** is a two-dimensional structure you can think of as a dict of Series sharing one index. Every column in a DataFrame is itself a Series.",
              "lineage": {
                "concept_ids": [
                  "pandas.dataframe_series_model"
                ],
