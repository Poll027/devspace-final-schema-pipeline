      "title": "Read from consumer to supplier",
      "blocks": [
        {
          "type": "prose",
          "text": "The handler declares a needed type and names its supplying callable through Depends. FastAPI resolves that callable’s inputs, executes it and gives the returned value to the handler.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f1",
              "fastapi_backend.depends#f2"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Pass provider rather than calling provider() in the declaration. Another operation can declare the same reusable provider. This makes the supplier visible; it does not establish an application-lifetime value store.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f2",
              "fastapi_backend.depends#f3"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb4"
            ]
          }
        }
      ]
    },
    {
      "step_id": "tile_032.s03",
      "type": "explainer",
      "concept_ids": [
        "fastapi_backend.depends"
      ],
      "lineage": {
