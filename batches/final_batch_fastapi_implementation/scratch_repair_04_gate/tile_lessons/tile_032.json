      "title": "Declare the supplied input",
      "blocks": [
        {
          "type": "prose",
          "text": "Use Annotated[Type, Depends(provider)] to declare an input that FastAPI supplies by executing the provider. Pass the callable provider, not provider(). FastAPI can then resolve the provider’s inputs.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f1",
              "fastapi_backend.depends#f2"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb2",
              "fastapi_backend.depends#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Dependencies expose needed inputs at the handler and let multiple operations reuse input-provision logic rather than relying on an invisible global lookup.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f3"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "from typing import Annotated\nfrom fastapi import FastAPI, Depends\napp = FastAPI()\n\ndef provider() -> str:\n    return \"synthetic-auth-context-not-verified\"\n\n@app.get(\"/orders\")\ndef orders(context: Annotated[str, Depends(provider)]):\n    return {\"context\": context}\n",
          "annotations": [
            {
              "start_line": 5,
              "end_line": 5,
              "text": "Reusable input supplier; its synthetic value is not verified authentication."
            },
            {
              "start_line": 9,
              "end_line": 9,
              "text": "Pass the callable to Depends, not provider(). FastAPI resolves inputs, executes it and supplies its value here."
            },
            {
              "start_line": 10,
              "end_line": 10,
              "text": "The handler uses the supplied argument."
            }
          ],
          "reveal": "all",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb1",
              "fastapi_backend.depends#tb2",
              "fastapi_backend.depends#tb3"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f1",
