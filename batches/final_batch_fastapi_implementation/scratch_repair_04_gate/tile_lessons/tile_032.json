      },
      "title": "Callable, resolution, value",
      "blocks": [
        {
          "type": "prose",
          "text": "Annotated[Type, Depends(provider)] describes input provisioning: resolve the provider’s inputs, execute it and supply its result to the handler. Passing the callable preserves that instruction; calling it in advance is different.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f1",
              "fastapi_backend.depends#f2"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb5",
              "fastapi_backend.depends#tb6"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Multiple operations can declare the same input supplier. Keep each needed input explicit at its consumer rather than hiding it in a global lookup.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f3"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb5"
            ]
          }
        }
      ]
    },
