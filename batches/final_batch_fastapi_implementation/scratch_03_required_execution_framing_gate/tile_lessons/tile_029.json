              "segment_id": "seg_fastapi.modular_application_NkgIHa6KtHg_67_145",
              "video_id": "NkgIHa6KtHg",
              "youtube_url": "https://www.youtube.com/watch?v=NkgIHa6KtHg",
              "review_url": "https://www.youtube.com/watch?v=NkgIHa6KtHg&t=67s",
              "start_seconds": 67,
              "end_seconds": 145,
              "label": "Register feature operations on APIRouter and include them in the application",
              "summary": "APIRouter organizes related operations in separate modules. Create a router in a feature module, then register operations with router.get or router.post instead of app.get or app.post. The main module includes the router with app.include_router. Moving existing operations into feature modules can preserve their external URLs and behavior while improving internal organization. Inclusion also supports common prefixes and tags.",
              "fact_ids": [
                "f1",
                "f2"
              ],
              "transcript_ref": "NkgIHa6KtHg:67-145"
            }
          ],
          "group_title": "Feature registration and application assembly",
          "bridge": {
            "before": "Watch for the distinction between registering operations on APIRouter and including that router in the application. The other-framework analogy is optional; focus on the FastAPI declarations.",
            "after": "The clip names prefixes and tags but does not explain path concatenation or inclusion-level dependencies and responses. The text supplies these details, including how /api and /orders become /api/orders."
          },
          "default_mode": "video"
        }
