          ],
          "option_feedback": {
            "o1": {
              "message": "Import feature routers and call app.include_router(router) to assemble their operations into the application. An include_router prefix adds to the included operations' paths, and tags, dependencies and responses can be supplied at inclusion."
            },
            "o2": {
              "message": "Feature registration belongs to the router; the application must explicitly include it."
            },
            "o3": {
              "message": "An import alone does not perform the required application inclusion."
            }
          }
        },
