              "option_id": "o1",
              "text": "Import its router in the application module and call app.include_router(router)."
            },
            {
              "option_id": "o2",
              "text": "Register with @router.get and assume that every FastAPI app discovers it."
            },
            {
              "option_id": "o3",
              "text": "Import the feature module but never include its router."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
