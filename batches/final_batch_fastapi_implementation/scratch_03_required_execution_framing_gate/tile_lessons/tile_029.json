      "title": "Register a feature, then include it",
      "blocks": [
        {
          "type": "prose",
          "text": "Create an APIRouter and register the feature’s operations on it. The main application imports that router and calls app.include_router(router) to assemble its operations.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi.modular_application"
            ],
            "fact_ids": [
              "fastapi.modular_application#f1",
              "fastapi.modular_application#f2"
            ],
            "teaching_block_ids": [
              "fastapi.modular_application#tb2",
              "fastapi.modular_application#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "An inclusion prefix adds to local paths. Inclusion can also supply tags, dependencies and responses.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi.modular_application"
            ],
            "fact_ids": [
              "fastapi.modular_application#f3"
            ],
            "teaching_block_ids": [
              "fastapi.modular_application#tb3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "# Feature module: orders.py\nfrom fastapi import APIRouter\nrouter = APIRouter()\n@router.get(\"/orders\")\ndef list_orders():\n    return []\n\n# Application assembly module: main.py\nfrom fastapi import FastAPI\napp = FastAPI()\nfrom orders import router\napp.include_router(router, prefix=\"/api\")\n",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Feature module registers operations on its router."
            },
            {
              "start_line": 3,
              "end_line": 3,
              "text": "Local /orders registration."
            },
            {
              "start_line": 11,
              "end_line": 11,
              "text": "Application inclusion adds /api: assembled path /api/orders."
            }
          ],
          "reveal": "all",
          "lineage": {
            "concept_ids": [
              "fastapi.modular_application"
            ],
            "teaching_block_ids": [
              "fastapi.modular_application#tb1",
              "fastapi.modular_application#tb2",
              "fastapi.modular_application#tb3"
            ],
            "fact_ids": [
              "fastapi.modular_application#f1",
