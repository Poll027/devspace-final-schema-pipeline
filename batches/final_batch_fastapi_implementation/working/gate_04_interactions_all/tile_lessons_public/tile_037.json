      "blocks": [
        {
          "type": "prose",
          "text": "The last middleware added is the outermost wrapper: requests traverse it first, while responses traverse it last. For two middleware additions, trace the request through the second addition then the first and into the handler, and trace the resulting response through the first addition then the second.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi.existing_middleware_stack"
            ],
            "teaching_block_ids": [
              "fastapi.existing_middleware_stack#tb2",
