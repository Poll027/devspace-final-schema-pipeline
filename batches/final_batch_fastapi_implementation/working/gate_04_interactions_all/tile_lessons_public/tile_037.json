              "fastapi.existing_middleware_stack#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Adding A then B puts B outside A, not inside it. Requests travel B → A → handler; responses travel handler → A → B, not the same sequence.",
          "role": "example",
