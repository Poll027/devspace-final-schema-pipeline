              "segment_id": "seg_fastapi_backend.depends_f270BoTicMA_323_534",
              "video_id": "f270BoTicMA",
              "youtube_url": "https://www.youtube.com/watch?v=f270BoTicMA",
              "review_url": "https://www.youtube.com/watch?v=f270BoTicMA&t=323s",
              "start_seconds": 323,
              "end_seconds": 534,
              "label": "Supply a service object with Depends and Annotated",
              "summary": "A simple Logger class illustrates a service object that an endpoint needs. Constructing that object inside each handler repeats the provision logic. Moving construction into get_logger gives handlers a reusable provider that returns a new Logger. Depends connects the handler’s declared input to that provider. An Annotated[Logger, Depends(get_logger)] alias then makes the same declaration reusable without repeating it in every handler. The reuse concerns the declaration and provision logic; the provider still constructs a new object.",
              "fact_ids": [
                "f1",
                "f3"
              ],
              "transcript_ref": "f270BoTicMA:323-534"
            }
          ],
          "group_title": "Make a handler’s supplied service input explicit",
          "bridge": {
            "before": "Watch how construction moves from the handler into a provider, then becomes an Annotated input. The clip’s wording about avoiding repeated instantiation means avoiding manual construction in handlers, not sharing one application-wide object.",
            "after": "The clip demonstrates supplied inputs and reusable declarations. It does not explain why Depends receives the callable rather than its result; the text covers that distinction so FastAPI can resolve the provider’s inputs."
          },
          "default_mode": "video"
        }
      ]
