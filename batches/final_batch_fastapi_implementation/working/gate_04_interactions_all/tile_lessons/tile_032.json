        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Declare a handler input with Annotated[Type, Depends(provider)] to have FastAPI execute the provider and supply its returned value.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb2"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Pass the provider callable to Depends rather than calling it in the declaration, so FastAPI can resolve its inputs. A dependency makes a handler's needed input explicit and can be reused by multiple operations for shared input-provision logic.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb3"
            ],
            "fact_ids": [
              "fastapi_backend.depends#f2",
              "fastapi_backend.depends#f3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "from typing import Annotated\nfrom fastapi import FastAPI, Depends\napp = FastAPI()\n\ndef provider() -> str:\n    return \"synthetic-auth-context-not-verified\"\n\n@app.get(\"/orders\")\ndef orders(context: Annotated[str, Depends(provider)]):\n    return {\"context\": context}\n",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 10,
              "text": "Declare a typed parameter with Annotated[Type, Depends(provider)]. Pass the callable, not provider(). FastAPI resolves the provider and supplies its result before calling the operation. Another operation can declare the same provider for reusable input-provision logic. This is an explicit input, not an application-wide hidden value store."
            }
          ],
          "reveal": "all",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb1",
              "fastapi_backend.depends#tb2",
              "fastapi_backend.depends#tb3"
            ],
            "fact_ids": [
