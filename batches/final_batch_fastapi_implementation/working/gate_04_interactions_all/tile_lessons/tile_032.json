      "blocks": [
        {
          "type": "prose",
          "text": "Read the orders handler backward from return {\"context\": context} to its Annotated[str, Depends(provider)] parameter. The returned context is the explicit handler argument supplied when FastAPI executes the provider and resolves its inputs. Depends receives provider itself, not provider() evaluated in the declaration. Another operation can declare the same supplier for shared input-provision logic; reuse is visible at each consuming parameter rather than hidden in an application-wide value store.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "fastapi_backend.depends"
            ],
            "teaching_block_ids": [
              "fastapi_backend.depends#tb5",
