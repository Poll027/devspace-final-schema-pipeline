        "anchors": [
          "mle.model_risk_documentation#assessment:document_task_limits_and_foreseeable_misuse_under_existing_policy"
        ]
      },
      "title": "Check the distinction",
      "lede": "Read the supplied evidence and choose the response that follows the declared rule.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.mle.tile.033_033.s04",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "mle.model_risk_documentation",
            "fact_ids": [
              "f4"
            ],
            "capability": "document_task_limits_and_foreseeable_misuse_under_existing_policy"
          }
        ],
        "anchors": [
          "mle.model_risk_documentation#assessment:document_task_limits_and_foreseeable_misuse_under_existing_policy"
        ],
        "feedback": {
          "correct": {
            "message": "Your result follows the fixed evidence and the declared conditioning populations."
          },
          "incorrect": {
            "message": "Recheck which observations belong in each denominator and keep the declared decision inputs fixed."
          },
          "hints": [
            "Separate the observations being measured from the fixed decision assumptions.",
            "Check each required field against the supplied evidence before drawing the conclusion."
          ],
          "remediation_step_id": "mle.tile.033_033.r01"
        },
        "public": {
          "prompt": "An existing policy permits identity A; a supplied access-grant record includes A and B. What belongs in the risk record?",
          "options": [
            {
              "option_id": "o1",
              "text": "Preserve permitted scope A and identify B as an out-of-scope grant."
            },
            {
              "option_id": "o2",
              "text": "Expand the permitted scope to A and B to match observed grants."
            },
            {
              "option_id": "o3",
              "text": "Copy any exposed credential value as evidence of the grant."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "o1"
          ],
          "option_feedback": {
            "o1": {
              "message": "Record the deviation without redefining the existing authorization policy."
            },
            "o2": {
              "message": "Observed grants do not authorize extending the permitted identity scope."
            },
            "o3": {
              "message": "Describe exposure location and handling limitation without copying secrets."
            }
          }
        }
      }
    },
