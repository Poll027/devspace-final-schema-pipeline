      "title": "Write one bounded risk record",
      "lede": "Use the supplied policy and evaluation evidence to record mismatches and limitations without changing permissions or copying secrets.",
      "interaction": {
        "type": "external_proof",
        "interaction_id": "ix.mle.tile.033_033.s05",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "measures": [
          {
            "concept_id": "mle.model_risk_documentation",
            "fact_ids": [
              "f1"
            ],
            "capability": "audit_access_grants_against_permitted_identity_scope"
          },
          {
            "concept_id": "mle.model_risk_documentation",
            "fact_ids": [
              "f2"
            ],
            "capability": "document_credential_exposure_without_disclosing_secrets"
          },
          {
