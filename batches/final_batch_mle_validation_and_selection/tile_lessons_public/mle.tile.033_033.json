            "fact_ids": [
              "f3"
            ],
            "capability": "state_evidence_supported_segment_limitations"
          },
          {
            "concept_id": "mle.model_risk_documentation",
            "fact_ids": [
              "f4"
            ],
            "capability": "document_task_limits_and_foreseeable_misuse_under_existing_policy"
          }
        ],
        "anchors": [
          "mle.model_risk_documentation#practice",
          "mle.model_risk_documentation#assessment:audit_access_grants_against_permitted_identity_scope",
          "mle.model_risk_documentation#assessment:document_credential_exposure_without_disclosing_secrets",
          "mle.model_risk_documentation#assessment:state_evidence_supported_segment_limitations",
          "mle.model_risk_documentation#assessment:document_task_limits_and_foreseeable_misuse_under_existing_policy"
        ],
        "feedback": {
          "correct": {
            "message": "The single record preserves policy scope and cites bounded supplied evidence without exposing secrets."
          },
          "incorrect": {
            "message": "Retain every existing-policy field, identify scope deviations, and separate sample evidence from universal suitability."
          },
          "hints": [
            "Separate existing permission scope from observed grants.",
            "Describe exposure handling without reproducing credential values."
          ],
          "remediation_step_id": "mle.tile.033_033.r02"
        },
        "public": {
          "instruction": "Produce one text risk-and-use record. Preserve existing policy; do not copy secrets or create new permissions.\npermitted_identities: permitted=A; observed=A and B.\ncredential_handling: permitted=do not reproduce secret values; observed=sample_image.credential_field [REDACTED].\npermitted_use: permitted=evaluate supplied order-task validation evidence; observed=task-specific validation fixture.\ntask_limits: permitted=supplied order task and validation cohort only; observed=no evidence outside the supplied cohort.\nforeseeable_misuse: documented misuse=aggregate improvement used as universal segment suitability; observed=zone A and B have different observed sample errors.\nsegment_evidence: permitted=retain supported sample limitations; observed=zone B has higher observed eligible error proportion than zone A.\nAccess grants: A granted=True, B granted=True.\nSlice evidence: A 2/40=0.05, B 6/20=0.3.\nAggregate and segment errors: reference 12/60=0.2, model 8/60=0.13333333333333333. Retain all scope, task, misuse and redacted-exposure limitations; sample evidence is not universal suitability.",
          "evidence_kinds": [
            "text",
            "file"
          ],
          "checklist": [
            "Preserve the existing permitted identity scope A and identify the observed B grant as out of scope.",
            "Document only the redacted credential field location and handling limitation, never a secret value.",
            "Retain permitted use, task/cohort limits and foreseeable misuse fields without expanding permissions.",
            "Cite the supplied zone sample proportions and counts; state representation beyond the sample is unresolved and aggregate improvement is not universal suitability."
          ]
        },
        "grading": {
          "mode": "manual",
          "rubric": [
            {
              "criterion": "Preserve the existing permitted identity scope A and identify the observed B grant as out of scope.",
              "weight": 1
            },
            {
              "criterion": "Document only the redacted credential field location and handling limitation, never a secret value.",
              "weight": 1
            },
            {
              "criterion": "Retain permitted use, task/cohort limits and foreseeable misuse fields without expanding permissions.",
              "weight": 1
            },
            {
              "criterion": "Cite the supplied zone sample proportions and counts; state representation beyond the sample is unresolved and aggregate improvement is not universal suitability.",
              "weight": 1
            }
          ]
        }
      }
