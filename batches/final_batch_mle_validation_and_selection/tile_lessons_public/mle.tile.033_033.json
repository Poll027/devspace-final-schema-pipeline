          "mle.model_risk_documentation#f4"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "title": "Documentation is not permission",
      "blocks": [
        {
          "type": "prose",
          "text": "Documentation is not authorization. Do not enlarge identity scope, claim universal suitability or disclose the credential being flagged.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "mle.model_risk_documentation"
            ],
            "teaching_block_ids": [
              "mle.model_risk_documentation#tb5"
            ],
            "fact_ids": [
              "mle.model_risk_documentation#f1",
              "mle.model_risk_documentation#f2",
