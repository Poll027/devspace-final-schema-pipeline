      "title": "Preserve existing scope",
      "blocks": [
        {
          "type": "prose",
          "text": "Build one bounded risk record from existing policy and supplied evidence. Documentation must not expand permissions or reproduce exposed secrets.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "mle.model_risk_documentation"
            ],
            "teaching_block_ids": [
              "mle.model_risk_documentation#tb1"
            ],
            "fact_ids": []
          }
        },
        {
          "type": "prose",
          "text": "Compare observed grants with existing permitted identities and record out-of-scope grants rather than defining a new policy. Literal credentials in images or metadata are exposure risks: describe the handling limitation without copying the secret. Aggregate improvement can coexist with segment differences; state supported evaluation limitations, not universal suitability.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "mle.model_risk_documentation"
            ],
            "teaching_block_ids": [
              "mle.model_risk_documentation#tb2"
            ],
