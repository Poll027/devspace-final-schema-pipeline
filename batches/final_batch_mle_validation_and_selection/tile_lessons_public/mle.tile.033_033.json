      },
      "title": "Map evidence into the record",
      "blocks": [
        {
          "type": "prose",
          "text": "Place existing policy beside supplied observations. An observed identity outside the permitted set is a mismatch to record, not a reason to enlarge that set. Describe the redacted credential-exposure location without copying a value. Carry documented task limits, foreseeable misuse and supported aggregate/segment evidence into one record. Keep permission language separate from measured limitations.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "mle.model_risk_documentation"
            ],
            "teaching_block_ids": [
              "mle.model_risk_documentation#tb4"
            ],
            "fact_ids": [
              "mle.model_risk_documentation#f1",
              "mle.model_risk_documentation#f2",
              "mle.model_risk_documentation#f3",
              "mle.model_risk_documentation#f4"
            ]
          }
        }
      ]
    },
    {
      "step_id": "mle.tile.033_033.s03",
      "type": "explainer",
      "concept_ids": [
        "mle.model_risk_documentation"
      ],
