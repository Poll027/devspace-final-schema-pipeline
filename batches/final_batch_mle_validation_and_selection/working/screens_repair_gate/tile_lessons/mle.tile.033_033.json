      "blocks": [
        {
          "type": "prose",
          "text": "Compare the permitted identity set with observed grants; an extra grant is a mismatch, not permission to enlarge the set. Describe the supplied credential-exposure location without reproducing a secret. Map documented task limits, foreseeable misuse and supported segment limitations into one existing-policy record. Separate permission language from evidence language. Aggregate improvement cannot justify universal suitability, and documenting a mismatch is not authorization.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "mle.model_risk_documentation"
            ],
            "fact_ids": [
              "mle.model_risk_documentation#f1",
              "mle.model_risk_documentation#f2",
              "mle.model_risk_documentation#f3",
              "mle.model_risk_documentation#f4"
