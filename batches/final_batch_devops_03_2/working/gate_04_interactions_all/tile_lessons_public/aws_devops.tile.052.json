      "title": "An alert has settings, not stopping power",
      "blocks": [
        {
          "type": "prose",
          "text": "An AWS budget compares cost or usage with a configured amount over a selected period. Create a cost budget using the approved scope, amount and period; configure an actual or forecast threshold and the approved recipient.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_a_budget_notification"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_a_budget_notification#tb1",
              "aws_devops.configure_a_budget_notification#tb2",
              "aws_devops.configure_a_budget_notification#tb3"
            ],
            "fact_ids": [
              "aws_devops.configure_a_budget_notification#f1",
              "aws_devops.configure_a_budget_notification#f2"
            ],
            "anchors": []
          }
        },
        {
          "type": "prose",
          "text": "Here the scope is sandbox workload, the supplied budget amount is 1000, and the period is monthly. The single notification uses the supplied threshold value of 80 on an actual basis, sent to budget-owner@example.invalid. Compare the saved settings with the approved inputs and retain the recipient setting.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_a_budget_notification"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_a_budget_notification#tb4"
            ],
            "fact_ids": [
              "aws_devops.configure_a_budget_notification#f1",
              "aws_devops.configure_a_budget_notification#f2"
            ],
            "anchors": []
          }
        },
        {
          "type": "diagram",
          "diagram_kind": "container",
          "title": "Supplied settings and evidence",
          "nodes": [
            {
              "id": "panel0",
              "label": "Cost budget",
              "kind": "UI panel",
              "fields": [
                "budget id: sandbox-cost-budget",
                "scope: sandbox workload",
                "amount: 1000",
                "period: monthly"
