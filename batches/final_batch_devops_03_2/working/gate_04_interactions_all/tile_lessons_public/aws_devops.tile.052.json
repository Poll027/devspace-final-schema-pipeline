        ]
      },
      "title": "Judge the budget notification excerpts",
      "lede": "Read the supplied excerpts in this step and decide which match the approved budget and single notification settings.",
      "interaction": {
        "type": "classify",
        "interaction_id": "ix.aws_devops.tile.052.s03",
        "difficulty": "stretch",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.configure_a_budget_notification#practice",
          "aws_devops.configure_a_budget_notification#assessment:verify_budget_threshold_and_recipient_against_spend_policy"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.configure_a_budget_notification",
            "capability": "verify_budget_threshold_and_recipient_against_spend_policy",
            "fact_ids": [
              "f2"
            ]
          }
        ],
        "public": {
          "prompt": "Read each saved-settings excerpt and decide whether it meets ALL approved criteria below. The threshold value is a percent of the budget amount. A valid result has matching scope, amount and period, exactly one matching notification (threshold value, actual or forecast basis, and approved recipient), and no resource-stopping actions.\nApproved criteria:\n```json\n{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 1000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": false\n}\n```",
          "buckets": [
            {
              "bucket_id": "meets",
              "label": "Meets the supplied review criteria"
            },
            {
              "bucket_id": "fails",
              "label": "Fails the supplied review criteria"
            }
          ],
          "items": [
            {
              "item_id": "review1",
              "text": "{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 1000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": false\n}"
            },
            {
              "item_id": "review2",
              "text": "{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 1000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"forecast\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": false\n}"
            },
            {
              "item_id": "review3",
              "text": "{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 2000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": false\n}"
            },
            {
              "item_id": "review4",
              "text": "{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 1000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    },\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": false\n}"
            },
            {
              "item_id": "review5",
              "text": "{\n  \"budget\": {\n    \"budget_id\": \"sandbox-cost-budget\",\n    \"scope\": \"sandbox workload\",\n    \"amount\": 1000,\n    \"period\": \"monthly\"\n  },\n  \"notifications\": [\n    {\n      \"notification_id\": \"sandbox-cost-alert\",\n      \"threshold_value\": 80,\n      \"threshold_basis\": \"actual\",\n      \"recipient\": \"budget-owner@example.invalid\"\n    }\n  ],\n  \"resource_stopping_actions_configured\": true\n}"
            }
          ]
        },
        "grading": {
          "assignments": {
            "review1": "meets",
            "review2": "fails",
            "review3": "fails",
            "review4": "fails",
            "review5": "fails"
          },
          "item_feedback": {
            "review1": {
              "message": "The saved budget and its exactly one notification match every approved setting, with no resource-stopping actions."
            },
            "review2": {
              "message": "The notification basis differs from the approved basis, even though its threshold and recipient match."
            },
            "review3": {
              "message": "The saved budget amount differs from the approved amount; matching notification settings do not fix that."
            },
            "review4": {
              "message": "Two notification entries violate the exactly-one requirement, even though their settings match."
            },
            "review5": {
              "message": "Resource-stopping actions are configured, contrary to this notification-only task."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "You checked the full saved budget, exactly one notification and the absence of stopping actions."
          },
          "incorrect": {
            "message": "Check every budget and notification field, the notification count and the action setting."
          },
          "hints": [
            "A matching threshold does not establish that the budget amount matches.",
            "Inspect the full notification list and the action setting."
          ]
        }
      }
