        {
          "type": "prose",
          "text": "A notification alerts recipients. It does not itself stop resources or cap spending; stopping requires separately configured actions. No resource-stopping actions are configured in this example.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "aws_devops.configure_a_budget_notification"
            ],
            "teaching_block_ids": [
              "aws_devops.configure_a_budget_notification#tb3",
              "aws_devops.configure_a_budget_notification#tb4",
              "aws_devops.configure_a_budget_notification#tb5"
            ],
            "fact_ids": [
              "aws_devops.configure_a_budget_notification#f3"
            ],
            "anchors": []
          }
        }
      ]
    },
    {
      "step_id": "aws_devops.tile.052.s02",
      "type": "check",
      "concept_ids": [
        "aws_devops.configure_a_budget_notification"
      ],
      "lineage": {
