        "anchors": [
          "aws_devops.configure_a_budget_notification#assessment:verify_budget_threshold_and_recipient_against_spend_policy"
        ]
      },
      "title": "Check the notification settings",
      "lede": "Compare the supplied notification settings with the approved inputs and choose the matching configuration.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.052.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.configure_a_budget_notification#assessment:verify_budget_threshold_and_recipient_against_spend_policy"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.configure_a_budget_notification",
            "capability": "verify_budget_threshold_and_recipient_against_spend_policy",
            "fact_ids": [
              "f2"
            ]
          }
        ],
        "public": {
          "prompt": "Read the approved notification settings below. Which candidate matches the threshold value (percent of budget amount), actual or forecast basis, and recipient?\n```json\n{\n  \"threshold_value\": 80,\n  \"threshold_basis\": \"actual\",\n  \"recipient\": \"budget-owner@example.invalid\"\n}\n```",
          "options": [
            {
              "option_id": "option1",
              "text": "{\n  \"threshold_value\": 80,\n  \"threshold_basis\": \"actual\",\n  \"recipient\": \"budget-owner@example.invalid\"\n}"
            },
            {
              "option_id": "option2",
              "text": "{\n  \"threshold_value\": 80,\n  \"threshold_basis\": \"forecast\",\n  \"recipient\": \"budget-owner@example.invalid\"\n}"
            },
            {
              "option_id": "option3",
              "text": "{\n  \"threshold_value\": 80,\n  \"threshold_basis\": \"actual\",\n  \"recipient\": \"\"\n}"
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "option1"
          ],
          "option_feedback": {
            "option1": {
              "message": "All three settings match the approved inputs."
            },
            "option2": {
              "message": "The threshold basis differs from the approved input; the same threshold value does not make actual and forecast interchangeable for this requirement."
            },
            "option3": {
              "message": "The approved recipient is missing; a matching threshold alone is insufficient."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "The threshold value, basis and recipient all match."
          },
          "incorrect": {
            "message": "Compare all three settings; one matching field is not enough."
          },
          "hints": [
            "Check the threshold basis separately from its value.",
            "The recipient must also match the approved input."
          ],
          "remediation_step_id": "aws_devops.tile.052.r01"
        }
      }
    },
    {
      "step_id": "aws_devops.tile.052.s03",
      "type": "hands_on",
      "concept_ids": [
        "aws_devops.configure_a_budget_notification"
      ],
      "lineage": {
        "teaching_block_ids": [],
        "fact_ids": [
          "aws_devops.configure_a_budget_notification#f2"
        ],
        "segment_ids": [],
        "anchors": [
          "aws_devops.configure_a_budget_notification#practice",
