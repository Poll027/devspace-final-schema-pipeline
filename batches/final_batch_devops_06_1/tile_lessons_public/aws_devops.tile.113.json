      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.113.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.block_release_on_actionable_dependency_or_image_security_findings#assessment:determine_blocking_gate_outcome_and_required_evidence"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.block_release_on_actionable_dependency_or_image_security_findings",
            "capability": "determine_blocking_gate_outcome_and_required_evidence",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "The scan-policy check identifies an actionable unexcepted finding. Which gate result and evidence are required?",
          "options": [
            {
              "option_id": "a",
              "text": "Return failure, block promotion because it requires check success, and retain the scan report and policy decision."
            },
            {
              "option_id": "b",
              "text": "Return success so promotion can proceed, while keeping the report."
            },
            {
              "option_id": "c",
              "text": "Return failure but allow promotion without requiring the scan-policy check to succeed."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Return failure, block promotion because it requires check success, and retain the scan report and policy decision."
            },
            "b": {
              "message": "Keeping a report does not make an actionable unexcepted finding a passing policy result."
            },
            "c": {
              "message": "A failing check only gates progression when promotion requires its success."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The supplied scan-policy check returns failure for the actionable unexcepted finding, promotion remains blocked because it requires that check's success, and the report and policy decision are retained as evidence."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.113.r01"
        }
      }
    },
