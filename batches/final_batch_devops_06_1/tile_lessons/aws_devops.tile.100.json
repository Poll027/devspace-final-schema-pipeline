        "measures": [
          {
            "concept_id": "aws_devops.run_supplied_unit_and_integration_tests_as_blocking_pipeline_gates",
            "capability": "verify_failing_supplied_test_blocks_promotion",
            "fact_ids": [
              "f1",
              "f2",
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "A supplied unit test exits nonzero while integration succeeds. Which configuration and outcome demonstrate a blocking test gate?",
          "options": [
            {
              "option_id": "a",
              "text": "Both supplied commands run in their jobs; promotion needs both jobs; neither test uses continue-on-error; the unit job fails and promotion is skipped."
            },
            {
              "option_id": "b",
              "text": "Set continue-on-error on the failed test and still describe promotion as blocked."
            },
            {
              "option_id": "c",
              "text": "Make promotion need only the successful integration job."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Both supplied commands run in their jobs; promotion needs both jobs; neither test uses continue-on-error; the unit job fails and promotion is skipped."
            },
            "b": {
              "message": "Failure must propagate from the command to its job and the dependent promotion. continue-on-error defeats this blocking requirement."
            },
            "c": {
              "message": "Promotion must require both test jobs, not just the successful one."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The failing supplied test reports a nonzero exit status, its job fails, and the dependent promotion job is skipped even when the other test job succeeds."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.100.r01"
        }
      }
    },
