            ]
          }
        },
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Use run: TEST_COMMAND for the supplied unit and integration commands. Set promotion to needs: [UNIT_JOB, INTEGRATION_JOB], requiring both jobs.",
