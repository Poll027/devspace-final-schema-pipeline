        ],
        "measures": [
          {
            "concept_id": "aws_devops.automate_isolated_infrastructure_restoration_using_a_supplied_cloudformation_ec2_template",
            "capability": "verify_restoration_target_and_execution_authority",
            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "public": {
          "prompt": "Which restoration setup matches the required target and execution authority?",
          "options": [
            {
              "option_id": "a",
              "text": "The supplied template and parameters, approved recovery credentials, and explicit isolated account and Region."
            },
            {
              "option_id": "b",
              "text": "The supplied template with the current account and Region left unverified."
            },
            {
              "option_id": "c",
              "text": "An arbitrary replacement template in the isolated account, regardless of required parameters."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. The supplied template and parameters, approved recovery credentials, and explicit isolated account and Region."
            },
            "b": {
              "message": "Stack resources are provisioned under the selected account authority and Region; these must be explicit and approved."
            },
            "c": {
              "message": "Isolation does not replace using the supplied restoration template and required parameters."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Use the supplied template and required parameters with approved recovery credentials in the explicit isolated account and Region. Inspect completed stack events, resource IDs and outputs, then judge the instance and service checks separately. In restore-service-fails, the instance check passes but the service check fails, so recovery readiness is not verified. In restore-service-passes, both checks pass. Stack completion alone does not establish recovery readiness."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.112.r01"
        }
      }
    },
