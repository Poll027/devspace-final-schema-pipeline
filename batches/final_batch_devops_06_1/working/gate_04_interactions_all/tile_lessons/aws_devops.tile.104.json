        ]
      },
      "eyebrow": "Check your understanding",
      "lede": "Read the supplied excerpts in this step and decide which conclusions or actions are correct, defective or unsafe.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.104.s02",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "recovery.credential_readiness#assessment:distinguish_session_lifetime_from_authorization"
        ],
        "measures": [
          {
            "concept_id": "recovery.credential_readiness",
            "capability": "distinguish_session_lifetime_from_authorization",
            "fact_ids": [
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "An approved recovery session is unexpired, but the supplied backup-read test is denied. What does this establish?",
          "options": [
            {
              "option_id": "a",
              "text": "The session is not ready: valid lifetime does not establish sufficient authorization."
            },
            {
              "option_id": "b",
              "text": "The session is ready because its expiration time is still in the future."
            },
            {
              "option_id": "c",
              "text": "The denied operation can be omitted from the readiness record."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. The session is not ready: valid lifetime does not establish sufficient authorization."
            },
            "b": {
              "message": "Credential lifetime and authorization are separate requirements."
            },
            "c": {
              "message": "Access outcomes must be verified, not hidden by a valid lifetime."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The approved session is established, its identity and expiry are inspected, and both supplied operation outcomes are recorded alongside its lifetime. Readiness requires the expected identity, a valid unexpired session, and successful backup-read and recovery-resource operations; an unexpired session with a denied operation is identified as not ready."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.104.r01"
        }
      }
    },
