          "diagram_kind": "container",
          "nodes": [
            {
              "id": "n0",
              "label": "Approved session identity and expiry"
            },
            {
              "id": "n1",
              "label": "Backup-read authorization outcome"
            },
            {
              "id": "n2",
              "label": "Recovery-resource authorization outcome"
            }
          ],
          "edges": [],
          "alt_text": "Show the approved recovery session's identity and expiry alongside the supplied backup-read and recovery-resource test outcomes, making lifetime and authorization separately visible without displaying credentials.",
