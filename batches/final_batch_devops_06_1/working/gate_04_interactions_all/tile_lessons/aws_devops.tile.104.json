        "public": {
          "prompt": "When must the approved rehearsal scope and stop conditions be recorded?",
          "options": [
            {
              "option_id": "a",
              "text": "Before provisioning recovery resources or directing client test traffic."
            },
            {
              "option_id": "b",
              "text": "After provisioning, but before the first client test request."
            },
            {
              "option_id": "c",
              "text": "Only after the rehearsal finishes successfully."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Before provisioning recovery resources or directing client test traffic."
            },
            "b": {
              "message": "Provisioning is already a rehearsal action; scope and stop conditions must precede it."
            },
            "c": {
              "message": "A later record does not bound the actions before they happen."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The prepared target uses the supplied isolated account and network. Restoration destinations and client test traffic settings do not point to production, and the approved scope and stop conditions are recorded before any provisioning or test traffic begins."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
