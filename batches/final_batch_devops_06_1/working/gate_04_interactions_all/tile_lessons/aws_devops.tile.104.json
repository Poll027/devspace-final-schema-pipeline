        ]
      },
      "eyebrow": "Read the evidence",
      "blocks": [
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Recovery needs a valid, unexpired session with permissions for backup access and resource creation. Establish the approved session and inspect identity and expiry.",
          "lineage": {
            "concept_ids": [
              "recovery.credential_readiness"
            ],
            "fact_ids": [
              "recovery.credential_readiness#f1",
              "recovery.credential_readiness#f2"
            ],
            "teaching_block_ids": [
              "recovery.credential_readiness#tb1",
              "recovery.credential_readiness#tb2",
              "recovery.credential_readiness#tb3",
              "recovery.credential_readiness#tb4",
              "recovery.credential_readiness#tb5"
            ]
          }
        },
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Before rehearsal, test the supplied backup-read and recovery-resource operations. Record both outcomes alongside lifetime. Unexpired credentials with denied backup access are not ready; successful access does not remove the lifetime requirement.",
          "lineage": {
            "concept_ids": [
              "recovery.credential_readiness"
            ],
            "fact_ids": [
              "recovery.credential_readiness#f2",
              "recovery.credential_readiness#f3"
            ],
            "teaching_block_ids": [
              "recovery.credential_readiness#tb1",
              "recovery.credential_readiness#tb2",
              "recovery.credential_readiness#tb3",
              "recovery.credential_readiness#tb4",
              "recovery.credential_readiness#tb5"
            ]
          }
        },
        {
