              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "A supplied Lambda smoke check fails. Which job-result reporting path preserves the release gate?",
          "options": [
            {
              "option_id": "a",
              "text": "Call PutJobFailureResult and leave dependent progression blocked."
            },
            {
              "option_id": "b",
              "text": "Call PutJobSuccessResult because the deployment operation completed."
            },
            {
              "option_id": "c",
              "text": "Call PutJobSuccessResult now and check live behavior afterward."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Call PutJobFailureResult and leave dependent progression blocked."
            },
            "b": {
              "message": "Deployment completion does not justify success when live validation fails."
            },
            "c": {
              "message": "A passing smoke check must precede PutJobSuccessResult with the job ID."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The action checks the supplied endpoint against the expected response for the deployed revision. A passing check calls PutJobSuccessResult with the job ID; a failing check calls PutJobFailureResult and leaves dependent progression blocked."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.116.r01"
        }
      }
    },
