      "eyebrow": "Read the evidence",
      "blocks": [
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Deployment completion is not a live behavior check. Run the supplied smoke-check action against the deployed endpoint and compare its response with the expectation for the deployed revision.",
          "lineage": {
            "concept_ids": [
              "aws_devops.gate_release_completion_on_a_deployed_service_smoke_check"
            ],
            "fact_ids": [
              "aws_devops.gate_release_completion_on_a_deployed_service_smoke_check#f1",
