              "aws_devops.verify_availability_across_availability_zones_under_a_controlled_failure#tb2",
              "aws_devops.verify_availability_across_availability_zones_under_a_controlled_failure#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Verify that remaining independent capacity and the request path maintain required service behavior. Surviving instances alone do not prove availability.",
