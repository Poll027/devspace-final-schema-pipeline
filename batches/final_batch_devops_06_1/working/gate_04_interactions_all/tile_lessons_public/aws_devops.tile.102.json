        ],
        "measures": [
          {
            "concept_id": "aws_devops.verify_availability_across_availability_zones_under_a_controlled_failure",
            "capability": "explain_controlled_failure_as_availability_verification",
            "fact_ids": [
              "f1"
            ]
          }
        ],
        "public": {
          "prompt": "What is the purpose of deliberately introducing a controlled failure in an availability experiment?",
          "options": [
            {
              "option_id": "a",
              "text": "Verify whether the workload meets its availability requirements under failure."
            },
            {
              "option_id": "b",
              "text": "Prove availability merely by counting instances that remain running."
            },
            {
              "option_id": "c",
              "text": "Demonstrate that every component remains unchanged during the experiment."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Verify whether the workload meets its availability requirements under failure."
            },
            "b": {
              "message": "Surviving components alone do not establish the required service behavior."
            },
            "c": {
              "message": "The experiment deliberately introduces a failure; unchanged components are not its success criterion."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. Only the approved components in one AZ are affected, the defined abort criteria are enforced, and the result is judged against the supplied service requirement using client-request outcomes and remaining-path evidence rather than surviving instance count alone."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.102.r01"
        }
      }
    },
