      "lede": "Read the supplied excerpts in this step and decide which conclusions or actions are correct, defective or unsafe.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.102.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
