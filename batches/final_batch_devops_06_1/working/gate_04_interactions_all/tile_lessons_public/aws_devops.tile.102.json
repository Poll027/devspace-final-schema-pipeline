      "eyebrow": "Read the evidence",
      "blocks": [
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Resilience testing deliberately introduces failures to check availability requirements. Bound the approved experiment to the supplied AZ components, define abort criteria and monitor client-visible behavior.",
