        ]
      },
      "eyebrow": "Check your understanding",
      "lede": "Read the supplied excerpts in this step and decide which conclusions or actions are correct, defective or unsafe.",
      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.103.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "cost.safe_teardown#assessment:verify_dependency_ordered_resource_removal"
        ],
        "measures": [
          {
            "concept_id": "cost.safe_teardown",
            "capability": "verify_dependency_ordered_resource_removal",
            "fact_ids": [
              "f1",
              "f2"
            ]
          }
        ],
        "public": {
          "prompt": "A supplied exercise resource depends on another exercise resource. Which removal rule respects scope and dependencies?",
          "options": [
            {
              "option_id": "a",
              "text": "Confirm approved exercise membership, remove the dependent resource before its prerequisite, and verify each deletion result."
            },
            {
              "option_id": "b",
              "text": "Delete the prerequisite first and infer dependent removal from that request."
            },
            {
              "option_id": "c",
              "text": "Delete similarly named resources without checking approved tags or stack membership."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. Confirm approved exercise membership, remove the dependent resource before its prerequisite, and verify each deletion result."
            },
            "b": {
              "message": "Dependencies determine removal order; a deletion request is not proof of each resource removal."
            },
            "c": {
              "message": "Only resources identified by the supplied exercise membership or approved tags are in scope."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. Only approved exercise resources are targeted, and unrelated resources remain unchanged. Removal respects dependencies, including complete bucket-content cleanup before bucket deletion. Each deletion result is inspected; retained resources and failures are identified for approved follow-up rather than treated as removed. Completion is reported as a resource-removal result, not billing verification."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.103.r01"
        }
      }
    },
