      "blocks": [
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Delete only exercise resources identified by stack membership or approved tags. Remove dependents before prerequisites and verify results. CloudFormation uses resource relationships when deleting a stack.",
          "lineage": {
            "concept_ids": [
              "cost.safe_teardown"
            ],
            "fact_ids": [
