              "cost.safe_teardown#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "role": "mechanism",
          "text": "Empty the exercise S3 bucket before deletion: remove objects, all object versions and delete markers.",
          "lineage": {
            "concept_ids": [
              "cost.safe_teardown"
            ],
            "fact_ids": [
              "cost.safe_teardown#f3"
            ],
            "teaching_block_ids": [
              "cost.safe_teardown#tb1",
