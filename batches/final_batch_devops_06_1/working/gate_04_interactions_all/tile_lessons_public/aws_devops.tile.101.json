      "interaction": {
        "type": "choice",
        "interaction_id": "ix.aws_devops.tile.101.s03",
        "difficulty": "intro",
        "grading_mode": "client",
        "standalone": true,
        "anchors": [
          "aws_devops.submit_small_reviewable_infrastructure_changes#assessment:verify_change_isolation_and_coherence"
        ],
        "measures": [
          {
            "concept_id": "aws_devops.submit_small_reviewable_infrastructure_changes",
            "capability": "verify_change_isolation_and_coherence",
            "fact_ids": [
              "f1",
              "f3"
            ]
          }
        ],
        "public": {
          "prompt": "Which pull-request scope best supports focused infrastructure review?",
          "options": [
            {
              "option_id": "a",
              "text": "One coherent EC2 change with clear intent, a focused diff and saved-plan evidence identifying the affected EC2 resource."
            },
            {
              "option_id": "b",
              "text": "Several unrelated infrastructure changes grouped under one short commit message."
            },
            {
              "option_id": "c",
              "text": "One EC2 change with clear intent but no saved-plan evidence of the affected resource."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "a"
          ],
          "option_feedback": {
            "a": {
              "message": "Correct. One coherent EC2 change with clear intent, a focused diff and saved-plan evidence identifying the affected EC2 resource."
            },
            "b": {
              "message": "A short message does not make unrelated changes coherent or reduce their review complexity."
            },
            "c": {
              "message": "Focused scope is not enough: the affected EC2 resource must be visible in saved-plan evidence."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Correct. Your judgement follows the supplied evidence and the stated requirement."
          },
          "incorrect": {
            "message": "Compare the evidence with the requirement rather than inferring success from a partial signal. The change record contains one coherent EC2 change, a traceable commit, clear intent, saved-plan evidence identifying the affected EC2 resource, supplied reviewer approval, a successful CI execution using that approved saved plan, and verification of the resulting single EC2 instance."
          },
          "hints": [
            "Separate the observed outcome from what was merely intended.",
            "Check every required condition, not just the most reassuring field."
          ],
          "remediation_step_id": "aws_devops.tile.101.r01"
        }
      }
    },
