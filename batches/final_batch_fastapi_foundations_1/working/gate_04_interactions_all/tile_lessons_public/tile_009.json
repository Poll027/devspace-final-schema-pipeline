    {
      "step_id": "tile_009.s02",
      "type": "explainer",
      "concept_ids": [
        "asgi.request_lifecycle"
      ],
      "eyebrow": "ASGI server and application request lifecycle",
      "title": "Why the distinction matters",
      "lineage": {
        "concept_ids": [
          "asgi.request_lifecycle"
        ],
        "teaching_block_ids": [
          "asgi.request_lifecycle#tb4"
        ],
