          "asgi.request_lifecycle#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Keep scope separate from events: it describes the connection, while receive and send exchange events. Send response status and headers in http.response.start before the http.response.body event. The server owns network handling; the application participates through the ASGI callable.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "asgi.request_lifecycle"
            ],
            "teaching_block_ids": [
              "asgi.request_lifecycle#tb4"
            ],
            "fact_ids": [
              "asgi.request_lifecycle#f1",
              "asgi.request_lifecycle#f2",
              "asgi.request_lifecycle#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_009.s02.b01"
        }
      ]
    },
    {
      "step_id": "tile_009.s03",
      "type": "explainer",
      "concept_ids": [
        "asgi.request_lifecycle"
      ],
      "eyebrow": "ASGI server and application request lifecycle",
      "title": "Reason through an example",
      "lineage": {
        "concept_ids": [
          "asgi.request_lifecycle"
        ],
        "teaching_block_ids": [
          "asgi.request_lifecycle#tb5",
          "asgi.request_lifecycle#tb6"
