          "asgi.request_lifecycle#f3"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Trace the server invoking app with scope, receive and send. The application receives http.request, sends http.response.start containing status and headers, then sends http.response.body. Draw separate arrows for metadata and body, not one handler return. Keep the network connection in the server box.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "asgi.request_lifecycle"
            ],
            "teaching_block_ids": [
              "asgi.request_lifecycle#tb5"
            ],
            "fact_ids": [
              "asgi.request_lifecycle#f1",
              "asgi.request_lifecycle#f2",
              "asgi.request_lifecycle#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_009.s03.b01"
        },
        {
          "type": "prose",
          "text": "The application does not directly own all network handling. The ASGI server handles the connection and invokes the callable.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "asgi.request_lifecycle"
            ],
            "teaching_block_ids": [
              "asgi.request_lifecycle#tb6"
            ],
            "fact_ids": [
              "asgi.request_lifecycle#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_009.s03.b02"
        },
        {
          "type": "prose",
          "role": "walkthrough",
          "text": "Pass an event dictionary to `send`. Its `type` names the event. A response-start event carries `status` and `headers`; a response-body event carries `body`. Use the supplied values without choosing a status or implementing networking.",
          "lineage": {
            "concept_ids": [
              "asgi.request_lifecycle"
            ],
            "teaching_block_ids": [
              "asgi.request_lifecycle#tb5"
            ],
            "fact_ids": [
              "asgi.request_lifecycle#f1",
              "asgi.request_lifecycle#f2",
              "asgi.request_lifecycle#f3"
            ],
            "anchors": [
              "asgi.request_lifecycle#practice"
            ]
          },
          "block_id": "tile_009.s03.b03"
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "async def app(scope, receive, send):\n    request = await receive()\n    await send({'type': 'http.response.start', 'status': supplied_status, 'headers': supplied_headers})\n    await send({'type': 'http.response.body', 'body': supplied_body})",
          "annotations": [
            {
              "start_line": 2,
              "end_line": 2,
              "text": "`receive()` obtains the supplied request."
            },
            {
              "start_line": 3,
              "end_line": 4,
              "text": "Response start precedes response body."
            }
          ],
          "lineage": {
            "concept_ids": [
