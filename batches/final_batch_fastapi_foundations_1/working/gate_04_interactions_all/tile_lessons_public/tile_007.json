      "blocks": [
        {
          "type": "prose",
          "text": "A decorator can add behavior around a service callable without rewriting that callable.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.decorator_wrappers"
            ],
            "teaching_block_ids": [
              "python.decorator_wrappers#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          },
          "block_id": "tile_007.s01.b01"
        },
        {
          "type": "prose",
          "text": "At function definition, the decorator expression is evaluated and called with the function object. Its returned value becomes the function name’s binding.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.decorator_wrappers"
            ],
            "teaching_block_ids": [
              "python.decorator_wrappers#tb2"
            ],
            "fact_ids": [
              "python.decorator_wrappers#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_007.s01.b02"
        },
        {
          "type": "prose",
          "text": "@decorate above def function(...): is roughly function = decorate(function). Build a callable wrapper by defining an inner function that calls the supplied function, then returning the inner function.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.decorator_wrappers"
            ],
            "teaching_block_ids": [
              "python.decorator_wrappers#tb3"
            ],
            "fact_ids": [
