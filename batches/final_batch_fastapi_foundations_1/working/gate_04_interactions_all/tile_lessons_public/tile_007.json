      "blocks": [
        {
          "type": "prose",
          "text": "Trace two times: definition applies decorate to the function object and binds the returned value; a later call uses that binding. If the returned value is an inner wrapper, that later call goes through it to the original function. The decorator receives the function, not the result of calling it with service data.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "python.decorator_wrappers"
            ],
            "teaching_block_ids": [
              "python.decorator_wrappers#tb4"
            ],
            "fact_ids": [
              "python.decorator_wrappers#f1",
              "python.decorator_wrappers#f2",
              "python.decorator_wrappers#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_007.s02.b01"
        },
        {
          "type": "prose",
          "text": "A decorator is not a comment. Its returned value becomes the function name’s binding.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.decorator_wrappers"
            ],
