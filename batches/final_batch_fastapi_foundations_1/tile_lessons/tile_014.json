      "blocks": [
        {
          "type": "prose",
          "text": "Order input needs a declared shape. Validation can convert compatible values; it is not merely an original-type check.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "pydantic.model_validation_conversion"
            ],
            "teaching_block_ids": [
              "pydantic.model_validation_conversion#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          },
          "block_id": "tile_014.s01.b01"
        },
        {
          "type": "prose",
          "text": "Subclass BaseModel and declare typed fields. Construct with Model(field=value, ...) or validate data with Model.model_validate(data).",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "pydantic.model_validation_conversion"
            ],
            "teaching_block_ids": [
              "pydantic.model_validation_conversion#tb2"
            ],
            "fact_ids": [
              "pydantic.model_validation_conversion#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_014.s01.b02"
        },
        {
          "type": "prose",
          "text": "Compatible inputs can convert to declared types; default validation does not prove their original types matched. Inputs that cannot satisfy the model raise ValidationError with failed-field details. Fields without defaults are required; declared defaults supply omitted values.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "pydantic.model_validation_conversion"
            ],
            "teaching_block_ids": [
              "pydantic.model_validation_conversion#tb3"
            ],
            "fact_ids": [
              "pydantic.model_validation_conversion#f2",
              "pydantic.model_validation_conversion#f3",
              "pydantic.model_validation_conversion#f4"
            ],
            "anchors": []
          },
          "block_id": "tile_014.s01.b03"
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "from pydantic import BaseModel, ValidationError\n\nclass OrderInput(BaseModel):\n    quantity: int\n    note: str | None = None\n\nfirst = OrderInput(quantity='3')\ncases = [{'quantity': '3'}, {'quantity': 3}, {}, {'quantity': 'many'}]\nfor data in cases:\n    try:\n        model = OrderInput.model_validate(data)\n        print(model)\n    except ValidationError as error:\n        print(error.errors())\n",
          "annotations": [
            {
              "start_line": 4,
              "end_line": 5,
              "text": "quantity required; note default supplied on omission."
            },
            {
              "start_line": 7,
              "end_line": 8,
              "text": "Compare compatible string input, integer input, omitted quantity and incompatible input."
            },
            {
              "start_line": 9,
              "end_line": 14,
              "text": "Expected outcomes: {'quantity': '3'} and {'quantity': 3} both produce quantity=3 and note=None. {} fails because quantity is required. {'quantity': 'many'} fails integer validation for quantity. Failures raise ValidationError with field details."
            }
          ],
          "lineage": {
            "concept_ids": [
              "pydantic.model_validation_conversion"
            ],
            "teaching_block_ids": [
              "pydantic.model_validation_conversion#tb1",
              "pydantic.model_validation_conversion#tb2",
              "pydantic.model_validation_conversion#tb3"
            ],
            "fact_ids": [
              "pydantic.model_validation_conversion#f1",
              "pydantic.model_validation_conversion#f2",
              "pydantic.model_validation_conversion#f3",
              "pydantic.model_validation_conversion#f4"
            ],
            "anchors": [
              "pydantic.model_validation_conversion#visual"
            ]
          },
          "block_id": "tile_014.s01.b04"
        }
