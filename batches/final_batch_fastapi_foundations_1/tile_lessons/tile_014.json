      "blocks": [
        {
          "type": "prose",
          "text": "For OrderInput, quantity has no default and must be present; omitted note uses its declared default. Construct or model_validate compatible quantity input, compare incompatible input and omission, and inspect ValidationError field details for failures. Read the model as validated output, not a historical guarantee of input types.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "pydantic.model_validation_conversion"
            ],
            "teaching_block_ids": [
              "pydantic.model_validation_conversion#tb5"
