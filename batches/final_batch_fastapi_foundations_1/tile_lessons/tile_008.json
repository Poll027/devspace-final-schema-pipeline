      "blocks": [
        {
          "type": "prose",
          "text": "Create and activate .venv, then check which python or where python. With that interpreter identified, install the supplied dependency using python -m pip install and inspect it using python -m pip show. Compare both version and location. Repeat for another project rather than assuming both commands use the same environment.",
          "role": "walkthrough",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb5"
            ],
            "fact_ids": [
