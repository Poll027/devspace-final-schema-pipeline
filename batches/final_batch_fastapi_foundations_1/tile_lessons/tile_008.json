      "blocks": [
        {
          "type": "prose",
          "text": "Two projects can need different dependency versions. Identify which interpreter and packages each uses.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          },
          "block_id": "tile_008.s01.b01"
        },
        {
          "type": "prose",
          "text": "A virtual environment has a particular Python installation and its own installed packages, allowing applications to use different dependency versions.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb2"
            ],
            "fact_ids": [
              "python.isolated_environments#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_008.s01.b02"
        },
        {
          "type": "prose",
          "text": "Create it with python -m venv .venv. Activate using source .venv/bin/activate on Unix or .venv\\Scripts\\activate on Windows. Install with python -m pip install package; inspect version and location with python -m pip show package. Confirm the interpreter path with which python on Unix or where python on Windows.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb3"
