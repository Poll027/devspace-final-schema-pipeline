      "blocks": [
        {
          "type": "prose",
          "text": "A virtual environment has a particular Python installation and its own installed packages, allowing applications to use different dependency versions.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb2",
              "python.isolated_environments#tb4",
              "python.isolated_environments#tb5"
            ],
            "fact_ids": [
              "python.isolated_environments#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_008.r02.b01"
        },
        {
          "type": "prose",
          "text": "Create an environment with python -m venv .venv and activate it with source .venv/bin/activate on Unix or .venv\\Scripts\\activate on Windows.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb3",
              "python.isolated_environments#tb5"
            ],
            "fact_ids": [
              "python.isolated_environments#f2"
            ],
            "anchors": []
          },
          "block_id": "tile_008.r02.b02"
        },
        {
          "type": "prose",
          "text": "Use python -m pip install package within the environment to install a dependency, and python -m pip show package to inspect its installed version and location.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb3",
              "python.isolated_environments#tb4",
              "python.isolated_environments#tb5",
              "python.isolated_environments#tb6"
            ],
            "fact_ids": [
              "python.isolated_environments#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_008.r02.b03"
        },
        {
          "type": "prose",
          "text": "Check which python on Unix or where python on Windows to confirm that the interpreter path belongs to the activated environment.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.isolated_environments"
            ],
            "teaching_block_ids": [
              "python.isolated_environments#tb3",
              "python.isolated_environments#tb4",
              "python.isolated_environments#tb5",
              "python.isolated_environments#tb6"
            ],
            "fact_ids": [
              "python.isolated_environments#f4"
            ],
            "anchors": []
          },
          "block_id": "tile_008.r02.b04"
        },
        {
          "type": "prose",
          "text": "Each environment has its own packages. Verify interpreter path and package version and location.",
