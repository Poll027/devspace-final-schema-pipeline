              "python.isolated_environments#f3",
              "python.isolated_environments#f4"
            ],
            "anchors": []
          },
          "block_id": "tile_008.s03.b01"
        },
        {
          "type": "prose",
          "text": "Activation alone is not inspection. Confirm the interpreter path, then inspect the package’s version and location.",
          "role": "misconception",
          "lineage": {
