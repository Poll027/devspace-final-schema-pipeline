      "type": "explainer",
      "concept_ids": [
        "auth.local_password_verification"
      ],
      "eyebrow": "Local password hashing and credential verification without an OAuth password grant",
      "title": "Establish the rule",
      "lineage": {
        "concept_ids": [
          "auth.local_password_verification"
        ],
        "teaching_block_ids": [
          "auth.local_password_verification#tb1",
          "auth.local_password_verification#tb2",
