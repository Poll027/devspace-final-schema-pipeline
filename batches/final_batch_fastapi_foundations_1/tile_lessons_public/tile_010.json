          "auth.local_password_verification#f3"
        ],
        "segment_ids": [],
        "anchors": [
          "auth.local_password_verification#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "For a local password check, store verification material rather than a password intended to be recovered later.",
          "role": "intro",
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb1"
            ],
            "fact_ids": [],
            "anchors": []
          },
          "block_id": "tile_010.s01.b01"
        },
        {
          "type": "prose",
          "text": "Use password hashing, not plaintext storage or reversible encryption.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb2"
            ],
            "fact_ids": [
              "auth.local_password_verification#f1"
            ],
            "anchors": []
          },
          "block_id": "tile_010.s01.b02"
        },
        {
          "type": "prose",
          "text": "Salts distinguish hashes; an adjustable work factor increases guessing cost. Create pwdlib’s PasswordHash.recommended(), store hash(password), and check submissions with verify(plain_password, stored_hash).",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb3"
            ],
            "fact_ids": [
              "auth.local_password_verification#f2",
              "auth.local_password_verification#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_010.s01.b03"
        },
        {
          "type": "prose",
          "text": "Use the registered synthetic passwords. Create the recommended hasher, store its hash(password) result, then supply the submitted plaintext first and stored hash second to verify. Salt distinguishes hashes; work factor increases guessing cost. Do not replace hashing with reversible storage.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb4"
            ],
            "fact_ids": [
              "auth.local_password_verification#f1",
              "auth.local_password_verification#f2",
              "auth.local_password_verification#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_010.s01.b04"
        },
        {
          "type": "prose",
          "text": "Verification checks a submission against a stored hash. It does not recover the original password through decryption.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb5"
            ],
            "fact_ids": [
              "auth.local_password_verification#f1",
              "auth.local_password_verification#f3"
            ],
            "anchors": []
          },
          "block_id": "tile_010.s01.b05"
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "from pwdlib import PasswordHash\n\npassword = \"synthetic-order-password\"\ndifferent_password = \"different-synthetic-password\"\npassword_hash = PasswordHash.recommended()\nstored_hash = password_hash.hash(password)\nmatching_result = password_hash.verify(password, stored_hash)\nnonmatching_result = password_hash.verify(different_password, stored_hash)\n",
          "annotations": [
            {
              "start_line": 5,
              "end_line": 6,
              "text": "Create the recommended hasher and store the hash, not plaintext."
            },
            {
              "start_line": 7,
              "end_line": 8,
              "text": "Submitted password first; stored hash second. matching_result is True; nonmatching_result is False. Verification checks the submission without decrypting the stored hash."
            }
          ],
          "lineage": {
            "concept_ids": [
              "auth.local_password_verification"
            ],
            "teaching_block_ids": [
              "auth.local_password_verification#tb1",
              "auth.local_password_verification#tb2",
              "auth.local_password_verification#tb3",
              "auth.local_password_verification#tb4",
              "auth.local_password_verification#tb5"
            ],
            "fact_ids": [
              "auth.local_password_verification#f1",
              "auth.local_password_verification#f2",
              "auth.local_password_verification#f3"
            ],
            "anchors": [
              "auth.local_password_verification#visual"
            ]
          },
          "block_id": "tile_010.s01.b06"
        }
      ]
    },
