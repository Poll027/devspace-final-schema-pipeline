        "public": {
          "prompt": "Which password-storage design separates storage, salt, and work-factor roles correctly?",
          "options": [
            {
              "option_id": "option1",
              "text": "Store a password hash; salts distinguish hashes, and a work factor raises guessing cost."
            },
            {
              "option_id": "option2",
              "text": "Store reversible encryption; salts make it equivalent to password hashing."
            },
            {
              "option_id": "option3",
              "text": "Store a password hash; the salt replaces the work factor by providing the same cost control."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "option1"
          ],
          "option_feedback": {
            "option1": {
              "message": "Correct: Store a password hash; salts distinguish hashes, and a work factor raises guessing cost."
            },
            "option2": {
              "message": "Password storage should use password hashing rather than reversible encryption."
            },
            "option3": {
              "message": "Salts distinguish hashes; adjustable work factors control guessing cost. Their roles differ."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Store a password hash; salts distinguish hashes, and a work factor raises guessing cost."
