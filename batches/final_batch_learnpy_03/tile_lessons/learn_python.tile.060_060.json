              "review_url": "https://www.youtube.com/watch?v=_JGmemuINww&t=43s",
              "start_seconds": 43,
              "end_seconds": 243,
              "label": "Replace a shared default list with a None guard",
              "summary": "An employee-list helper appends a name and displays the list. Passing an existing list updates that list as intended. However, two calls that omit the list accumulate both names in the same default list, rather than starting separately. Default values are evaluated once when the function is defined, so later calls reuse the mutable object. The repair changes the default to None and creates an empty list inside an if employee_list is None branch. The repaired function is written but not executed in this range.",
              "fact_ids": [
                "f1",
                "f2"
              ],
              "transcript_ref": "_JGmemuINww:43-243"
            }
          ],
          "group_title": "Shared defaults and fresh per-call lists",
          "bridge": {
            "before": "Watch how calls that omit the employee list reuse its contents. Then follow the repair: a None default and an identity check move list creation into the function body.",
            "after": "The clip explains both default reuse and the None guard, but stops before executing the repair. The text demonstrates independent results and also states that this pattern works for dictionaries."
          },
          "default_mode": "video"
        }
      ]
