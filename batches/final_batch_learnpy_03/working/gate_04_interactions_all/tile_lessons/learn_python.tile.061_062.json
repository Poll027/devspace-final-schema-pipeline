        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "sorted(records, key=function) creates a new sorted list. Each function(record) result supplies that record’s comparison key.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.sorting_with_key_functions"
            ],
            "fact_ids": [
              "python.sorting_with_key_functions#f1"
            ],
            "teaching_block_ids": [
              "python.sorting_with_key_functions#tb2",
              "python.sorting_with_key_functions#tb4",
              "python.sorting_with_key_functions#tb5"
            ]
          }
        },
        {
          "type": "prose",
          "text": "sorted leaves the original list unchanged. Use reverse=True to reverse the ordering.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.sorting_with_key_functions"
            ],
            "fact_ids": [
              "python.sorting_with_key_functions#f2"
            ],
            "teaching_block_ids": [
              "python.sorting_with_key_functions#tb3",
              "python.sorting_with_key_functions#tb4",
              "python.sorting_with_key_functions#tb5"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Sorting is stable: records with equal keys keep their original relative order.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.sorting_with_key_functions"
            ],
            "fact_ids": [
              "python.sorting_with_key_functions#f3"
            ],
            "teaching_block_ids": [
              "python.sorting_with_key_functions#tb3",
              "python.sorting_with_key_functions#tb4",
              "python.sorting_with_key_functions#tb5"
            ]
          }
        },
        {
          "type": "prose",
          "text": "For case-normalized text ordering, str.lower can supply a lowercase comparison key.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.sorting_with_key_functions"
            ],
            "fact_ids": [
              "python.sorting_with_key_functions#f4"
            ],
            "teaching_block_ids": [
              "python.sorting_with_key_functions#tb3",
              "python.sorting_with_key_functions#tb4"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "records = [{\"label\": \"blue\", \"quantity\": 3}, {\"label\": \"Red\", \"quantity\": 2}, {\"label\": \"BLUE\", \"quantity\": 3}]\n\ndef label_key(record):\n    return record[\"label\"].lower()\n\nordered = sorted(records, key=label_key)\nprint([record[\"label\"] for record in ordered])\nprint([record[\"label\"] for record in records])",
          "annotations": [
            {
              "start_line": 4,
              "end_line": 4,
              "text": "The comparison keys are 'blue', 'red', and 'blue'."
            },
            {
              "start_line": 6,
              "end_line": 6,
              "text": "Create a new list; blue and BLUE have equal keys and retain their original relative order."
            },
            {
              "start_line": 7,
              "end_line": 7,
              "text": "The sorted labels are ['blue', 'BLUE', 'Red']."
            },
            {
              "start_line": 8,
              "end_line": 8,
              "text": "The original labels remain ['blue', 'Red', 'BLUE']."
            }
          ],
          "reveal": "all",
          "lineage": {
            "concept_ids": [
              "python.sorting_with_key_functions"
            ],
