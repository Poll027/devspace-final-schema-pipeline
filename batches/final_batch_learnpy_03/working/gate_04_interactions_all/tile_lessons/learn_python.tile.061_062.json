              "start_seconds": 323,
              "end_seconds": 411,
              "label": "Order numbers using an absolute-value key",
              "summary": "Ordinary numeric sorting places negative values before positive values. Passing abs as the key function changes the comparison to each number's absolute value: its distance from zero. The sorted result therefore orders the original numbers by magnitude, retaining their signs rather than replacing them with their comparison keys.",
              "fact_ids": [
                "f1"
              ],
              "transcript_ref": "D3JvDWO-BY4:323-411"
            }
          ],
          "group_title": "Ordering by a calculated comparison key",
          "bridge": {
            "before": "Watch how passing abs as the key changes the comparison criterion. Each number supplies a calculated comparison key, while the result still contains the original numbers.",
            "after": "The clip demonstrates comparison keys. The text also covers preserving the original list, reverse ordering, stable ordering for equal keys, and lowercase text keys."
          },
          "default_mode": "video"
        }
