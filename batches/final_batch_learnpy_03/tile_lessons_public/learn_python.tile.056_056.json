      "blocks": [
        {
          "type": "prose",
          "text": "Import Path with from pathlib import Path. It provides concrete paths using the platform’s path conventions.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.pathlib_paths"
            ],
            "fact_ids": [
              "python.pathlib_paths#f1"
