            "teaching_block_ids": [
              "python.pathlib_paths#tb3",
              "python.pathlib_paths#tb4",
              "python.pathlib_paths#tb5"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Relative paths are interpreted against the current working directory. Choose an explicit base directory to avoid depending on an unintended working directory.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.pathlib_paths"
            ],
