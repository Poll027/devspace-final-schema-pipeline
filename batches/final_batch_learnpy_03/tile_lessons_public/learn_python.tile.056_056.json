              "python.pathlib_paths#tb4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "base / \"child\" builds a child path. An absolute right operand instead replaces the previous path; it does not stay beneath that base.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.pathlib_paths"
            ],
            "fact_ids": [
              "python.pathlib_paths#f2"
