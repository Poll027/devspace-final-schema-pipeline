          "python.variadic_arguments_and_unpacking#f2",
          "python.variadic_arguments_and_unpacking#f3",
          "python.variadic_arguments_and_unpacking#f4"
        ],
        "segment_ids": [],
        "anchors": []
      },
      "blocks": [
        {
          "type": "prose",
          "text": "For wrapper(3, price=5), args is (3,) and kwargs is {'price': 5}. target(*args, **kwargs) binds quantity to 3 and price to 5. Adding price=4 to that target call would supply price twice.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f1",
              "python.variadic_arguments_and_unpacking#f2",
              "python.variadic_arguments_and_unpacking#f3",
              "python.variadic_arguments_and_unpacking#f4"
            ],
