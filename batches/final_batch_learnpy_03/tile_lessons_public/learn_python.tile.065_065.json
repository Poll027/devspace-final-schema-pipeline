    {
      "step_id": "learn_python.tile.065_065.s01",
      "type": "explainer",
      "concept_ids": [
        "python.variadic_arguments_and_unpacking"
      ],
      "title": "Binding variable arguments with *args and **kwargs",
      "lineage": {
        "concept_ids": [
          "python.variadic_arguments_and_unpacking"
        ],
        "teaching_block_ids": [
          "python.variadic_arguments_and_unpacking#tb1",
          "python.variadic_arguments_and_unpacking#tb2",
          "python.variadic_arguments_and_unpacking#tb3"
        ],
        "fact_ids": [
          "python.variadic_arguments_and_unpacking#f1",
          "python.variadic_arguments_and_unpacking#f2",
          "python.variadic_arguments_and_unpacking#f3",
          "python.variadic_arguments_and_unpacking#f4"
        ],
        "segment_ids": [],
        "anchors": [
          "python.variadic_arguments_and_unpacking#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "In a definition, *args collects remaining positional arguments into a tuple.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f1"
            ],
            "teaching_block_ids": [
              "python.variadic_arguments_and_unpacking#tb2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "In a definition, **kwargs collects additional keyword arguments into a dictionary. A call cannot give one parameter two values.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f2"
            ],
            "teaching_block_ids": [
              "python.variadic_arguments_and_unpacking#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "In a call, *args expands a sequence into positional arguments; **kwargs expands a dictionary into keyword arguments.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f3"
            ],
            "teaching_block_ids": [
              "python.variadic_arguments_and_unpacking#tb3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A forwarding wrapper can define wrapper(*args, **kwargs) and return target(*args, **kwargs). Do not add arguments that duplicate a supplied binding.",
          "role": "mechanism",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f4"
            ],
            "teaching_block_ids": [
              "python.variadic_arguments_and_unpacking#tb3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "def target(quantity, price=4):\n    return quantity * price\n\ndef wrapper(*args, **kwargs):\n    return target(*args, **kwargs)\n\nprint(wrapper(3, price=5))",
          "annotations": [
            {
              "start_line": 4,
              "end_line": 4,
              "text": "Collect positional arguments and additional keyword arguments."
            },
            {
              "start_line": 5,
              "end_line": 5,
              "text": "Expand both collections at the target call; do not duplicate a parameter."
            },
            {
              "start_line": 7,
              "end_line": 7,
              "text": "The supplied positional quantity and keyword price reach the target."
            }
          ],
          "reveal": "all",
          "lineage": {
            "concept_ids": [
              "python.variadic_arguments_and_unpacking"
            ],
            "fact_ids": [
              "python.variadic_arguments_and_unpacking#f1",
              "python.variadic_arguments_and_unpacking#f2",
              "python.variadic_arguments_and_unpacking#f3",
              "python.variadic_arguments_and_unpacking#f4"
            ],
            "teaching_block_ids": [
              "python.variadic_arguments_and_unpacking#tb2",
              "python.variadic_arguments_and_unpacking#tb3",
              "python.variadic_arguments_and_unpacking#tb4",
              "python.variadic_arguments_and_unpacking#tb5"
            ],
            "anchors": [
              "python.variadic_arguments_and_unpacking#visual"
            ]
          }
        }
      ]
    },
    {
