      "blocks": [
        {
          "type": "prose",
          "text": "Syntax errors happen during parsing. The report points to the line and location where the parser detected invalid syntax.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.syntax_vs_runtime_errors"
            ],
            "teaching_block_ids": [
              "python.syntax_vs_runtime_errors#tb2",
              "python.syntax_vs_runtime_errors#tb4"
            ],
            "fact_ids": [
              "python.syntax_vs_runtime_errors#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Valid syntax can still raise an exception during execution. Read the exception type and explanation in its error message.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.syntax_vs_runtime_errors"
            ],
            "teaching_block_ids": [
              "python.syntax_vs_runtime_errors#tb3",
              "python.syntax_vs_runtime_errors#tb4"
            ],
            "fact_ids": [
              "python.syntax_vs_runtime_errors#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Invalid syntax blocks compilation to an executable code object. Repair it before tracing that source’s runtime behavior.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.syntax_vs_runtime_errors"
            ],
            "teaching_block_ids": [
              "python.syntax_vs_runtime_errors#tb3",
              "python.syntax_vs_runtime_errors#tb4",
              "python.syntax_vs_runtime_errors#tb5"
            ],
