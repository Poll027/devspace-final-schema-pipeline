                "python.syntax_vs_runtime_errors#f3"
              ],
              "anchors": [
                "python.syntax_vs_runtime_errors#visual"
              ]
            }
          },
          "change_summary": "Repairing source structure is separate from investigating the runtime value.",
          "lineage": {
            "concept_ids": [
