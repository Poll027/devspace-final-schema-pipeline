                "python.syntax_vs_runtime_errors#f3"
              ],
              "anchors": [
                "python.syntax_vs_runtime_errors#visual"
              ]
            }
          },
          "after": {
            "type": "code_walkthrough",
            "language": "python",
            "code": "quantity = 1\nif quantity > 0:\n    quantity = int(\"three\")",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 3,
                "text": "The colon repairs syntax. The conversion still raises ValueError during execution; read its exception type and explanation."
              },
              {
                "start_line": 3,
                "end_line": 3,
                "text": "Runtime report: `ValueError: invalid literal for int() with base 10: 'three'`. Parsing now succeeds, but converting this text to an integer fails during execution."
              }
            ],
            "lineage": {
              "concept_ids": [
                "python.syntax_vs_runtime_errors"
              ],
              "teaching_block_ids": [
                "python.syntax_vs_runtime_errors#tb4"
              ],
              "fact_ids": [
                "python.syntax_vs_runtime_errors#f1",
