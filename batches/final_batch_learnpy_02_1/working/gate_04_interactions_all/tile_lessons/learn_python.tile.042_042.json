            ]
          }
        },
        {
          "type": "before_after",
          "before": {
            "type": "code_walkthrough",
            "language": "python",
            "code": "quantity = 1\nif quantity > 0\n    quantity = int(\"three\")",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 3,
                "text": "The header is missing its colon. Parsing detects invalid syntax; repair it before tracing execution."
              },
              {
                "start_line": 2,
                "end_line": 2,
                "text": "Parser report: `SyntaxError: expected ':'`; the detected location is the end of the `if quantity > 0` header, where its colon is missing."
              }
            ],
            "lineage": {
              "concept_ids": [
                "python.syntax_vs_runtime_errors"
              ],
              "teaching_block_ids": [
                "python.syntax_vs_runtime_errors#tb4"
              ],
              "fact_ids": [
