      "blocks": [
        {
          "type": "prose",
          "text": "Use [3, 2, 5] for editable quantities, (2, 5) for fixed bounds, {\"notebook\", \"pen\"} for distinct labels, and {\"notebook\": 3, \"pen\": 2} for quantities by label. Choose by the access and update needed, not literal length.",
          "role": "example",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb4"
            ],
            "fact_ids": [
              "python.collection_selection#f1",
              "python.collection_selection#f2",
              "python.collection_selection#f3",
              "python.collection_selection#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Insertion order does not make dictionary lookup positional: it uses keys. Sets also have no sequence positions, even when a display looks ordered.",
          "role": "misconception",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb5"
