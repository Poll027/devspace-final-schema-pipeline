        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Use a list when ordered positions need updates: it is a mutable sequence.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb2"
            ],
            "fact_ids": [
              "python.collection_selection#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A tuple is an immutable sequence for a fixed, ordered group.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb3"
            ],
            "fact_ids": [
              "python.collection_selection#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Sets hold distinct hashable values, not sequence positions. They support membership tests and set operations.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb3"
            ],
            "fact_ids": [
              "python.collection_selection#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "A dictionary maps hashable keys to values and allows updates. It preserves insertion order, but lookup uses keys rather than sequence positions.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.collection_selection"
            ],
            "teaching_block_ids": [
              "python.collection_selection#tb3"
            ],
            "fact_ids": [
              "python.collection_selection#f4"
            ]
          }
        },
        {
          "type": "comparison",
          "columns": [
            {
              "id": "example",
              "label": "Order helper collection"
            },
            {
              "id": "access",
              "label": "Access and updates"
            }
          ],
          "rows": [
            {
              "criterion": "List: editable positions",
              "cells": {
                "example": "[3, 2, 5]",
                "access": "Mutable sequence; access by position."
              }
            },
            {
              "criterion": "Tuple: fixed ordered group",
              "cells": {
                "example": "(2, 5)",
                "access": "Immutable sequence; fixed ordered values."
              }
            },
            {
              "criterion": "Set: distinct membership",
              "cells": {
                "example": "{\"notebook\", \"pen\"}",
                "access": "Distinct hashable values; membership and set operations; no sequence positions."
              }
            },
            {
              "criterion": "Dictionary: key lookup",
              "cells": {
                "example": "{\"notebook\": 3, \"pen\": 2}",
                "access": "Hashable keys map to values; updates and insertion order; lookup by key."
              }
            }
          ],
