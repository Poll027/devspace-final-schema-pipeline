        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "strip() removes leading and trailing whitespace, not whitespace inside the text.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_methods"
            ],
            "teaching_block_ids": [
              "python.string_methods#tb2",
              "python.string_methods#tb4",
              "python.string_methods#tb5"
            ],
            "fact_ids": [
              "python.string_methods#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The chars argument to strip describes removable edge characters, not a literal prefix or suffix.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_methods"
            ],
            "teaching_block_ids": [
              "python.string_methods#tb3",
              "python.string_methods#tb4",
              "python.string_methods#tb5"
            ],
            "fact_ids": [
              "python.string_methods#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "lower() returns a copy with cased characters changed to lowercase.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_methods"
            ],
            "teaching_block_ids": [
              "python.string_methods#tb3",
              "python.string_methods#tb4"
            ],
            "fact_ids": [
              "python.string_methods#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "With an explicit separator, split separates on that delimiter and keeps empty fields between repeated delimiters.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_methods"
            ],
            "teaching_block_ids": [
              "python.string_methods#tb3",
              "python.string_methods#tb4",
              "python.string_methods#tb5"
            ],
            "fact_ids": [
              "python.string_methods#f4"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Without a separator, split() groups whitespace runs and omits leading and trailing empty fields.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.string_methods"
            ],
            "teaching_block_ids": [
              "python.string_methods#tb3",
              "python.string_methods#tb4",
              "python.string_methods#tb5"
            ],
            "fact_ids": [
              "python.string_methods#f5"
            ]
          }
        },
        {
          "type": "side_by_side",
          "left": {
            "type": "code_walkthrough",
            "language": "python",
            "code": "text = \"  Blue  \"\nprint(text.strip().lower())\nprint(\"xylabelyx\".strip(\"xy\"))\nprint(\"  red   blue  \".strip())",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 3,
                "text": "Strip removes edge whitespace, not interior whitespace. Lower returns a lowercase copy; strip chars are removable characters."
              },
              {
                "start_line": 1,
                "end_line": 2,
                "text": "`text.strip()` returns `'Blue'`; applying `.lower()` returns `'blue'`."
              },
              {
                "start_line": 3,
                "end_line": 3,
                "text": "`'xylabelyx'.strip('xy')` returns `'label'`: x and y are removable edge characters, not a literal affix."
              },
              {
                "start_line": 4,
                "end_line": 4,
                "text": "Returns `'red   blue'`: the three interior spaces remain."
              }
            ],
            "lineage": {
              "concept_ids": [
                "python.string_methods"
              ],
              "teaching_block_ids": [
                "python.string_methods#tb4"
              ],
              "fact_ids": [
                "python.string_methods#f1",
                "python.string_methods#f2",
                "python.string_methods#f3",
                "python.string_methods#f4",
                "python.string_methods#f5"
              ],
              "anchors": [
                "python.string_methods#visual"
              ]
            }
          },
          "right": {
            "type": "code_walkthrough",
            "language": "python",
            "code": "print(\"red,,blue\".split(\",\"))\nprint(\"  red   blue  \".split())",
            "annotations": [
              {
                "start_line": 1,
                "end_line": 2,
                "text": "An explicit delimiter preserves empty fields between repeated delimiters; whitespace splitting groups runs and omits edge empty fields."
              },
              {
                "start_line": 1,
                "end_line": 1,
                "text": "`'red,,blue'.split(',')` returns `['red', '', 'blue']`."
              },
              {
                "start_line": 2,
                "end_line": 2,
                "text": "`'  red   blue  '.split()` returns `['red', 'blue']`."
              }
            ],
            "lineage": {
              "concept_ids": [
                "python.string_methods"
              ],
              "teaching_block_ids": [
                "python.string_methods#tb4"
              ],
              "fact_ids": [
                "python.string_methods#f1",
                "python.string_methods#f2",
                "python.string_methods#f3",
                "python.string_methods#f4",
                "python.string_methods#f5"
              ],
              "anchors": [
                "python.string_methods#visual"
              ]
            }
          },
          "left_label": "Clean edges and change case",
          "right_label": "Separate fields",
          "takeaway": "Removing edge whitespace is not the same operation as splitting fields.",
