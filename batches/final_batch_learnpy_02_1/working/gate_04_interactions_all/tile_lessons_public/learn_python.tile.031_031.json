            ]
          }
        },
        {
          "type": "prose",
          "text": "math functions operate on real rather than complex values; an invalid operation such as sqrt(-1.0) raises ValueError.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.math_utilities"
            ],
            "teaching_block_ids": [
