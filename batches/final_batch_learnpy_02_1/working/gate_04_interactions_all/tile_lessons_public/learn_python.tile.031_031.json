        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "import math\nprint(math.sqrt(9))\ntry:\n    print(math.sqrt(-1.0))\nexcept ValueError:\n    print(\"No real square root for this input\")",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 1,
              "text": "Import the math module before using its functions."
            },
            {
              "start_line": 2,
              "end_line": 2,
              "text": "`math.sqrt(9)` returns `3.0`, which this print call displays."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "`math.sqrt(-1.0)` raises `ValueError`: this input has no real square root. It does not return a complex result."
