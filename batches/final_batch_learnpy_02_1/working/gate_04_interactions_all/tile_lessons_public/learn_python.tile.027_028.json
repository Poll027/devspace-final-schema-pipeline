              "python.console_input_output#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "print separates displayed values with spaces and finishes with a newline by default. Customize the separators with sep and the ending with end.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.console_input_output"
            ],
            "teaching_block_ids": [
              "python.console_input_output#tb3",
