        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "label = input(\"Label: \")\nprint(\"Selected\", label, sep=\": \", end=\"!\\n\")",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 2,
              "text": "The prompt is displayed, but it is not part of the returned input text."
