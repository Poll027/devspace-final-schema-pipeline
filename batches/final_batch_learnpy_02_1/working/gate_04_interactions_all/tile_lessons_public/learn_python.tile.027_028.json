          "type": "prose",
          "text": "With an indented body, for position, value in enumerate(sequence, start=1): numbers entries from one. No manual counter update is needed.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.enumerate_iteration"
            ],
            "teaching_block_ids": [
              "python.enumerate_iteration#tb3",
