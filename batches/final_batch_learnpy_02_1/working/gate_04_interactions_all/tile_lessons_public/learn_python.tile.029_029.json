          "python.floating_point_limits#tb5"
        ],
        "segment_ids": [],
        "anchors": [
          "python.floating_point_limits#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "Many decimal fractions have no exact binary floating-point representation.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.floating_point_limits"
            ],
            "teaching_block_ids": [
              "python.floating_point_limits#tb2",
              "python.floating_point_limits#tb4"
            ],
            "fact_ids": [
              "python.floating_point_limits#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "math.isclose(a, b, rel_tol=..., abs_tol=...) uses relative and absolute tolerances instead of demanding exact equality.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.floating_point_limits"
            ],
            "teaching_block_ids": [
              "python.floating_point_limits#tb3",
              "python.floating_point_limits#tb4"
            ],
            "fact_ids": [
              "python.floating_point_limits#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "The default relative tolerance is 1e-9 and absolute tolerance is 0.0; comparison to zero requires an appropriate positive absolute tolerance when nonzero differences should count as close.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.floating_point_limits"
            ],
            "teaching_block_ids": [
              "python.floating_point_limits#tb3",
              "python.floating_point_limits#tb4",
              "python.floating_point_limits#tb5"
            ],
            "fact_ids": [
              "python.floating_point_limits#f3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "import math\nprint(0.1 + 0.2 == 0.3)\nprint(math.isclose(0.1 + 0.2, 0.3))\nprint(math.isclose(0.000001, 0.0, abs_tol=0.00001))",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 4,
              "text": "Near zero, the default absolute tolerance supplies no positive allowance."
            },
            {
              "start_line": 2,
              "end_line": 2,
              "text": "Result: `False`; this computed sum is not exactly equal to 0.3."
            },
            {
              "start_line": 3,
              "end_line": 3,
              "text": "Result: `True`; the values are close under the default tolerances."
            },
            {
              "start_line": 4,
              "end_line": 4,
              "text": "Result: `True`; the explicit positive `abs_tol=0.00001` allows this difference from zero."
            }
          ],
          "lineage": {
            "concept_ids": [
              "python.floating_point_limits"
            ],
            "teaching_block_ids": [
              "python.floating_point_limits#tb4"
            ],
            "fact_ids": [
              "python.floating_point_limits#f1",
              "python.floating_point_limits#f2",
              "python.floating_point_limits#f3"
            ],
            "anchors": [
              "python.floating_point_limits#visual"
            ]
          }
        }
      ]
    },
