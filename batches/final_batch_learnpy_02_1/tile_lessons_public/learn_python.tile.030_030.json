          "segments": [
            {
              "segment_id": "seg_python.indentation_and_blocks_aWe2BfHXnik_29_193",
              "video_id": "aWe2BfHXnik",
              "youtube_url": "https://www.youtube.com/watch?v=aWe2BfHXnik",
              "review_url": "https://www.youtube.com/watch?v=aWe2BfHXnik&t=29s",
              "start_seconds": 29,
              "end_seconds": 193,
              "label": "Recognise block membership and repair inconsistent indentation",
              "summary": "Indentation determines which statements belong to an if body. Statements aligned within that body share its condition; an unindented statement following it is outside the body. The example uses x = 10 and compares x with 5. Giving statements in the same body different indentation produces errors; aligning them consistently repairs the structure. Although consistent two-space indentation can work, use four spaces per level.",
              "fact_ids": [
                "f2",
                "f3"
              ],
              "transcript_ref": "aWe2BfHXnik:29-193"
            },
            {
              "segment_id": "seg_python.indentation_and_blocks_CcgSYrWwSpE_0_398",
              "video_id": "CcgSYrWwSpE",
              "youtube_url": "https://www.youtube.com/watch?v=CcgSYrWwSpE",
              "review_url": "https://www.youtube.com/watch?v=CcgSYrWwSpE&t=0s",
              "start_seconds": 0,
              "end_seconds": 398,
              "label": "Build indented bodies and add a deeper nested block",
              "summary": "An if header ends with a colon, and its indented statements run only when its condition is true. Moving a following statement into or out of that indentation changes whether it belongs to the conditional body. Inconsistent spacing produces an indentation error. Tabs and spaces are different characters, and mixing them can fail even when their alignment looks similar. Use four spaces per level rather than the alternative widths discussed. An if inside another if introduces a deeper body, indented another four spaces.",
              "fact_ids": [
                "f1",
                "f2",
                "f3"
              ],
              "transcript_ref": "CcgSYrWwSpE:0-398"
            }
          ],
          "group_title": "Grouping statements with indentation",
          "bridge": {
            "before": "Watch how indentation changes statement membership and how the second clip adds a deeper block. Both discuss alternative indentation widths; Devspace uses four spaces per level. A block is the header's multi-line suite.",
            "after": "The first clip does not explain deeper nesting or the colon-ended header requirement; the text covers both. The second demonstrates nested conditions; the text applies the same grouping rules to a condition inside a loop."
          },
          "default_mode": "video"
        }
      ]
    },
