      "step_id": "learn_python.tile.045_045.s01",
      "type": "explainer",
      "concept_ids": [
        "python.unicode_and_bytes"
      ],
      "eyebrow": "Learn",
      "title": "Encoding and decoding Unicode text and bytes",
      "lineage": {
        "fact_ids": [
          "python.unicode_and_bytes#f1",
          "python.unicode_and_bytes#f2",
          "python.unicode_and_bytes#f3",
          "python.unicode_and_bytes#f4"
        ],
        "teaching_block_ids": [
          "python.unicode_and_bytes#tb1",
          "python.unicode_and_bytes#tb2",
          "python.unicode_and_bytes#tb3",
          "python.unicode_and_bytes#tb4",
          "python.unicode_and_bytes#tb5"
        ],
        "segment_ids": [],
        "anchors": [
          "python.unicode_and_bytes#visual"
        ]
      },
      "blocks": [
        {
          "type": "prose",
          "text": "str holds Unicode text; bytes holds binary data. They are distinct kinds of values.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.unicode_and_bytes"
            ],
            "teaching_block_ids": [
              "python.unicode_and_bytes#tb2",
              "python.unicode_and_bytes#tb4",
              "python.unicode_and_bytes#tb5"
            ],
            "fact_ids": [
              "python.unicode_and_bytes#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "text.encode(\"utf-8\") produces bytes using UTF-8.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.unicode_and_bytes"
            ],
            "teaching_block_ids": [
              "python.unicode_and_bytes#tb3",
              "python.unicode_and_bytes#tb4"
            ],
            "fact_ids": [
              "python.unicode_and_bytes#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Decode UTF-8 bytes with payload.decode(\"utf-8\") to get text. Match the decoding encoding to the encoded data to recover that text.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.unicode_and_bytes"
            ],
            "teaching_block_ids": [
              "python.unicode_and_bytes#tb3",
              "python.unicode_and_bytes#tb4",
              "python.unicode_and_bytes#tb5"
            ],
            "fact_ids": [
              "python.unicode_and_bytes#f3"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Bytes invalid for the chosen decoding cause a decoding failure: UnicodeDecodeError.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.unicode_and_bytes"
            ],
            "teaching_block_ids": [
              "python.unicode_and_bytes#tb3",
              "python.unicode_and_bytes#tb4",
              "python.unicode_and_bytes#tb5"
            ],
            "fact_ids": [
              "python.unicode_and_bytes#f4"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "text = \"café\"\npayload = text.encode(\"utf-8\")\nrestored = payload.decode(\"utf-8\")\nprint(type(text))\nprint(type(payload))\nprint(restored)\nprint(restored == text)",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 7,
              "text": "Encoded bytes are not already Unicode text."
            },
            {
              "start_line": 1,
              "end_line": 1,
              "text": "`text` is the Unicode string `'café'`."
            },
            {
              "start_line": 2,
              "end_line": 2,
              "text": "`payload` is the UTF-8 bytes value `b'caf\\xc3\\xa9'`, not a str."
            },
            {
              "start_line": 3,
              "end_line": 3,
              "text": "Matching UTF-8 decoding restores `'café'`."
            },
            {
              "start_line": 4,
              "end_line": 5,
              "text": "The displayed types are `<class 'str'>` and `<class 'bytes'>`."
            },
            {
              "start_line": 6,
              "end_line": 6,
              "text": "Displays `café`."
            },
            {
              "start_line": 7,
              "end_line": 7,
              "text": "Displays `True`: restored text equals the original text."
            }
          ],
          "lineage": {
            "concept_ids": [
              "python.unicode_and_bytes"
            ],
            "teaching_block_ids": [
              "python.unicode_and_bytes#tb4"
            ],
            "fact_ids": [
              "python.unicode_and_bytes#f1",
              "python.unicode_and_bytes#f2",
              "python.unicode_and_bytes#f3",
              "python.unicode_and_bytes#f4"
            ],
            "anchors": [
              "python.unicode_and_bytes#visual"
            ]
          }
        }
      ]
