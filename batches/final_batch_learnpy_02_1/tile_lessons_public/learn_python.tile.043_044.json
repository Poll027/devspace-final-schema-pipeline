            ]
          }
        },
        {
          "type": "prose",
          "text": "Use if collection: for a nonempty guard, or if not collection: for an empty guard. No equality comparison to True is required.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.truth_value_testing"
