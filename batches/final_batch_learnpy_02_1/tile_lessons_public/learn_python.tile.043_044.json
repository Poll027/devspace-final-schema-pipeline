      "blocks": [
        {
          "type": "prose",
          "text": "None is a singleton commonly used to mark an absent value.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.none_and_identity"
            ],
            "teaching_block_ids": [
              "python.none_and_identity#tb2",
              "python.none_and_identity#tb4"
            ],
            "fact_ids": [
              "python.none_and_identity#f1"
            ]
          }
        },
        {
          "type": "prose",
          "text": "is asks whether two operands are the same object; is not asks whether they are different objects.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.none_and_identity"
            ],
            "teaching_block_ids": [
              "python.none_and_identity#tb3",
              "python.none_and_identity#tb4"
            ],
            "fact_ids": [
              "python.none_and_identity#f2"
            ]
          }
        },
        {
          "type": "prose",
          "text": "Test absence with value is None or value is not None. A truth test also rejects legitimate zero or empty values.",
          "role": "definition",
          "lineage": {
            "concept_ids": [
              "python.none_and_identity"
            ],
            "teaching_block_ids": [
              "python.none_and_identity#tb3",
              "python.none_and_identity#tb4",
              "python.none_and_identity#tb5"
            ],
            "fact_ids": [
              "python.none_and_identity#f3"
            ]
          }
        },
        {
          "type": "code_walkthrough",
          "language": "python",
          "code": "quantity = 0\nif quantity is not None:\n    print(\"Quantity supplied\", quantity)\nquantity = None\nif quantity is None:\n    print(\"Quantity absent\")",
          "annotations": [
            {
              "start_line": 1,
              "end_line": 6,
              "text": "For quantity 0, `quantity is not None` is true even though a truth test of quantity is false. For quantity None, `quantity is None` is true and a truth test is also false. Identity distinguishes absence from legitimate zero."
            }
          ],
          "lineage": {
            "concept_ids": [
              "python.none_and_identity"
            ],
            "teaching_block_ids": [
              "python.none_and_identity#tb4"
            ],
            "fact_ids": [
