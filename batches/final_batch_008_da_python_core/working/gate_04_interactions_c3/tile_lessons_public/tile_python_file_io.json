          "prompt": "What is the main advantage of using `with open('orders.txt', 'r') as f:` instead of `f = open('orders.txt', 'r')`?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "It reads the file faster."
            },
            {
              "option_id": "opt_b",
              "text": "It closes the file automatically when the block finishes, even if an exception is raised."
            },
            {
              "option_id": "opt_c",
              "text": "It prevents other programs from reading the file at the same time."
            },
            {
              "option_id": "opt_d",
              "text": "It loads the entire file into memory before the block starts."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "The `with` statement does not affect read speed. Its purpose is automatic resource management."
            },
            "opt_b": {
              "message": "Correct. The `with` statement closes the file automatically when the block ends, even if an exception is raised inside the block."
            },
            "opt_c": {
              "message": "The `with` statement does not lock the file for exclusive access. Its purpose is to ensure the file is closed when the block exits."
            },
            "opt_d": {
              "message": "The `with` statement does not preload the file. It simply ensures the file object is closed when the block finishes."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Right — `with open(...)` guarantees the file is closed when the block exits, even if an exception occurs."
          },
