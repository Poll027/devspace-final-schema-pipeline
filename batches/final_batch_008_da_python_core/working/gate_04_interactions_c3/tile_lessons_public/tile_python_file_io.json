        "grading": {
          "correct_option_ids": [
            "opt_c"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "`'r'` opens a file for reading. It raises an error if the file does not exist and does not erase existing content."
            },
            "opt_b": {
              "message": "`'a'` opens a file for appending — it adds to the end of an existing file rather than erasing it."
            },
            "opt_c": {
              "message": "Correct. `'w'` opens a file for writing. It creates the file if it does not exist and erases any existing content."
            },
            "opt_d": {
              "message": "Omitting the mode defaults to `'r'` (read), not write. To write, you must pass `'w'` explicitly."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Right — `'w'` mode creates the file if needed and erases existing content before writing."
          },
          "incorrect": {
            "message": "The three main modes are `'r'` (read), `'w'` (write, erasing existing content), and `'a'` (append). Writing from scratch uses `'w'`."
          },
          "hints": [
            "Think about what the first letter of each mode stands for: r=read, w=write, a=append.",
            "Which mode would erase an existing file's contents before writing new data?"
          ],
          "remediation_step_id": "tile_python_file_io.r01"
        }
      }
