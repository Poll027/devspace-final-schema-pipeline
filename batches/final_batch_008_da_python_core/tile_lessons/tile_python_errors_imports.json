              "f3"
            ]
          }
        ],
        "anchors": [
          "python.error_handling#assessment:handle_invalid_number_conversion"
        ],
        "public": {
          "prompt": "```python\ntry:\n    minutes = int('fast')\nexcept ValueError:\n    print('Not a valid number')\n```\n\nWhat does this code print?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "Nothing — the program crashes with a `ValueError`."
            },
            {
              "option_id": "opt_b",
              "text": "`Not a valid number`"
            },
            {
              "option_id": "opt_c",
              "text": "`0` — Python converts non-numeric strings to `0`."
            },
            {
              "option_id": "opt_d",
              "text": "`ValueError` — the exception message is printed automatically."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "The `except ValueError:` clause catches the error, so the program does not crash. It prints the message instead."
            },
            "opt_b": {
              "message": "Correct. `int('fast')` raises a `ValueError`, which the `except ValueError:` clause catches, printing 'Not a valid number'."
            },
            "opt_c": {
              "message": "Python does not convert non-numeric strings to `0`. `int('fast')` raises a `ValueError`."
            },
            "opt_d": {
              "message": "Python does not automatically print exception messages. The `except` clause runs your code — in this case `print('Not a valid number')`."
            }
          }
        },
        "feedback": {
          "correct": {
            "message": "Right — `int('fast')` raises a `ValueError`, the `except ValueError:` clause catches it, and the message is printed."
          },
          "incorrect": {
            "message": "When `int()` cannot convert a string, it raises a `ValueError`. The `except ValueError:` clause catches it and runs the code inside — here, printing the message."
          },
          "hints": [
            "What does `int('fast')` do? Can it convert the string 'fast' to an integer?",
            "When an exception matches the `except` clause, the clause's body runs instead of crashing."
          ],
          "remediation_step_id": "tile_python_errors_imports.r01"
        }
      }
