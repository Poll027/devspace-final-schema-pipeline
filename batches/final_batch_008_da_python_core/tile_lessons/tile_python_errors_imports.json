        "public": {
          "prompt": "After running `import fibo`, how do you call the `fib` function from that module?",
          "options": [
            {
              "option_id": "opt_a",
              "text": "`fib(1000)` — `import fibo` adds `fib` directly to the namespace."
            },
            {
              "option_id": "opt_b",
              "text": "`fibo.fib(1000)` — the module name is the prefix."
            },
            {
              "option_id": "opt_c",
              "text": "`import fibo.fib(1000)` — you import and call in one step."
            },
            {
              "option_id": "opt_d",
              "text": "`fibo(fib, 1000)` — you pass the function name as an argument."
            }
          ],
          "selection": "single",
          "shuffle": true
        },
        "grading": {
          "correct_option_ids": [
            "opt_b"
          ],
          "option_feedback": {
            "opt_a": {
              "message": "`import fibo` adds the module name `fibo` to the namespace, not the names inside it. To call `fib` directly, you would need `from fibo import fib`."
