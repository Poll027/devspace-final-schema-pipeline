            ]
          }
        },
        {
          "step_id": "tile_stakeholder_prioritizing_framing_context.s02",
          "type": "explainer",
          "concept_ids": [
            "stakeholder.prioritizing_findings_by_relevance"
          ],
          "eyebrow": "Prioritizing Findings",
          "title": "Put the most important finding first",
          "lede": "Once you know which finding matters most, the inverted pyramid tells you where to put it.",
          "blocks": [
            {
              "type": "prose",
              "block_id": "tile_stakeholder_prioritizing_framing_context.s02.b1",
              "role": "workflow",
              "text": "Use the inverted pyramid: most important information first, everything else from most to least important. For the QuickShip delivery report, the Lagos slowdown opens the report; other findings follow only if relevant to the decision.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.prioritizing_findings_by_relevance"
                ],
                "teaching_block_ids": [
                  "stakeholder.prioritizing_findings_by_relevance#tb4"
                ],
                "fact_ids": [
                  "stakeholder.prioritizing_findings_by_relevance#f4"
                ]
              }
            }
          ],
          "reward": {
