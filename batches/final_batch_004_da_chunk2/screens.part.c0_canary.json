                    "tone": "focus"
                  }
                ]
              },
              "takeaway": "Same dataset, two orderings. Kano leads when ranked by analytical interestingness; Lagos leads when ranked by relevance to the decision. The stakeholder's decision is the right criterion.",
              "lineage": {
                "concept_ids": [
                  "stakeholder.prioritizing_findings_by_relevance"
                ],
