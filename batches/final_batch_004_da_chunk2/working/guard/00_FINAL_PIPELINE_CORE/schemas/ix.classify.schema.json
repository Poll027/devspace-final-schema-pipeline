{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.classify.schema.json",
  "title": "Interaction: classify (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "classify"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bucket_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "bucket_id",
              "label"
            ]
          },
          "minItems": 2
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "row": {
                    "$ref": "common.schema.json#/$defs/row_ref"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "row",
                  "column"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "item_id",
              "text"
            ]
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "buckets",
        "items"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "assignments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "role_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "item_feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "message": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false,
            "required": [
              "message"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "assignments"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
