{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.before_after.schema.json",
  "title": "Block: before_after (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "before_after"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "before": {
      "oneOf": [
        {
          "$ref": "block.data_table.schema.json"
        },
        {
          "$ref": "block.spreadsheet_grid.schema.json"
        },
        {
          "$ref": "block.chart.schema.json"
        },
        {
          "$ref": "block.code_walkthrough.schema.json"
        },
        {
          "$ref": "block.diagram.schema.json"
        },
        {
          "$ref": "block.process_flow.schema.json"
        }
      ]
    },
    "after": {
      "oneOf": [
        {
          "$ref": "block.data_table.schema.json"
        },
        {
          "$ref": "block.spreadsheet_grid.schema.json"
        },
        {
          "$ref": "block.chart.schema.json"
        },
        {
          "$ref": "block.code_walkthrough.schema.json"
        },
        {
          "$ref": "block.diagram.schema.json"
        },
        {
          "$ref": "block.process_flow.schema.json"
        }
      ]
    },
    "change_summary": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "before",
    "after",
    "change_summary"
  ]
}
