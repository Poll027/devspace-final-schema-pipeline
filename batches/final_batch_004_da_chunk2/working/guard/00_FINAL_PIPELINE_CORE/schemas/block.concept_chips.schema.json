{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.concept_chips.schema.json",
  "title": "Block: concept_chips (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "concept_chips"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short_text": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "additionalProperties": false,
        "required": [
          "concept_id",
          "label",
          "short_text"
        ]
      },
      "minItems": 2
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "items"
  ]
}
