{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.callout.schema.json",
  "title": "Block: callout (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "callout"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tone": {
      "enum": [
        "info",
        "tip",
        "warning",
        "misconception"
      ]
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "tone",
    "text"
  ]
}
