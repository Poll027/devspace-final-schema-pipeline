{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step.schema.json",
  "title": "A single player screen",
  "type": "object",
  "properties": {
    "step_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "enum": [
        "explainer",
        "video",
        "check",
        "hands_on",
        "recap",
        "remediation"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lede": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "block_union.schema.json"
      }
    },
    "interaction": {
      "$ref": "interaction_union.schema.json"
    },
    "reward": {
      "$ref": "common.schema.json#/$defs/reward"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "step_id",
    "type",
    "title",
    "concept_ids",
    "lineage"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "check",
              "hands_on"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "interaction"
        ]
      },
      "else": {
        "not": {
          "required": [
            "interaction"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "explainer",
              "video",
              "recap",
              "remediation"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "blocks"
        ]
      }
    }
  ]
}
