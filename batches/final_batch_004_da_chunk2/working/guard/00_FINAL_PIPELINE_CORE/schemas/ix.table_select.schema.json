{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.table_select.schema.json",
  "title": "Interaction: table_select (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "table_select"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "asset_ref": {
          "$ref": "common.schema.json#/$defs/asset_ref"
        },
        "intro": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "prompt": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "target_kind": {
                "enum": [
                  "row",
                  "column",
                  "cell"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "task_id",
              "prompt",
              "target_kind"
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "asset_ref",
        "tasks"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "row": {
                "$ref": "common.schema.json#/$defs/row_ref"
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "expect_value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "task_id"
            ]
          },
          "minItems": 1
        },
        "task_feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "correct": {
                "type": "string"
              },
              "incorrect": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "answers"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
