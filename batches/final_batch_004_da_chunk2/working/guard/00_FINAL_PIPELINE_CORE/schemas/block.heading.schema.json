{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.heading.schema.json",
  "title": "Block: heading (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "heading"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        2,
        3
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "text"
  ]
}
