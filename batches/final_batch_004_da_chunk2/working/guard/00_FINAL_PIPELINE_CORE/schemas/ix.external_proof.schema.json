{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.external_proof.schema.json",
  "title": "Interaction: external_proof (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "external_proof"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "instruction": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "evidence_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "url",
              "screenshot",
              "file",
              "text"
            ]
          },
          "minItems": 1
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "instruction",
        "evidence_kinds"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "self_attest",
            "rubric_ai",
            "manual"
          ]
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "criterion"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
