{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.choice.schema.json",
  "title": "Interaction: choice (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "choice"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "option_id",
              "text"
            ]
          },
          "minItems": 2
        },
        "selection": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "shuffle": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "options",
        "selection"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "correct_option_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 1
        },
        "option_feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "message": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "misconception_id": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "additionalProperties": false,
            "required": [
              "message"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "correct_option_ids"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
