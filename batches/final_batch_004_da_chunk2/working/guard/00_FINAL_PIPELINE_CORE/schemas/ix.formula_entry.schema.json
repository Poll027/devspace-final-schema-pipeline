{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.formula_entry.schema.json",
  "title": "Interaction: formula_entry (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "formula_entry"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "asset_ref": {
          "$ref": "common.schema.json#/$defs/asset_ref"
        },
        "sheet_name": {
          "type": "string"
        },
        "target_cell": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]+$"
        },
        "allowed_functions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "asset_ref",
        "target_cell"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "expected_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "must_use_functions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbid_hardcoded_values": {
          "type": "boolean"
        },
        "reference_formula": {
          "type": "string"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "expected_value"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
