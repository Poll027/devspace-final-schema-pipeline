{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.process_flow.schema.json",
  "title": "Block: process_flow (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "process_flow"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "TB",
        "LR"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "start",
              "end",
              "step",
              "decision",
              "io",
              "subprocess"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      },
      "minItems": 2
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "next",
              "yes",
              "no",
              "loop_back",
              "branch"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ]
      }
    },
    "reveal": {
      "enum": [
        "all",
        "stepwise"
      ]
    },
    "alt_text": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "nodes",
    "edges",
    "alt_text"
  ]
}
