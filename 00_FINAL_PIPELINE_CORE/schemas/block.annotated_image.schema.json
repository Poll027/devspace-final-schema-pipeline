{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.annotated_image.schema.json",
  "title": "Block: annotated_image (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "annotated_image"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "alt_text": {
      "type": "string",
      "minLength": 1
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "w",
          "h",
          "label"
        ]
      }
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "asset_id",
    "alt_text"
  ]
}
