{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.chart.schema.json",
  "title": "Block: chart (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "chart"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "chart_kind": {
      "enum": [
        "bar",
        "line",
        "scatter",
        "histogram",
        "box",
        "pie",
        "heatmap"
      ]
    },
    "asset_ref": {
      "$ref": "common.schema.json#/$defs/asset_ref"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "alt_text": {
      "type": "string",
      "minLength": 1
    },
    "encoding": {
      "type": "object",
      "properties": {
        "x": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "quantitative",
                "ordinal",
                "nominal",
                "temporal"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "type"
          ]
        },
        "y": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "quantitative",
                "ordinal",
                "nominal",
                "temporal"
              ]
            },
            "aggregate": {
              "enum": [
                "sum",
                "mean",
                "median",
                "count",
                "min",
                "max"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "type"
          ]
        },
        "color": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "field"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "x"
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "text"
        ]
      }
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "chart_kind",
    "asset_ref",
    "title",
    "alt_text",
    "encoding"
  ]
}
