{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.diagram_label.schema.json",
  "title": "Interaction: diagram_label (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "diagram_label"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "diagram": {
          "$ref": "block.diagram.schema.json"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "label_id",
              "text"
            ]
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "diagram",
        "labels"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "placements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "placements"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
