{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screens_part.schema.json",
  "title": "Stage 03 output: explainer/video/recap/remediation content; check/hands_on steps carry framing only",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "screens_part"
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tile_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "type": {
                  "enum": [
                    "explainer",
                    "video",
                    "check",
                    "hands_on",
                    "recap",
                    "remediation"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "concept_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 1
                },
                "eyebrow": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "block_union.schema.json"
                  }
                },
                "reward": {
                  "$ref": "common.schema.json#/$defs/reward"
                },
                "lineage": {
                  "$ref": "common.schema.json#/$defs/lineage"
                }
              },
              "additionalProperties": false,
              "required": [
                "step_id",
                "type",
                "title",
                "concept_ids",
                "lineage"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "explainer",
                          "video",
                          "recap",
                          "remediation"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "blocks"
                    ]
                  }
                }
              ]
            },
            "minItems": 1
          },
          "remediation_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "type": {
                  "enum": [
                    "explainer",
                    "video",
                    "check",
                    "hands_on",
                    "recap",
                    "remediation"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "concept_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 1
                },
                "eyebrow": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "lede": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "block_union.schema.json"
                  }
                },
                "reward": {
                  "$ref": "common.schema.json#/$defs/reward"
                },
                "lineage": {
                  "$ref": "common.schema.json#/$defs/lineage"
                }
              },
              "additionalProperties": false,
              "required": [
                "step_id",
                "type",
                "title",
                "concept_ids",
                "lineage"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "explainer",
                          "video",
                          "recap",
                          "remediation"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "blocks"
                    ]
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "tile_id",
          "title",
          "steps"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_id",
    "batch_id",
    "tiles"
  ]
}
