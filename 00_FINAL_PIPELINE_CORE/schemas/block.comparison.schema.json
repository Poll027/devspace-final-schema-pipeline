{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.comparison.schema.json",
  "title": "Block: comparison (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "comparison"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      },
      "minItems": 2
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "cells": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "criterion",
          "cells"
        ]
      },
      "minItems": 1
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "columns",
    "rows"
  ]
}
