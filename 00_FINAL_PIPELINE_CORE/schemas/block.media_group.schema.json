{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.media_group.schema.json",
  "title": "Block: media_group (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "media_group"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "group_title": {
      "type": "string"
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "video_id": {
            "type": "string",
            "minLength": 1
          },
          "youtube_url": {
            "type": "string",
            "minLength": 1
          },
          "review_url": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "transcript_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "segment_id",
          "video_id",
          "youtube_url",
          "start_seconds",
          "end_seconds",
          "summary"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "bridge": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "default_mode": {
      "enum": [
        "video",
        "summary"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "segment_ids"
  ]
}
