{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.find_issues.schema.json",
  "title": "Interaction: find_issues (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "find_issues"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "asset_ref": {
          "$ref": "common.schema.json#/$defs/asset_ref"
        },
        "instructions": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "category_id",
              "label"
            ]
          },
          "minItems": 2
        },
        "goal_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "asset_ref",
        "instructions",
        "categories",
        "goal_count"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "category_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "locations": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/cell_ref"
                },
                "minItems": 1
              },
              "explanation": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false,
            "required": [
              "issue_id",
              "category_id",
              "locations",
              "explanation"
            ]
          },
          "minItems": 1
        },
        "decoys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "$ref": "common.schema.json#/$defs/cell_ref"
              },
              "message": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "additionalProperties": false,
            "required": [
              "location",
              "message"
            ]
          }
        },
        "wrong_category_message": {
          "type": "string"
        },
        "completion_message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "issues"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
