{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.data_table.schema.json",
  "title": "Block: data_table (data pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "data_table"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "asset_ref": {
      "$ref": "common.schema.json#/$defs/asset_ref"
    },
    "caption": {
      "type": "string"
    },
    "highlight": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "label": {
            "type": "string"
          },
          "tone": {
            "enum": [
              "focus",
              "good",
              "bad",
              "neutral"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "target"
        ]
      }
    },
    "tag_columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "enum": [
              "focus",
              "good",
              "bad",
              "neutral"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "column",
          "tag"
        ]
      }
    },
    "inspect": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "caption_template": {
          "type": "string"
        },
        "id_column": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "asset_ref"
  ]
}
