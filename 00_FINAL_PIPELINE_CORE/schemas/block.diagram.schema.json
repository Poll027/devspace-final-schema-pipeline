{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.diagram.schema.json",
  "title": "Block: diagram (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "diagram"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "diagram_kind": {
      "enum": [
        "graph",
        "erd",
        "architecture",
        "network",
        "sequence",
        "venn",
        "tree",
        "layers",
        "mindmap",
        "timeline",
        "number_line",
        "array",
        "mapping",
        "container"
      ]
    },
    "title": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "value": {
            "type": "number"
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "cardinality": {
            "enum": [
              "1:1",
              "1:N",
              "N:1",
              "N:N"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "directed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ]
      }
    },
    "layout": {
      "enum": [
        "auto",
        "manual"
      ]
    },
    "positions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ]
      }
    },
    "alt_text": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "diagram_kind",
    "nodes",
    "alt_text"
  ]
}
