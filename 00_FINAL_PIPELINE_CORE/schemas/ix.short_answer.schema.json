{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.short_answer.schema.json",
  "title": "Interaction: short_answer (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "short_answer"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "input_kind": {
          "enum": [
            "text",
            "number"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "input_kind"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "accepted_answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "numeric": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "value"
          ]
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
