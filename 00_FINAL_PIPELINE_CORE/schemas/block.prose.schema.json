{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.prose.schema.json",
  "title": "Block: prose (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "prose"
    },
    "block_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "role": {
      "enum": [
        "intro",
        "definition",
        "mechanism",
        "example",
        "misconception",
        "takeaway",
        "syntax",
        "workflow",
        "practical_context",
        "mental_model",
        "walkthrough"
      ]
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "text"
  ]
}
