{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tile_plan.schema.json",
  "title": "Stage 02 output: deterministic step skeleton per tile",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "tile_plan"
    },
    "path_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tile_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "region_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "terrain_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "concept_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 1
          },
          "cluster_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "next_tile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "type": {
                  "enum": [
                    "explainer",
                    "video",
                    "check",
                    "hands_on",
                    "recap"
                  ]
                },
                "concept_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 1
                },
                "teaching_block_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "fact_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "segment_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "planned_interaction_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "planned_visual_block_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "visual_purpose": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "word_budget": {
                  "type": "integer",
                  "minimum": 0
                },
                "mapping_rule": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "step_id",
                "type",
                "concept_ids"
              ]
            }
          },
          "needs": {
            "type": "object",
            "properties": {
              "packs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "block_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "interaction_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "runtimes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "tile_id",
          "concept_ids",
          "steps",
          "needs"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_id",
    "batch_id",
    "tiles"
  ]
}
