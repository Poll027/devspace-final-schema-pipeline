{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.ordering.schema.json",
  "title": "Interaction: ordering (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "ordering"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "item_id",
              "text"
            ]
          },
          "minItems": 2
        },
        "follow_up": {
          "type": "object",
          "properties": {
            "prompt": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option_id": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "option_id",
                  "text"
                ]
              },
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "prompt",
            "options"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "items"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "correct_order": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 2
        },
        "accepted_alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "loop_back_note": {
          "type": "string"
        },
        "follow_up_correct_option_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "correct_order"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
