{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ix.match_pairs.schema.json",
  "title": "Interaction: match_pairs (core pack)",
  "type": "object",
  "properties": {
    "type": {
      "const": "match_pairs"
    },
    "interaction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "difficulty": {
      "enum": [
        "intro",
        "core",
        "stretch"
      ]
    },
    "grading_mode": {
      "enum": [
        "client",
        "server"
      ]
    },
    "standalone": {
      "type": "boolean"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/measures"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "public": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "left": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ]
          },
          "minItems": 2
        },
        "right": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ]
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "left",
        "right"
      ]
    },
    "grading": {
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "right": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "additionalProperties": false,
            "required": [
              "left",
              "right"
            ]
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "pairs"
      ]
    },
    "feedback": {
      "$ref": "common.schema.json#/$defs/feedback"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "interaction_id",
    "public",
    "grading",
    "feedback",
    "measures"
  ]
}
