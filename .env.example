# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# Azure OpenAI / Microsoft Foundry: Azure portal > your Foundry resource > Resource Management > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=

# Deployment names (Foundry > Build > Models). The first free name in a ladder is used.
GEN_LADDER=gpt-6.1-sol
EVAL_LADDER=gpt-6-astra

# Optional: low | medium | high. Left unset, the deployment's default is used.
# REASONING_EFFORT=medium

# Optional: stop/finish notifications as a JSON POST ({"text":..., "content":...}); works with Slack and Discord incoming webhooks.
# NOTIFY_WEBHOOK_URL=
